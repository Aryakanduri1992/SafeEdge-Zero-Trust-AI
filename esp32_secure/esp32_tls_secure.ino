/*
 * SafeEdge ESP32 Secure TLS Firmware (Arduino)
 * =============================================
 * Secure firmware with TLS/SSL certificate verification
 * and mutual authentication for ESP32 devices.
 * 
 * Features:
 * - TLS 1.2 encrypted communication
 * - Certificate pinning (SHA256 fingerprint)
 * - Mutual TLS (mTLS) authentication
 * - Secure handshake protocol
 * - Anti-replay protection
 * - Automatic reconnection with backoff
 * 
 * Hardware: ESP32
 * Author: SafeEdge Team - Imagine Cup 2026
 */

#include <WiFi.h>
#include <WiFiClientSecure.h>
#include <ArduinoJson.h>
#include <mbedtls/sha256.h>
#include <esp_random.h>

// ==================== CONFIGURATION ====================
// WiFi credentials (loaded from separate file or secrets)
#ifndef WIFI_SSID
#define WIFI_SSID "YOUR_WIFI_SSID"
#endif

#ifndef WIFI_PASSWORD
#define WIFI_PASSWORD "YOUR_WIFI_PASSWORD"
#endif

// Backend server configuration
const char* BACKEND_HOST = "192.168.29.192";
const int BACKEND_PORT = 8443;
const char* DEVICE_ID = "esp32_safeedge_001";
const char* FIRMWARE_VERSION = "2.0.0-TLS";

// Timing configuration
const int REPORT_INTERVAL_MS = 5000;
const int HEARTBEAT_INTERVAL_MS = 30000;
const int HANDSHAKE_TIMEOUT_MS = 30000;
const int MAX_RECONNECT_DELAY_MS = 60000;

// ==================== CERTIFICATES ====================
// Root CA Certificate (generated by tls_certificate_manager.py)
const char* ca_cert = R"EOF(
-----BEGIN CERTIFICATE-----
# Your SafeEdge Root CA certificate here
# Generate using: python tls_certificate_manager.py init
-----END CERTIFICATE-----
)EOF";

// Device Certificate (generated for this specific device)
const char* device_cert = R"EOF(
-----BEGIN CERTIFICATE-----
# Your device certificate here
# Generate using: python tls_certificate_manager.py device --device-id esp32_safeedge_001
-----END CERTIFICATE-----
)EOF";

// Device Private Key
const char* device_key = R"EOF(
-----BEGIN EC PRIVATE KEY-----
# Your device private key here
-----END EC PRIVATE KEY-----
)EOF";

// Server certificate fingerprint for pinning (SHA256)
// Update this with your actual server certificate fingerprint
const char* SERVER_CERT_FINGERPRINT = "AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99:AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99";

// ==================== GLOBAL VARIABLES ====================
WiFiClientSecure secureClient;
String sessionId = "";
bool isConnected = false;
unsigned long lastReportTime = 0;
unsigned long lastHeartbeatTime = 0;
int reconnectDelay = 1000;

// LED pins for status indication
const int LED_RED = 32;
const int LED_YELLOW = 26;
const int LED_GREEN = 25;
const int BUZZER_PIN = 33;

// ==================== FUNCTION DECLARATIONS ====================
void setupLEDs();
void setStatusLED(const char* status);
bool connectWiFi();
bool establishSecureConnection();
bool performSecureHandshake();
bool verifyCertificateFingerprint();
String generateNonce();
bool sendMessage(JsonDocument& doc);
bool receiveMessage(JsonDocument& doc);
void sendSensorData();
void sendHeartbeat();
String calculateSHA256(const uint8_t* data, size_t len);

// ==================== SETUP ====================
void setup() {
    Serial.begin(115200);
    delay(1000);
    
    Serial.println();
    Serial.println("================================================");
    Serial.println("SafeEdge ESP32 Secure TLS Firmware v2.0");
    Serial.println("Imagine Cup 2026 - Hospital IoT Security");
    Serial.println("================================================");
    
    // Initialize LEDs
    setupLEDs();
    setStatusLED("initializing");
    
    // Connect to WiFi
    if (!connectWiFi()) {
        Serial.println("WiFi connection failed!");
        setStatusLED("error");
        return;
    }
    
    // Configure secure client
    secureClient.setCACert(ca_cert);
    secureClient.setCertificate(device_cert);
    secureClient.setPrivateKey(device_key);
    
    // Establish secure connection
    if (!establishSecureConnection()) {
        Serial.println("Secure connection failed!");
        setStatusLED("error");
        return;
    }
    
    setStatusLED("connected");
    Serial.println("\nSecure connection established!");
    Serial.println("Starting sensor monitoring...\n");
}

// ==================== MAIN LOOP ====================
void loop() {
    // Check connection status
    if (!isConnected || !secureClient.connected()) {
        setStatusLED("warning");
        Serial.println("Connection lost. Reconnecting...");
        
        if (!establishSecureConnection()) {
            delay(reconnectDelay);
            reconnectDelay = min(reconnectDelay * 2, MAX_RECONNECT_DELAY_MS);
            return;
        }
        
        reconnectDelay = 1000;  // Reset backoff
        setStatusLED("connected");
    }
    
    unsigned long currentTime = millis();
    
    // Send sensor data at regular intervals
    if (currentTime - lastReportTime >= REPORT_INTERVAL_MS) {
        sendSensorData();
        lastReportTime = currentTime;
    }
    
    // Send heartbeat
    if (currentTime - lastHeartbeatTime >= HEARTBEAT_INTERVAL_MS) {
        sendHeartbeat();
        lastHeartbeatTime = currentTime;
    }
    
    delay(100);
}

// ==================== LED FUNCTIONS ====================
void setupLEDs() {
    pinMode(LED_RED, OUTPUT);
    pinMode(LED_YELLOW, OUTPUT);
    pinMode(LED_GREEN, OUTPUT);
    pinMode(BUZZER_PIN, OUTPUT);
    
    // Startup blink
    for (int i = 0; i < 3; i++) {
        digitalWrite(LED_GREEN, HIGH);
        delay(100);
        digitalWrite(LED_GREEN, LOW);
        delay(100);
    }
}

void setStatusLED(const char* status) {
    digitalWrite(LED_RED, LOW);
    digitalWrite(LED_YELLOW, LOW);
    digitalWrite(LED_GREEN, LOW);
    noTone(BUZZER_PIN);
    
    if (strcmp(status, "connected") == 0 || strcmp(status, "safe") == 0) {
        digitalWrite(LED_GREEN, HIGH);
    } else if (strcmp(status, "warning") == 0 || strcmp(status, "initializing") == 0) {
        digitalWrite(LED_YELLOW, HIGH);
        tone(BUZZER_PIN, 1500, 100); // Short warning beep
    } else if (strcmp(status, "error") == 0 || strcmp(status, "critical") == 0) {
        digitalWrite(LED_RED, HIGH);
        tone(BUZZER_PIN, 2000, 200); // Long critical beep
    }
}

// ==================== WIFI CONNECTION ====================
bool connectWiFi() {
    Serial.print("Connecting to WiFi");
    
    WiFi.mode(WIFI_STA);
    WiFi.begin(WIFI_SSID, WIFI_PASSWORD);
    
    int attempts = 0;
    while (WiFi.status() != WL_CONNECTED && attempts < 30) {
        delay(500);
        Serial.print(".");
        attempts++;
    }
    
    Serial.println();
    
    if (WiFi.status() == WL_CONNECTED) {
        Serial.println("WiFi Connected!");
        Serial.print("IP Address: ");
        Serial.println(WiFi.localIP());
        Serial.print("Signal Strength: ");
        Serial.print(WiFi.RSSI());
        Serial.println(" dBm");
        return true;
    }
    
    return false;
}

// ==================== SECURE CONNECTION ====================
bool establishSecureConnection() {
    Serial.print("Connecting to ");
    Serial.print(BACKEND_HOST);
    Serial.print(":");
    Serial.println(BACKEND_PORT);
    
    setStatusLED("initializing");
    
    // Close any existing connection
    if (secureClient.connected()) {
        secureClient.stop();
    }
    
    // Connect with TLS
    if (!secureClient.connect(BACKEND_HOST, BACKEND_PORT)) {
        Serial.println("TLS connection failed!");
        return false;
    }
    
    Serial.println("TLS connection established");
    
    // Verify server certificate fingerprint (certificate pinning)
    if (!verifyCertificateFingerprint()) {
        Serial.println("Certificate verification failed!");
        secureClient.stop();
        return false;
    }
    
    Serial.println("Server certificate verified");
    
    // Perform secure handshake
    if (!performSecureHandshake()) {
        Serial.println("Secure handshake failed!");
        secureClient.stop();
        return false;
    }
    
    isConnected = true;
    return true;
}

