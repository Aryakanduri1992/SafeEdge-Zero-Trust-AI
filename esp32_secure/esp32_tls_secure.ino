// ==================== SECURE HANDSHAKE ====================
bool performSecureHandshake() {
    Serial.println("Starting secure handshake...");
    
    unsigned long startTime = millis();
    
    // Step 1: Receive challenge from server
    StaticJsonDocument<512> challenge;
    
    if (!receiveMessage(challenge)) {
        Serial.println("Failed to receive challenge");
        return false;
    }
    
    if (strcmp(challenge["type"], "challenge") != 0) {
        Serial.println("Invalid message type, expected challenge");
        return false;
    }
    
    const char* serverNonce = challenge["nonce"];
    long serverTimestamp = challenge["timestamp"];
    
    Serial.print("Challenge received from: ");
    Serial.println(challenge["server_id"].as<const char*>());
    
    // Verify timestamp is recent (anti-replay protection)
    long currentTimestamp = millis() / 1000;  // Simplified - use NTP in production
    // Note: In production, sync time with NTP and verify server timestamp
    
    // Step 2: Generate and send response
    String clientNonce = generateNonce();
    
    StaticJsonDocument<512> response;
    response["type"] = "challenge_response";
    response["server_nonce"] = serverNonce;
    response["client_nonce"] = clientNonce;
    response["timestamp"] = serverTimestamp;
    response["device_id"] = DEVICE_ID;
    response["device_type"] = "ESP32_NICU_Monitor";
    response["firmware_version"] = FIRMWARE_VERSION;
    
    JsonArray capabilities = response.createNestedArray("capabilities");
    capabilities.add("temperature");
    capabilities.add("humidity");
    capabilities.add("motion");
    capabilities.add("tls");
    capabilities.add("mtls");
    
    if (!sendMessage(response)) {
        Serial.println("Failed to send challenge response");
        return false;
    }
    
    Serial.println("Challenge response sent");
    
    // Step 3: Receive session confirmation
    StaticJsonDocument<512> confirmation;
    
    if (!receiveMessage(confirmation)) {
        Serial.println("Failed to receive session confirmation");
        return false;
    }
    
    if (strcmp(confirmation["type"], "session_established") != 0) {
        Serial.print("Handshake failed: ");
        Serial.println(confirmation["error"].as<const char*>());
        return false;
    }
    
    sessionId = confirmation["session_id"].as<String>();
    int expiresIn = confirmation["expires_in"];
    
    Serial.print("Session established: ");
    Serial.println(sessionId.substring(0, 16) + "...");
    Serial.print("Session expires in: ");
    Serial.print(expiresIn);
    Serial.println("s");
    
    // Step 4: Send final confirmation
    StaticJsonDocument<128> finalConfirm;
    finalConfirm["type"] = "session_confirmed";
    
    if (!sendMessage(finalConfirm)) {
        Serial.println("Failed to send session confirmation");
        return false;
    }
    
    unsigned long handshakeTime = millis() - startTime;
    Serial.print("Handshake complete in ");
    Serial.print(handshakeTime);
    Serial.println("ms");
    
    return true;
}

String generateNonce() {
    // Generate 32-byte cryptographic nonce using hardware RNG
    uint8_t nonceBytes[32];
    esp_fill_random(nonceBytes, 32);
    
    String nonce = "";
    for (int i = 0; i < 32; i++) {
        char hex[3];
        sprintf(hex, "%02x", nonceBytes[i]);
        nonce += hex;
    }
    
    return nonce;
}

// ==================== MESSAGE HANDLING ====================
bool sendMessage(JsonDocument& doc) {
    String jsonStr;
    serializeJson(doc, jsonStr);
    
    // Send length prefix (4 bytes, big-endian)
    uint32_t length = jsonStr.length();
    uint8_t lengthBytes[4];
    lengthBytes[0] = (length >> 24) & 0xFF;
    lengthBytes[1] = (length >> 16) & 0xFF;
    lengthBytes[2] = (length >> 8) & 0xFF;
    lengthBytes[3] = length & 0xFF;
    
    secureClient.write(lengthBytes, 4);
    secureClient.print(jsonStr);
    secureClient.flush();
    
    return true;
}

bool receiveMessage(JsonDocument& doc) {
    unsigned long startTime = millis();
    
    // Wait for data with timeout
    while (secureClient.available() < 4) {
        if (millis() - startTime > HANDSHAKE_TIMEOUT_MS) {
            Serial.println("Receive timeout");
            return false;
        }
        delay(10);
    }
    
    // Read length prefix
    uint8_t lengthBytes[4];
    secureClient.readBytes(lengthBytes, 4);
    
    uint32_t length = ((uint32_t)lengthBytes[0] << 24) |
                      ((uint32_t)lengthBytes[1] << 16) |
                      ((uint32_t)lengthBytes[2] << 8) |
                      (uint32_t)lengthBytes[3];
    
    // Sanity check
    if (length > 65536) {
        Serial.println("Message too large");
        return false;
    }
    
    // Read message
    String message = "";
    while (message.length() < length) {
        if (secureClient.available()) {
            message += (char)secureClient.read();
        }
        
        if (millis() - startTime > HANDSHAKE_TIMEOUT_MS) {
            Serial.println("Message read timeout");
            return false;
        }
    }
    
    // Parse JSON
    DeserializationError error = deserializeJson(doc, message);
    if (error) {
        Serial.print("JSON parse error: ");
        Serial.println(error.c_str());
        return false;
    }
    
    return true;
}

// ==================== SENSOR DATA ====================
void sendSensorData() {
    // Generate sensor data
    float temperature = 36.8 + (random(-30, 30) / 100.0);
    float humidity = 55.0 + (random(-25, 25) / 10.0);
    float airPressure = 1013.0 + (random(-25, 25) / 10.0);
    float oxygenLevel = 21.0 + (random(0, 50) / 100.0);
    bool motionDetected = random(100) < 5;
    bool doorOpen = random(100) < 2;
    float vibration = random(0, 30) / 100.0;
    float powerVoltage = 12.0 + (random(-25, 25) / 100.0);
    
    // Determine threat level
    const char* threatLevel = "safe";
    int securityScore = 100;
    bool anomalyDetected = false;
    
    if (temperature < 36.5 || temperature > 37.5) {
        threatLevel = "critical";
        securityScore -= 30;
        anomalyDetected = true;
    }
    
    if (humidity < 50 || humidity > 60) {
        if (strcmp(threatLevel, "safe") == 0) {
            threatLevel = "warning";
        }
        securityScore -= 20;
        anomalyDetected = true;
    }
    
    // Update status LED
    setStatusLED(threatLevel);
    
    // Build message
    StaticJsonDocument<1024> doc;
    doc["type"] = "sensor_data";
    doc["session_id"] = sessionId;
    doc["timestamp"] = millis() / 1000;
    
    JsonObject data = doc.createNestedObject("data");
    data["device_id"] = DEVICE_ID;
    data["temperature"] = temperature;
    data["humidity"] = humidity;
    data["air_pressure"] = airPressure;
    data["oxygen_level"] = oxygenLevel;
    data["motion_detected"] = motionDetected;
    data["door_status"] = doorOpen;
    data["vibration_level"] = vibration;
    data["power_voltage"] = powerVoltage;
    data["wifi_signal_strength"] = WiFi.RSSI();
    data["threat_level"] = threatLevel;
    data["anomaly_detected"] = anomalyDetected;
    data["security_score"] = max(0, securityScore);
    data["tls_enabled"] = true;
    data["mtls_enabled"] = true;
    
    // Send data
    if (sendMessage(doc)) {
        // Wait for response
        StaticJsonDocument<256> response;
        if (receiveMessage(response)) {
            Serial.print("[TLS] ");
            if (strcmp(threatLevel, "critical") == 0) {
                Serial.print("🔴 CRITICAL");
            } else if (strcmp(threatLevel, "warning") == 0) {
                Serial.print("🟡 WARNING");
            } else {
                Serial.print("🟢 SAFE");
            }
            Serial.print(" - Score: ");
            Serial.print(securityScore);
            Serial.print(" | Temp: ");
            Serial.print(temperature);
            Serial.println("°C");
        }
    } else {
        Serial.println("[TLS] Failed to send sensor data");
        isConnected = false;
    }
}

void sendHeartbeat() {
    StaticJsonDocument<256> doc;
    doc["type"] = "heartbeat";
    doc["session_id"] = sessionId;
    doc["timestamp"] = millis() / 1000;
    doc["uptime"] = millis() / 1000;
    doc["wifi_rssi"] = WiFi.RSSI();
    doc["free_heap"] = ESP.getFreeHeap();
    
    if (sendMessage(doc)) {
        StaticJsonDocument<128> response;
        if (receiveMessage(response)) {
            if (strcmp(response["type"], "heartbeat_ack") == 0) {
                Serial.println("[TLS] Heartbeat OK");
            }
        }
    } else {
        Serial.println("[TLS] Heartbeat failed");
        isConnected = false;
    }
}

// ==================== UTILITY FUNCTIONS ====================
String calculateSHA256(const uint8_t* data, size_t len) {
    uint8_t hash[32];
    mbedtls_sha256_context ctx;
    
    mbedtls_sha256_init(&ctx);
    mbedtls_sha256_starts(&ctx, 0);  // 0 = SHA256
    mbedtls_sha256_update(&ctx, data, len);
    mbedtls_sha256_finish(&ctx, hash);
    mbedtls_sha256_free(&ctx);
    
    String hashStr = "";
    for (int i = 0; i < 32; i++) {
        char hex[3];
        sprintf(hex, "%02X", hash[i]);
        hashStr += hex;
        if (i < 31) hashStr += ":";
    }
    
    return hashStr;
}
