/**
 * @file Overview
 * This ruleset enforces a role-based access control model for the AuthStation application.
 * It uses dedicated collections to manage Super Admin roles and links Admin profiles to their creating Super Admin.
 * The structure prioritizes Authorization Independence, avoiding `get()` calls in rules by denormalizing authorization context directly into documents.
 *
 * Data Structure:
 * - /roles_super_admin/{superAdminId}: Indicates a Firebase Auth user is a Super Admin.
 * - /admins/{adminId}: Stores Admin profiles, linked to a Super Admin via 'superAdminId'.
 * - /devices/{deviceId}: Stores IoT device data, linked to an Admin via 'adminId'.
 * - /alerts/{alertId}: Stores system alerts, linked to an Admin via 'adminId'.
 *
 * Key Security Decisions:
 * - Super Admin role is determined by the existence of a document in /roles_super_admin/{superAdminId}.
 * - Admin creation is restricted to Super Admins.
 * - Admins can only access devices and alerts associated with their 'adminId'.
 * - Authorization Independence is maintained by avoiding `get()` calls and denormalizing data.
 *
 * Denormalization for Authorization:
 * - The 'adminId' field in /devices/{deviceId} and /alerts/{alertId} is used to directly enforce access control.
 * - The existence of a document in /roles_super_admin/{superAdminId} grants super admin privileges.
 *
 * Structural Segregation:
 * - Dedicated collections for roles (/roles_super_admin/{superAdminId}) and data (/admins/{adminId}, /devices/{deviceId}, /alerts/{alertId}) enable simpler, more performant rules.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description: This rule controls access to Super Admin role documents.
     * @path: /roles_super_admin/{superAdminId}
     * @allow: User with UID 'superAdmin123' creates a document at /roles_super_admin/superAdmin123 (create).
     * @deny: User with UID 'admin456' tries to create a document at /roles_super_admin/superAdmin123 (create) - only the super admin can create their own role document.
     * @principle: Role-based access control. Only the authenticated user can create their own super admin role.
     */
    match /roles_super_admin/{superAdminId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn() && isOwner(superAdminId);
      allow update: if isSignedIn() && isOwner(superAdminId);
      allow delete: if isSignedIn() && isOwner(superAdminId);
    }

    /**
     * @description: This rule controls access to Admin profile documents.
     * @path: /admins/{adminId}
     * @allow: A Super Admin with UID 'superAdmin123' creates an admin profile at /admins/admin456 (create).
     * @deny: A regular user tries to create an admin profile at /admins/admin456 (create) - only Super Admins can create admin profiles.
     * @principle: Role-based access control. Only Super Admins can create/modify/delete admin profiles.
     */
    match /admins/{adminId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn() && isSuperAdmin();
      allow update: if isSignedIn() && isSuperAdmin();
      allow delete: if isSignedIn() && isSuperAdmin();
    }

    /**
     * @description: This rule controls access to Device documents.
     * @path: /devices/{deviceId}
     * @allow: An Admin with UID 'admin123' creates a device at /devices/device456 with adminId: 'admin123' (create).
     * @deny: An Admin with UID 'admin123' tries to create a device at /devices/device456 with adminId: 'admin789' (create) - adminId must match the user's UID.
     * @principle: Data ownership. Only the admin associated with the device can modify it.
     */
    match /devices/{deviceId} {
      allow get: if isSignedIn() && isDeviceAdmin(resource.data.adminId);
      allow list: if false;
      allow create: if isSignedIn() && isValidDeviceCreateRequest();
      allow update: if isSignedIn() && isDeviceAdmin(resource.data.adminId);
      allow delete: if isSignedIn() && isDeviceAdmin(resource.data.adminId);
    }

    /**
     * @description: This rule controls access to Alert documents.
     * @path: /alerts/{alertId}
     * @allow: An Admin with UID 'admin123' creates an alert at /alerts/alert456 with adminId: 'admin123' (create).
     * @deny: An Admin with UID 'admin123' tries to create an alert at /alerts/alert456 with adminId: 'admin789' (create) - adminId must match the user's UID.
     * @principle: Data ownership. Only the admin associated with the alert can modify it.
     */
    match /alerts/{alertId} {
      allow get: if isSignedIn() && isAlertAdmin(resource.data.adminId);
      allow list: if false;
      allow create: if isSignedIn() && isValidAlertCreateRequest();
      allow update: if isSignedIn() && isAlertAdmin(resource.data.adminId);
      allow delete: if isSignedIn() && isAlertAdmin(resource.data.adminId);
    }

    // --- Helper Functions ---

    /**
     * @description: Checks if the user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description: Checks if the authenticated user's UID matches the provided userId.
     * @param userId: The user ID to compare against.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description: Checks if the authenticated user is a Super Admin by verifying the existence of a document in /roles_super_admin/{uid}.
     */
    function isSuperAdmin() {
      return exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
    }

    /**
     * @description: Checks if the authenticated user ID is the same as the adminId.
     * @param adminId: The admin ID to compare against.
     */
    function isAdmin(adminId) {
      return request.auth.uid == adminId;
    }

    /**
     * @description: Checks if the authenticated user is authorized to read/write a device based on the device's adminId.
     * @param adminId: The admin ID associated with the device.
     */
    function isDeviceAdmin(adminId) {
        return isSignedIn() && request.auth.uid == adminId;
    }

    /**
     * @description: Checks if the authenticated user is authorized to read/write an alert based on the alert's adminId.
     * @param adminId: The admin ID associated with the alert.
     */
    function isAlertAdmin(adminId) {
        return isSignedIn() && request.auth.uid == adminId;
    }

    /**
     * @description: Check if an existing document is owned by the authenticated user.
     * @param userId: The ID of the user who should own the document.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description: Check if an existing Device document is owned by the authenticated user.
     * @param adminId: The ID of the admin who should own the device.
     */
    function isExistingDeviceAdmin(adminId) {
      return request.auth.uid == adminId && resource.data.adminId == request.auth.uid;
    }

    /**
     * @description: Check if an existing Alert document is owned by the authenticated user.
     * @param adminId: The ID of the admin who should own the Alert.
     */
    function isExistingAlertAdmin(adminId) {
      return request.auth.uid == adminId && resource.data.adminId == request.auth.uid;
    }

    /**
     * @description: Validates Device create request.
     */
    function isValidDeviceCreateRequest() {
      return request.resource.data.adminId == request.auth.uid;
    }

    /**
     * @description: Validates Alert create request.
     */
    function isValidAlertCreateRequest() {
      return request.resource.data.adminId == request.auth.uid;
    }
  }
}