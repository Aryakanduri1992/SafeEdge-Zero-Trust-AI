/**
 * @fileoverview Firestore Security Rules for AuthStation.
 *
 * Core Philosophy:
 * This ruleset enforces a multi-tenant data model where access is primarily governed
 * by organization and user roles. Super Admins have broad access, while regular
 * users are restricted to their organization's data. Data ownership is enforced
 * for write operations to ensure that users can only modify data within their
 * designated scope.
 *
 * Data Structure:
 * - /roles_super_admin/{superAdminId}: Documents identifying super administrator users.
 * - /organizations/{organizationId}: Stores profile information for each organization.
 * - /departments/{departmentId}: Stores department details, linked to an organization.
 * - /devices/{deviceId}: Stores individual device details, linked to a department and organization.
 * - /sensorReadings/{readingId}: Stores time-series sensor data, linked to a device and organization.
 *
 * Key Security Decisions:
 * - Super Admin Role: Super admins, identified in /roles_super_admin/{superAdminId}, bypass certain organizational restrictions.
 * - Organization-Based Access: Most data access is scoped to the organization. Users can only access data associated with their organization.
 * - List Operation Security: List operations are generally restricted to prevent unauthorized data discovery.
 * - Denormalization: The 'organizationId' field is crucial for many authorization checks.  It must be present in most entities.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     * @path N/A
     * @allow N/A
     * @deny N/A
     * @principle Authentication required for all protected resources.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user's ID matches the provided userId.
     * @path N/A
     * @allow request.auth.uid == 'user123'
     * @deny request.auth.uid != 'user123'
     * @principle Enforces ownership based on user ID.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the user's ID matches the userId and the resource exists.
     * @path N/A
     * @allow isOwner('user123') && resource != null
     * @deny !isOwner('user123') || resource == null
     * @principle Enforces ownership and resource existence for updates and deletes.
     */
    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }

    /**
     * @description Checks if the user is a super admin, which bypasses certain organization restrictions.
     * @path N/A
     * @allow User with UID in /roles_super_admin/{superAdminId}
     * @deny User with UID not in /roles_super_admin/{superAdminId}
     * @principle Super admins have privileged access.
     */
    function isSuperAdmin() {
      return exists(/databases/(default)/documents/roles_super_admin/$(request.auth.uid));
    }

    /**
     * @description Determines if the request targets the same organization as the user.
     * @path N/A
     * @allow request.auth.uid belogs to the target organization.
     * @deny request.auth.uid does not belong to the target organization.
     * @principle Ensures users only access data within their organization.
     */
    function isInOrganization(organizationId) {
      return get(/databases/$(database)/documents/organizations/$(organizationId)).data.superAdminId == request.auth.uid || isSuperAdmin();
    }

    /**
     * @description Checks if the 'organizationId' field in the request matches the resource's 'organizationId'.
     * @path N/A
     */
    function matchesOrganizationId(organizationId) {
      return request.resource.data.organizationId == organizationId;
    }

    /**
     * @description Checks if the 'organizationId' field in the resource data matches the existing document's 'organizationId'.
     * @path N/A
     */
    function matchesExistingOrganizationId(organizationId) {
      return resource.data.organizationId == organizationId;
    }


    /**
     * @description Manages access control for super admin roles.
     * @path /roles_super_admin/{superAdminId}
     * @allow (create) A user creating their own super admin role.
     * @deny (create) A user attempting to create a super admin role for another user.
     * @allow (get) Any signed-in user can get a super admin role.
     * @deny (get) A non-signed-in user attempting to get a super admin role.
     * @allow (list) Any signed-in user can list super admin roles.
     * @deny (list) A non-signed-in user attempting to list super admin roles.
     * @principle Enforces strict ownership for super admin role creation and read access for signed-in users.
     */
    match /roles_super_admin/{superAdminId} {
        allow create: if isOwner(superAdminId);
        allow get: if isSignedIn();
        allow list: if isSignedIn();
        allow update: if false;
        allow delete: if false;
    }

     /**
      * @description Manages access control for organizations.
      * @path /organizations/{organizationId}
      * @allow (create) A user creating an organization with their superAdminId.
      * @deny (create) A user attempting to create an organization with a mismatched superAdminId.
      * @allow (get) Any signed-in user can get organization information.
      * @deny (get) A non-signed-in user attempting to get organization information.
      * @allow (list) Any signed-in user can list organizations.
      * @deny (list) A non-signed-in user attempting to list organizations.
      * @allow (update) Only a super admin of the organization can update it.
      * @deny (update) A regular user attempting to update an organization they don't own.
      * @principle Enforces ownership for organization creation and restricts updates to super admins.
      */
    match /organizations/{organizationId} {
      allow create: if isSignedIn() && request.resource.data.superAdminId == request.auth.uid;
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow update: if isExistingOwner(request.auth.uid) || isSuperAdmin();
      allow delete: if false;
    }

    /**
     * @description Manages access control for departments within an organization.
     * @path /departments/{departmentId}
     * @allow (create) Only a super admin of the organization can create a department. Requires organizationId to match.
     * @deny (create) A regular user or super admin of another organization attempting to create a department.
     * @allow (get) Any signed-in user can get department information if the organization matches.
     * @deny (get) A non-signed-in user or user from another organization attempting to get department information.
     * @allow (list) Only the super admin for a given organization can list departments.
     * @deny (list) A regular user or super admin from another organization attempting to list departments.
     * @allow (update) Only a super admin of the organization can update a department.
     * @deny (update) A regular user or super admin of another organization attempting to update a department.
     * @principle Restricts department creation and updates to the organization's super admin, and enforces organization-level access for reads.
     */
    match /departments/{departmentId} {
      allow create: if isSignedIn() && isInOrganization(request.resource.data.organizationId) && matchesOrganizationId(request.resource.data.organizationId);
      allow get: if isSignedIn() && isInOrganization(resource.data.organizationId);
      allow list: if isSignedIn() && isInOrganization(request.query.stringValues.organizationId);
      allow update: if isSignedIn() && isInOrganization(resource.data.organizationId) && matchesExistingOrganizationId(resource.data.organizationId);
      allow delete: if false;
    }

    /**
     * @description Manages access control for devices within an organization and department.
     * @path /devices/{deviceId}
     * @allow (create) Only a super admin of the organization can create a device. Requires organizationId and departmentId to match.
     * @deny (create) A regular user or super admin of another organization attempting to create a device.
     * @allow (get) Any signed-in user can get device information if the organization matches.
     * @deny (get) A non-signed-in user or user from another organization attempting to get device information.
     * @allow (list) Only the super admin for a given organization can list devices.
     * @deny (list) A regular user or super admin from another organization attempting to list devices.
     * @allow (update) Only a super admin of the organization can update a device.
     * @deny (update) A regular user or super admin of another organization attempting to update a device.
     */
    match /devices/{deviceId} {
        allow create: if isSignedIn() && isInOrganization(request.resource.data.organizationId) && matchesOrganizationId(request.resource.data.organizationId);
        allow get: if isSignedIn() && isInOrganization(resource.data.organizationId);
        allow list: if isSignedIn() && isInOrganization(request.query.stringValues.organizationId);
        allow update: if isSignedIn() && isInOrganization(resource.data.organizationId) && matchesExistingOrganizationId(resource.data.organizationId);
        allow delete: if false;
    }

    /**
     * @description Manages access control for sensor readings associated with a device.
     * @path /sensorReadings/{readingId}
     * @allow (create) Only a super admin of the organization can create a sensor reading. Requires deviceId and organizationId to match.
     * @deny (create) A regular user or super admin of another organization attempting to create a sensor reading.
     * @allow (get) Any signed-in user can get sensor reading information if the organization matches.
     * @deny (get) A non-signed-in user or user from another organization attempting to get sensor reading information.
     * @allow (list) Only the super admin for a given organization can list sensor readings.
     * @deny (list) A regular user or super admin from another organization attempting to list sensor readings.
     * @allow (update) Only a super admin of the organization can update a sensor reading.
     * @deny (update) A regular user or super admin of another organization attempting to update a sensor reading.
     */
    match /sensorReadings/{readingId} {
        allow create: if isSignedIn() && isInOrganization(request.resource.data.organizationId) && matchesOrganizationId(request.resource.data.organizationId);
        allow get: if isSignedIn() && isInOrganization(resource.data.organizationId);
        allow list: if isSignedIn() && isInOrganization(request.query.stringValues.organizationId);
        allow update: if isSignedIn() && isInOrganization(resource.data.organizationId) && matchesExistingOrganizationId(resource.data.organizationId);
        allow delete: if false;
    }
  }
}