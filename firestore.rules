/**
 * @fileOverview Firestore Security Rules for AuthStation application.
 *
 * Core Philosophy:
 * This ruleset enforces a role-based access control model, primarily centered around "SuperAdmin" and "Admin" roles.
 * SuperAdmin privileges are granted based on the existence of a document in the `/roles_super_admin/{superAdminId}` collection.
 * Admin data is stored in the `/admins/{adminId}` collection and linked to a SuperAdmin via the `superAdminId` field.
 * Authorization Independence is a key design principle.  Rules avoid `get()` calls by relying on document existence
 * in role collections or by storing authorization data directly within the documents being secured.
 *
 * Data Structure:
 * - `/roles_super_admin/{superAdminId}`: SuperAdmin role documents. The existence of a document for a user ID grants SuperAdmin privileges.
 * - `/admins/{adminId}`: Admin profiles.  Each document contains a `superAdminId` field, linking it to the creating SuperAdmin.
 *
 * Key Security Decisions:
 * - SuperAdmin privileges are determined by the existence of a document in `/roles_super_admin/{superAdminId}`.
 * - Listing of admins is only allowed for SuperAdmins.
 * - Admin creation is restricted to SuperAdmins, validated by their document existing in /roles_super_admin/{superAdminId}.
 * - The `superAdminId` field in the `Admin` document is immutable after creation.
 *
 * Denormalization for Authorization:
 * - The existence of a document in `/roles_super_admin/{superAdminId}` serves as the denormalized authorization token for SuperAdmin privileges.
 *
 * Structural Segregation:
 * - The application uses role-based collections to determine user privileges for specific actions.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants SuperAdmin privileges based on document existence.
     * @path /roles_super_admin/{superAdminId}
     * @allow (create) User with matching UID creates their SuperAdmin document.
     * @deny (create) User attempts to create a SuperAdmin document for another user.
     * @allow (get) Any authenticated user can check if a SuperAdmin role exists for their ID.
     * @allow (list) Any authenticated user can list SuperAdmin role exists.
     * @deny (update, delete) No updates or deletes allowed. SuperAdmin role assignment is managed externally.
     * @principle SuperAdmin role is determined by the existence of a document with the user's UID as the document ID.
     */
    match /roles_super_admin/{superAdminId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == superAdminId;
      allow update, delete: if false;
    }

    /**
     * @description Manages Admin profiles, allowing SuperAdmins to create, read, update, and delete them.
     * @path /admins/{adminId}
     * @allow (create) SuperAdmin creates a new Admin profile.
     * @deny (create) Non-SuperAdmin attempts to create an Admin profile.
     * @allow (get) Any SuperAdmin user can read an Admin profile.
     * @allow (list) Any SuperAdmin user can list Admin profiles.
     * @allow (update) SuperAdmin updates an existing Admin profile.
     * @allow (delete) SuperAdmin deletes an existing Admin profile.
     * @deny (update, delete) Non-SuperAdmin attempts to update or delete an Admin profile.
     * @principle Restricts Admin management to SuperAdmins.
     */
    match /admins/{adminId} {
      allow get, list: if isSuperAdmin();
      allow create: if isSuperAdmin()
                   && request.resource.data.superAdminId == request.auth.uid;
      allow update: if isSuperAdmin()
                   && request.resource.data.superAdminId == resource.data.superAdminId;
      allow delete: if isSuperAdmin();
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isSuperAdmin() {
      return exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
    }
  }
}