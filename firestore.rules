/**
 * @file Firebase Security Rules for AuthStation Application
 *
 * @description This ruleset enforces a role-based access control model for the AuthStation application.
 * Super Admins have full control over Admins, while Admins manage their own Devices and Alerts.
 *
 * @dataStructure
 * - `/roles_super_admin/{superAdminId}`: Super Admin role assignments. The existence of a document at this path grants super admin privileges to the user with the matching UID.
 * - `/admins/{adminId}`: Admin user profiles, created and managed by Super Admins.
 * - `/devices/{deviceId}`: IoT device data, owned by an Admin. Each device has an `adminId` field linking it to the owning Admin.
 * - `/alerts/{alertId}`: System alerts generated by devices, owned by an Admin. Each alert has an `adminId` field linking it to the owning Admin.
 *
 * @keySecurityDecisions
 * - Super Admin role is determined by the existence of a document in the `/roles_super_admin/{superAdminId}` collection.
 * - Admins, Devices, and Alerts are all secured using an ownership model based on the `adminId` field.
 * - Listing of Admins, Devices, and Alerts is disallowed to prevent information disclosure.
 * - Authorization Independence is achieved by storing authorization information directly on the documents being secured and by using existence checks for roles.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Manages Super Admin role assignments.
     * @path /roles_super_admin/{superAdminId}
     * @allow (create) - A signed-in user can create their own Super Admin role document.
     * @deny (create) - A signed-in user cannot create a Super Admin role document for another user (mismatched UID).
     * @allow (get) A signed-in user can check the existence of a Super Admin role document.
     * @deny (list) Listing Super Admin roles is not permitted.
     * @principle Enforces user-ownership for Super Admin role creation, update, and deletion.
     */
    match /roles_super_admin/{superAdminId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn() && isOwner(superAdminId);
      allow update: if isSignedIn() && isOwner(superAdminId);
      allow delete: if isSignedIn() && isOwner(superAdminId);
    }

    /**
     * @description Manages Admin user profiles.
     * @path /admins/{adminId}
     * @allow (create) - A Super Admin can create a new Admin profile.
     * @deny (create) - A regular user cannot create an Admin profile.
     * @allow (get) A signed-in user can retrieve an Admin profile.
     * @deny (list) Listing Admin profiles is not permitted.
     * @principle Restricts Admin creation, update, and deletion to Super Admins only.
     */
    match /admins/{adminId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn() && isSuperAdmin();
      allow update: if isSignedIn() && isSuperAdmin();
      allow delete: if isSignedIn() && isSuperAdmin();
    }

    /**
     * @description Manages IoT device data.
     * @path /devices/{deviceId}
     * @allow (create) - An Admin can create a new device and associates it to their adminId.
     * @deny (create) - A user cannot create a device and associates it to another adminId.
     * @allow (get) A signed-in user can retrieve a device if they are the admin.
     * @deny (list) Listing devices is not permitted.
     * @principle Enforces device ownership based on the 'adminId' field.
     */
    match /devices/{deviceId} {
      allow get: if isSignedIn() && isAdmin(resource.data.adminId);
      allow list: if false;
      allow create: if isSignedIn() && isValidDeviceCreateRequest();
      allow update: if isSignedIn() && isAdmin(resource.data.adminId);
      allow delete: if isSignedIn() && isAdmin(resource.data.adminId);
    }

    /**
     * @description Manages system alerts generated from devices.
     * @path /alerts/{alertId}
     * @allow (create) - An Admin can create a new alert and associates it to their adminId.
     * @deny (create) - A user cannot create an alert and associates it to another adminId.
     * @allow (get) A signed-in user can retrieve an alert if they are the admin.
     * @deny (list) Listing alerts is not permitted.
     * @principle Enforces alert ownership based on the 'adminId' field.
     */
    match /alerts/{alertId} {
      allow get: if isSignedIn() && isAdmin(resource.data.adminId);
      allow list: if false;
      allow create: if isSignedIn() && isValidAlertCreateRequest();
      allow update: if isSignedIn() && isAdmin(resource.data.adminId);
      allow delete: if isSignedIn() && isAdmin(resource.data.adminId);
    }

    // -----------------------------
    // HELPER FUNCTIONS
    // -----------------------------

    /**
     * Check if user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Check if the authenticated user's UID matches the provided userId.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * Check if the authenticated user is a Super Admin.
     * (Exists if a doc at /roles_super_admin/{uid} is present.)
     */
    function isSuperAdmin() {
      return exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
    }

    /**
     * Check if the user is the Admin for the given adminId.
     */
    function isAdmin(adminId) {
      return request.auth.uid == adminId;
    }

    /**
     * Check if user owns a device based on its adminId.
     */
    function isDeviceAdmin(adminId) {
      return isSignedIn() && request.auth.uid == adminId;
    }

    /**
     * Check if user owns an alert based on its adminId.
     */
    function isAlertAdmin(adminId) {
      return isSignedIn() && request.auth.uid == adminId;
    }

    /**
     * Check ownership of an existing document.
     */
    function isExistingOwner(userId) {
      return resource.data.userId == userId;
    }

    /**
     * Check if existing Device document belongs to user.
     */
    function isExistingDeviceAdmin(adminId) {
      return resource.data.adminId == request.auth.uid;
    }

    /**
     * Check if existing Alert document belongs to user.
     */
    function isExistingAlertAdmin(adminId) {
      return resource.data.adminId == request.auth.uid;
    }

    /**
     * Validate Device create request.
     * (Use request.resource since resource doesn’t exist yet.)
     */
    function isValidDeviceCreateRequest() {
      return request.resource.data.adminId == request.auth.uid;
    }

    /**
     * Validate Alert create request.
     */
    function isValidAlertCreateRequest() {
      return request.resource.data.adminId == request.auth.uid;
    }
  }
}