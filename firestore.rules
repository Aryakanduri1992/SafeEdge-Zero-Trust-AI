/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a role-based access control model with super-admin capabilities and organization/department ownership.
 *
 * Data Structure:
 * - /roles_super_admin/{superAdminId}: Super admin role assignments, where {superAdminId} is the user's UID.
 * - /organizations/{organizationId}: Organization profiles, linked to a super admin.
 * - /departments/{departmentId}: Department information, linked to an organization and super admin.
 * - /devices/{deviceId}: Device information, linked to a department and organization.
 *
 * Key Security Decisions:
 * - Super admins can manage their organizations, departments, and devices.
 * - Organizations are isolated, with super admins managing their own data.
 * - No public listing of users, organizations, or departments is allowed.
 * - Unauthenticated access is disallowed.
 *
 * Denormalization for Authorization:
 * - Organization documents store the `superAdminId` to simplify ownership checks.
 * - Department documents store both `organizationId` and `superAdminId` for efficient authorization.
 * - Device documents store `departmentId` and `organizationId` for access control.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants super admin role assignment based on UID.
     * @path /roles_super_admin/{superAdminId}
     * @allow (create) User with UID 'user_abc' can create their super admin record if authenticated.
     * @deny (create) User with UID 'user_xyz' cannot create a super admin record for 'user_abc'.
     * @principle Allows a user to create their own super admin role; no updates or deletes allowed.
     */
    match /roles_super_admin/{superAdminId} {
      allow get: if false;
      allow list: if false;
      allow create: if isSignedIn() && isOwner(superAdminId);
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Manages organizations, allowing super admins to create, update, and delete their organizations.
     * @path /organizations/{organizationId}
     * @allow (create) SuperAdmin 'super_admin_abc' can create an organization.
     * @deny (update) User 'not_super_admin' cannot update organization 'org1' even if authenticated.
     * @principle Enforces super admin ownership for organization management.
     */
    match /organizations/{organizationId} {
      allow get: if false;
      allow list: if false;
      allow create: if isSignedIn() && request.resource.data.superAdminId == request.auth.uid;
      allow update: if isSignedIn() && isExistingOwner(resource.data.superAdminId);
      allow delete: if isSignedIn() && isExistingOwner(resource.data.superAdminId);
    }

    /**
     * @description Manages departments, allowing super admins to create, update, and delete departments within their organizations.
     * @path /departments/{departmentId}
     * @allow (create) SuperAdmin 'super_admin_abc' can create a department in their organization 'org1'.
     * @deny (update) User 'not_super_admin' cannot update department 'dept1' even if authenticated.
     * @principle Enforces super admin ownership for department management.
     */
    match /departments/{departmentId} {
      allow get: if false;
      allow list: if false;
      allow create: if isSignedIn() && request.resource.data.superAdminId == request.auth.uid;
      allow update: if isSignedIn() && isExistingOwner(resource.data.superAdminId);
      allow delete: if isSignedIn() && isExistingOwner(resource.data.superAdminId);
    }

    /**
     * @description Manages devices, allowing super admins to create, update, and delete devices within their departments.
     * @path /devices/{deviceId}
     * @allow (create) SuperAdmin 'super_admin_abc' can create a device in their department 'dept1'.
     * @deny (update) User 'not_super_admin' cannot update device 'device1' even if authenticated.
     * @principle Enforces super admin ownership for device management.
     */
    match /devices/{deviceId} {
      allow get: if false;
      allow list: if false;
      allow create: if isSignedIn() && request.resource.data.organizationId in (get(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)).data.superAdminId);
      allow update: if isSignedIn() && isExistingOwner(get(/databases/$(database)/documents/organizations/$(resource.data.organizationId)).data.superAdminId);
      allow delete: if isSignedIn() && isExistingOwner(get(/databases/$(database)/documents/organizations/$(resource.data.organizationId)).data.superAdminId);
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }
  }
}