/**
 * @fileoverview Firestore Security Rules for AuthStation application.
 *
 * Core Philosophy:
 * This ruleset enforces a role-based access control model for super admins and an ownership model for organizations and their associated data. Super admins have broad access, while organizations and their associated data are secured based on the `organizationId` and `departmentId` fields.
 *
 * Data Structure:
 * - /roles_super_admin/{superAdminId}: Documents identify super admins.
 * - /organizations/{organizationId}: Stores organization profile information, linked to a super admin.
 * - /departments/{departmentId}: Stores department information, linked to an organization.
 * - /devices/{deviceId}: Stores device information, linked to a department and an organization.
 *
 * Key Security Decisions:
 * - Super admins are granted broad read and write access to organizations, departments and devices.
 * - Only super admins can create, update, and delete organizations, departments, and devices.
 * - Data validation is relaxed in this prototype to allow for flexible schema changes, with validation focusing on relational integrity (IDs).
 * - Denormalization: The rules rely on the `organizationId` and `departmentId` fields within the `Department` and `Device` documents to enforce authorization without additional `get()` calls.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     * @return {boolean} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user is a super admin.
     * @return {boolean} True if the user is a super admin, false otherwise.
     */
    function isSuperAdmin() {
        return exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
    }

    /**
     * @description Checks if the user is the owner of the resource.
     * @param {string} userId The user ID to check against.
     * @return {boolean} True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the user is the existing owner of the resource.
     * @param {string} userId The user ID to check against.
     * @return {boolean} True if the user is the owner and the resource exists, false otherwise.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && getSelf().data != null;
    }

    function getSelf() {
      return get(request.path);
    }

    /**
     * @description Rules for the super admin role.
     * @path /roles_super_admin/{superAdminId}
     * @allow (create) User with matching UID can create the document.
     * @deny (create) User with mismatched UID cannot create the document.
     * @allow (get) Any super admin can read the document.
     * @deny (get) Any user can read a super admin profile other than his profile.
     * @principle Enforces document ownership for writes and admin-only reads.
     */
    match /roles_super_admin/{superAdminId} {
      allow get: if isSuperAdmin() || isOwner(superAdminId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(superAdminId);
      allow update: if isSignedIn() && isOwner(superAdminId); //allow the user to update the role in case of custom claims
      allow delete: if false;
    }

    /**
     * @description Rules for organizations.
     * @path /organizations/{organizationId}
     * @allow (create) Super admin can create an organization.
     * @deny (create) Non-super admin cannot create an organization.
     * @allow (get) Super admin can get an organization.
     * @deny (get) Non-super admin cannot get an organization.
     * @principle Enforces admin-only access.
     */
    match /organizations/{organizationId} {
      allow get: if isSuperAdmin();
      allow list: if isSuperAdmin();
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    /**
     * @description Rules for departments.
     * @path /departments/{departmentId}
     * @allow (create) Super admin can create a department.
     * @deny (create) Non-super admin cannot create a department.
     * @allow (get) Super admin can get a department.
     * @deny (get) Non-super admin cannot get an organization.
     * @principle Enforces admin-only access.
     */
    match /departments/{departmentId} {
      allow get: if isSuperAdmin();
      allow list: if isSuperAdmin();
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    /**
     * @description Rules for devices.
     * @path /devices/{deviceId}
     * @allow (create) Super admin can create a device.
     * @deny (create) Non-super admin cannot create a device.
     * @allow (get) Super admin can get a device.
     * @deny (get) Non-super admin cannot get an organization.
     * @principle Enforces admin-only access.
     */
    match /devices/{deviceId} {
      allow get: if isSuperAdmin();
      allow list: if isSuperAdmin();
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }
  }
}