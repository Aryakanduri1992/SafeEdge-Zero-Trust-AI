/**
 * @fileoverview Firestore Security Rules for AuthStation.
 *
 * Core Philosophy:
 * This ruleset enforces a multi-tenant security model where organizations and their super admins
 * have control over their own data. Super admins can manage their organization's departments
 * and devices. Sensor readings are associated with specific devices and organizations.
 *
 * Data Structure:
 * - /roles_super_admin/{superAdminId}: Lists of super admins, accessible only by super admins.
 * - /organizations/{organizationId}: Stores organization profiles, accessible by super admins of that organization.
 * - /departments/{departmentId}: Stores department information, accessible by super admins of the owning organization.  Departments contain the `organizationId`.
 * - /devices/{deviceId}: Stores device information, accessible by super admins of the owning organization.  Devices contain the `organizationId`.
 * - /sensorReadings/{readingId}: Stores sensor readings, accessible by super admins of the owning organization. Sensor Readings contain the `organizationId`.
 *
 * Key Security Decisions:
 * - Listing of super admins is denied to prevent enumeration.
 * - All write operations require a verified user.
 * - Data validation is relaxed in this prototyping phase to accelerate development.
 *
 * Denormalization for Authorization:
 * The `organizationId` field is present on both `departments`, `devices`, and `sensorReadings` documents.
 * This allows security rules to efficiently verify that a super admin has access to those documents
 * without needing to perform additional `get()` operations.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Protects the super admin role list. Super Admins can't be listed.
     * @path /roles_super_admin/{superAdminId}
     * @allow (get) Super admin can read their own record.
     * @deny (list) No one can list Super Admins.
     * @deny (create) No one can create Super Admin records directly.
     * @deny (update) No one can update Super Admin records directly.
     * @deny (delete) No one can delete Super Admin records directly.
     * @principle Prevents unauthorized access and modification of super admin roles.
     */
    match /roles_super_admin/{superAdminId} {
      allow get: if isSignedIn() && isOwner(superAdminId);
      allow list: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Manages organization profiles. Super admins can manage their own organization.
     * @path /organizations/{organizationId}
     * @allow (get) Any signed-in user can read the organization profile.
     * @allow (list) Any signed-in user can list organizations.
     * @allow (create) A super admin can create an organization if the superAdminId matches their UID.
     * @allow (update) A super admin can update their own organization.
     * @allow (delete) A super admin can delete their own organization.
     * @principle Enforces ownership for organization management.
     */
    match /organizations/{organizationId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.superAdminId == request.auth.uid;
      allow update: if isSignedIn() && isOrganizationOwner(organizationId);
      allow delete: if isSignedIn() && isOrganizationOwner(organizationId);
    }

    /**
     * @description Manages departments within an organization. Super admins can manage departments in their organization.
     * @path /departments/{departmentId}
     * @allow (get) Any signed-in user can read a department's information.
     * @allow (list) Super admins can list departments within their organization.
     * @allow (create) A super admin can create a department within their organization.
     * @allow (update) A super admin can update a department within their organization.
     * @allow (delete) A super admin can delete a department within their organization.
     * @principle Restricts department management to authorized super admins.
     */
    match /departments/{departmentId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && isOrganizationAdmin(request.query.data.organizationId);
      allow create: if isSignedIn() && request.resource.data.organizationId == request.auth.uid;
      allow update: if isSignedIn() && isDepartmentOwner(departmentId);
      allow delete: if isSignedIn() && isDepartmentOwner(departmentId);
    }

    /**
     * @description Manages devices within an organization. Super admins can manage devices in their organization.
     * @path /devices/{deviceId}
     * @allow (get) Any signed-in user can read device information.
     * @allow (list) Super admins can list devices within their organization.
     * @allow (create) A super admin can create a device within their organization.
     * @allow (update) A super admin can update a device within their organization.
     * @allow (delete) A super admin can delete a device within their organization.
     * @principle Restricts device management to authorized super admins.
     */
    match /devices/{deviceId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && isOrganizationAdmin(request.query.data.organizationId);
      allow create: if isSignedIn() && request.resource.data.organizationId == request.auth.uid;
      allow update: if isSignedIn() && isDeviceOwner(deviceId);
      allow delete: if isSignedIn() && isDeviceOwner(deviceId);
    }

    /**
     * @description Stores sensor readings from devices. Super admins can read sensor readings from their organization's devices.
     * @path /sensorReadings/{readingId}
     * @allow (get) Any signed-in user can read a sensor reading.
     * @allow (list) Super admins can list sensor readings within their organization.
     * @allow (create) Any signed-in user can create a sensor reading for a device in their organization.
     * @allow (update) No one can update sensor readings.
     * @allow (delete) No one can delete sensor readings.
     * @principle Allows data collection from sensors while restricting modification and deletion.
     */
    match /sensorReadings/{readingId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && isOrganizationAdmin(request.query.data.organizationId);
      allow create: if isSignedIn() && request.resource.data.organizationId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isOrganizationOwner(organizationId) {
        return get(/databases/$(database)/documents/organizations/$(organizationId)).data.superAdminId == request.auth.uid;
    }

    function isDepartmentOwner(departmentId) {
        return get(/databases/$(database)/documents/departments/$(departmentId)).data.organizationId == request.auth.uid;
    }

    function isDeviceOwner(deviceId) {
        return get(/databases/$(database)/documents/devices/$(deviceId)).data.organizationId == request.auth.uid;
    }
      
    function isOrganizationAdmin(organizationId) {
        return organizationId == request.auth.uid;
    }
  }
}