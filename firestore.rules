rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the requester is a Super Admin
    function isSuperAdmin() {
      return exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
    }

    // Super Admins have universal access. This rule must come first.
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }

    // Organization admins can read their own document.
    match /organizations/{orgId} {
      allow get: if request.auth.uid == orgId;
    }

    // Organization admins can query for their own departments.
    match /departments/{deptId} {
       allow list: if request.auth.uid == request.query.organizationId;
       allow get: if request.auth.uid == resource.data.organizationId;
    }
    
    // Organization admins can manage their own devices.
    match /devices/{deviceId} {
      allow get, list, create, update, delete: if request.auth.uid == request.resource.data.organizationId 
                                                 || request.auth.uid == resource.data.organizationId;
    }
  }
}
