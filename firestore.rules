/**
 * @fileoverview Firestore Security Rules for AuthStation.
 *
 * Core Philosophy:
 * This ruleset enforces a role-based access control model where Super Admins have elevated privileges,
 * organizations manage their own data, and departments and devices are linked to organizations.
 *
 * Data Structure:
 * - /roles_super_admin/{superAdminId}: Super Admin role assignments, where superAdminId is the Firebase Auth UID.
 * - /organizations/{organizationId}: Organization profiles, where organizationId is the Firebase Auth UID.
 * - /departments/{departmentId}: Department profiles, linked to organizations via the 'organizationId' field.
 * - /devices/{deviceId}: IoT device data, linked to a department via the 'departmentId' field.
 * - /alerts/{alertId}: System alerts, linked to devices and departments.
 *
 * Key Security Decisions:
 * - Super Admins are granted full read/write access to all data.
 * - Organizations can only manage their own departments and devices.
 * - Listing of super admins is denied.
 * - Data consistency is enforced by validating the 'organizationId' field on create and ensuring its immutability on update.
 *
 * Denormalization for Authorization:
 * - The 'organizationId' field is denormalized onto Department documents to allow for efficient organization-based access control.
 * - Device documents contain a 'departmentId' field, enabling rules to quickly check which department a device belongs to.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     * @returns {boolean} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user is the owner of the resource.
     * @param {string} userId - The user ID to check against.
     * @returns {boolean} True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user is the existing owner of the resource.
     * @param {string} userId - The user ID to check against.
     * @returns {boolean} True if the user is the owner and the resource exists, false otherwise.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Checks if the user is a super admin.
     * @returns {boolean} True if the user is a super admin, false otherwise.
     */
    function isSuperAdmin() {
      return exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
    }

    /**
     * @description Provides SuperAdmin role assignments, granting elevated privileges.
     * @path /roles_super_admin/{superAdminId}
     * @allow (create) - A SuperAdmin user can create their own role document.
     * @allow (get) - A SuperAdmin can read their own role document.
     * @deny (list) - No listing of SuperAdmin roles is allowed.
     * @deny (create) - A non-SuperAdmin user cannot create a SuperAdmin role.
     * @principle Enforces role-based access control for SuperAdmins.
     */
    match /roles_super_admin/{superAdminId} {
      allow get: if isSuperAdmin() && isOwner(superAdminId);
      allow list: if false;
      allow create: if isSuperAdmin() && isOwner(superAdminId);
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Stores primary organization profiles, each linked to a Firebase Auth UID.
     * @path /organizations/{organizationId}
     * @allow (create) - A SuperAdmin can create an organization with the organization's UID.
     * @allow (get) - Any authenticated user can read organization data.
     * @allow (list) - Any authenticated user can list organizations.
     * @allow (update) - Only the organization itself (or a SuperAdmin) can update its profile.
     * @allow (delete) - Only the organization itself (or a SuperAdmin) can delete its profile.
     * @principle Enforces organization-level access control, allowing organizations to manage their own profiles.
     */
    match /organizations/{organizationId} {
      allow get, list: if true;
      allow create: if isSuperAdmin() && isOwner(organizationId);
      allow update: if isSuperAdmin() || isExistingOwner(organizationId);
      allow delete: if isSuperAdmin() || isExistingOwner(organizationId);
    }

    /**
     * @description Stores department profiles. Each document includes an 'organizationId' to link it to the parent organization's auth account.
     * @path /departments/{departmentId}
     * @allow (create) - SuperAdmins or the parent organization can create departments. The 'organizationId' must match the parent.
     * @allow (get) - Any authenticated user can read department data.
     * @allow (list) - SuperAdmins or the parent organization can list departments.
     * @allow (update) - SuperAdmins or the parent organization can update departments.
     * @allow (delete) - SuperAdmins or the parent organization can delete departments.
     * @principle Enforces hierarchical access control, linking departments to their parent organizations.
     */
    match /departments/{departmentId} {
      allow get, list: if true;
      allow create: if isSuperAdmin() || (isSignedIn() && request.resource.data.organizationId == request.auth.uid);
      allow update: if isSuperAdmin() || (isSignedIn() && resource.data.organizationId == request.auth.uid);
      allow delete: if isSuperAdmin() || (isSignedIn() && resource.data.organizationId == request.auth.uid);
    }

       /**
     * @description Stores IoT device data, linked to a department (Department document).
     * @path /devices/{deviceId}
     * @allow (create) - A SuperAdmin or the parent organization can create a device in its department.
     * @allow (get) - Any authenticated user can read device data.
     * @allow (list) - Any authenticated user can list devices.
     * @allow (update) - A SuperAdmin or the parent organization can update devices in its department.
     * @allow (delete) - A SuperAdmin or the parent organization can delete devices in its department.
     * @principle Enforces access control based on organization and department ownership.
     */
    match /devices/{deviceId} {
      allow get, list: if true;
      allow create: if isSuperAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/departments/$(request.resource.data.departmentId)) && get(/databases/$(database)/documents/departments/$(request.resource.data.departmentId)).data.organizationId == request.auth.uid);
      allow update: if isSuperAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/departments/$(resource.data.departmentId)) && get(/databases/$(database)/documents/departments/$(resource.data.departmentId)).data.organizationId == request.auth.uid);
      allow delete: if isSuperAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/departments/$(resource.data.departmentId)) && get(/databases/$(database)/documents/departments/$(resource.data.departmentId)).data.organizationId == request.auth.uid);
    }

      /**
     * @description Stores system alerts generated from devices, linked to a department (Department document).
     * @path /alerts/{alertId}
     * @allow (create) - A SuperAdmin or the parent organization can create an alert in its department.
     * @allow (get) - Any authenticated user can read alert data.
     * @allow (list) - Any authenticated user can list alerts.
     * @allow (update) - A SuperAdmin or the parent organization can update alerts in its department.
     * @allow (delete) - A SuperAdmin or the parent organization can delete alerts in its department.
     * @principle Enforces access control based on organization and department ownership.
     */
    match /alerts/{alertId} {
      allow get, list: if true;
      allow create: if isSuperAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/departments/$(request.resource.data.departmentId)) && get(/databases/$(database)/documents/departments/$(request.resource.data.departmentId)).data.organizationId == request.auth.uid);
      allow update: if isSuperAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/departments/$(resource.data.departmentId)) && get(/databases/$(database)/documents/departments/$(resource.data.departmentId)).data.organizationId == request.auth.uid);
      allow delete: if isSuperAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/departments/$(resource.data.departmentId)) && get(/databases/$(database)/documents/departments/$(resource.data.departmentId)).data.organizationId == request.auth.uid);
    }
  }
}