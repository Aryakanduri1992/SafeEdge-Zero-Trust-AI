/**
 * @fileOverview Firestore Security Rules for AuthStation.
 *
 * Core Philosophy:
 * This ruleset enforces a role-based access control model. Super Admins are managed via the `roles_super_admin` collection,
 * and Admins are linked to Super Admins via the `admins` collection. Access to devices and alerts is controlled
 * based on Admin ownership.
 *
 * Data Structure:
 * - `/roles_super_admin/{superAdminId}`: Documents indicating Super Admin status. The existence of a document
 *   for a given UID grants Super Admin privileges.
 * - `/admins/{adminId}`: Admin user profiles, containing a `superAdminId` field to link back to the creating Super Admin.
 * - `/devices/{deviceId}`: IoT device data, linked to an Admin via the `adminId` field.
 * - `/alerts/{alertId}`: System alerts, linked to an Admin via the `adminId` field.
 *
 * Key Security Decisions:
 * - Super Admin status is determined solely by the existence of a document in the `roles_super_admin` collection,
 *   ensuring Authorization Independence.
 * - `list` operations are generally restricted to owners (e.g., Admins can list only their own devices).
 * - Data validation is minimized in this prototyping phase to allow for rapid schema iteration.
 *
 * Denormalization for Authorization:
 * - The `adminId` field is present in both the `devices` and `alerts` collections to allow direct access control
 *   without requiring additional `get()` calls.
 *
 * Structural Segregation:
 * - Role-based access is enforced through dedicated collections (e.g., `roles_super_admin`) rather than boolean flags
 *   within user documents, improving security and performance.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the current user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the current user's UID matches the provided user ID.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

     /**
      * @description Checks if the current user is an existing owner.
      * This means they are the owner and the document exists.
      */
    function isExistingOwner(userId) {
       return isOwner(userId) && resource != null;
    }

    /**
     * @description Checks if the current user is a Super Admin.
     * Super Admin status is determined by the existence of a document with their UID
     * in the `roles_super_admin` collection.
     */
    function isSuperAdmin() {
      return exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
    }

    /**
     * @description Rules for the Super Admin role collection.
     * @path /roles_super_admin/{superAdminId}
     * @allow (create) - A user can create their own Super Admin role document IF they are a super admin already, and their UID matches the superAdminId.
     * @allow (get) - Any signed-in user can get a Super Admin role document.
     * @allow (list) - Any signed-in user can list Super Admin role documents.
     * @deny (update) - No one can update a Super Admin role document.
     * @deny (delete) - No one can delete a Super Admin role document.
     * @principle Enforces role-based access control for Super Admins.
     */
    match /roles_super_admin/{superAdminId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == superAdminId && !exists(/databases/$(database)/documents/roles_super_admin/$(superAdminId));
      allow update, delete: if false;
    }

    /**
     * @description Rules for the Admin profiles collection.
     * @path /admins/{adminId}
     * @allow (create) - A Super Admin can create a new Admin profile. The 'superAdminId' field must match the Super Admin's UID.
     * @allow (get) - Any signed-in user can get an Admin profile.
     * @allow (list) - Any signed-in user can list Admin profiles.
     * @allow (update) - Only the Super Admin who created the Admin profile can update it.
     * @allow (delete) - Only the Super Admin who created the Admin profile can delete it.
     * @deny (create) - A non-Super Admin cannot create an Admin profile.
     * @deny (update) - An unauthorized user cannot modify the 'superAdminId' field.
     * @principle Enforces ownership and role-based access control for Admin profiles.
     */
    match /admins/{adminId} {
      allow get, list: if isSignedIn();
      allow create: if isSuperAdmin() && request.resource.data.superAdminId == request.auth.uid;
      allow update: if isSuperAdmin() && get(/databases/$(database)/documents/admins/$(adminId)).data.superAdminId == request.auth.uid;
      allow delete: if isSuperAdmin() && get(/databases/$(database)/documents/admins/$(adminId)).data.superAdminId == request.auth.uid;
    }

    /**
     * @description Rules for the Devices collection.
     * @path /devices/{deviceId}
     * @allow (create) - An Admin can create a new device, with the 'adminId' field matching their UID.
     * @allow (get) - Any signed-in user can get a device.
     * @allow (list) - Only an Admin can list their own devices.
     * @allow (update) - Only the Admin who owns the device can update it.
     * @allow (delete) - Only the Admin who owns the device can delete it.
     * @deny (create) - A user cannot create a device with an 'adminId' that doesn't match their UID.
     * @deny (update) - An unauthorized user cannot modify the 'adminId' field.
     * @principle Enforces ownership for device management.
     */
    match /devices/{deviceId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && get(/databases/$(database)/documents/devices/$(deviceId)).data.adminId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.adminId == request.auth.uid;
      allow update: if isSignedIn() && get(/databases/$(database)/documents/devices/$(deviceId)).data.adminId == request.auth.uid;
      allow delete: if isSignedIn() && get(/databases/$(database)/documents/devices/$(deviceId)).data.adminId == request.auth.uid;
    }

     /**
      * @description Rules for the Alerts collection.
      * @path /alerts/{alertId}
      * @allow (create) - An Admin can create a new alert, with the 'adminId' field matching their UID.
      * @allow (get) - Any signed-in user can get an alert.
      * @allow (list) - Only an Admin can list their own alerts.
      * @allow (update) - Only the Admin who owns the alert can update it.
      * @allow (delete) - Only the Admin who owns the alert can delete it.
      * @deny (create) - A user cannot create an alert with an 'adminId' that doesn't match their UID.
      * @deny (update) - An unauthorized user cannot modify the 'adminId' field.
      * @principle Enforces ownership for alert management.
      */
    match /alerts/{alertId} {
        allow get: if isSignedIn();
        allow list: if isSignedIn() && get(/databases/$(database)/documents/alerts/$(alertId)).data.adminId == request.auth.uid;
        allow create: if isSignedIn() && request.resource.data.adminId == request.auth.uid;
        allow update: if isSignedIn() && get(/databases/$(database)/documents/alerts/$(alertId)).data.adminId == request.auth.uid;
        allow delete: if isSignedIn() && get(/databases/$(database)/documents/alerts/$(alertId)).data.adminId == request.auth.uid;
    }
  }
}