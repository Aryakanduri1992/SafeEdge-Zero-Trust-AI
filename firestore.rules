rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // SUPERADMIN: Global read/write access
    function isSuperAdmin() {
      return exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
    }

    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }

    // ORGANIZATIONS: Admins can read their own profile
    match /organizations/{orgId} {
      allow read: if request.auth.uid == orgId;
    }

    // DEPARTMENTS: Admins can list and get departments belonging to their organization
    match /departments/{departmentId} {
      allow read: if request.auth.uid == resource.data.organizationId;
      allow list: if request.auth.uid == request.query.get("where")[2][2];
    }

    // DEVICES: Admins can manage devices for their organization
    match /devices/{deviceId} {
      allow get: if request.auth.uid == resource.data.organizationId;
      allow list: if request.auth.uid == request.query.get("where")[2][2];
      allow create: if request.auth.uid == request.resource.data.organizationId;
      allow update: if request.auth.uid == resource.data.organizationId;
      allow delete: if request.auth.uid == resource.data.organizationId;
    }
  }
}
