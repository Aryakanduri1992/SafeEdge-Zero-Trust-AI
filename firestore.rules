/**
 * @description This ruleset enforces a strict role-based access control model for the AuthStation application.
 * Super Admins are managed via the `/roles_super_admin/{superAdminId}` collection, while Admins and Devices are managed under `/admins/{adminId}` and `/devices/{deviceId}` respectively.
 * Alerts are stored in the `/alerts/{alertId}` collection, tied to specific admin accounts.
 *
 * Data Structure:
 * - /roles_super_admin/{superAdminId}: Documents indicating Super Admin privileges. The document's existence is sufficient for authorization.
 * - /admins/{adminId}: Stores Admin profiles, including a `superAdminId` to link to the creating Super Admin.
 * - /devices/{deviceId}: Stores IoT device data, linked to an admin account via `adminId`.
 * - /alerts/{alertId}: Stores system alerts, also linked to an admin account via `adminId`.
 *
 * Key Security Decisions:
 * - Super Admin privileges are granted based on the existence of a document in the `/roles_super_admin/{superAdminId}` collection.
 * - Admin and Device data access is restricted to authorized admins, enforced through the `adminId` field in the document.
 * - The `list` operation is explicitly allowed only for admins listing their own devices and alerts.
 * - Authorization Independence is maintained by embedding all necessary authorization data directly within the documents, avoiding costly `get()` calls.
 * - Write operations on the document requires write authorization.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants Super Admin privileges based on the existence of a document in this collection.
     * @path /roles_super_admin/{superAdminId}
     * @allow (get) If the user's UID matches the `superAdminId`. This is for checking the Super Admin role.
     * @allow (list) If the user's UID matches the `superAdminId`. Allows listing of their own role document.
     * @allow (create) if the user's UID matches the `superAdminId`.
     * @allow (update) if the user's UID matches the `superAdminId` and the document exists.
     * @allow (delete) if the user's UID matches the `superAdminId` and the document exists.
     * @deny If the user attempts to create a document with a `superAdminId` that does not match their UID.
     * @principle Enforces role-based access control, granting Super Admin privileges based on document existence.
     */
    match /roles_super_admin/{superAdminId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(superAdminId);
      allow list: if isOwner(superAdminId);
      allow create: if isOwner(superAdminId);
      allow update: if isExistingOwner(superAdminId);
      allow delete: if isExistingOwner(superAdminId);
    }

    /**
     * @description Manages Admin profiles, linked to a Super Admin.
     * @path /admins/{adminId}
     * @allow (get) If the user's UID matches the `adminId`.
     * @allow (list) if false; Admins are not generally listable.
     * @allow (create) If the user's UID matches the `adminId`.
     * @allow (update) If the user's UID matches the `adminId` and the document exists.
     * @allow (delete) If the user's UID matches the `adminId` and the document exists.
     * @deny If a user attempts to create an admin profile with an `adminId` that doesn't match their UID.
     * @principle Enforces document ownership for admins, restricting access to their own profiles.
     */
    match /admins/{adminId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(adminId);
      allow list: if false;
      allow create: if isOwner(adminId);
      allow update: if isExistingOwner(adminId);
      allow delete: if isExistingOwner(adminId);
    }

    /**
     * @description Manages IoT device data, linked to an admin account.
     * @path /devices/{deviceId}
     * @allow (get) If the user is signed in and their UID matches the `adminId` in the device document.
     * @allow (list) If the user is signed in and their UID matches the `adminId` in the device document.
     * @allow (create) If the user is signed in and their UID matches the `adminId` in the device document.
     * @allow (update) If the user is signed in, their UID matches the `adminId` in the device document, and the document exists.
     * @allow (delete) If the user is signed in, their UID matches the `adminId` in the device document, and the document exists.
     * @deny If a user attempts to create a device with an `adminId` that does not match their UID.
     * @principle Enforces document ownership for devices, restricting access to devices owned by the requesting admin.
     */
    match /devices/{deviceId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isAdminOwner(adminId) {
        return isSignedIn() && request.auth.uid == adminId;
      }
      function isExistingAdminOwner(adminId) {
        return isAdminOwner(adminId) && resource != null;
      }
      allow get: if isSignedIn() && isAdminOwner(resource.data.adminId);
      allow list: if isSignedIn() && isAdminOwner(request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.adminId == request.auth.uid;
      allow update: if isExistingAdminOwner(resource.data.adminId);
      allow delete: if isExistingAdminOwner(resource.data.adminId);
    }

    /**
     * @description Manages system alerts, linked to an admin account.
     * @path /alerts/{alertId}
     * @allow (get) If the user is signed in and their UID matches the `adminId` in the alert document.
     * @allow (list) If the user is signed in and their UID matches the `adminId` in the alert document.
     * @allow (create) If the user is signed in and their UID matches the `adminId` in the alert document.
     * @allow (update) If the user is signed in, their UID matches the `adminId` in the alert document, and the document exists.
     * @allow (delete) If the user is signed in, their UID matches the `adminId` in the alert document, and the document exists.
     * @deny If a user attempts to create an alert with an `adminId` that does not match their UID.
     * @principle Enforces document ownership for alerts, restricting access to alerts owned by the requesting admin.
     */
    match /alerts/{alertId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isAdminOwner(adminId) {
        return isSignedIn() && request.auth.uid == adminId;
      }
      function isExistingAdminOwner(adminId) {
        return isAdminOwner(adminId) && resource != null;
      }

      allow get: if isSignedIn() && isAdminOwner(resource.data.adminId);
      allow list: if isSignedIn() && isAdminOwner(request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.adminId == request.auth.uid;
      allow update: if isExistingAdminOwner(resource.data.adminId);
      allow delete: if isExistingAdminOwner(resource.data.adminId);
    }
  }
}