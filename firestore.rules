/**
 * @file Firestore Security Rules
 * @core_philosophy This ruleset enforces a multi-tenant security model where organizations and their associated data (departments, devices) are isolated. Super admins manage organizations. Users can only access data within their organization.
 * @data_structure
 *   - /roles_super_admin/{superAdminId}: Stores documents to identify super admins.
 *   - /organizations/{organizationId}: Stores organization profiles.
 *   - /departments/{departmentId}: Stores department information. Each department is associated with an organization.
 *   - /devices/{deviceId}: Stores device information. Each device is associated with a department and an organization.
 *
 * @key_security_decisions
 *   - Super admins are identified via a separate collection (`/roles_super_admin`) for efficient role checking.
 *   - Organizations can only be created by a super admin.
 *   - Departments and devices are scoped to an organization.
 *   - Listing of devices is restricted to signed-in users of the organization.
 *   - No public read access is granted to any collection.
 *
 * @denormalization_for_authorization
 *   - Each document in `/departments` and `/devices` contains `organizationId`, enabling rules to enforce tenant isolation without complex queries.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows read and write access to super admin role documents.
     * @path /roles_super_admin/{superAdminId}
     * @allow (get, list) User with matching UID can read their own super admin role document.
     * @allow (create, update, delete) User with matching UID can manage their own super admin role document.
     * @deny (get, list) User with non-matching UID cannot read another user's super admin role document.
     * @deny (create, update, delete) User with non-matching UID cannot manage another user's super admin role document.
     * @principle Enforces document ownership for super admin role documents.
     */
    match /roles_super_admin/{superAdminId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      allow get: if isOwner(superAdminId);
      allow list: if false;
      allow create: if isOwner(superAdminId);
      allow update: if isOwner(superAdminId);
      allow delete: if isOwner(superAdminId);
    }

    /**
     * @description Allows super admins to manage organizations.
     * @path /organizations/{organizationId}
     * @allow (create) Super admin can create an organization, enforcing that the creator is the superAdminId
     * @allow (get, list) Any signed-in user can retrieve an organization.
     * @allow (update, delete) Only the super admin associated with the organization can update or delete it.
     * @deny (create) Non-super admin attempts to create an organization.
     * @deny (update, delete) Non-super admin attempts to modify an organization.
     * @principle Enforces ownership and role-based access for organization management.
     */
    match /organizations/{organizationId} {
      function isSuperAdmin() {
        return exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
      }
      function isSignedIn() {
        return request.auth != null;
      }
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isSuperAdmin();
      allow update, delete: if isSignedIn() && isSuperAdmin();
    }

    /**
     * @description Allows management of departments within an organization.
     * @path /departments/{departmentId}
     * @allow (get, list) Any signed-in user can retrieve a department.
     * @allow (create) Only the super admin associated with the organization can create a department.
     * @allow (update, delete) Only the super admin associated with the organization can update or delete it.
     * @deny (create) Non-super admin attempts to create a department.
     * @deny (update, delete) Non-super admin attempts to modify a department.
     * @principle Enforces ownership and role-based access for department management.
     */
    match /departments/{departmentId} {
        function isSignedIn() {
          return request.auth != null;
        }

        function isSuperAdminForDepartment(orgId) {
          return exists(/databases/$(database)/documents/roles_super_admin/$(get(/databases/$(database)/documents/organizations/$(orgId)).data.superAdminId));
        }

        allow get, list: if isSignedIn();
        allow create: if isSignedIn() && isSuperAdminForDepartment(request.resource.data.organizationId);
        allow update, delete: if isSignedIn() && isSuperAdminForDepartment(resource.data.organizationId);
    }

    /**
     * @description Manages access to device information, restricting it to signed-in users within the same organization.
     * @path /devices/{deviceId}
     * @allow (get) Any signed-in user can retrieve a device.
     * @allow (list) Only signed-in users can list devices within their organization.
     * @allow (create) Only super admins associated with the organization can create a device.
     * @allow (update, delete) Only super admins associated with the organization can update or delete devices.
     * @deny (create) Non-super admin attempts to create a device.
     * @deny (update, delete) Non-super admin attempts to modify a device.
     * @principle Enforces ownership and role-based access for device management.
     */
    match /devices/{deviceId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isSuperAdminForDevice(orgId) {
          return exists(/databases/$(database)/documents/roles_super_admin/$(get(/databases/$(database)/documents/organizations/$(orgId)).data.superAdminId));
      }

      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isSuperAdminForDevice(request.resource.data.organizationId);
      allow update, delete: if isSignedIn() && isSuperAdminForDevice(resource.data.organizationId);
    }
  }
}