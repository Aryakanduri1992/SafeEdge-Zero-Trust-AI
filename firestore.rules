/**
 * @file Firestore Security Rules for AuthStation
 * @version Prototyping Mode - Data shape is not strictly enforced. Authorization is strictly enforced.
 *
 * @description This ruleset enforces a hierarchical, role-based access control model for the AuthStation application.
 *
 * Data Structure:
 * - /roles_super_admin/{superAdminId}: Documents indicating super admin status.
 * - /organizations/{organizationId}: Documents for organizations, using the Firebase Auth UID as the document ID.
 * - /admins/{adminId}: Documents representing departments, linked to an organization via the 'organizationId' field.
 * - /devices/{deviceId}: Documents for IoT devices, linked to a department (Admin) via the 'adminId' field.
 * - /alerts/{alertId}: Documents for system alerts, linked to a department (Admin) via the 'adminId' field.
 *
 * Key Security Decisions:
 * - Super Admins: Super admin status is determined by presence in the /roles_super_admin collection.
 * - Organization Ownership: Organizations are granted ownership over their respective data trees.
 * - Department-Level Access: Departments (Admins) inherit access rights from their parent organization.
 * - Data Consistency: The rules enforce relational integrity by validating foreign key relationships (e.g., 'organizationId', 'adminId').
 *
 * Denormalization for Authorization:
 * - The 'organizationId' field is present on the Admin documents, to avoid having to query all the organizations to find the parent for a given Admin.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants Super Admins full access to their roles document.
     * @path /roles_super_admin/{superAdminId}
     * @allow (get, list) if isSignedIn()
     * @allow (create, update, delete) if isSignedIn() && isOwner(superAdminId)
     * @deny (create) if !isSignedIn() || request.auth.uid != superAdminId
     * @deny (update, delete) if !isSignedIn() || request.auth.uid != superAdminId || resource == null
     * @principle Enforces document ownership for writes and requires authentication.
     */
    match /roles_super_admin/{superAdminId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isOwner(superAdminId);
      allow update: if isSignedIn() && isExistingOwner(superAdminId);
      allow delete: if isSignedIn() && isExistingOwner(superAdminId);
    }

    /**
     * @description Grants Organizations full access to their profiles.
     * @path /organizations/{organizationId}
     * @allow (get, list) if isSignedIn()
     * @allow (create, update, delete) if isSignedIn() && isOwner(organizationId)
     * @deny (create) if !isSignedIn() || request.auth.uid != organizationId
     * @deny (update, delete) if !isSignedIn() || request.auth.uid != organizationId || resource == null
     * @principle Enforces document ownership for writes and requires authentication.
     */
    match /organizations/{organizationId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isOwner(organizationId);
      allow update: if isSignedIn() && isExistingOwner(organizationId);
      allow delete: if isSignedIn() && isExistingOwner(organizationId);
    }

    /**
     * @description Grants Organizations access to manage their Departments (Admins).
     * @path /admins/{adminId}
     * @allow (get, list) if isSignedIn()
     * @allow (create) if isSignedIn() && request.resource.data.organizationId == request.auth.uid
     * @allow (update) if isSignedIn() && resource != null && resource.data.organizationId == request.auth.uid && resource.data.organizationId == request.resource.data.organizationId
     * @allow (delete) if isSignedIn() && resource != null && resource.data.organizationId == request.auth.uid
     * @deny (create) if !isSignedIn() || request.resource.data.organizationId != request.auth.uid
     * @deny (update) if !isSignedIn() || resource == null || resource.data.organizationId != request.auth.uid || resource.data.organizationId != request.resource.data.organizationId
     * @deny (delete) if !isSignedIn() || resource == null || resource.data.organizationId != request.auth.uid
     * @principle Enforces that only the owning Organization can manage its Departments.
     */
    match /admins/{adminId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.organizationId == request.auth.uid;
      allow update: if isSignedIn() && resource != null && resource.data.organizationId == request.auth.uid && resource.data.organizationId == request.resource.data.organizationId;
      allow delete: if isSignedIn() && resource != null && resource.data.organizationId == request.auth.uid;
    }

    /**
     * @description Grants access to manage Devices to the department (Admin) they belong to.
     * @path /devices/{deviceId}
     * @allow (get, list) if isSignedIn()
     * @allow (create) if isSignedIn()
                  && request.resource.data.adminId != null
                  && get(/databases/$(database)/documents/admins/$(request.resource.data.adminId)).data.organizationId == request.auth.uid;
     * @allow (update) if isSignedIn()
                  && resource != null
                  && get(/databases/$(database)/documents/admins/$(resource.data.adminId)).data.organizationId == request.auth.uid;
     * @allow (delete) if isSignedIn()
                  && resource != null
                  && get(/databases/$(database)/documents/admins/$(resource.data.adminId)).data.organizationId == request.auth.uid;
     * @deny (create) if !isSignedIn()
     * @deny (update) if !isSignedIn() || resource == null
     * @deny (delete) if !isSignedIn() || resource == null
     * @principle Enforces that only the owning Department can manage its Devices.
     */
    match /devices/{deviceId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn()
                  && request.resource.data.adminId != null
                  && get(/databases/$(database)/documents/admins/$(request.resource.data.adminId)).data.organizationId == request.auth.uid;
      allow update: if isSignedIn()
                  && resource != null
                  && get(/databases/$(database)/documents/admins/$(resource.data.adminId)).data.organizationId == request.auth.uid;
      allow delete: if isSignedIn()
                  && resource != null
                  && get(/databases/$(database)/documents/admins/$(resource.data.adminId)).data.organizationId == request.auth.uid;
    }

    /**
     * @description Grants access to manage Alerts to the department (Admin) they belong to.
     * @path /alerts/{alertId}
     * @allow (get, list) if isSignedIn()
     * @allow (create) if isSignedIn()
                  && request.resource.data.adminId != null
                  && get(/databases/$(database)/documents/admins/$(request.resource.data.adminId)).data.organizationId == request.auth.uid;
     * @allow (update) if isSignedIn()
                  && resource != null
                  && get(/databases/$(database)/documents/admins/$(resource.data.adminId)).data.organizationId == request.auth.uid;
     * @allow (delete) if isSignedIn()
                  && resource != null
                  && get(/databases/$(database)/documents/admins/$(resource.data.adminId)).data.organizationId == request.auth.uid;
     * @deny (create) if !isSignedIn()
     * @deny (update) if !isSignedIn() || resource == null
     * @deny (delete) if !isSignedIn() || resource == null
     * @principle Enforces that only the owning Department can manage its Alerts.
     */
    match /alerts/{alertId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn()
                  && request.resource.data.adminId != null
                  && get(/databases/$(database)/documents/admins/$(request.resource.data.adminId)).data.organizationId == request.auth.uid;
      allow update: if isSignedIn()
                  && resource != null
                  && get(/databases/$(database)/documents/admins/$(resource.data.adminId)).data.organizationId == request.auth.uid;
      allow delete: if isSignedIn()
                  && resource != null
                  && get(/databases/$(database)/documents/admins/$(resource.data.adminId)).data.organizationId == request.auth.uid;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
        return isSignedIn() && isOwner(userId) && resource != null;
    }
  }
}