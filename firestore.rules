rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is authenticated.
     * @path N/A
     * @allow N/A
     * @deny N/A
     * @principle Authentication is required for nearly all operations.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user's UID matches the provided userId.
     * @path N/A
     * @allow N/A
     * @deny N/A
     * @principle Enforces user-ownership for data access.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user is a Super Admin.
     * @path N/A
     * @allow N/A
     * @deny N/A
     */
    function isSuperAdmin() {
      return exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
    }

    /**
     * @description Checks if the authenticated user is the Super Admin who created an organization.
     * @path N/A
     */
    function isOrgCreator(superAdminId) {
      return isSignedIn() && isSuperAdmin() && request.auth.uid == superAdminId;
    }

    /**
     * @description Checks if the organization ID of the admin matches the authenticated user's UID.
     * @path N/A
     */
     function isAdminForOrganization(organizationId) {
      return isSignedIn() && get(/databases/$(database)/documents/organizations/$(organizationId)).data.id == request.auth.uid;
    }

     /**
     * @description Checks if an organization exists and if the request comes from the superAdmin who created it.
     * @path N/A
     */
    function isExistingOrgCreator(superAdminId) {
      return isOrgCreator(superAdminId) && resource != null;
    }

    /**
     * @description Checks if the user is the owner and the resource exists.
     * @path N/A
     * @allow N/A
     * @deny N/A
     * @principle Prevents modification of non-existent documents.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource.data != null;
    }

    /**
     * @description Checks if the resource exists.
     */
    function resourceExists() {
        return resource != null;
    }

    /**
     * @description Rules for the /roles_super_admin/{superAdminId} collection.
     * @path /roles_super_admin/{superAdminId}
     * @allow User with UID 'superAdmin123' can create their SuperAdmin role (create).
     * @deny User with UID 'attacker123' cannot create a SuperAdmin role with ID 'superAdmin123' (create) because they are not the owner.
     * @principle Enforces ownership and prevents unauthorized role assignment.
     */
    match /roles_super_admin/{superAdminId} {
      allow get: if isOwner(superAdminId);
      allow list: if false;
      allow create: if isOwner(superAdminId);
      allow update: if isOwner(superAdminId);
      allow delete: if isOwner(superAdminId);
    }

    /**
     * @description Rules for the /organizations/{organizationId} collection.
     * @path /organizations/{organizationId}
     * @allow SuperAdmin with UID 'superAdmin123' can create an organization with UID 'org123' (create) if they are the creator.
     * @deny User with UID 'attacker123' cannot create an organization with UID 'org123' (create) because they are not a Super Admin.
     * @principle Enforces Super Admin control over organization creation.
     */
    match /organizations/{organizationId} {
      allow get: if isSuperAdmin();
      allow list: if false;
      allow create: if isSuperAdmin() && request.resource.data.superAdminId == request.auth.uid;
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    /**
     * @description Rules for the /admins/{adminId} collection.
     * @path /admins/{adminId}
     * @allow Organization with UID 'org123' can create a department (Admin document) under their organization (create).
     * @deny User with UID 'attacker123' cannot create a department under organization 'org123' (create) because they are not an admin of that organization.
     * @principle Enforces organization-level control over department creation.
     */
    match /admins/{adminId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn() && (request.resource.data.organizationId != null && exists(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId))) || isSuperAdmin();
      allow update: if isSignedIn() && (resource.data.organizationId != null && exists(/databases/$(database)/documents/organizations/$(resource.data.organizationId))) || isSuperAdmin();
      allow delete: if isSignedIn() && (resource.data.organizationId != null && exists(/databases/$(database)/documents/organizations/$(resource.data.organizationId))) || isSuperAdmin();
    }

    /**
     * @description Rules for the /devices/{deviceId} collection.
     * @path /devices/{deviceId}
     * @allow Admin user for the organization tied to the device can read the device's data (get).
     * @deny Non-admin user cannot access device data (get).
     * @principle Restricts device access to authorized departments.
     */
    match /devices/{deviceId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn() && (request.resource.data.adminId != null && exists(/databases/$(database)/documents/admins/$(request.resource.data.adminId))) || isSuperAdmin();
      allow update: if isSignedIn() && (resource.data.adminId != null && exists(/databases/$(database)/documents/admins/$(resource.data.adminId))) || isSuperAdmin();
      allow delete: if isSignedIn() && (resource.data.adminId != null && exists(/databases/$(database)/documents/admins/$(resource.data.adminId))) || isSuperAdmin();
    }

    /**
     * @description Rules for the /alerts/{alertId} collection.
     * @path /alerts/{alertId}
     * @allow Admin user for the organization tied to the alert can read the alert's data (get).
     * @deny Non-admin user cannot access alert data (get).
     * @principle Restricts alert access to authorized departments.
     */
    match /alerts/{alertId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn() && (request.resource.data.adminId != null && exists(/databases/$(database)/documents/admins/$(request.resource.data.adminId))) || isSuperAdmin();
      allow update: if isSignedIn() && (resource.data.adminId != null && exists(/databases/$(database)/documents/admins/$(resource.data.adminId))) || isSuperAdmin();
      allow delete: if isSignedIn() && (resource.data.adminId != null && exists(/databases/$(database)/documents/admins/$(resource.data.adminId))) || isSuperAdmin();
    }
  }
}