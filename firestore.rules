/**
 * @file Firestore Security Rules
 * @description This ruleset implements a role-based access control model with a SuperAdmin role.
 *
 * Data Structure:
 * - /roles_super_admin/{superAdminId}: Documents identifying Super Admins. The document ID must match the user's UID.
 * - /organizations/{organizationId}: Stores organization data, linked to a SuperAdmin.
 * - /departments/{departmentId}: Stores department data, linked to an Organization and SuperAdmin.
 * - /devices/{deviceId}: Stores device data, linked to a Department and Organization.
 *
 * Key Security Decisions:
 * - Super Admins can manage all Organizations, Departments, and Devices.
 * - Only authenticated users can create, update, or delete data. Anonymous users can read.
 * - Data consistency between document IDs and internal fields is enforced on creation.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user is a Super Admin.
     */
    function isSuperAdmin() {
      return exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
    }

    /**
     * @description Checks if the specified user ID matches the authenticated user's ID.
     * @param {string} userId - The user ID to check against the authenticated user's ID.
     * @returns {boolean} True if the user ID matches the authenticated user's ID, false otherwise.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the specified user ID is the existing owner of the document.
     * @param {string} userId - The user ID to check against the authenticated user's ID.
     * @returns {boolean} True if the user ID matches the authenticated user's ID, false otherwise.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Rules for SuperAdmin role documents.
     * @path /roles_super_admin/{superAdminId}
     * @allow (create) - A user with matching UID can create their own SuperAdmin role.
     * @allow (get, list) - A SuperAdmin can read their own role document.
     * @deny (create) - A user without matching UID cannot create a SuperAdmin role.
     * @deny (update, delete) - Only a SuperAdmin can update their own role document.
     * @principle Enforces document ownership and role-based access control.
     */
    match /roles_super_admin/{superAdminId} {
      allow get: if isOwner(superAdminId);
      allow list: if false;
      allow create: if isSignedIn() && request.auth.uid == superAdminId;
      allow update: if isOwner(superAdminId) && isSuperAdmin();
      allow delete: if isOwner(superAdminId) && isSuperAdmin();
    }

    /**
     * @description Rules for organizations.
     * @path /organizations/{organizationId}
     * @allow (create) - A SuperAdmin can create an organization.
     * @allow (get, list) - Any authenticated user can read organizations.
     * @allow (update, delete) - Only a SuperAdmin can update or delete an organization.
     * @deny (create) - A non-SuperAdmin cannot create an organization.
     * @principle Enforces role-based access control for organizations.
     */
    match /organizations/{organizationId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    /**
     * @description Rules for departments.
     * @path /departments/{departmentId}
     * @allow (create) - A SuperAdmin can create a department.
     * @allow (get, list) - Any authenticated user can read departments.
     * @allow (update, delete) - Only a SuperAdmin can update or delete a department.
     * @deny (create) - A non-SuperAdmin cannot create a department.
     * @principle Enforces role-based access control for departments.
     */
    match /departments/{departmentId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    /**
     * @description Rules for devices.
     * @path /devices/{deviceId}
     * @allow (create) - A SuperAdmin can create a device.
     * @allow (get, list) - Any authenticated user can read devices.
     * @allow (update, delete) - Only a SuperAdmin can update or delete a device.
     * @deny (create) - A non-SuperAdmin cannot create a device.
     * @principle Enforces role-based access control for devices.
     */
    match /devices/{deviceId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }
  }
}