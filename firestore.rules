/**
 * @file Firestore Security Rules for AuthStation
 * @version Prototyping
 *
 * @description This ruleset enforces a role-based access control model, separating Super Admin and Admin privileges.
 * All write operations are strictly controlled based on user authentication and document ownership.
 * Data validation is relaxed in the prototyping phase, focusing on authorization and relational integrity.
 *
 * Data Structure:
 * - /roles_super_admin/{superAdminId}: Documents indicating a Super Admin role. Existence of a document grants Super Admin privileges.
 * - /admins/{adminId}: Admin user profiles, linked to a Super Admin via the 'superAdminId' field.
 * - /devices/{deviceId}: IoT device data, linked to an Admin via the 'adminId' field.
 * - /alerts/{alertId}: System alerts, linked to an Admin via the 'adminId' field.
 *
 * Key Security Decisions:
 * - Super Admin privileges are granted based on the existence of a document in the `/roles_super_admin/{superAdminId}` collection.
 * - Access to Admin, Device, and Alert data is restricted to the associated Admin user, enforced through the 'adminId' field.
 * - Data shape validation is minimized for rapid prototyping, focusing on critical relational integrity checks.
 * - Listing of Devices and Alerts is restricted to the owning Admin.
 *
 * Denormalization for Authorization:
 * - The `adminId` field is present in both the `Device` and `Alert` documents to allow direct rule-based filtering and authorization, avoiding complex queries or joins.
 *
 * Structural Segregation:
 * - Super Admin roles are managed in a separate collection (`/roles_super_admin`) to simplify role verification and avoid the need to read user profile data during authorization.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants Super Admin privileges based on the existence of a document.
     * @path /roles_super_admin/{superAdminId}
     * @allow (create) User with UID 'superAdminId' can create their SuperAdmin role document.
     * @deny (create) User with a different UID cannot create a SuperAdmin role document.
     * @principle Enforces role-based access control based on document existence.
     */
    match /roles_super_admin/{superAdminId} {
      function isSuperAdmin(superAdminId) {
        return request.auth != null && request.auth.uid == superAdminId;
      }
      allow get: if false;
      allow list: if false;
      allow create: if isSuperAdmin(superAdminId);
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Manages Admin profiles.
     * @path /admins/{adminId}
     * @allow (create) A SuperAdmin can create an Admin profile.
     * @deny (create) A non-SuperAdmin cannot create an Admin profile.
     * @principle Enforces ownership and role-based access control for Admin profile management.
     */
    match /admins/{adminId} {
      function isSuperAdmin() {
        return exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
      }
      function isAdmin(adminId) {
        return request.auth != null && request.auth.uid == adminId;
      }
      function isExistingAdmin(adminId) {
        return isAdmin(adminId) && get(/databases/$(database)/documents/admins/$(adminId)).data != null;
      }
      allow get: if isAdmin(adminId);
      allow list: if false;
      allow create: if isSuperAdmin();
      allow update: if isExistingAdmin(adminId);
      allow delete: if isExistingAdmin(adminId);
    }

     /**
      * @description Manages IoT device data.
      * @path /devices/{deviceId}
      * @allow (create) An Admin can create a device associated with their adminId.
      * @deny (create) A non-Admin cannot create a device.
      * @principle Enforces ownership for device data based on the 'adminId' field.
      */
     match /devices/{deviceId} {
        function isAdmin(adminId) {
          return request.auth != null && request.auth.uid == adminId;
        }

        function isDeviceOwner(deviceId) {
            return request.auth.uid == get(/databases/$(database)/documents/devices/$(deviceId)).data.adminId;
        }

        function isExistingDeviceOwner(deviceId) {
          return isDeviceOwner(deviceId) && get(/databases/$(database)/documents/devices/$(deviceId)).data != null;
        }

        allow get: if isDeviceOwner(deviceId);
        allow list: if isAdmin(request.auth.uid);
        allow create: if request.auth != null && request.resource.data.adminId == request.auth.uid;
        allow update: if isExistingDeviceOwner(deviceId);
        allow delete: if isExistingDeviceOwner(deviceId);
      }

     /**
      * @description Manages system alerts.
      * @path /alerts/{alertId}
      * @allow (create) An authorized process can create an alert associated with an adminId.
      * @deny (create) A non-authorized process cannot create an alert.
      * @principle Enforces that alerts are linked to a valid admin.
      */
    match /alerts/{alertId} {
      function isAdmin(adminId) {
        return request.auth != null && request.auth.uid == adminId;
      }

      function isAlertOwner(alertId) {
          return request.auth.uid == get(/databases/$(database)/documents/alerts/$(alertId)).data.adminId;
      }

      function isExistingAlertOwner(alertId) {
        return isAlertOwner(alertId) && get(/databases/$(database)/documents/alerts/$(alertId)).data != null;
      }

      allow get: if isAlertOwner(alertId);
      allow list: if isAdmin(request.auth.uid);
      allow create: if request.auth != null && request.resource.data.adminId == request.auth.uid;
      allow update: if isExistingAlertOwner(alertId);
      allow delete: if isExistingAlertOwner(alertId);
    }
  }
}