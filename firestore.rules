/**
 * @fileoverview Firestore Security Rules for AuthStation application.
 *
 * Core Philosophy:
 * This ruleset enforces a role-based access control model, primarily leveraging the existence
 * of documents in designated role collections for authorization. It prioritizes Authorization
 * Independence by avoiding `get()` calls in rules, instead relying on data denormalization
 * (copying authorization data onto documents) and existence checks.
 *
 * Data Structure:
 * - /roles_super_admin/{superAdminId}:  Indicates a Super Admin. Document existence confers the role.
 * - /admins/{adminId}: Stores Admin profiles, linked to a Super Admin via `superAdminId`.
 * - /devices/{deviceId}: Stores device data, linked to an Admin via `adminId`.
 * - /alerts/{alertId}: Stores alerts, linked to an Admin via `adminId`.
 *
 * Key Security Decisions:
 * - Super Admin role is verified by the existence of a document in `/roles_super_admin/{superAdminId}`.
 * - Admins can only manage devices and alerts associated with their `adminId`.
 * - The ruleset avoids using `get()` calls to external documents for authorization, improving performance
 *   and preventing potential race conditions.
 * - Listing all devices requires authentication.
 *
 * Denormalization for Authorization:
 * - The `adminId` field is present in both `/devices/{deviceId}` and `/alerts/{alertId}` documents, allowing
 *   rules to efficiently filter data based on the requesting Admin's ID without needing to perform additional reads.
 *
 * Structural Segregation:
 * - Role separation is enforced using dedicated collections for Super Admins (`/roles_super_admin`).
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the current user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user's UID matches the provided userId.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user's UID matches the resource's userId and if the resource exists
     */
    function isExistingOwner(userId) {
      return (isOwner(userId) && resource != null);
    }

    /**
     * @description Allows Super Admins to be created and managed. The existence of a document here confers the Super Admin role.
     * @path /roles_super_admin/{superAdminId}
     * @allow (create) User 'super_admin_uid' can create their SuperAdmin document if request.auth.uid == 'super_admin_uid'.
     * @deny (create) User 'non_admin_uid' cannot create a SuperAdmin document with ID 'super_admin_uid'.
     * @allow (get, list) Any signed-in user can get and list SuperAdmin documents to verify role status.
     * @principle Enforces Super Admin role via document existence check and restricts modification to the owner.
     */
    match /roles_super_admin/{superAdminId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isOwner(superAdminId);
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Manages Admin profiles. Super Admins can create admin profiles.
     * @path /admins/{adminId}
     * @allow (create) Super Admin can create admin profile.
     * @deny (create) Non-Super Admin cannot create admin profile.
     * @allow (get) Any signed-in user can get an admin profile.
     * @deny (update, delete) Only Super Admins can update or delete an admin profile.
     * @principle Restricts admin creation to super admins and enforces ownership for data access.
     */
    match /admins/{adminId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Manages IoT devices. Admins can create, read, update, and delete devices assigned to them.
     * @path /devices/{deviceId}
     * @allow (create) Admin can create a device with their adminId.
     * @deny (create) Admin cannot create a device with another adminId.
     * @allow (get) Any signed-in user can get a device.
     * @allow (update, delete) Only the admin associated with the device can update or delete it.
     * @principle Enforces admin-based ownership for device management.
     */
    match /devices/{deviceId} {
      allow get: if isSignedIn();
      allow list: if false; // Changed to false based on the error report. It seems all devices must not be read by all users.
      allow create: if isSignedIn() && request.resource.data.adminId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.adminId) && request.resource.data.adminId == resource.data.adminId;
      allow delete: if isExistingOwner(resource.data.adminId);
    }

    /**
     * @description Manages system alerts. Admins can create, read, update, and delete alerts associated with their devices.
     * @path /alerts/{alertId}
     * @allow (create) Admin can create an alert for their device.
     * @deny (create) Admin cannot create an alert for another admin's device.
     * @allow (get) Any signed-in user can get an alert.
     * @allow (update, delete) Only the admin associated with the alert can update or delete it.
     * @principle Enforces admin-based ownership for alert management.
     */
    match /alerts/{alertId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn() && request.resource.data.adminId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.adminId) && request.resource.data.adminId == resource.data.adminId;
      allow delete: if isExistingOwner(resource.data.adminId);
    }
  }
}