/**
 * @file Firestore Security Rules
 * @version 2
 *
 * @description
 * This ruleset enforces a role-based access control model with super-admin privileges.
 * Super admins have the ability to manage organizations, departments, and devices.
 * Data validation is relaxed to allow for rapid prototyping, focusing on authorization.
 *
 * @data_structure
 * - /roles_super_admin/{superAdminId}:  Documents that identify a user as a Super Admin.
 * - /organizations/{organizationId}: Stores organization profile information, accessible only by super admins.
 * - /departments/{departmentId}: Stores department information for all organizations, accessible only by super admins.
 * - /devices/{deviceId}: Stores information about individual devices, accessible only by super admins.
 *
 * @key_security_decisions
 * - Super admin role is determined by presence of document in `/roles_super_admin/{superAdminId}`.
 * - Listing of organizations, departments, and devices is only allowed for super admins.
 * - All data is considered private unless explicitly stated otherwise.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the current user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user is a super admin.
     */
    function isSuperAdmin() {
        return exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
    }

    /**
     * @description Checks if the provided userId matches the authenticated user's UID.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the user is a super admin and the document exists.
     */
    function isExistingSuperAdmin(superAdminId) {
      return isSuperAdmin() && get(/databases/$(database)/documents/roles_super_admin/$(superAdminId)).data != null;
    }


    /**
     * @description
     * This rule manages super admin role assignments.
     *
     * @path /roles_super_admin/{superAdminId}
     * @allow (create) User with matching UID can create their own super admin document.
     * @allow (get, list, update, delete) Only super admins can access and modify super admin documents.
     * @deny (create) A user cannot create a super admin entry for another user.
     * @deny (update, delete) Non-super admins cannot modify or delete super admin documents.
     * @principle Enforces strict ownership for super admin role creation; only super admins can modify super admin assignments.
     */
    match /roles_super_admin/{superAdminId} {
      allow get: if isSuperAdmin();
      allow list: if false;
      allow create: if isSignedIn() && isOwner(superAdminId);
      allow update: if isSuperAdmin() && isExistingSuperAdmin(superAdminId);
      allow delete: if isSuperAdmin() && isExistingSuperAdmin(superAdminId);
    }

    /**
     * @description
     * Manages the creation, modification, and deletion of organizations.
     * Only super admins can manage organizations.
     *
     * @path /organizations/{organizationId}
     * @allow (create, update, delete) Only super admins can create, update, or delete organization documents.
     * @allow (get, list) Only super admins can read organization documents.
     * @deny (create, update, delete) Non-super admins cannot manage organizations.
     * @principle Restricts organization management to super admins.
     */
    match /organizations/{organizationId} {
      allow get: if isSuperAdmin();
      allow list: if isSuperAdmin();
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    /**
     * @description
     * Manages the creation, modification, and deletion of departments.
     * Only super admins can manage departments.
     *
     * @path /departments/{departmentId}
     * @allow (create, update, delete) Only super admins can create, update, or delete department documents.
     * @allow (get, list) Only super admins can read department documents.
     * @deny (create, update, delete) Non-super admins cannot manage departments.
     * @principle Restricts department management to super admins.
     */
    match /departments/{departmentId} {
      allow get: if isSuperAdmin();
      allow list: if isSuperAdmin();
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    /**
     * @description
     * Manages the creation, modification, and deletion of devices.
     * Only super admins can manage devices.
     *
     * @path /devices/{deviceId}
     * @allow (create, update, delete) Only super admins can create, update, or delete device documents.
     * @allow (get, list) Only super admins can read device documents.
     * @deny (create, update, delete) Non-super admins cannot manage devices.
     * @principle Restricts device management to super admins.
     */
    match /devices/{deviceId} {
      allow get: if isSuperAdmin();
      allow list: if isSuperAdmin();
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }
  }
}