/**
 * @file Firebase Security Rules for AuthStation.
 *
 * @corePhilosophy This ruleset enforces a strict organization-centric model.
 *   - Super Admins have read and write access to resources *within* their organization.
 *   - Unauthorized access is explicitly denied.
 *
 * @dataStructure The Firestore data is structured as follows:
 *   - `/roles_super_admin/{superAdminId}`: Lists of super admins, accessible only by themselves.
 *   - `/organizations/{organizationId}`: Organization profile information, writable only by the super admin that owns the organization.
 *   - `/departments/{departmentId}`: Department data, writable only by the super admin that owns the organization.  Organization ID is denormalized here to make listing easier.
 *   - `/devices/{deviceId}`: Device data. Department and Organization IDs are denormalized here.
 *
 * @keySecurityDecisions
 *   - Super admins are granted the ability to manage departments and devices within their organization.
 *   - Listing all users is explicitly denied to prevent information disclosure.
 *   - The `roles_super_admin` collection is secured with self-ownership.
 *
 * @denormalizationForAuthorization
 *   - The `departments` and `devices` collections include `organizationId`, allowing rules to efficiently filter by organization without complex queries.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the current user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the current user's UID matches the given userId.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the current user is the owner of an existing resource.
     */
    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }

    /**
     * @description Checks if the organization ID on the request matches the organization ID on the resource.
     */
    function matchesOrganizationId(organizationId) {
        return request.resource.data.organizationId == resource.data.organizationId;
    }

    /**
     * @description Validates the organizationId
     */
    function isValidOrganizationId(organizationId) {
        return request.resource.data.organizationId == organizationId;
    }

    /**
     * @description Rules for the /roles_super_admin/{superAdminId} collection.
     * @path /roles_super_admin/{superAdminId}
     * @allow (create) Signed-in user with UID 'A4d1RGR2kURnUunWMKLAYCbffUU2' can create a document where superAdminId is 'A4d1RGR2kURnUunWMKLAYCbffUU2'.
     * @allow (get) Signed-in user with UID 'A4d1RGR2kURnUunWMKLAYCbffUU2' can get their own superAdmin profile.
     * @deny (create) Signed-in user with UID 'A4d1RGR2kURnUunWMKLAYCbffUU2' cannot create a document where superAdminId is NOT 'A4d1RGR2kURnUunWMKLAYCbffUU2'.
     * @deny (get) Non-signed-in user cannot get any superAdmin profile.
     * @principle Enforces document ownership for writes and restricts access to a user's own data.
     */
    match /roles_super_admin/{superAdminId} {
      allow get: if isOwner(superAdminId);
      allow list: if false;
      allow create: if isOwner(superAdminId);
      allow update: if isOwner(superAdminId);
      allow delete: if isOwner(superAdminId);
    }

    /**
     * @description Rules for the /organizations/{organizationId} collection.
     * @path /organizations/{organizationId}
     * @allow (create) Signed-in user with UID 'A4d1RGR2kURnUunWMKLAYCbffUU2' can create an organization with organizationId 'A4d1RGR2kURnUunWMKLAYCbffUU2'.
     * @allow (get) Anyone can get an organization profile.
     * @deny (create) Signed-in user with UID 'A4d1RGR2kURnUunWMKLAYCbffUU2' cannot create an organization with a different organizationId.
     * @deny (update) Non-signed-in user cannot update any organization profile.
     * @principle Enforces document ownership for writes, but allows public reads.
     */
    match /organizations/{organizationId} {
        allow get: if true;
        allow list: if false;
        allow create: if isSignedIn() && request.resource.data.superAdminId == request.auth.uid;
        allow update: if isSignedIn() && resource.data.superAdminId == request.auth.uid;
        allow delete: if isSignedIn() && resource.data.superAdminId == request.auth.uid;
    }

    /**
     * @description Rules for the /departments/{departmentId} collection.
     * @path /departments/{departmentId}
     * @allow (create) Signed-in user with UID 'A4d1RGR2kURnUunWMKLAYCbffUU2' can create a department with organizationId matching their UID.
     * @allow (get) Anyone can get a department.
     * @deny (list) Non-SuperAdmin user can not list all departments if the organizationId doesn't match
     * @deny (create) Signed-in user with UID 'A4d1RGR2kURnUunWMKLAYCbffUU2' cannot create a department with a different organizationId.
     * @deny (update) Non-signed-in user cannot update any department.
     * @principle Enforces document ownership for writes, but allows public reads.
     */
    match /departments/{departmentId} {
        allow get: if true;
        allow list: if false;
        allow create: if isSignedIn() && get(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)).data.superAdminId == request.auth.uid;
        allow update: if isSignedIn() && get(/databases/$(database)/documents/organizations/$(resource.data.organizationId)).data.superAdminId == request.auth.uid;
        allow delete: if isSignedIn() && get(/databases/$(database)/documents/organizations/$(resource.data.organizationId)).data.superAdminId == request.auth.uid;
    }

    /**
     * @description Rules for the /devices/{deviceId} collection.
     * @path /devices/{deviceId}
     * @allow (create) Signed-in user can create a device with a valid organizationId.
     * @allow (get) Anyone can get device information.
     * @deny (create) Signed-in user cannot create a device with an invalid organizationId.
     * @deny (update) Non-signed-in user cannot update any device.
     * @principle Enforces document ownership for writes, but allows public reads.
     */
    match /devices/{deviceId} {
        allow get: if true;
        allow list: if true;
        allow create: if isSignedIn() && get(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)).data.superAdminId == request.auth.uid;
        allow update: if isSignedIn() && get(/databases/$(database)/documents/organizations/$(resource.data.organizationId)).data.superAdminId == request.auth.uid;
        allow delete: if isSignedIn() && get(/databases/$(database)/documents/organizations/$(resource.data.organizationId)).data.superAdminId == request.auth.uid;
    }
  }
}