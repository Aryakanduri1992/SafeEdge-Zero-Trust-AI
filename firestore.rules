/**
 * @description This ruleset enforces a role-based access control system for the AuthStation application,
 *              with distinct privileges for Super Admins and Admins. It leverages the existence of
 *              documents in specific collections to grant roles, ensuring Authorization Independence.
 * @dataStructure
 *   - /roles_super_admin/{superAdminId}:  Documents indicate a user is a Super Admin.  The existence
 *     of a document with a matching UID grants super-admin privileges.
 *   - /admins/{adminId}: Stores Admin profiles, linked to their creating Super Admin via the `superAdminId` field.
 *     Authorization Independence: Access does NOT depend on reading data from the Super Admin document.
 * @keySecurityDecisions
 *   - Super Admin role is determined solely by the presence of a document in `/roles_super_admin/{superAdminId}`.
 *   - Admin creation is restricted to Super Admins.
 *   - Listing of Admins is only permitted for Super Admins.
 *   - Regular users cannot list or access Admin data.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants Super Admin privileges based on document existence in this collection.
     * @path /roles_super_admin/{superAdminId}
     * @allow (get, list) if isSignedIn() - Allows any authenticated user to check if a Super Admin exists for a given UID.
     * @allow (create) if request.auth.uid == superAdminId - Allows a user to create their own Super Admin role document, effectively self-assigning the role.
     * @allow (update, delete) if false - Prevents modification or deletion of Super Admin role documents through rules.
     * @deny (create) if request.auth.uid != superAdminId - Protects Super Admin role assignment from unauthorized users.
     * @principle DBAC (Database Auth Based Control); existence of a document grants the Super Admin role.
     */
    match /roles_super_admin/{superAdminId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if request.auth.uid == superAdminId;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Manages Admin profiles.  Super Admins can create, read, update, and delete Admin profiles.
     * @path /admins/{adminId}
     * @allow (get) if isSignedIn() - Allows any authenticated user to read an Admin profile.
     * @allow (list) if exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid)) - Allows Super Admins to list Admin profiles.
     * @allow (create) if exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid)) && request.resource.data.superAdminId == request.auth.uid - Allows Super Admins to create new Admin profiles, enforcing that the 'superAdminId' matches the creator's UID.
     * @allow (update) if exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid)) && resource != null && resource.data.superAdminId == request.resource.data.superAdminId - Allows Super Admins to update existing Admin profiles, ensuring the `superAdminId` remains unchanged.
     * @allow (delete) if exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid)) && resource != null - Allows Super Admins to delete existing Admin profiles.
     * @deny (create) if !exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid)) - Prevents non-Super Admins from creating Admin profiles.
     * @deny (update) if resource != null && resource.data.superAdminId != request.resource.data.superAdminId - Protects the `superAdminId` field from unauthorized modification.
     * @deny (delete) if !exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid)) - Prevents non-Super Admins from deleting Admin profiles.
     * @principle Role-based access control, Authorization Independence, Relational Integrity.
     */
    match /admins/{adminId} {
      allow get: if isSignedIn();
      allow list: if exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
      allow create: if exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid)) && request.resource.data.superAdminId == request.auth.uid;
      allow update: if exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid)) && resource != null && resource.data.superAdminId == request.resource.data.superAdminId;
      allow delete: if exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid)) && resource != null;
    }

    function isSignedIn() {
      return request.auth != null;
    }
  }
}