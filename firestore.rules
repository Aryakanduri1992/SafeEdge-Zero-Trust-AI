/**
 * @fileoverview Firestore Security Rules for AuthStation.
 *
 * Core Philosophy:
 * This ruleset enforces a role-based access control model with a super admin role.
 * Organizations and their related data (departments, devices, sensor readings) are secured based on the organization ID.
 * Super admins have read and write access to all organizations and associated data. Other users (currently not explicitly modeled) are denied access.
 *
 * Data Structure:
 * - /roles_super_admin/{superAdminId}: Super admin role assignments, identified by UID.
 * - /organizations/{organizationId}: Stores organization profile information.
 * - /departments/{departmentId}: Stores department information.
 * - /devices/{deviceId}: Stores device information.
 * - /sensorReadings/{readingId}: Stores time-series sensor data.
 *
 * Key Security Decisions:
 * - Super admin role is granted by the presence of a document in the `roles_super_admin` collection.
 * - Non-super admins are explicitly denied access to all data. Future roles (e.g., organization admins) will require updates to these rules.
 * - List operations are generally allowed for super admins but denied for others, reflecting a design choice to prevent unauthorized data discovery.
 * - The rules prioritize strict access control and assume that all write operations require authorization.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants super admins full access to manage super admin roles. No one else can.
     * @path /roles_super_admin/{superAdminId}
     * @allow (get, list, create, update, delete) if request.auth.uid exists as a document ID in /roles_super_admin.
     * @deny (get, list, create, update, delete) if request.auth.uid does not exist as a document ID in /roles_super_admin.
     * @principle Enforces role-based access control; only super admins can manage super admin roles.
     */
    match /roles_super_admin/{superAdminId} {
      allow get: if isSignedIn() && isSuperAdmin();
      allow list: if isSignedIn() && isSuperAdmin();
      allow create: if isSignedIn() && isSuperAdmin();
      allow update: if isSignedIn() && isSuperAdmin();
      allow delete: if isSignedIn() && isSuperAdmin();
    }

    /**
     * @description Grants super admins full access to manage organizations.
     * @path /organizations/{organizationId}
     * @allow (get, list) if request.auth.uid exists as a document ID in /roles_super_admin.
     * @allow (create, update, delete) if request.auth.uid exists as a document ID in /roles_super_admin.
     * @deny (get, list, create, update, delete) if request.auth.uid does not exist as a document ID in /roles_super_admin.
     * @principle Enforces role-based access control; only super admins can manage organizations.
     */
    match /organizations/{organizationId} {
      allow get: if isSignedIn() && isSuperAdmin();
      allow list: if isSignedIn() && isSuperAdmin();
      allow create: if isSignedIn() && isSuperAdmin();
      allow update: if isSignedIn() && isSuperAdmin();
      allow delete: if isSignedIn() && isSuperAdmin();
    }

    /**
     * @description Grants super admins full access to manage departments.
     * @path /departments/{departmentId}
     * @allow (get, list) if request.auth.uid exists as a document ID in /roles_super_admin.
     * @allow (create, update, delete) if request.auth.uid exists as a document ID in /roles_super_admin.
     * @deny (get, list, create, update, delete) if request.auth.uid does not exist as a document ID in /roles_super_admin.
     * @principle Enforces role-based access control; only super admins can manage departments.
     */
    match /departments/{departmentId} {
      allow get: if isSignedIn() && isSuperAdmin();
      allow list: if isSignedIn() && isSuperAdmin();
      allow create: if isSignedIn() && isSuperAdmin();
      allow update: if isSignedIn() && isSuperAdmin();
      allow delete: if isSignedIn() && isSuperAdmin();
    }

    /**
     * @description Grants super admins full access to manage devices.
     * @path /devices/{deviceId}
     * @allow (get, list) if request.auth.uid exists as a document ID in /roles_super_admin.
     * @allow (create, update, delete) if request.auth.uid exists as a document ID in /roles_super_admin.
     * @deny (get, list, create, update, delete) if request.auth.uid does not exist as a document ID in /roles_super_admin.
     * @principle Enforces role-based access control; only super admins can manage devices.
     */
    match /devices/{deviceId} {
      allow get: if isSignedIn() && isSuperAdmin();
      allow list: if isSignedIn() && isSuperAdmin();
      allow create: if isSignedIn() && isSuperAdmin();
      allow update: if isSignedIn() && isSuperAdmin();
      allow delete: if isSignedIn() && isSuperAdmin();
    }

    /**
     * @description Grants super admins full access to manage sensor readings.
     * @path /sensorReadings/{readingId}
     * @allow (get, list) if request.auth.uid exists as a document ID in /roles_super_admin.
     * @allow (create, update, delete) if request.auth.uid exists as a document ID in /roles_super_admin.
     * @deny (get, list, create, update, delete) if request.auth.uid does not exist as a document ID in /roles_super_admin.
     * @principle Enforces role-based access control; only super admins can manage sensor readings.
     */
    match /sensorReadings/{readingId} {
      allow get: if isSignedIn() && isSuperAdmin();
      allow list: if isSignedIn() && isSuperAdmin();
      allow create: if isSignedIn() && isSuperAdmin();
      allow update: if isSignedIn() && isSuperAdmin();
      allow delete: if isSignedIn() && isSuperAdmin();
    }

     // Allow read access to the entire collection for list operations
    match /{path=**} {
      allow get: if false; // No one can get arbitrary documents
      allow list: if isSignedIn() && isSuperAdmin();
      allow create: if false; // No one can create arbitrary documents
      allow update: if false; // No one can update arbitrary documents
      allow delete: if false; // No one can delete arbitrary documents
    }
  }

  // Helper function to determine if a user is signed in.
  function isSignedIn() {
    return request.auth != null;
  }

  // Helper function to determine if a user is a super admin.
  function isSuperAdmin() {
    return exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
  }
}