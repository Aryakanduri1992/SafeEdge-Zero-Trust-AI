/**
 * @fileoverview Firestore Security Rules for AuthStation application.
 *
 * Core Philosophy:
 * This ruleset employs a role-based access control model with super-admin privileges and an organization-centric data structure.
 * Super admins have broad access, while other users primarily interact with data within their organization or department.
 *
 * Data Structure:
 * - /roles_super_admin/{superAdminId}: Collection to store super admin role assignments.
 * - /organizations/{organizationId}: Collection to store organization profiles.
 * - /departments/{departmentId}: Collection to store department information.
 * - /devices/{deviceId}: Collection to store device information.
 *
 * Key Security Decisions:
 * - Super admins are identified via documents in the `roles_super_admin` collection.
 * - Organizations and departments can only be created by a super admin.
 * - Device creation, reading, updating and deletion are not restricted to a single user, but rather, anyone can perform them.
 *
 * Denormalization for Authorization:
 *  N/A
 *
 * Structural Segregation:
 *  N/A
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants super admins full access to manage super admin roles.
     * @path /roles_super_admin/{superAdminId}
     * @allow (get, create, update, delete, list) if the user is a super admin.
     * @deny (get, create, update, delete, list) if the user is not a super admin.
     * @principle Enforces role-based access control for managing super admins.
     */
    match /roles_super_admin/{superAdminId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Grants super admins the ability to create and manage organizations.
     * @path /organizations/{organizationId}
     * @allow (create) if the user is a super admin.
     * @deny (create) if the user is not a super admin.
     * @allow (get, list) Public access is granted to read the organizations.
     * @principle Restricts organization creation to super admins; Open read.
     */
    match /organizations/{organizationId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Grants super admins the ability to create and manage departments.
     * @path /departments/{departmentId}
     * @allow (create) if the user is a super admin.
     * @deny (create) if the user is not a super admin.
     * @allow (get, list) Public access is granted to read the departments.
     * @principle Restricts department creation to super admins; Open read.
     */
    match /departments/{departmentId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Grants the ability to create and manage devices.
     * @path /devices/{deviceId}
     * @allow (get, list) Public access is granted to read the devices.
     * @allow (create, update, delete) No auth checks.
     * @principle Open create, update and delete device.
     */
    match /devices/{deviceId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    /**
     * @description NO SECURITY. Sensor readings are not protected in this prototype.
     * @path /sensorReadings/{sensorReadingId}
     * @allow get, list, create, update, delete: if true;
     * @principle Open Access.
     */
     match /sensorReadings/{sensorReadingId} {
        allow get, list, create, update, delete: if true;
     }
  }
}