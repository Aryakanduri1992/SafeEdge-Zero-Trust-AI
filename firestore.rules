
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the user's UID exists in the roles_super_admin collection.
    // This is more reliable than custom claims for rules, as it doesn't depend on token refresh state.
    function isSuperAdmin() {
      return exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
    }

    // Super admins have broad access
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }

    // Organizations can be read and updated by the user whose UID matches the document ID (the org admin).
    match /organizations/{orgId} {
      allow read, update: if request.auth.uid == orgId;
    }

    // Departments can be read by the admin of the organization they belong to.
    match /departments/{deptId} {
      allow read: if request.auth.uid == resource.data.organizationId;
    }

    // Devices can be read by the admin of the organization they belong to.
    match /devices/{deviceId} {
      allow read, write, delete: if request.auth.uid == resource.data.organizationId;
    }
  }
}
