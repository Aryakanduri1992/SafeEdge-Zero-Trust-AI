/**
 * @file Firebase Security Rules for AuthStation Firestore.
 *
 * @core_philosophy This ruleset enforces a role-based access control model with a super admin role.
 *  Super admins are defined by documents in the `/roles_super_admin/{superAdminId}` collection,
 *  which associates a user ID with the super admin role.
 *  Organizations, departments, and devices are secured such that only super admins can create them.
 *
 * @data_structure The Firestore data is structured as follows:
 *  - `/roles_super_admin/{superAdminId}`: Documents identifying super admins.
 *  - `/organizations/{organizationId}`: Documents storing organization information.
 *  - `/departments/{departmentId}`: Documents storing department information.
 *  - `/devices/{deviceId}`: Documents storing device information.
 *
 * @key_security_decisions
 *  - Super admins can manage organizations, departments, and devices.
 *  - Regular users (non-super admins) have no access to these resources.
 *  - Listing of documents in the `/roles_super_admin` collection is explicitly denied to prevent unauthorized role discovery.
 *
 * @denormalization_for_authorization SuperAdmin role is determined by the presence of a document
 *  in `/roles_super_admin/{superAdminId}` where the document ID matches the user's UID.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Manages super admin role assignments.
     * @path /roles_super_admin/{superAdminId}
     * @allow (create) Authenticated user with matching UID creates their SuperAdmin profile.
     * @allow (get) Authenticated SuperAdmin reads their own SuperAdmin profile.
     * @deny (list) Prevents listing all SuperAdmin documents.
     * @deny (create) Non-authenticated user attempts to create a SuperAdmin profile.
     * @deny (create) Authenticated user attempts to create a SuperAdmin profile with a mismatched ID.
     * @deny (update) Prevents unauthorized modification of SuperAdmin documents.
     * @deny (delete) Prevents unauthorized deletion of SuperAdmin documents.
     * @principle Enforces role-based access control, restricting SuperAdmin management to authorized users.
     */
    match /roles_super_admin/{superAdminId} {
      allow get: if isSignedIn() && isOwner(superAdminId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(superAdminId) && request.resource.data.id == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Manages organization profiles.
     * @path /organizations/{organizationId}
     * @allow (create) SuperAdmin creates an organization profile.
     * @allow (get) Authenticated user gets an organization profile.
     * @allow (list) Authenticated user lists organization profiles.
     * @deny (create) Non-SuperAdmin attempts to create an organization profile.
     * @deny (update) Prevents unauthorized modification of organization profiles.
     * @deny (delete) Prevents unauthorized deletion of organization profiles.
     * @principle Restricts organization creation to SuperAdmins, while allowing read access to all authenticated users.
     */
    match /organizations/{organizationId} {
      allow get, list: if isSignedIn();
      allow create: if isSuperAdmin();
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Manages department profiles.
     * @path /departments/{departmentId}
     * @allow (create) SuperAdmin creates a department profile.
     * @allow (get) Authenticated user gets a department profile.
     * @allow (list) Authenticated user lists department profiles.
     * @deny (create) Non-SuperAdmin attempts to create a department profile.
     * @deny (update) Prevents unauthorized modification of department profiles.
     * @deny (delete) Prevents unauthorized deletion of department profiles.
     * @principle Restricts department creation to SuperAdmins, while allowing read access to all authenticated users.
     */
    match /departments/{departmentId} {
      allow get, list: if isSignedIn();
      allow create: if isSuperAdmin();
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Manages device profiles.
     * @path /devices/{deviceId}
     * @allow (create) SuperAdmin creates a device profile.
     * @allow (get) Authenticated user gets a device profile.
     * @allow (list) Authenticated user lists device profiles.
     * @deny (create) Non-SuperAdmin attempts to create a device profile.
     * @deny (update) Prevents unauthorized modification of device profiles.
     * @deny (delete) Prevents unauthorized deletion of device profiles.
     * @principle Restricts device creation to SuperAdmins, while allowing read access to all authenticated users.
     */
    match /devices/{deviceId} {
      allow get, list: if isSignedIn();
      allow create: if isSuperAdmin();
      allow update: if false;
      allow delete: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isSuperAdmin() {
      return exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
    }
  }
}