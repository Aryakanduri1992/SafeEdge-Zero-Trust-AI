/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a multi-tenant security model where organizations and their members have isolated access to data.
 *
 * Data Structure:
 * - /roles_super_admin/{superAdminId}: Documents identifying super administrators.
 * - /organizations/{organizationId}: Stores organization profile information.
 * - /departments/{departmentId}: Stores department information for all organizations.
 * - /devices/{deviceId}: Stores information about individual devices.
 *
 * Key Security Decisions:
 * - Super admins are defined by their presence in the `/roles_super_admin` collection.
 * - Organizations can only be created by a super admin.
 * - Departments are scoped to organizations and controlled by super admins.
 * - Devices are scoped to organizations and departments. List operations on devices are restricted to the organization.
 * - Data shapes are not strictly enforced to allow for rapid prototyping.
 *
 * Denormalization for Authorization:
 * - The `organizationId` field is present on `departments` and `devices` to allow direct access control without additional reads.
 *
 * Structural Segregation:
 * - There are no explicit public collections.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secure the super admin role assignments.
     * @path /roles_super_admin/{superAdminId}
     * @allow (get): Authenticated user can read their own role.
     * @allow (list): No one can list super admins.
     * @allow (create): No one can create super admins via client; only backend.
     * @allow (update): No one can update super admins via client; only backend.
     * @allow (delete): No one can delete super admins via client; only backend.
     * @principle Owner-only access to role document.
     */
    match /roles_super_admin/{superAdminId} {
      allow get: if isSignedIn() && isOwner(superAdminId);
      allow list: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Secure organization profile information.
     * @path /organizations/{organizationId}
     * @allow (get): Any authenticated user can read organization information.
     * @allow (list): No one can list organizations.
     * @allow (create): Only a super admin can create an organization. The `superAdminId` must match the authenticated user.
     * @allow (update): No one can update organizations via client; only backend.
     * @allow (delete): No one can delete organizations via client; only backend.
     * @principle Owner-only write access with public read.
     */
    match /organizations/{organizationId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn() && isSuperAdmin() && request.resource.data.superAdminId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Secure department information for all organizations.
     * @path /departments/{departmentId}
     * @allow (get): Any authenticated user can read department information.
     * @allow (list): No one can list departments.
     * @allow (create): Only a super admin can create a department.  The `organizationId` must exist.
     * @allow (update): No one can update departments via client; only backend.
     * @allow (delete): No one can delete departments via client; only backend.
     * @principle Owner-only write access with public read.
     */
    match /departments/{departmentId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn() && isSuperAdmin() && exists(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId));
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Secure device information.
     * @path /devices/{deviceId}
     * @allow (get): Any authenticated user can read device information.
     * @allow (list): Only users in the device's organization can list devices.
     * @allow (create): Only a super admin can create a device. The `organizationId` and `departmentId` must exist.
     * @allow (update): No one can update devices via client; only backend.
     * @allow (delete): No one can delete devices via client; only backend.
     * @principle Organization-scoped access control with public read.
     */
    match /devices/{deviceId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && get(/databases/$(database)/documents/departments/$(resource.data.departmentId)).data.organizationId == get(/databases/$(database)/documents/departments/$(request.resource.data.departmentId)).data.organizationId;
      allow create: if isSignedIn() && isSuperAdmin() && exists(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)) && exists(/databases/$(database)/documents/departments/$(request.resource.data.departmentId));
      allow update: if false;
      allow delete: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isSuperAdmin() {
      return exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
    }
    
    function isOrganizationMember(userId, organizationId) {
        return get(/databases/$(database)/documents/organizations/$(organizationId)).data.memberIds.hasAny([userId]);
    }

    function exists(path) {
      return get(path).data != null;
    }
  }
}