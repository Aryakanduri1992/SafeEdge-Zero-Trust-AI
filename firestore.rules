/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a role-based access control model for the AuthStation application.
 *
 * Data Structure:
 * - /roles_super_admin/{superAdminId}: Stores SuperAdmin role information.
 * - /organizations/{organizationId}: Stores Organization profiles.
 * - /departments/{departmentId}: Stores Department information.
 * - /devices/{deviceId}: Stores Device information.
 *
 * Key Security Decisions:
 * - Super Admins can only manage their own organizations, departments, and devices.
 * - Organizations are created by Super Admins and are associated with a specific Super Admin.
 * - Departments are associated with Organizations.
 * - Devices are associated with Departments and Organizations.
 * - Prevents listing of super admins.
 *
 * Denormalization for Authorization:
 * - Each document (Organization, Department, Device) includes the `superAdminId` to simplify authorization checks. This avoids needing to query the `roles_super_admin` collection.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Restricts access to the /roles_super_admin collection to prevent listing. Only allows getting a specific super admin role by ID.
     * @path /roles_super_admin/{superAdminId}
     * @allow (get) Authenticated user can retrieve their own super admin role.
     * @deny (list) No one can list all super admins.
     * @principle Prevents unauthorized listing of super admin roles.
     */
    match /roles_super_admin/{superAdminId} {
      allow get: if isSignedIn() && isOwner(superAdminId);
      allow list: if false;
      allow create, update, delete: if false;
    }

    /**
     * @description Manages access to organization profiles. Super Admins can create, update, and delete organizations they own.  Anyone can read.
     * @path /organizations/{organizationId}
     * @allow (create) Super Admin creates a new organization with their ID.
     * @allow (get, list) Anyone can read organizations profiles.
     * @deny (update, delete) Unauthorized user attempts to modify an organization.
     * @principle Enforces owner-only writes.
     */
    match /organizations/{organizationId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.superAdminId == request.auth.uid;
      allow update: if isSignedIn() && isExistingOwner(resource.data.superAdminId);
      allow delete: if isSignedIn() && isExistingOwner(resource.data.superAdminId);
    }

    /**
     * @description Manages access to department profiles. Super Admins can create, update, and delete departments they own.
     * @path /departments/{departmentId}
     * @allow (create) Super Admin creates a new department with their ID.
     * @deny (update, delete) Unauthorized user attempts to modify a department.
     * @principle Enforces owner-only writes.
     */
    match /departments/{departmentId} {
      allow get, list: if isSignedIn() && isSuperAdminForOrganization(resource.data.organizationId);
      allow create: if isSignedIn() && request.resource.data.superAdminId == request.auth.uid && isSuperAdminForOrganization(request.resource.data.organizationId);
      allow update: if isSignedIn() && isExistingOwner(resource.data.superAdminId) && isSuperAdminForOrganization(resource.data.organizationId);
      allow delete: if isSignedIn() && isExistingOwner(resource.data.superAdminId) && isSuperAdminForOrganization(resource.data.organizationId);
    }

    /**
     * @description Manages access to device information. Super Admins can create, update, and delete devices they own.
     * @path /devices/{deviceId}
     * @allow (create) Super Admin creates a new device with their ID.
     * @deny (update, delete) Unauthorized user attempts to modify a device.
     * @principle Enforces owner-only writes.
     */
    match /devices/{deviceId} {
      allow get, list: if isSignedIn() && isSuperAdminForOrganization(resource.data.organizationId);
      allow create: if isSignedIn() && request.resource.data.departmentId != null && isSuperAdminForOrganization(request.resource.data.organizationId);
      allow update: if isSignedIn() && isExistingOwner(resource.data.organizationId) && isSuperAdminForOrganization(resource.data.organizationId);
      allow delete: if isSignedIn() && isExistingOwner(resource.data.organizationId) && isSuperAdminForOrganization(resource.data.organizationId);
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(ownerId) {
      return isSignedIn() && isOwner(ownerId) && resource != null;
    }

    function isSuperAdminForOrganization(organizationId) {
        return exists(/databases/$(database)/documents/organizations/$(organizationId)) && get(/databases/$(database)/documents/organizations/$(organizationId)).data.superAdminId == request.auth.uid;
    }
  }
}