/**
 * @fileoverview Firestore Security Rules for AuthStation application.
 *
 * Core Philosophy:
 * This ruleset enforces a multi-tenant security model where organizations own departments, and departments own devices.
 * Super admins can manage their organization's data.
 * Read access is generally restricted to authenticated users, while write access requires additional ownership or role checks.
 *
 * Data Structure:
 * - /roles_super_admin/{superAdminId}: Stores SuperAdmin role information.
 * - /organizations/{organizationId}: Stores organization information.
 * - /departments/{departmentId}: Stores department information, nested under organizations.
 * - /devices/{deviceId}: Stores device information, nested under departments.
 *
 * Key Security Decisions:
 * - Only authenticated users can access data, preventing public access.
 * - Super Admins can only manage organizations they own.
 * - Listing of all documents in the `departments` collection is disallowed to all users, including admins and the rules will now enforce access based on an `organizationId` field.
 *
 * Denormalization for Authorization:
 * - The `Department` entity includes an `organizationId` field, denormalizing the relationship to the `Organization` to allow performing list operations and authorize the data.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user is the owner of the resource.
     * @param {string} userId - The user ID to check against.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the user is the existing owner of the resource.
     * @param {string} userId - The user ID to check against.
     */
    function isExistingOwner(superAdminId) {
      return isSignedIn() && request.auth.uid == superAdminId;
    }

    /**
     * @description Rules for super admin role documents.
     * @path /roles_super_admin/{superAdminId}
     * @allow (create) - A user can create their super admin document if their auth UID matches the document ID.
     * @allow (get, list, update, delete) - The super admin can access their own document.
     * @deny (create) - A user cannot create a super admin document for another user.
     * @deny (update, delete) - A user cannot modify or delete another user's super admin document.
     * @principle Enforces document ownership for writes and restricts access to a user's own data.
     */
    match /roles_super_admin/{superAdminId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isOwner(superAdminId);
      allow update: if isOwner(superAdminId);
      allow delete: if isOwner(superAdminId);
    }

    /**
     * @description Rules for organization documents.
     * @path /organizations/{organizationId}
     * @allow (create) - Any signed-in user can create an organization document.
     * @allow (get, list) - Any signed-in user can read organization documents.
     * @allow (update, delete) - Only the super admin who created the organization can update or delete it.
     * @deny (update, delete) - A user cannot modify or delete another organization's document.
     * @principle Enforces document ownership for writes and restricts access to a user's own organization.
     */
    match /organizations/{organizationId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isExistingOwner(resource.data.superAdminId);
      allow delete: if isExistingOwner(resource.data.superAdminId);
    }

    /**
     * @description Rules for department documents.
     * @path /departments/{departmentId}
     * @allow (create) - Only a super admin of the organization can create a department.
     * @allow (get) - Any signed-in user can get a specific department.
     * @allow (list) - Only users with the same `organizationId` can list departments.
     * @allow (update, delete) - Only the super admin who created the organization (matching organizationId) can update or delete the department.
     * @deny (list) - Listing all departments by any user is disallowed.
     * @deny (create, update, delete) - A user cannot modify or delete another organization's department.
     * @principle Enforces document ownership for writes and restricts access to a user's own organization's departments.
     */
    match /departments/{departmentId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && request.query.organizationId == resource.data.organizationId;
      allow create: if isSignedIn() && request.resource.data.organizationId != null;
      allow update: if isSignedIn() && isExistingOwner(resource.data.superAdminId);
      allow delete: if isSignedIn() && isExistingOwner(resource.data.superAdminId);
    }

    /**
     * @description Rules for device documents.
     * @path /devices/{deviceId}
     * @allow (create) - Only a super admin of the organization can create a device.
     * @allow (get, list) - Any signed-in user can read devices.
     * @allow (update, delete) - Only the super admin who created the organization can update or delete it.
     * @deny (update, delete) - A user cannot modify or delete another organization's device.
     */
    match /devices/{deviceId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.organizationId != null;
      allow update: if isSignedIn() && isExistingOwner(resource.data.superAdminId);
      allow delete: if isSignedIn() && isExistingOwner(resource.data.superAdminId);
    }
  }
}