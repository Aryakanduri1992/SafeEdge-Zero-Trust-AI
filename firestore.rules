/**
 * @file Firestore Security Rules
 * @version 2
 *
 * @description
 * This ruleset enforces a role-based access control model, primarily centered around super admins and organizations.
 * It allows super admins to manage organizations, departments, and devices within their assigned organization.
 *
 * Data Structure:
 * - /roles_super_admin/{superAdminId}: Documents identifying super admins. The document ID is the user's UID.
 * - /organizations/{organizationId}: Documents storing organization information.
 * - /departments/{departmentId}: Documents storing department information, linked to organizations.
 * - /devices/{deviceId}: Documents storing device information, linked to departments and organizations.
 *
 * Key Security Decisions:
 * - Super admins can only manage data within their own organization.
 * - Organizations and departments are not listable. Access is only allowed with a valid ID.
 * - Device creation, modification, and deletion is restricted to super admins of the relevant organization.
 *
 * Denormalization for Authorization:
 * - The department and device documents both contain 'organizationId' fields. This allows rules on these collections to quickly verify that the user has access to the relevant organization without needing additional `get()` operations.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the current user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the current user is the owner (identified by UID) of the document.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the current user is an existing owner of the document.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Checks if the user is a super admin.
     */
    function isSuperAdmin() {
      return exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
    }

    /**
     * @description Checks if the user is a super admin for the given organization.
     */
    function isSuperAdminForOrganization(organizationId) {
      return isSuperAdmin() && get(/databases/$(database)/documents/organizations/$(organizationId)).data.superAdminId == request.auth.uid;
    }

    /**
     * @description
     * Rules for documents that identify a user as a Super Admin.
     * @path /roles_super_admin/{superAdminId}
     * @allow (create) User with UID 'user_abc' can create a super admin record if request.auth.uid == 'user_abc'.
     * @deny (create) User with UID 'user_xyz' cannot create a super admin record for user 'user_abc'.
     * @principle Allows self-creation of super admin records, enforcing that only the authenticated user can create their own record.
     */
    match /roles_super_admin/{superAdminId} {
      allow get: if false;
      allow list: if false;

      allow create: if isOwner(superAdminId);
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description
     * Rules for organization profile information.
     * @path /organizations/{organizationId}
     * @allow (create) A super admin can create an organization with their superAdminId.
     * @deny (create) A non-super admin cannot create an organization.
     * @principle Enforces that only super admins can create organizations and links the organization to the super admin.
     */
    match /organizations/{organizationId} {
      allow get: if isSuperAdminForOrganization(organizationId);
      allow list: if false;

      allow create: if isSuperAdmin() && request.resource.data.superAdminId == request.auth.uid;
      allow update: if isSuperAdminForOrganization(organizationId) && get(/databases/$(database)/documents/organizations/$(organizationId)).data.superAdminId == request.auth.uid;
      allow delete: if false;
    }

    /**
     * @description
     * Rules for department information for all organizations.
     * @path /departments/{departmentId}
     * @allow (create) A super admin can create a department for their organization.
     * @deny (create) A non-super admin cannot create a department.
     * @principle Enforces that only super admins can create departments within their organization.
     */
    match /departments/{departmentId} {
      allow get: if isSuperAdminForOrganization(resource.data.organizationId);
      allow list: if false;

      allow create: if isSuperAdmin() && request.resource.data.organizationId != null && get(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)).data.superAdminId == request.auth.uid;
      allow update: if isSuperAdminForOrganization(resource.data.organizationId) && resource.data.organizationId == resource.data.organizationId && get(/databases/$(database)/documents/organizations/$(resource.data.organizationId)).data.superAdminId == request.auth.uid;
      allow delete: if false;
    }

    /**
     * @description
     * Rules for information about individual devices.
     * @path /devices/{deviceId}
     * @allow (create) A super admin can create a device for their organization's department.
     * @deny (create) A non-super admin cannot create a device.
     * @principle Enforces that only super admins can create devices within their organization's departments.
     */
    match /devices/{deviceId} {
      allow get: if isSuperAdminForOrganization(resource.data.organizationId);
      allow list: if false;

      allow create: if isSuperAdmin() && request.resource.data.organizationId != null && get(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)).data.superAdminId == request.auth.uid;
      allow update: if isSuperAdminForOrganization(resource.data.organizationId) && resource.data.organizationId == resource.data.organizationId && get(/databases/$(database)/documents/organizations/$(resource.data.organizationId)).data.superAdminId == request.auth.uid;
      allow delete: if isSuperAdminForOrganization(resource.data.organizationId);
    }
  }
}