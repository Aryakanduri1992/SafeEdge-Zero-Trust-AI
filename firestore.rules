/**
 * @file Overview
 * This ruleset enforces a role-based access control model centered around SuperAdmins, Organizations, and Admins (departments).
 *
 * Data Structure:
 * - /roles_super_admin/{superAdminId}: Stores SuperAdmin profiles, linked to Firebase Auth UIDs.
 * - /organizations/{organizationId}: Stores Organization profiles, with organizationId matching the Firebase Auth UID.
 * - /admins/{adminId}: Stores Admin (department) profiles, linked to an organization via 'organizationId'.
 * - /devices/{deviceId}: Stores IoT device data, linked to a department via 'adminId'.
 * - /alerts/{alertId}: Stores system alerts, linked to a department via 'adminId'.
 *
 * Key Security Decisions:
 * - SuperAdmins are granted elevated privileges based on their presence in /roles_super_admin.
 * - Organizations are identified by their Firebase Auth UID, used as the document ID in /organizations.
 * - Departments (Admins) inherit access control from their parent Organization.
 * - Listing of devices collection requires to be authenticated.
 *
 * Denormalization for Authorization:
 * - Admin documents contain the organizationId of their parent organization, enabling efficient authorization checks.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user's UID matches the provided userId.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the user is an existing owner of the document.
     */
    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }

     /**
      * @description Checks if the requesting user is a SuperAdmin
      */
    function isSuperAdmin() {
        return exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
    }

    /**
     * @description Rules for SuperAdmin role assignments.
     * @path /roles_super_admin/{superAdminId}
     * @allow (create) User 'superAdminId' can create their own role document.
     * @deny (create) User attempts to create a role document for a different user.
     * @principle Enforces self-creation and ownership for SuperAdmin role documents.
     */
    match /roles_super_admin/{superAdminId} {
      allow get: if isSuperAdmin() || isOwner(superAdminId);
      allow list: if false;
      allow create: if isOwner(superAdminId);
      allow update: if isOwner(superAdminId);
      allow delete: if isOwner(superAdminId);
    }

    /**
     * @description Rules for Organization profiles.
     * @path /organizations/{organizationId}
     * @allow (create) A SuperAdmin can create an organization with their ID.
     * @deny (update) A non-SuperAdmin attempts to modify an organization.
     * @principle Restricts organization creation to SuperAdmins and enforces ownership.
     */
    match /organizations/{organizationId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    /**
     * @description Rules for Admin (department) profiles.
     * @path /admins/{adminId}
     * @allow (create) A SuperAdmin can create a department linked to an organization.
     * @deny (update) A non-SuperAdmin attempts to modify a department.
     * @principle Restricts department creation to SuperAdmins and enforces organizational linking.
     */
    match /admins/{adminId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    /**
     * @description Rules for IoT device data.
     * @path /devices/{deviceId}
     * @allow (get) Any authenticated user can read device data.
     * @deny (create) Only SuperAdmins can create devices.
     * @principle Restricts device creation to SuperAdmins while allowing read access to all authenticated users.
     */
    match /devices/{deviceId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    /**
     * @description Rules for system alerts.
     * @path /alerts/{alertId}
     * @allow (get) Any authenticated user can read alert data.
     * @deny (create) Only SuperAdmins can create alerts.
     * @principle Restricts alert creation to SuperAdmins while allowing read access to all authenticated users.
     */
    match /alerts/{alertId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }
  }
}