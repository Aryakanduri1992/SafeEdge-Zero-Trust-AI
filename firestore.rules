/**
 * @file Firestore Security Rules for AuthStation application.
 *
 * Core Philosophy:
 * This ruleset enforces a role-based access control model for super administrators.
 * Only authenticated super administrators can access and modify their own data.
 *
 * Data Structure:
 * Super admin roles are stored in the `/roles_super_admin/{superAdminId}` collection,
 * where `{superAdminId}` is the UID of the user.
 *
 * Key Security Decisions:
 * - Only authenticated super admins can create, update, or delete their own role document.
 * - Listing of super admin role documents is not allowed.
 *
 * Denormalization for Authorization:
 * The existence of a document in the `/roles_super_admin/{superAdminId}` collection
 * is used to determine if a user has super administrator privileges. This avoids
 * the need for separate authentication or authorization services.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Manages super admin roles. Only the super admin themselves can create, read, update, or delete their role.
     * @path /roles_super_admin/{superAdminId}
     * @allow (create) User with UID 'user_abc' can create their super admin role document at /roles_super_admin/user_abc if request.auth.uid == 'user_abc'.
     * @allow (get) User with UID 'user_abc' can read their super admin role document at /roles_super_admin/user_abc if request.auth.uid == 'user_abc'.
     * @allow (update) User with UID 'user_abc' can update their super admin role document at /roles_super_admin/user_abc if request.auth.uid == 'user_abc'.
     * @allow (delete) User with UID 'user_abc' can delete their super admin role document at /roles_super_admin/user_abc if request.auth.uid == 'user_abc'.
     * @deny (create) User with UID 'user_xyz' cannot create a super admin role document at /roles_super_admin/user_abc.
     * @deny (get) User with UID 'user_xyz' cannot read the super admin role document at /roles_super_admin/user_abc.
     * @deny (update) User with UID 'user_xyz' cannot update the super admin role document at /roles_super_admin/user_abc.
     * @deny (delete) User with UID 'user_xyz' cannot delete the super admin role document at /roles_super_admin/user_abc.
     * @principle Enforces strict user ownership for super admin role management.
     */
    match /roles_super_admin/{superAdminId} {
      allow get: if isSignedIn() && isOwner(superAdminId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(superAdminId);
      allow update: if isSignedIn() && isExistingOwner(superAdminId);
      allow delete: if isSignedIn() && isExistingOwner(superAdminId);
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }
  }
}