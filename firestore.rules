/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a role-based access control model with super-admin privileges.
 * All data is organized into top-level collections: organizations, departments, and devices.
 *
 * Key Security Decisions:
 * - Super admins, identified by documents in `roles_super_admin`, have full access to all organizations, departments, and devices.
 * - Regular users (non-super-admins) are not explicitly granted any access.
 * - Data shape is not strictly validated to allow rapid prototyping.
 *
 * Denormalization for Authorization:
 * The `superAdminId` field in the Organization and Department documents is crucial for quickly checking super-admin permissions.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the current user is signed in.
     * @path N/A (Helper Function)
     * @allow N/A (Helper Function)
     * @deny N/A (Helper Function)
     * @principle Requires authentication for certain actions.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the current user is a Super Admin based on a document in the roles_super_admin collection.
     * @path N/A (Helper Function)
     * @allow N/A (Helper Function)
     * @deny N/A (Helper Function)
     * @principle Role-based access control.
     */
    function isSuperAdmin() {
        return exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
    }

    /**
     * @description Checks if the current user is the owner of the document, using the superAdminId field.
     * @path N/A (Helper Function)
     * @allow N/A (Helper Function)
     * @deny N/A (Helper Function)
     * @principle Ownership-based access control.
     */
    function isOwner(superAdminId) {
      return isSignedIn() && request.auth.uid == superAdminId;
    }

    /**
     * @description Checks if the current user is the existing owner of the document, using the superAdminId field.  Also verifies document existence.
     * @path N/A (Helper Function)
     * @allow N/A (Helper Function)
     * @deny N/A (Helper Function)
     * @principle Ownership-based access control and document existence check.
     */
    function isExistingOwner(superAdminId) {
      return isSignedIn() && request.auth.uid == superAdminId && getSelf().data.superAdminId == superAdminId;
    }

    /**
     * Helper function to get the current resource
     */
    function getSelf() {
        return get(request.path);
    }

    /**
     * @description Rules for the roles_super_admin collection.  Super admins can only create a document with their own UID.
     * @path /roles_super_admin/{superAdminId}
     * @allow (create) User abc can create a document at /roles_super_admin/abc if they are authenticated as user abc.
     * @deny (create) User def cannot create a document at /roles_super_admin/abc.
     * @principle Enforces user-owned data.
     */
    match /roles_super_admin/{superAdminId} {
      allow get: if isSuperAdmin();
      allow list: if false;
      allow create: if isSignedIn() && request.auth.uid == superAdminId;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Rules for the organizations collection. Super admins can create, read, update, and delete organizations.
     * @path /organizations/{organizationId}
     * @allow (create) A super admin can create a new organization.
     * @deny (update) A non-super admin cannot update any organization.
     * @principle Role-based access control.
     */
    match /organizations/{organizationId} {
      allow get: if isSuperAdmin();
      allow list: if isSuperAdmin();
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    /**
     * @description Rules for the departments collection. Super admins can create, read, update and delete any department.
     * @path /departments/{departmentId}
     * @allow (create) A super admin can create a new department.
     * @deny (update) A regular user cannot update any department.
     * @principle Role-based access control.
     */
    match /departments/{departmentId} {
      allow get: if isSuperAdmin();
      allow list: if isSuperAdmin();
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

        /**
     * @description Rules for the devices collection. Super admins can create, read, update, and delete any device.
     * @path /devices/{deviceId}
     * @allow (create) A super admin can create a new device.
     * @deny (update) A regular user cannot update any device.
     * @principle Role-based access control.
     */
    match /devices/{deviceId} {
      allow get: if isSuperAdmin();
      allow list: if isSuperAdmin();
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }
  }
}