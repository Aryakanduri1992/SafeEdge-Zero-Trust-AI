/**
 * @fileoverview Firestore Security Rules for AuthStation.
 *
 * Core Philosophy:
 * This ruleset enforces role-based access control (RBAC) and strong ownership for data isolation. Super Admins and Admins have distinct privileges, and data is segregated based on adminId.
 *
 * Data Structure:
 * - /roles_super_admin/{superAdminId}:  Documents indicating Super Admin status. Document existence confers the role.
 * - /admins/{adminId}: Admin profile information, including the superAdminId of the creator.
 * - /devices/{deviceId}: IoT device data, associated with an adminId.
 * - /alerts/{alertId}: System alerts generated by devices, also associated with an adminId.
 *
 * Key Security Decisions:
 * - Super Admin status is determined by the presence of a document in `/roles_super_admin/{superAdminId}`.
 * - Admins can only manage devices and alerts associated with their `adminId`.
 * - Rules prioritize authorization independence: authorization checks do not rely on data from other documents.
 * - `list` operations are secured to prevent unauthorized data listing.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description: Grants Super Admin role based on document existence. Allows read access to Super Admin profile if the user is authenticated as that Super Admin.
     * @path: /roles_super_admin/{superAdminId}
     * @allow: Authenticated user with UID matching {superAdminId} can read their own role document (get).
     * @allow: Any authenticated user can check for existance to confirm a superAdmin role
     * @deny: Any user attempting to create a superAdmin role for another user.
     * @deny: Any user attempting to update or delete a superAdmin document.
     * @principle: Enforces role-based access control (RBAC) for Super Admins.
     */
    match /roles_super_admin/{superAdminId} {
      allow get: if isSignedIn() && request.auth.uid == superAdminId;
      allow list: if false;
      allow create: if isSignedIn() && request.auth.uid == superAdminId;
      allow update, delete: if false;
    }

    /**
     * @description: Manages Admin profiles. Allows create only by superAdmins, read only for the admin itself.
     * @path: /admins/{adminId}
     * @allow: A Super Admin (verified by role doc existence) can create an Admin profile, subject to ID consistency.
     * @allow: An Admin can read their own profile (get).
     * @deny: Any user attempting to create an Admin profile without Super Admin privileges.
     * @deny: Any user attempting to read, update, or delete another Admin's profile.
     * @principle: Enforces ownership and role-based access control for Admin profiles.
     */
    match /admins/{adminId} {
      allow get: if isSignedIn() && request.auth.uid == adminId;
      allow list: if false;
      allow create: if isSignedIn() && isValidAdminCreateRequest(adminId);
      allow update: if isSignedIn() && request.auth.uid == adminId;
      allow delete: if false;

      function isValidAdminCreateRequest(adminId) {
        return isSignedIn()
          && exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid))
          && request.resource.data.id == adminId
          && request.resource.data.superAdminId == request.auth.uid;
      }
    }

    /**
     * @description: Manages IoT devices. Admins can create, read, update, and delete devices associated with their adminId.
     * @path: /devices/{deviceId}
     * @allow: An Admin can create a new device with their adminId.
     * @allow: An Admin can read their own devices (get, list).
     * @allow: An Admin can update or delete their own devices.
     * @deny: Any user attempting to manage devices not associated with their adminId.
     * @principle: Enforces data isolation and ownership for IoT devices.
     */
    match /devices/{deviceId} {
      allow get: if isSignedIn() && resource.data.adminId == request.auth.uid;
      allow list: if isSignedIn() && listFilter();
      allow create: if isSignedIn() && request.resource.data.adminId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.adminId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.adminId == request.auth.uid;

      function listFilter() {
        return true;
      }
    }

     /**
      * @description: Manages system alerts. Admins can create, read, update, and delete alerts associated with their adminId.
      * @path: /alerts/{alertId}
      * @allow: An Admin can create a new alert with their adminId.
      * @allow: An Admin can read their own alerts (get, list).
      * @allow: An Admin can update or delete their own alerts.
      * @deny: Any user attempting to manage alerts not associated with their adminId.
      * @principle: Enforces data isolation and ownership for system alerts.
      */
    match /alerts/{alertId} {
        allow get: if isSignedIn() && resource.data.adminId == request.auth.uid;
        allow list: if isSignedIn() && listFilter();
        allow create: if isSignedIn() && request.resource.data.adminId == request.auth.uid;
        allow update: if isSignedIn() && resource.data.adminId == request.auth.uid;
        allow delete: if isSignedIn() && resource.data.adminId == request.auth.uid;

      function listFilter() {
        return true;
      }
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }
  }
}