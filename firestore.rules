/**
 * @file Firebase Security Rules for AuthStation Firestore.
 *
 * Core Philosophy:
 * This ruleset enforces a role-based access control model with super-admin privileges.
 * Super admins have broad access to manage organizations, departments, and devices.
 * Organizations can only be created by super admins. Devices and departments are scoped to organizations.
 *
 * Data Structure:
 * - /roles_super_admin/{superAdminId}: Stores super admin role information.
 * - /organizations/{organizationId}: Stores organization data.
 * - /departments/{departmentId}: Stores department data, nested under organizations.
 * - /devices/{deviceId}: Stores device data, associated with specific departments and organizations.
 *
 * Key Security Decisions:
 * - Super admin role is verified via a lookup in the `roles_super_admin` collection.
 * - Organizations can only be created by a super admin.
 * - Departments and devices are secured by ensuring the superAdminId matches the requesting user's UID.
 * - All write operations validate that the user is signed in.
 *
 * Denormalization for Authorization:
 * The `superAdminId` is present on both `organizations` and `departments` to facilitate authorization checks
 * without requiring additional `get()` calls.
 *
 * Structural Segregation: N/A (no clear public/private content split).
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user is a super admin by verifying their UID exists in the roles_super_admin collection.
     */
    function isSuperAdmin() {
      return exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
    }

    /**
     * @description Checks if the requesting user's UID matches the superAdminId on the resource.
     */
    function isSuperAdminForResource(superAdminId) {
        return isSignedIn() && request.auth.uid == superAdminId;
    }

    /**
     * @description Stores documents that identify a user as a Super Admin by their UID.
     * @path /roles_super_admin/{superAdminId}
     * @allow (create) User with UID 'user_abc' creates their SuperAdmin profile.
     * @deny (create) User with UID 'user_abc' attempts to create a SuperAdmin profile for 'other_user'.
     * @principle Allows creation of super admin role document only by the user themselves.
     */
    match /roles_super_admin/{superAdminId} {
      allow get: if false;
      allow list: if false;
      allow create: if isSignedIn() && request.auth.uid == superAdminId;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Stores organization profile information.
     * @path /organizations/{organizationId}
     * @allow (create) SuperAdmin creates a new organization.
     * @deny (create) Non-SuperAdmin attempts to create an organization.
     * @principle Restricts organization creation to super admins.
     */
    match /organizations/{organizationId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && isSuperAdmin();
      allow update: if isSignedIn() && isSuperAdmin();
      allow delete: if isSignedIn() && isSuperAdmin();
    }

    /**
     * @description Stores department information for all organizations.
     * @path /departments/{departmentId}
     * @allow (create) SuperAdmin creates a new department.
     * @deny (create) Non-SuperAdmin attempts to create a department.
     * @principle Restricts department creation to super admins.
     */
    match /departments/{departmentId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && isSuperAdmin();
      allow update: if isSignedIn() && isSuperAdmin();
      allow delete: if isSignedIn() && isSuperAdmin();
    }

    /**
     * @description Stores information about individual devices, including their latest sensor readings.
     * @path /devices/{deviceId}
     * @allow (create) SuperAdmin creates a new device.
     * @deny (create) Non-SuperAdmin attempts to create a device.
     * @principle Restricts device creation to super admins.
     */
    match /devices/{deviceId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && isSuperAdmin();
      allow update: if isSignedIn() && isSuperAdmin();
      allow delete: if isSignedIn() && isSuperAdmin();
    }
  }
}