/**
 * @description This ruleset enforces a role-based access control model for the AuthStation application.
 * Super Admins have elevated privileges, while Admins have more limited access to device and alert data.
 * @dataStructure
 * - /roles_super_admin/{superAdminId}: Indicates Super Admin status; document existence grants elevated privileges.
 * - /admins/{adminId}: Stores Admin profiles, linked to a Super Admin via 'superAdminId'.
 * - /devices/{deviceId}: Stores IoT device data, linked to an Admin via 'adminId'.
 * - /alerts/{alertId}: Stores system alerts, linked to an Admin via 'adminId'.
 * @keySecurityDecisions
 * - Super Admin status is determined by the existence of a document in `/roles_super_admin/{superAdminId}`.
 * - Authorization Independence is maintained by avoiding `get()` calls in security rules. All authorization context is available in the documents being accessed.
 * - Admins can only access devices and alerts associated with their 'adminId'.
 * @denormalizationForAuthorization
 * The 'adminId' field is present on both 'Device' and 'Alert' documents to allow security rules to quickly filter by admin ownership without additional reads.
 * @structuralSegregation
 * Super Admin roles are stored in a separate `/roles_super_admin` collection, enabling simple existence checks for authorization.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user's UID matches the provided userId.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user's UID matches the provided userId and the resource exists.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Checks if the authenticated user has super admin role
     */
    function isSuperAdmin() {
        return exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
    }

    /**
     * @description Rules for the /roles_super_admin/{superAdminId} collection.
     * This collection indicates a Firebase Auth user is a Super Admin, granting elevated privileges.
     * Existence of a document here is sufficient for role verification.
     * @path /roles_super_admin/{superAdminId}
     * @allow (create) User with UID 'user_abc' creates a document at /roles_super_admin/user_abc when authenticated.
     * @deny (create) User with UID 'user_def' attempts to create a document at /roles_super_admin/user_abc.
     * @principle Enforces role-based access control: only the user themselves can create their Super Admin role document.
     */
    match /roles_super_admin/{superAdminId} {
      allow get: if isSuperAdmin();
      allow list: if false;
      allow create: if isSignedIn() && isOwner(superAdminId);
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Rules for the /admins/{adminId} collection.
     * Stores Admin profiles. Includes 'superAdminId' to reference the Super Admin who created the admin.
     * Note that access does NOT depend on the superAdmin document's content, ensuring Authorization Independence.
     * @path /admins/{adminId}
     * @allow (create) A Super Admin creates a new admin profile with a matching adminId.
     * @deny (update) A non-Super Admin attempts to update an admin profile.
     * @principle Only Super Admins can create admin profiles.
     */
    match /admins/{adminId} {
      allow get: if isSuperAdmin() || resource.data.id == request.auth.uid;
      allow list: if isSuperAdmin();
      allow create: if isSuperAdmin() && request.resource.data.id == adminId;
      allow update: if isSuperAdmin() && isExistingOwner(adminId) && request.resource.data.id == resource.data.id;
      allow delete: if isSuperAdmin() && isExistingOwner(adminId);
    }

    /**
     * @description Rules for the /devices/{deviceId} collection.
     * Stores IoT device data, linked to an admin account.
     * @path /devices/{deviceId}
     * @allow (get) Any user can read a device's data.
     * @deny (create) A non-admin user attempts to create a device.
     * @principle Admins can manage devices, and devices are isolated to their admin accounts.
     */
    match /devices/{deviceId} {
      allow get: if true;
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.adminId == request.auth.uid;
      allow update: if isSignedIn() && isExistingOwner(deviceId) && resource.data.adminId == request.auth.uid;
      allow delete: if isSignedIn() && isExistingOwner(deviceId) && resource.data.adminId == request.auth.uid;
    }

    /**
     * @description Rules for the /alerts/{alertId} collection.
     * Stores system alerts generated from devices, linked to an admin account.
     * @path /alerts/{alertId}
     * @allow (get) Any user can read an alert's data.
     * @deny (create) A non-admin user attempts to create an alert.
     * @principle Alerts are associated with admin accounts, and access is restricted accordingly.
     */
    match /alerts/{alertId} {
      allow get: if true;
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.adminId == request.auth.uid;
      allow update: if isSignedIn() && isExistingOwner(alertId) && resource.data.adminId == request.auth.uid;
      allow delete: if isSignedIn() && isExistingOwner(alertId) && resource.data.adminId == request.auth.uid;
    }
  }
}