/**
 * @file Firebase Security Rules for AuthStation Application
 *
 * @core_philosophy This ruleset enforces a role-based access control model,
 *                  granting elevated privileges to Super Admins while ensuring
 *                  data isolation between regular Admins. Authorization
 *                  Independence is a key principle, minimizing `get()` calls
 *                  and ensuring clear, auditable security rules.
 *
 * @data_structure The data is structured into top-level collections for
 *                 roles (roles_super_admin), admins (admins), devices (devices),
 *                 and alerts (alerts).  Each admin is linked to a superAdmin, and
 *                 devices/alerts are associated with admins.
 *
 * @key_security_decisions
 *   - Super Admin privileges are determined solely by the existence of a
 *     document in the `/roles_super_admin/{superAdminId}` collection.
 *   - Admin creation is restricted to Super Admins.
 *   - Admins can only access devices and alerts associated with their ID.
 *   - Listing of Super Admins is disallowed.
 *
 * @denormalization_for_authorization The `superAdminId` field is denormalized
 *                                    onto the `Admin` document, ensuring that
 *                                    the link between admins and super admins
 *                                    can be verified without additional reads.
 *                                    Similarly, `adminId` is present in `Device`
 *                                    and `Alert` documents.
 *
 * @structural_segregation N/A - all collections are top-level.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the current user is signed in.
     * @return {boolean} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user's UID matches the provided userId.
     * @param {string} userId - The user ID to compare against the authenticated user's UID.
     * @return {boolean} True if the user is authenticated and the UID matches, false otherwise.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user is an existing owner of the document.
     * @param {string} userId - The user ID to compare against the authenticated user's UID.
     * @return {boolean} True if the user is authenticated, the UID matches, and the resource exists.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Checks if the current user is a Super Admin.
     * @return {boolean} True if the user is a Super Admin, false otherwise.
     */
    function isSuperAdmin() {
      return exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
    }

    match /roles_super_admin/{superAdminId} {
      /**
       * @description Manages Super Admin role assignments based on document existence.
       * @path /roles_super_admin/{superAdminId}
       * @allow (create) - Authenticated user with matching UID creates their Super Admin role.
       * @allow (get) - Any signed in user can check for a super admin role.
       * @deny (create) - Unauthenticated user attempts to create a Super Admin role.
       * @deny (update) - Any user attempts to modify a Super Admin role document.
       * @deny (delete) - Any user attempts to delete a Super Admin role document.
       * @principle Enforces role-based access control using document existence.
       */
      allow get: if isSignedIn();
      allow list: if false; // Do not allow listing of Super Admin roles.
      allow create: if isOwner(superAdminId) && !exists(/databases/$(database)/documents/roles_super_admin/$(superAdminId));
      allow update, delete: if false;
    }

    match /admins/{adminId} {
      /**
       * @description Manages Admin profiles, allowing Super Admins to create, and the Admin to manage their own profile.
       * @path /admins/{adminId}
       * @allow (create) - Super Admin creates a new Admin profile.
       * @allow (get) - Any signed in user can read an admin profile.
       * @allow (update) - The admin can update their own profile.
       * @allow (delete) - Super Admin can delete an Admin profile.
       * @deny (create) - Non-Super Admin attempts to create an Admin profile.
       * @deny (update) - Non-admin attempts to update the Admin profile.
       * @deny (delete) - Non-Super Admin attempts to delete an Admin profile.
       * @principle Enforces role-based access control with Super Admin privileges and ownership for profile updates.
       */
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSuperAdmin() && request.resource.data.superAdminId == request.auth.uid;
      allow update: if isExistingOwner(adminId);
      allow delete: if isSuperAdmin() && resource != null;
    }

    match /devices/{deviceId} {
      /**
       * @description Manages IoT device data, restricting access to the associated Admin.
       * @path /devices/{deviceId}
       * @allow (create) - Admin creates a new device associated with their account.
       * @allow (get) - Any signed in user can read a device.
       * @allow (update) - The associated Admin updates the device data.
       * @allow (delete) - The associated Admin deletes the device data.
       * @deny (create) - Non-Admin attempts to create a device.
       * @deny (update) - Non-Admin attempts to update the device data.
       * @deny (delete) - Non-Admin attempts to delete the device data.
       * @principle Enforces ownership-based access control for device management.
       */
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.adminId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.adminId == request.auth.uid && resource != null;
      allow delete: if isSignedIn() && resource.data.adminId == request.auth.uid && resource != null;
    }

    match /alerts/{alertId} {
      /**
       * @description Manages system alerts, restricting access to the associated Admin.
       * @path /alerts/{alertId}
       * @allow (create) - System creates a new alert associated with an Admin account.
       * @allow (get) - The associated Admin can read the alert.
       * @allow (update) - The associated Admin updates the alert status (e.g., acknowledge, resolve).
       * @allow (delete) - The associated Admin deletes the alert.
       * @deny (create) - Unauthorized system attempts to create an alert for another Admin.
       * @deny (update) - Non-Admin attempts to update the alert.
       * @deny (delete) - Non-Admin attempts to delete the alert.
       * @principle Enforces ownership-based access control for alert management.
       */
      allow get, list: if isSignedIn() && resource.data.adminId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.adminId != null;
      allow update: if isSignedIn() && resource.data.adminId == request.auth.uid && resource != null;
      allow delete: if isSignedIn() && resource.data.adminId == request.auth.uid && resource != null;
    }
  }
}