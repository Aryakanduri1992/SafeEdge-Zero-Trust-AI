/**
 * @file Firestore Security Rules for AuthStation
 *
 * @Core Philosophy:
 * This ruleset enforces a role-based access control system with super-admin and admin roles.
 * Super admins have broad access, while admins are restricted to their organization's data.
 * All write operations require authentication, and access is granted based on user roles and ownership.
 * Authorization Independence is prioritized.
 *
 * @Data Structure:
 * - /roles_super_admin/{superAdminId}: Documents indicating super admin status.
 * - /admins/{adminId}: Admin user profiles, linked to a super admin via 'superAdminId'.
 * - /devices/{deviceId}: IoT device data, linked to an admin via 'adminId'.
 * - /alerts/{alertId}: System alerts generated by devices, linked to an admin via 'adminId'.
 *
 * @Key Security Decisions:
 * - Only authenticated users can perform write operations.
 * - Super admin status is determined by the existence of a document in /roles_super_admin/{superAdminId}.
 * - Admins can only access devices and alerts associated with their 'adminId'.
 * - Data access is segregated between different admins.
 * - No public listing of any collections is allowed.
 *
 * @Denormalization for Authorization:
 * - The existence of a document in `/roles_super_admin/{superAdminId}` is used to determine super admin status, avoiding the need to read the document's content.
 * - The `adminId` field in `Device` and `Alert` documents is used to enforce data isolation between different admins, avoiding complex queries.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description: Checks if the user is signed in.
     * @path: N/A (helper function)
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description: Checks if the authenticated user is a super admin.
     * @path: N/A (helper function)
     */
    function isSuperAdmin() {
      return exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
    }

    /**
     * @description: Checks if the authenticated user is the owner of the resource, based on the provided user ID.
     * @path: N/A (helper function)
     * @param: userId - The user ID to compare against the authenticated user's UID.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description: Checks if the authenticated user is the existing owner of the resource, based on the provided user ID, and ensures the resource exists.
     * @path: N/A (helper function)
     * @param: userId - The user ID to compare against the authenticated user's UID.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Rules for the super admins role collection. Only super admins can create, update, or delete these role documents.
     * @path /roles_super_admin/{superAdminId}
     * @allow create (create): If the user is a super admin AND their UID matches the superAdminId.
     * @allow get (get): If the user is a super admin.
     * @allow list (list): If the user is a super admin.
     * @allow update (update): If the user is a super admin AND their UID matches the superAdminId.
     * @allow delete (delete): If the user is a super admin AND their UID matches the superAdminId.
     * @deny create (create): If the user is not authenticated.
     * @deny update (update): If the user is not authenticated.
     * @deny delete (delete): If the user is not authenticated.
     * @principle: Enforces role-based access control for super admins.
     */
    match /roles_super_admin/{superAdminId} {
      allow get, list: if isSuperAdmin();
      allow create: if isSignedIn() && isOwner(superAdminId);
      allow update: if isExistingOwner(superAdminId) && isSuperAdmin();
      allow delete: if isExistingOwner(superAdminId) && isSuperAdmin();
    }

    /**
     * @description Rules for the admins collection. Super admins can create admins. Admins can read/update their own profiles.
     * @path /admins/{adminId}
     * @allow create (create): If the user is a super admin.
     * @allow get (get): If the user is a super admin, or if the requesting user ID is the adminId.
     * @allow list (list): If the user is a super admin.
     * @allow update (update): If the user is a super admin, or if the requesting user ID is the adminId.
     * @allow delete (delete): If the user is a super admin.
     * @deny create (create): If the user is not a super admin.
     * @deny update (update): If the user is not a super admin and not the admin itself.
     * @deny delete (delete): If the user is not a super admin.
     * @principle: Enforces role-based access control for admins, allowing super admins to manage them.
     */
    match /admins/{adminId} {
      allow get: if isSuperAdmin() || isOwner(adminId);
      allow list: if isSuperAdmin();
      allow create: if isSignedIn() && isSuperAdmin();
      allow update: if isExistingOwner(adminId) || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    /**
     * @description Rules for the devices collection. Admins can create, read, update, and delete devices.
     * @path /devices/{deviceId}
     * @allow create (create): If the user is an admin and the device's adminId matches the user's ID.
     * @allow get (get): If the user is a super admin, or if the device's adminId matches the user's ID.
     * @allow list (list): If the user is a super admin, or if the device's adminId matches the user's ID.
     * @allow update (update): If the user is an admin and the device's adminId matches the user's ID.
     * @allow delete (delete): If the user is an admin and the device's adminId matches the user's ID.
     * @deny create (create): If the user is not authenticated.
     * @deny update (update): If the user is not authenticated.
     * @deny delete (delete): If the user is not authenticated.
     * @principle: Enforces ownership for devices, ensuring only the associated admin can manage them.
     */
    match /devices/{deviceId} {
      allow get: if isSuperAdmin() || (isSignedIn() && resource.data.adminId == request.auth.uid);
      allow list: if isSuperAdmin() || (isSignedIn() && resource.data.adminId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.adminId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.adminId);
      allow delete: if isExistingOwner(resource.data.adminId);
    }

    /**
     * @description Rules for the alerts collection. Admins can create, read, update, and delete alerts.
     * @path /alerts/{alertId}
     * @allow create (create): If the user is an admin and the alert's adminId matches the user's ID.
     * @allow get (get): If the user is a super admin, or if the alert's adminId matches the user's ID.
     * @allow list (list): If the user is a super admin, or if the alert's adminId matches the user's ID.
     * @allow update (update): If the user is an admin and the alert's adminId matches the user's ID.
     * @allow delete (delete): If the user is an admin and the alert's adminId matches the user's ID.
     * @deny create (create): If the user is not authenticated.
     * @deny update (update): If the user is not authenticated.
     * @deny delete (delete): If the user is not authenticated.
     * @principle: Enforces ownership for alerts, ensuring only the associated admin can manage them.
     */
    match /alerts/{alertId} {
      allow get: if isSuperAdmin() || (isSignedIn() && resource.data.adminId == request.auth.uid);
      allow list: if isSuperAdmin() || (isSignedIn() && resource.data.adminId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.adminId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.adminId);
      allow delete: if isExistingOwner(resource.data.adminId);
    }
  }
}