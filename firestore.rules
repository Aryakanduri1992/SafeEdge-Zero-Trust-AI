/**
 * @fileoverview Firestore Security Rules for AuthStation.
 *
 * Core Philosophy:
 * This ruleset enforces a role-based access control model where Super Admins and Admins have specific privileges.
 * Super Admin status is determined by the existence of a document in the `/roles_super_admin/{superAdminId}` collection.
 * Admins and devices are associated with a superAdminId or adminId, respectively, enabling data isolation and controlled access.
 *
 * Data Structure:
 * - /roles_super_admin/{superAdminId}: Super Admin role documents.
 * - /admins/{adminId}: Admin profile documents, containing `superAdminId`.
 * - /devices/{deviceId}: IoT device data, containing `adminId`.
 * - /alerts/{alertId}: System alerts, containing `adminId`.
 *
 * Key Security Decisions:
 * - Super Admin status is verified by the existence of a document in the `/roles_super_admin/{superAdminId}` collection.
 * - Access to Admin profiles is restricted to Super Admins only.
 * - Devices are associated with an Admin, and access is restricted to that Admin.
 * - Alerts are associated with an Admin, and access is restricted to that Admin.
 * - `list` operations for devices and alerts are restricted to the associated Admin.
 *
 * Denormalization for Authorization:
 * - The `adminId` field is denormalized into the `Device` and `Alert` documents. This allows the security rules to verify the relationship between the Admin and the Device/Alert, preventing unauthorized access.
 *
 * Structural Segregation:
 * - The use of separate collections for Super Admins, Admins, Devices, and Alerts enforces a clear separation of concerns and simplifies access control.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is from an authenticated user.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user's UID matches the provided userId.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user's UID matches the userId and if the document exists.
     */
    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }

    /**
     * @description Checks if the requesting user is a Super Admin.
     */
    function isSuperAdmin() {
      return exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
    }

    /**
     * @description Checks if the requesting user is an Admin and the adminId matches.
     */
    function isAdminOf(adminId) {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.superAdminId == adminId;
    }

    /**
     * @description
     *  Rules for Super Admin role assignment.
     * @path /roles_super_admin/{superAdminId}
     * @allow (create) User with UID 'user123' creates a document at /roles_super_admin/user123 when authenticated.
     * @deny (create) User with UID 'user123' attempts to create a document at /roles_super_admin/user456 (mismatched UID).
     * @principle Enforces document ownership (self-creation) for Super Admin role assignment.
     */
    match /roles_super_admin/{superAdminId} {
      allow get: if false;
      allow list: if false;
      allow create: if isSignedIn() && isOwner(superAdminId);
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description
     *  Rules for Admin profiles.
     * @path /admins/{adminId}
     * @allow (create) A super admin creates a new admin profile.
     * @deny (update) A regular user attempts to modify an admin profile.
     * @principle Restricts write access to Super Admins only.
     */
    match /admins/{adminId} {
      allow get: if isSuperAdmin();
      allow list: if isSuperAdmin();
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    /**
     * @description
     *  Rules for Device data.
     * @path /devices/{deviceId}
     * @allow (create) An admin creates a new device with their adminId.
     * @allow (update) The admin modifies their own device.
     * @deny (update) An admin attempts to modify another admin's device.
     * @principle Enforces ownership based on the adminId field.
     */
    match /devices/{deviceId} {
      allow get: if isSignedIn() && request.auth.uid == resource.data.adminId;
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.adminId;
      allow update: if isSignedIn() && request.auth.uid == resource.data.adminId;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.adminId;
    }

    /**
     * @description
     *  Rules for Alert data.
     * @path /alerts/{alertId}
     * @allow (create) An admin creates a new alert with their adminId.
     * @allow (update) The admin modifies their own alert.
     * @deny (update) An admin attempts to modify another admin's alert.
     * @principle Enforces ownership based on the adminId field.
     */
    match /alerts/{alertId} {
      allow get: if isSignedIn() && request.auth.uid == resource.data.adminId;
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.adminId;
      allow update: if isSignedIn() && request.auth.uid == resource.data.adminId;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.adminId;
    }
  }
}