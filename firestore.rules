/**
 * @fileoverview Firestore Security Rules for AuthStation.
 *
 * Core Philosophy:
 * This ruleset enforces a role-based access control model for SuperAdmins and an ownership-based access control model for Organizations, Departments, Devices, and Alerts.
 * SuperAdmins can manage Organizations, Departments and Devices.
 *
 * Data Structure:
 * - /roles_super_admin/{superAdminId}: Documents indicating super admin roles.  The document ID is the user's UID.
 * - /organizations/{organizationId}: Documents for organizations. The document ID is the organization's ID.  Organizations are created by SuperAdmins.
 * - /departments/{departmentId}: Documents for departments within organizations.
 * - /devices/{deviceId}: Documents representing IoT devices within departments.
 * - /alerts/{alertId}: Documents for alerts generated by devices.
 *
 * Key Security Decisions:
 * - SuperAdmins are granted broad access to manage organizations, departments, and devices.
 * - Only authenticated users can create, update, or delete documents. Anonymous users are not authorized for write operations.
 * - Data validation is minimal, focusing on relational integrity checks (e.g., creatorId matching the authenticated user's UID) rather than full schema validation.
 * - List operations are generally restricted to owners or SuperAdmins to prevent unauthorized data discovery.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the requesting user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the requesting user's UID matches the provided userId.
     * @param {string} userId - The user ID to compare against the request's authentication UID.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the user is an existing owner of the document.
     * @param {string} userId - The user ID to compare against the request's authentication UID.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Determines if the requesting user is a SuperAdmin.
     * @details Checks for the existence of a document in `/roles_super_admin/{userId}` where the document ID is the user's UID.
     */
    function isSuperAdmin() {
      return exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
    }

    /**
     * @description Rules for documents indicating Super Admin roles.
     * @path /roles_super_admin/{superAdminId}
     * @allow (get) Authenticated user can retrieve their own SuperAdmin record.
     * @allow (list) SuperAdmin can list their own SuperAdmin record.
     * @allow (create) Only a superAdmin can create a SuperAdmin document for themselves.
     * @deny (update) Non SuperAdmin users cannot update SuperAdmin documents.
     * @deny (delete) Non SuperAdmin users cannot delete SuperAdmin documents.
     * @principle Restricts SuperAdmin management to authorized users.
     */
    match /roles_super_admin/{superAdminId} {
      allow get: if isSignedIn() && isOwner(superAdminId);
      allow list: if false;
      allow create: if isSignedIn() && isSuperAdmin() && isOwner(superAdminId);
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Rules for Organization documents.
     * @path /organizations/{organizationId}
     * @allow (get) Any authenticated user can get an organization.
     * @allow (list) SuperAdmins can list all organizations.
     * @allow (create) SuperAdmins can create organizations.
     * @deny (update) Only SuperAdmins can update organizations.
     * @deny (delete) Only SuperAdmins can delete organizations.
     * @principle Enforces SuperAdmin control over organizations.
     */
    match /organizations/{organizationId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && isSuperAdmin();
      allow create: if isSignedIn() && isSuperAdmin();
      allow update: if isSignedIn() && isSuperAdmin();
      allow delete: if isSignedIn() && isSuperAdmin();
    }

    /**
     * @description Rules for Department documents.
     * @path /departments/{departmentId}
     * @allow (get) Any authenticated user can get a department.
     * @allow (list) SuperAdmins can list all departments.
     * @allow (create) SuperAdmins can create departments.
     * @deny (update) Only SuperAdmins can update departments.
     * @deny (delete) Only SuperAdmins can delete departments.
     * @principle Enforces SuperAdmin control over departments.
     */
    match /departments/{departmentId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && isSuperAdmin();
      allow create: if isSignedIn() && isSuperAdmin();
      allow update: if isSignedIn() && isSuperAdmin();
      allow delete: if isSignedIn() && isSuperAdmin();
    }

    /**
     * @description Rules for Device documents.
     * @path /devices/{deviceId}
     * @allow (get) Any authenticated user can get a device.
     * @allow (list) SuperAdmins can list all devices.
     * @allow (create) SuperAdmins can create devices.
     * @deny (update) Only SuperAdmins can update devices.
     * @deny (delete) Only SuperAdmins can delete devices.
     * @principle Enforces SuperAdmin control over devices.
     */
    match /devices/{deviceId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && isSuperAdmin();
      allow create: if isSignedIn() && isSuperAdmin();
      allow update: if isSignedIn() && isSuperAdmin();
      allow delete: if isSignedIn() && isSuperAdmin();
    }

    /**
     * @description Rules for Alert documents.
     * @path /alerts/{alertId}
     * @allow (get) Any authenticated user can get an alert.
     * @allow (list) SuperAdmins can list all alerts.
     * @allow (create) SuperAdmins can create alerts.
     * @deny (update) Only SuperAdmins can update alerts.
     * @deny (delete) Only SuperAdmins can delete alerts.
     * @principle Restricts alert access to SuperAdmins.
     */
    match /alerts/{alertId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && isSuperAdmin();
      allow create: if isSignedIn() && isSuperAdmin();
      allow update: if isSignedIn() && isSuperAdmin();
      allow delete: if isSignedIn() && isSuperAdmin();
    }
  }
}