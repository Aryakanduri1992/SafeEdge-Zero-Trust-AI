/**
 * @file Firestore Security Rules for AuthStation
 * @description This ruleset enforces a strict, hierarchical security model for the AuthStation application.
 *
 * Core Philosophy:
 *  - Strict user-ownership for SuperAdmin and Organization data.
 *  - Departments (Admins) are linked to Organizations via the `organizationId` field.
 *  - Access to Devices and Alerts is controlled through the parent Admin (department).
 *  - Super Admins are granted elevated privileges, specifically the ability to list admins.
 *
 * Data Structure:
 *  - /roles_super_admin/{superAdminId}: Super Admin profiles, linked to Firebase Auth UIDs.
 *  - /organizations/{organizationId}: Organization profiles, each linked to a Firebase Auth UID.
 *  - /admins/{adminId}: Department profiles, linked to the parent organization via `organizationId`.
 *  - /devices/{deviceId}: IoT device data, linked to a department (Admin) via `adminId`.
 *  - /alerts/{alertId}: System alerts generated from devices, linked to a department (Admin) via `adminId`.
 *
 * Key Security Decisions:
 *  - Listing Organizations and Devices is generally disallowed, unless explicitly specified for a Super Admin.
 *  - All write operations are protected by authorization checks to ensure data integrity and prevent unauthorized modifications.
 *  - Data consistency is enforced, particularly for relational fields like `organizationId` in the `/admins` collection.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     * @path N/A
     * @allow N/A
     * @deny N/A
     * @principle Authentication: Requires user to be signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user's UID matches the provided userId.
     * @path N/A
     * @allow N/A
     * @deny N/A
     * @principle Authorization: Enforces user-specific access control.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user's UID matches the provided userId and the document exists.
     * @path N/A
     * @allow N/A
     * @deny N/A
     * @principle Authorization: Combines ownership and existence checks for safer destructive operations.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }
    
    /**
     * @description Defines a super admin role, granting elevated privileges.
     * @path /roles_super_admin/{superAdminId}
     * @allow (get) SuperAdmin user can read their own profile data.
     * @allow (create) SuperAdmin can create their own profile data during signup.
     * @deny (get) Non-SuperAdmin users cannot access SuperAdmin profiles.
     * @deny (update) Non-SuperAdmin users cannot modify SuperAdmin profiles.
     * @principle Enforces document ownership for writes, restricts access to a user's own data tree.
     */
    match /roles_super_admin/{superAdminId} {
      allow get: if isOwner(superAdminId);
      allow list: if false;
      allow create: if isOwner(superAdminId);
      allow update: if isExistingOwner(superAdminId);
      allow delete: if isExistingOwner(superAdminId);
    }

    /**
     * @description Stores primary organization profiles, each linked to a Firebase Auth UID.
     * @path /organizations/{organizationId}
     * @allow (get) Organization can read its own profile data.
     * @allow (create) Organization can create its own profile data during signup.
     * @deny (get) Non-Organization users cannot access Organization profiles.
     * @deny (update) Non-Organization users cannot modify Organization profiles.
     * @principle Enforces document ownership for writes, restricts access to a user's own data tree.
     */
    match /organizations/{organizationId} {
      allow get: if isOwner(organizationId);
      allow list: if false;
      allow create: if isOwner(organizationId) && request.resource.data.id == organizationId;
      allow update: if isExistingOwner(organizationId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(organizationId);
    }

    /**
     * @description Stores department profiles. Each document includes an 'organizationId' to link it to the parent organization's auth account.
     * @path /admins/{adminId}
     * @allow (get) Any authenticated user can read department profiles (public read).
     * @allow (create) Only SuperAdmins can create new department profiles, with 'superAdminId' matching their UID.
     * @allow (update) Only SuperAdmins can update existing department profiles, ensuring the 'superAdminId' remains unchanged.
     * @allow (delete) Only SuperAdmins can delete department profiles.
     * @deny (create) Non-SuperAdmin users cannot create department profiles.
     * @deny (update) Non-SuperAdmin users cannot modify existing department profiles.
     * @principle Enforces document ownership for writes, restricts access to a user's own data tree.
     */
    match /admins/{adminId} {
      allow get: if true;
      allow list: if isSignedIn(); // SuperAdmin access will be handled in code.
      allow create: if isSignedIn() && request.resource.data.superAdminId == request.auth.uid;
      allow update: if isSignedIn() && resource != null && request.resource.data.superAdminId == resource.data.superAdminId;
      allow delete: if isSignedIn() && resource != null;
    }

   /**
     * @description Stores IoT device data, linked to a department (Admin document).
     * @path /devices/{deviceId}
     * @allow (get) Any authenticated user can read device data (public read).
     * @deny (list) Listing devices is not permitted.
     * @allow (create) Only authenticated users can create new device data, ensuring the 'adminId' matches an existing Admin.
     * @allow (update) Only authenticated users can update existing device data, ensuring the 'adminId' remains unchanged.
     * @allow (delete) Only authenticated users can delete device data.
     * @deny (create) Non-authenticated users cannot create device data.
     * @deny (update) Non-authenticated users cannot modify existing device data.
     * @principle Enforces document ownership for writes, restricts access to a user's own data tree.
     */
    match /devices/{deviceId} {
      allow get: if true;
      allow list: if false;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Stores system alerts generated from devices, linked to a department (Admin document).
     * @path /alerts/{alertId}
     * @allow (get) Any authenticated user can read alert data (public read).
     * @deny (list) Listing alerts is not permitted.
     * @allow (create) Only authenticated users can create new alert data, ensuring the 'adminId' matches an existing Admin.
     * @allow (update) Only authenticated users can update existing alert data, ensuring the 'adminId' remains unchanged.
     * @allow (delete) Only authenticated users can delete alert data.
     * @deny (create) Non-authenticated users cannot create alert data.
     * @deny (update) Non-authenticated users cannot modify existing alert data.
     * @principle Enforces document ownership for writes, restricts access to a user's own data tree.
     */
    match /alerts/{alertId} {
      allow get: if true;
      allow list: if false;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }
  }
}