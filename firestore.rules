/**
 * @fileoverview Firestore Security Rules for AuthStation application.
 *
 * Core Philosophy:
 * This ruleset prioritizes secure authorization based on user roles and ownership, while allowing flexible data schemas during prototyping.
 *
 * Data Structure:
 * - /roles_super_admin/{superAdminId}: Stores SuperAdmin role assignments.
 * - /organizations/{organizationId}: Stores organization profiles.
 * - /departments/{departmentId}: Stores department data.
 * - /devices/{deviceId}: Stores device information.
 * - /sensorReadings/{readingId}: Stores sensor data readings.
 *
 * Key Security Decisions:
 * - SuperAdmin role is required for creating/managing Organizations.
 * - Organizations can only be created by a SuperAdmin
 * - Departments and devices are scoped to Organizations and can only be created by users with appropriate roles within that Organization.
 * - Public listing is disabled for all collections containing potentially private data.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user is a SuperAdmin based on their UID.
     */
    function isSuperAdmin(userId) {
      return exists(/databases/$(database)/documents/roles_super_admin/$(userId));
    }

    /**
     * @description Checks if the user is the owner of a resource based on the provided userId.
     */
    function isOwner(userId) {
        return request.auth.uid == userId;
    }

    /**
     * @description Checks if the user is the existing owner of a resource, ensuring the document exists.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }


    /**
     * @description Rules for the roles_super_admin collection.
     * @path /roles_super_admin/{superAdminId}
     * @allow (get) Signed-in user can get their own role document.
     * @allow (create) Only the user themselves can create their own role.
     * @deny (create) Another user attempts to create a role document for someone else.
     * @deny (update) No one can update role documents.
     * @deny (delete) No one can delete role documents.
     * @principle Enforces strict user-ownership and prevents unauthorized role assignment.
     */
    match /roles_super_admin/{superAdminId} {
      allow get: if isSignedIn() && isOwner(superAdminId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(superAdminId) && request.resource.data.id == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Rules for the organizations collection.
     * @path /organizations/{organizationId}
     * @allow (create) A SuperAdmin can create an organization.
     * @deny (create) A non-SuperAdmin attempts to create an organization.
     * @allow (get) Anyone can read an organization.
     * @deny (update) Only a super admin may update the org.
     */
    match /organizations/{organizationId} {
      allow get: if true;
      allow list: if false;
      allow create: if isSignedIn() && isSuperAdmin(request.auth.uid);
      allow update: if isSignedIn() && isSuperAdmin(request.auth.uid);
      allow delete: if false;
    }

    /**
     * @description Rules for the departments collection.
     * @path /departments/{departmentId}
     */
    match /departments/{departmentId} {
        allow get: if true;
        allow list: if false;
        allow create: if isSignedIn();
        allow update: if isSignedIn();
        allow delete: if false;
    }

    /**
     * @description Rules for the devices collection.
     * @path /devices/{deviceId}
     */
    match /devices/{deviceId} {
        allow get: if true;
        allow list: if false;
        allow create: if isSignedIn();
        allow update: if isSignedIn();
        allow delete: if false;
    }

    /**
     * @description Rules for the sensorReadings collection.
     * @path /sensorReadings/{readingId}
     */
    match /sensorReadings/{readingId} {
        allow get: if true;
        allow list: if false;
        allow create: if isSignedIn();
        allow update: if false;
        allow delete: if false;
    }
  }
}