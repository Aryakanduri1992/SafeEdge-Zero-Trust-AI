rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Super admins can read and write to any collection.
    match /{document=**} {
      allow read, write: if request.auth.uid != null && exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
    }

    // Organizations can read their own profile.
    match /organizations/{orgId} {
      allow read, update: if request.auth.uid == orgId;
    }

    // Admins can read departments belonging to their organization.
    match /departments/{deptId} {
      allow read: if request.auth.uid != null && get(/databases/$(database)/documents/departments/$(deptId)).data.organizationId == request.auth.uid;
      allow create: if request.auth.uid != null; // Super admin rule covers this, but explicit for clarity
    }

    // Admins can read and write devices belonging to their organization.
    match /devices/{deviceId} {
      allow read, delete, update: if request.auth.uid != null && get(/databases/$(database)/documents/devices/$(deviceId)).data.organizationId == request.auth.uid;
      allow create: if request.auth.uid != null && request.resource.data.organizationId == request.auth.uid;
    }
  }
}
