/**
 * @file Firestore Security Rules for AuthStation Application
 *
 * Core Philosophy: This ruleset enforces a strict role-based access control system with authorization independence.
 * Super Admins are managed via the `roles_super_admin` collection, and Admins are managed via the `admins` collection.
 * All data is scoped to either Super Admins or regular Admins, ensuring data isolation and preventing unauthorized access.
 *
 * Data Structure:
 * - `/roles_super_admin/{superAdminId}`: Super Admin role assignments. Document existence grants Super Admin privileges.
 * - `/admins/{adminId}`: Admin profiles, containing a `superAdminId` field for tracking the creator.
 * - `/devices/{deviceId}`: IoT device data, linked to an admin account via the `adminId` field.
 * - `/alerts/{alertId}`: System alerts generated from devices, linked to an admin account via the `adminId` field.
 *
 * Key Security Decisions:
 * - Super Admin status is determined solely by the existence of a document in `/roles_super_admin/{superAdminId}`.
 * - Listing of users (admins or super admins) is not explicitly denied.
 * - Authorization Independence: Admin access does NOT depend on the superAdmin document's content.
 *
 * Denormalization for Authorization:
 * - The `adminId` field is present in both `/devices/{deviceId}` and `/alerts/{alertId}` to avoid the need for complex `get()` calls to determine ownership.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants Super Admin role based on document existence.
     * @path /roles_super_admin/{superAdminId}
     * @allow (create) User with UID 'superAdmin123' creates a document at /roles_super_admin/superAdmin123.
     * @deny (create) User with UID 'notSuperAdmin' tries to create a document at /roles_super_admin/superAdmin123.
     * @principle Implements role-based access control, granting Super Admin privileges based on document existence.
     */
    match /roles_super_admin/{superAdminId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn() && request.auth.uid == superAdminId;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Manages Admin profiles, linked to a Super Admin.
     * @path /admins/{adminId}
     * @allow (create) Super Admin creates an Admin profile.
     * @deny (update) Non-Super Admin attempts to update an Admin profile.
     * @principle Enforces Super Admin control over Admin profile creation and ensures authorization independence.
     */
    match /admins/{adminId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && isAdmin();
      allow create: if isSignedIn() && isSuperAdmin() && request.resource.data.superAdminId == request.auth.uid && request.resource.data.id == adminId;
      allow update: if isSignedIn() && isSuperAdmin() && resource.data.superAdminId == request.auth.uid && resource.data.id == request.resource.data.id;
      allow delete: if isSignedIn() && isSuperAdmin() && resource.data.superAdminId == request.auth.uid;
    }

    /**
     * @description Manages IoT device data, linked to an admin account.
     * @path /devices/{deviceId}
     * @allow (create) Admin creates a new device.
     * @deny (update) Unauthorized user attempts to modify device data.
     * @principle Enforces Admin-level ownership of device data.
     */
    match /devices/{deviceId} {
      allow get: if isSignedIn() && isAdminForDevice(deviceId);
      allow list: if isSignedIn() && isAdmin();
      allow create: if isSignedIn() && isAdmin() && request.resource.data.adminId == request.auth.uid && request.resource.data.id == deviceId;
      allow update: if isSignedIn() && isAdminForDevice(deviceId) && resource.data.adminId == request.auth.uid && resource.data.id == request.resource.data.id;
      allow delete: if isSignedIn() && isAdminForDevice(deviceId) && resource.data.adminId == request.auth.uid;
    }

    /**
     * @description Manages system alerts generated from devices, linked to an admin account.
     * @path /alerts/{alertId}
     * @allow (create) System creates a new alert.
     * @deny (delete) Unauthorized user attempts to delete an alert.
     * @principle Enforces Admin-level ownership of alert data.
     */
    match /alerts/{alertId} {
      allow get: if isSignedIn() && isAdminForAlert(alertId);
      allow list: if isSignedIn() && isAdmin();
      allow create: if isSignedIn() && isAdmin() && request.resource.data.adminId == request.auth.uid && request.resource.data.id == alertId;
      allow update: if isSignedIn() && isAdminForAlert(alertId) && resource.data.adminId == request.auth.uid && resource.data.id == request.resource.data.id;
      allow delete: if isSignedIn() && isAdminForAlert(alertId) && resource.data.adminId == request.auth.uid;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
    }

    function isAdmin() {
        return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.id == request.auth.uid;
    }

    function isAdminForDevice(deviceId) {
        return get(/databases/$(database)/documents/devices/$(deviceId)).data.adminId == request.auth.uid;
    }

     function isAdminForAlert(alertId) {
          return get(/databases/$(database)/documents/alerts/$(alertId)).data.adminId == request.auth.uid;
    }
  }
}