/**
 * @file Firestore Security Rules for AuthStation application.
 *
 * Core Philosophy:
 * This ruleset enforces a role-based access control model for super admins and an ownership model for organizations and their related data (departments, devices).
 * Super admins, as defined in the `roles_super_admin` collection, have elevated privileges.
 * Each organization is managed independently.
 *
 * Data Structure:
 * - /roles_super_admin/{superAdminId}: Documents identifying super admins.
 * - /organizations/{organizationId}: Documents storing organization information.
 * - /departments/{departmentId}: Documents storing department information, linked to an organization.
 * - /devices/{deviceId}: Documents storing device information, linked to a department and organization.
 *
 * Key Security Decisions:
 * - Super admins are granted broad read access and create permissions.
 * - Organizations are secured via ownership: only the creating super admin can modify them.
 * - Departments and Devices inherit organizational ownership for data access.
 * - Listing users is disallowed.
 *
 * Denormalization for Authorization:
 *  - The `Department` entity contains `organizationId` and `superAdminId`, enabling direct authorization checks without requiring additional `get()` calls.
 *  - The `Device` entity contains `organizationId` and `departmentId`, enabling direct authorization checks without requiring additional `get()` calls.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description: Controls access to the super admin role assignments.
     * @path: /roles_super_admin/{superAdminId}
     * @allow: (get, list) request.auth != null; allows any authenticated user to check for super admin status.
     * @allow: (create) request.auth != null && request.resource.data.id == request.auth.uid; allows a user to create their own super admin role IF the ID matches their UID
     * @deny: (update, delete) if true; prevents modification or deletion of super admin roles through direct client requests.
     * @principle: Role-based access control, self-creation.
     */
    match /roles_super_admin/{superAdminId} {
      allow get: if isSignedIn();
      allow list: if false; // Listing all Super Admins is not permitted

      allow create: if isSignedIn() && request.auth.uid == superAdminId;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description: Controls access to organization profiles.
     * @path: /organizations/{organizationId}
     * @allow: (get, list) if isSignedIn(); allows any authenticated user to read all organizations
     * @allow: (create) if isSignedIn() && request.resource.data.superAdminId == request.auth.uid; allows creation if the superAdminId matches the authenticated user.
     * @allow: (update, delete) if isExistingOwner(resource.data.superAdminId); only the super admin who created the organization can modify/delete.
     * @deny: (create) if request.resource.data.superAdminId != request.auth.uid; prevents creating an organization with mismatched super admin ID.
     * @principle: Ownership-based access control, enforced on writes.
     */
    match /organizations/{organizationId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();

      allow create: if isSignedIn() && request.resource.data.superAdminId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.superAdminId) && request.resource.data.superAdminId == resource.data.superAdminId;
      allow delete: if isExistingOwner(resource.data.superAdminId);
    }

    /**
     * @description: Controls access to department profiles.
     * @path: /departments/{departmentId}
     * @allow: (get, list) if isSignedIn(); allows any authenticated user to read all departments
     * @allow: (create) if isSignedIn() && request.resource.data.superAdminId == request.auth.uid; allows creation if the superAdminId matches the authenticated user.
     * @allow: (update, delete) if isExistingOwner(resource.data.superAdminId); only the super admin who created the department can modify/delete.
     * @deny: (create) if request.resource.data.superAdminId != request.auth.uid; prevents creating a department with mismatched super admin ID.
     * @principle: Ownership-based access control, enforced on writes.
     */
    match /departments/{departmentId} {
        allow get: if isSignedIn();
        allow list: if isSignedIn();

        allow create: if isSignedIn() && request.resource.data.superAdminId == request.auth.uid;
        allow update: if isExistingOwner(resource.data.superAdminId) && request.resource.data.superAdminId == resource.data.superAdminId;
        allow delete: if isExistingOwner(resource.data.superAdminId);
    }

    /**
     * @description: Controls access to device profiles.
     * @path: /devices/{deviceId}
     * @allow: (get, list) if isSignedIn(); allows any authenticated user to read all devices
     * @allow: (create) if isSignedIn(); allows a signed-in user to create a device.
     * @allow: (update, delete) if isExistingDeviceOwner(resource.data.departmentId, resource.data.organizationId); only the super admin who created the organization can modify/delete the device.
     * @principle: Ownership-based access control, enforced on writes.
     */
    match /devices/{deviceId} {
        allow get: if isSignedIn();
        allow list: if isSignedIn();

        allow create: if isSignedIn();
        allow update: if isSignedIn() && isExistingDeviceOwner(resource.data.departmentId, resource.data.organizationId);
        allow delete: if isSignedIn() && isExistingDeviceOwner(resource.data.departmentId, resource.data.organizationId);
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return isSignedIn() && isOwner(userId) && resource != null;
    }

    function isExistingDeviceOwner(departmentId, organizationId) {
      return get(/databases/$(database)/documents/departments/$(departmentId)).data.organizationId == organizationId;
    }
  }
}