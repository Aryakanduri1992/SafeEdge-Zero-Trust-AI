/**
 * @description This ruleset enforces a strict role-based access control model for the AuthStation application.
 * Super Admins, identified by their presence in the `/roles_super_admin` collection, have elevated privileges.
 * Admins are linked to Super Admins via the `superAdminId` field in their profile documents.
 * Data is segregated to ensure admins can only access data related to their accounts.
 * @dataStructure
 * - `/roles_super_admin/{superAdminId}`: Indicates a Firebase Auth user is a Super Admin.
 * - `/admins/{adminId}`: Stores Admin profiles, including a `superAdminId` field.
 * - `/devices/{deviceId}`: Stores IoT device data, linked to an admin account via `adminId`.
 * - `/alerts/{alertId}`: Stores system alerts, linked to an admin account via `adminId`.
 * @keySecurityDecisions
 * - Super Admin status is determined by the existence of a document in `/roles_super_admin/{superAdminId}`.
 * - Authorization Independence is enforced, avoiding `get()` calls in security rules.
 * - Admins can only `list` devices and alerts associated with their `adminId`.
 * @denormalizationForAuthorization
 * - Super Admin status is checked by the presence of a document in `/roles_super_admin/{superAdminId}`, which avoids the need to read any data from a super admin document.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user's UID matches the provided userId.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user's UID matches the provided userId and the resource exists.
     */
    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }

    /**
     * @description Rule for Super Admin role documents.
     * @path /roles_super_admin/{superAdminId}
     * @allow (create) If the authenticated user's UID matches the document ID, allowing self-creation of the role.
     * @deny (create) If the authenticated user's UID does not match the document ID.
     * @deny (update, delete) Always deny updates and deletes, as the presence of the document is the role indicator.
     * @principle Enforces role-based access control, restricting super admin role assignment.
     */
    match /roles_super_admin/{superAdminId} {
      allow get: if false;
      allow list: if false;

      allow create: if isOwner(superAdminId);
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Rules for Admin documents.
     * @path /admins/{adminId}
     * @allow (create) If the request is made by a Super Admin.
     * @allow (get, list) Public read access to admin profiles.
     * @allow (update, delete) If the request is made by a Super Admin.
     * @deny (update) If the `superAdminId` field is being changed.
     * @principle Enforces role-based access control and prevents unauthorized modification of admin profiles.
     */
    match /admins/{adminId} {
      allow get, list: if true;

      allow create: if isSignedIn() && exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
      allow update: if isExistingOwner(request.auth.uid) && exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
      allow delete: if isExistingOwner(request.auth.uid) && exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
    }

   /**
     * @description Rules for Device documents.
     * @path /devices/{deviceId}
     * @allow (get, list) Allow anyone to read any device data.
     * @allow (create) If the request is made by an authenticated user.
     * @allow (update, delete) If the request is made by the admin who owns the device.
     * @principle Enforces device ownership and allows public read access.
     */
    match /devices/{deviceId} {
      allow get, list: if true;

      allow create: if isSignedIn();
      allow update: if isExistingOwner(resource.data.adminId);
      allow delete: if isExistingOwner(resource.data.adminId);
    }

    /**
     * @description Rules for Alert documents.
     * @path /alerts/{alertId}
     * @allow (get, list) Allow anyone to read any alert data.
     * @allow (create) If the request is made by an authenticated user.
     * @allow (update, delete) If the request is made by the admin who owns the alert.
     * @principle Enforces alert ownership and allows public read access.
     */
    match /alerts/{alertId} {
      allow get, list: if true;

      allow create: if isSignedIn();
      allow update: if isExistingOwner(resource.data.adminId);
      allow delete: if isExistingOwner(resource.data.adminId);
    }
  }
}