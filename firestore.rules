/**
 * @file Firebase Security Rules for AuthStation.
 *
 * @core_philosophy This ruleset enforces a role-based access control model,
 *  primarily using the `roles_super_admin` collection to grant super admin privileges.
 *  Organizations, Departments, and Devices are secured based on the authenticated
 *  user's role and ownership/relationship to the data.
 *
 * @data_structure
 * - /roles_super_admin/{superAdminId}:  Documents identifying Super Admins.
 * - /organizations/{organizationId}: Organization profile information.
 * - /departments/{departmentId}: Department information for all organizations.
 * - /devices/{deviceId}: Information about individual devices.
 *
 * @key_security_decisions
 * - Super Admins are granted broad access to Organizations, Departments, and Devices.
 * - Organizations can only be created by a Super Admin.
 * - Departments and Devices are linked to Organizations via `organizationId` and can be managed by Super Admins.
 * - Data validation is relaxed in this prototype to enable rapid iteration. However,
 *   authorization checks are strictly enforced.
 *
 * @denormalization_for_authorization
 *   The `Organization`, `Department`, and `Device` schemas include the `superAdminId`, and `organizationId`,
 *   fields. These fields are used to authorize operations based on the Super Admin's role and the relationships between entities.
 *   This design avoids costly `get()` operations in the security rules.
 *   These fields will be validated for relational integrity on `create` operations.
 *
 * @structural_segregation Not applicable in this configuration. All collections store finalized data.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user's UID matches the provided userId.
     * @param {string} userId - The user ID to compare against the authenticated user's UID.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user is a Super Admin by verifying their UID exists in the roles_super_admin collection.
     * @param {string} superAdminId - The superAdminId to check against the authenticated user's UID.
     */
    function isSuperAdmin(superAdminId) {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_super_admin/$(superAdminId));
    }

     /**
      * @description Checks if the user is a super admin based on the organization's superAdminId.
      * @param {string} superAdminId - The superAdminId to check against the authenticated user's UID.
      */
    function isOrgSuperAdmin(superAdminId) {
      return isSignedIn() && request.auth.uid == superAdminId;
    }

    /**
     * @description Checks if the user is a super admin based on the organization's superAdminId and the document exists.
     * @param {string} superAdminId - The superAdminId to check against the authenticated user's UID.
     */
    function isExistingOrgSuperAdmin(superAdminId) {
      return isOrgSuperAdmin(superAdminId) && resource != null;
    }

    /**
     * @description Security rules for the roles_super_admin collection.
     * @path /roles_super_admin/{superAdminId}
     * @allow (get) Authenticated user can read their own super admin record.
     *    Request: auth.uid = "user123", path = "/roles_super_admin/user123"
     * @allow (create) Authenticated user can create their own super admin record if the ID matches.
     *    Request: auth.uid = "user123", path = "/roles_super_admin/user123", data.id = "user123"
     * @deny (get) Authenticated user tries to read another user's super admin record.
     *    Request: auth.uid = "user123", path = "/roles_super_admin/user456"
     * @deny (update) Non-SuperAdmin tries to update a SuperAdmin record.
     *    Request: auth.uid = "nonAdmin", path = "/roles_super_admin/superAdmin", data.email = "newemail@example.com"
     * @principle Enforces document ownership and prevents unauthorized access to super admin roles.
     */
    match /roles_super_admin/{superAdminId} {
      allow get: if isOwner(superAdminId);
      allow list: if false;
      allow create: if isOwner(superAdminId) && request.resource.data.id == superAdminId;
      allow update, delete: if false;
    }

    /**
     * @description Security rules for the organizations collection.
     * @path /organizations/{organizationId}
     * @allow (get) Anyone can read organization data.
     *    Request: auth.uid = null, path = "/organizations/org123"
     * @allow (create) A Super Admin can create an organization.  The `superAdminId` must match their UID.
     *    Request: auth.uid = "superAdmin123", path = "/organizations/org456", data.superAdminId = "superAdmin123"
     * @allow (update) A Super Admin can update an organization they own.
     *    Request: auth.uid = "superAdmin123", path = "/organizations/org456", data.organizationName = "New Org Name"
     * @allow (delete) A Super Admin can delete an organization they own.
     *    Request: auth.uid = "superAdmin123", path = "/organizations/org456"
     * @deny (create) A non-Super Admin attempts to create an organization.
     *    Request: auth.uid = "user123", path = "/organizations/org456"
     * @deny (update) A non-Super Admin attempts to update an organization.
     *    Request: auth.uid = "user123", path = "/organizations/org456"
     * @principle Allows public read access while enforcing Super Admin ownership for write operations.
     */
    match /organizations/{organizationId} {
        allow get, list: if true;
        allow create: if isSignedIn() && isSuperAdmin(request.resource.data.superAdminId);
        allow update: if isExistingOrgSuperAdmin(resource.data.superAdminId);
        allow delete: if isExistingOrgSuperAdmin(resource.data.superAdminId);
    }

    /**
     * @description Security rules for the departments collection.
     * @path /departments/{departmentId}
     * @allow (get) Anyone can read department data.
     *    Request: auth.uid = null, path = "/departments/dept123"
     * @allow (create) A Super Admin can create a department for an organization they own. The `organizationId` must match an existing organization, and the superAdminId must match the organization's superAdminId.
     *    Request: auth.uid = "superAdmin123", path = "/departments/dept456", data.organizationId = "org456", data.superAdminId = "superAdmin123"
     * @allow (update) A Super Admin can update a department that belongs to an organization they own.
     *    Request: auth.uid = "superAdmin123", path = "/departments/dept456", data.departmentName = "New Dept Name"
     * @allow (delete) A Super Admin can delete a department that belongs to an organization they own.
     *    Request: auth.uid = "superAdmin123", path = "/departments/dept456"
     * @deny (create) A non-Super Admin attempts to create a department.
     *    Request: auth.uid = "user123", path = "/departments/dept456"
     * @deny (update) A non-Super Admin attempts to update a department.
     *    Request: auth.uid = "user123", path = "/departments/dept456"
     * @principle Allows public read access while enforcing Super Admin ownership for write operations.
     */
    match /departments/{departmentId} {
      allow get, list: if true;
      allow create: if isSignedIn() && isSuperAdmin(request.resource.data.superAdminId) && get(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)).data.superAdminId == request.auth.uid;
      allow update: if isSignedIn() && isSuperAdmin(resource.data.superAdminId) && get(/databases/$(database)/documents/organizations/$(resource.data.organizationId)).data.superAdminId == request.auth.uid && resource != null;
      allow delete: if isSignedIn() && isSuperAdmin(resource.data.superAdminId) && get(/databases/$(database)/documents/organizations/$(resource.data.organizationId)).data.superAdminId == request.auth.uid && resource != null;
    }

    /**
     * @description Security rules for the devices collection.
     * @path /devices/{deviceId}
     * @allow (get) Anyone can read device data.
     *    Request: auth.uid = null, path = "/devices/device123"
     * @allow (create) A Super Admin can create a device for an organization they own. The `organizationId` must match an existing organization, and the superAdminId must match the organization's superAdminId.
     *    Request: auth.uid = "superAdmin123", path = "/devices/device456", data.organizationId = "org456"
     * @allow (update) A Super Admin can update a device that belongs to an organization they own.
     *    Request: auth.uid = "superAdmin123", path = "/devices/device456", data.name = "New Device Name"
     * @allow (delete) A Super Admin can delete a device that belongs to an organization they own.
     *    Request: auth.uid = "superAdmin123", path = "/devices/device456"
     * @deny (create) A non-Super Admin attempts to create a device.
     *    Request: auth.uid = "user123", path = "/devices/device456"
     * @deny (update) A non-Super Admin attempts to update a device.
     *    Request: auth.uid = "user123", path = "/devices/device456"
     * @principle Allows public read access while enforcing Super Admin ownership for write operations.
     */
    match /devices/{deviceId} {
      allow get, list: if true;
      allow create: if isSignedIn() && isSuperAdmin(get(/databases/$(database)/documents/departments/$(request.resource.data.departmentId)).data.superAdminId) && get(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)).data.superAdminId == request.auth.uid;
      allow update: if isSignedIn() && isSuperAdmin(get(/databases/$(database)/documents/departments/$(resource.data.departmentId)).data.superAdminId) && get(/databases/$(database)/documents/organizations/$(resource.data.organizationId)).data.superAdminId == request.auth.uid && resource != null;
      allow delete: if isSignedIn() && isSuperAdmin(get(/databases/$(database)/documents/departments/$(resource.data.departmentId)).data.superAdminId) && get(/databases/$(database)/documents/organizations/$(resource.data.organizationId)).data.superAdminId == request.auth.uid && resource != null;
    }
  }
}