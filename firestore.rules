/**
 * @file Firestore Security Rules for AuthStation Application
 *
 * @description This ruleset enforces a role-based access control model for the AuthStation application.
 * Super Admins and Admins have different levels of access, with data isolation between different admin accounts.
 *
 * @dataStructure
 * - `/roles_super_admin/{superAdminId}`: Documents indicate Super Admin role.
 * - `/admins/{adminId}`: Admin user profiles, linked to a Super Admin via `superAdminId`.
 * - `/devices/{deviceId}`: IoT device data, linked to an Admin via `adminId`.
 * - `/alerts/{alertId}`: System alerts generated by devices, linked to an Admin via `adminId`.
 *
 * @keySecurityDecisions
 * - Super Admin role is determined by the existence of a document in `/roles_super_admin/{superAdminId}`.
 * - Authorization Independence: Admin document access does NOT depend on Super Admin document content.
 * - Admins can only access devices and alerts associated with their `adminId`.
 * - Listing of the alerts collection is only allowed for signed in users.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user's UID matches the provided user ID.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the user is an existing owner.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Determines if the user has a super admin role.
     * @details This function checks if a document exists in the /roles_super_admin/{userId} collection.
     */
    function isSuperAdmin() {
      return exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
    }

    /**
     * @description Rules for the Super Admin role collection.
     * @path /roles_super_admin/{superAdminId}
     * @allow (create) User with UID 'user123' creates a document at /roles_super_admin/user123.
     * @deny (create) User with UID 'user456' tries to create a document at /roles_super_admin/user123.
     * @principle Enforces role-based access control for Super Admins. Only the user with the matching UID can create their role document.
     */
    match /roles_super_admin/{superAdminId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn() && isOwner(superAdminId);
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Rules for the Admins collection.
     * @path /admins/{adminId}
     * @allow (create) A Super Admin creates a new Admin profile.
     * @allow (update) An Admin updates their own profile.
     * @deny (create) A regular user tries to create an Admin profile.
     * @principle Enforces role-based access control for Admin profiles. Super Admins can create, and Admins can manage their profiles.
     */
    match /admins/{adminId} {
      allow get: if isSignedIn();
      allow list: if isSuperAdmin();
      allow create: if isSuperAdmin();
      allow update: if isExistingOwner(adminId);
      allow delete: if false;
    }

    /**
     * @description Rules for the Devices collection.
     * @path /devices/{deviceId}
     * @allow (create) An Admin creates a new Device, with the correct `adminId`.
     * @allow (update) An Admin updates a Device they own.
     * @deny (create) A user tries to create a Device with an `adminId` that doesn't match their own.
     * @principle Enforces data ownership for Devices, ensuring only the owning Admin can modify them.
     */
    match /devices/{deviceId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.adminId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.adminId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.adminId == request.auth.uid && resource != null;
    }

    /**
     * @description Rules for the Alerts collection.
     * @path /alerts/{alertId}
     * @allow (create) The system creates a new Alert with the correct `adminId`.
     * @allow (get) An admin gets an alert with their own adminId
     * @deny (create) A user tries to create an Alert with an `adminId` that doesn't match their own.
     * @principle Enforces data ownership for Alerts, ensuring only the owning Admin can access them.
     */
    match /alerts/{alertId} {
      allow get: if isSignedIn() && resource.data.adminId == request.auth.uid;
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.adminId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }
  }
}