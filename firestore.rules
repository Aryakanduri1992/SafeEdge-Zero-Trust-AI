/**
 * @description This ruleset enforces a strict ownership model for super admins, organizations, departments and devices.
 * Super admins are managed via a dedicated 'roles_super_admin' collection.
 * All reads and writes are restricted to authenticated users.
 *
 * @dataStructure
 * - /roles_super_admin/{superAdminId}: Stores SuperAdmin profile documents, accessible only to the super admin themselves.
 * - /organizations/{organizationId}: Stores Organization profile documents, accessible only to the super admin that created them.
 * - /departments/{departmentId}: Stores Department data, accessible only to the super admin of the organization.
 * - /devices/{deviceId}: Stores Device data, accessible only to the super admin of the organization.
 *
 * @keySecurityDecisions
 * - Listing of users is disallowed.
 * - Super admin can only manage their own organization, department and devices.
 * - Flexible data validation is enabled for rapid prototyping, focusing on authorization.
 *
 * @denormalizationForAuthorization
 * - Each document should contain fields like 'superAdminId' to avoid costly 'get()' calls in security rules.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Manages SuperAdmin role documents. Only the user with the matching UID can read or write.
     * @path /roles_super_admin/{superAdminId}
     * @allow (get, create, update, delete) - Authenticated user with UID matching the superAdminId.
     * @deny (get, create, update, delete) - Any other user.
     * @principle Enforces document ownership for all operations.
     */
    match /roles_super_admin/{superAdminId} {
      function isOwner(superAdminId) {
        return request.auth.uid == superAdminId;
      }
      function isExistingOwner(superAdminId) {
          return request.auth.uid == resource.data.uid;
      }
      allow get: if isOwner(superAdminId);
      allow list: if false;
      allow create: if isOwner(superAdminId);
      allow update: if isOwner(superAdminId);
      allow delete: if isOwner(superAdminId);
    }

    /**
     * @description Manages Organization profile documents. Only the super admin that created the organization can read or write.
     * @path /organizations/{organizationId}
     * @allow (create) - Authenticated user creating a new organization with their UID as superAdminId.
     * @allow (get, update, delete) - Authenticated user with UID matching the organization's superAdminId.
     * @deny (get, create, update, delete) - Any other user.
     * @principle Enforces document ownership for writes and prevents unauthorized modifications.
     */
    match /organizations/{organizationId} {
      function isOwner(superAdminId) {
        return request.auth.uid == superAdminId;
      }
      function isExistingOwner(superAdminId) {
          return request.auth.uid == resource.data.superAdminId;
      }
      allow get: if isExistingOwner(resource.data.superAdminId);
      allow list: if false;
      allow create: if request.auth.uid == request.resource.data.superAdminId;
      allow update: if isExistingOwner(resource.data.superAdminId);
      allow delete: if isExistingOwner(resource.data.superAdminId);
    }

    /**
     * @description Manages Department documents. Only the super admin of the associated organization can read or write.
     * @path /departments/{departmentId}
     * @allow (create) - Authenticated user creating a new department with their UID matching the organization's superAdminId.
     * @allow (get, update, delete) - Authenticated user with UID matching the department's organization's superAdminId.
     * @deny (get, create, update, delete) - Any other user.
     * @principle Enforces organization-level ownership for departments.
     */
    match /departments/{departmentId} {
      function isOwner(superAdminId) {
        return request.auth.uid == superAdminId;
      }
        function isExistingOwner(superAdminId) {
          return request.auth.uid == resource.data.superAdminId;
      }
      allow get: if isExistingOwner(resource.data.superAdminId);
      allow list: if false;
      allow create: if request.auth.uid == request.resource.data.superAdminId;
      allow update: if isExistingOwner(resource.data.superAdminId);
      allow delete: if isExistingOwner(resource.data.superAdminId);
    }

    /**
     * @description Manages Device documents. Only the super admin of the associated organization can read or write.
     * @path /devices/{deviceId}
     * @allow (create) - Authenticated user creating a new device with their UID matching the organization's superAdminId.
     * @allow (get, update, delete) - Authenticated user with UID matching the device's organization's superAdminId.
     * @deny (get, create, update, delete) - Any other user.
     * @principle Enforces organization-level ownership for devices.
     */
    match /devices/{deviceId} {
       function isOwner(superAdminId) {
        return request.auth.uid == superAdminId;
      }
        function isExistingOwner(superAdminId) {
          return request.auth.uid == resource.data.superAdminId;
      }
      allow get: if isExistingOwner(resource.data.superAdminId);
      allow list: if false;
      allow create: if request.auth.uid == request.resource.data.superAdminId;
      allow update: if isExistingOwner(resource.data.superAdminId);
      allow delete: if isExistingOwner(resource.data.superAdminId);
    }
  }
}