/**
 * @fileoverview Firestore Security Rules for AuthStation application.
 *
 * Core Philosophy:
 * This ruleset enforces a role-based access control model, primarily leveraging the existence of documents in specific collections
 * to grant elevated privileges. It also ensures that admins can only manage data (devices, alerts) associated with their own accounts.
 *
 * Data Structure:
 * - /roles_super_admin/{superAdminId}: Indicates a Firebase Auth user is a Super Admin.
 * - /admins/{adminId}: Stores Admin profiles, linked to a Super Admin via 'superAdminId'.
 * - /devices/{deviceId}: Stores IoT device data, linked to an admin account.
 * - /alerts/{alertId}: Stores system alerts, linked to an admin account.
 *
 * Key Security Decisions:
 * - Super Admin privileges are granted solely based on the existence of a document in `/roles_super_admin/{superAdminId}`.
 * - Authorization Independence is maintained by avoiding `get()` calls and denormalizing authorization data (e.g., `adminId` in alerts).
 * - Admins can only access devices and alerts associated with their `adminId`.
 * - Listing all users or all devices is disallowed. Only listing alerts is allowed, but only for admins.
 *
 * Denormalization for Authorization:
 * - The `alerts` and `devices` collections include an `adminId` field, which is used to restrict access to each admin's own data. This avoids costly `get()` calls to retrieve the admin's ID and compares against request.auth.uid.
 *
 * Structural Segregation:
 * - Global roles are implemented using dedicated collections (`/roles_super_admin/{uid}`), enabling simple existence checks for authorization.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user's UID matches the provided userId.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user's UID matches the resource's userId and that the resource exists.
     */
    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }

    /**
     * @description Checks if a super admin role document exists for the requesting user.
     */
    function isSuperAdmin() {
      return exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
    }

    /**
     * @description
     *  Rules for the super admin role. A user is a super admin if a document exists under /roles_super_admin/{superAdminId}
     *  This allows super admins to self-declare themselves as a super admin.
     * @path /roles_super_admin/{superAdminId}
     * @allow (create) User with UID 'user123' can create the document /roles_super_admin/user123 if authenticated.
     * @deny (create) User with UID 'user123' cannot create the document /roles_super_admin/user456.
     * @principle Enforces role-based access control; only allows creating a super admin role for the authenticated user.
     */
    match /roles_super_admin/{superAdminId} {
      allow get: if false;
      allow list: if false;
      allow create: if isSignedIn() && isOwner(superAdminId);
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description
     *  Rules for the admins collection. Admins can be created by super admins.
     * @path /admins/{adminId}
     * @allow (create) A super admin can create an admin profile.
     * @deny (create) A regular user cannot create an admin profile.
     * @principle Enforces role-based access control; only super admins can create admin profiles.
     */
    match /admins/{adminId} {
      allow get: if false;
      allow list: if false;
      allow create: if isSuperAdmin();
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description
     *  Rules for the devices collection. Devices can be created, updated, and deleted only by admins.
     *  Admins can only manage devices associated with their adminId.
     * @path /devices/{deviceId}
     * @allow (create) An admin can create a device with their adminId.
     * @allow (update) An admin can update a device with their adminId if the device exists.
     * @allow (delete) An admin can delete a device with their adminId if the device exists.
     * @deny (create) A user cannot create a device with an incorrect adminId.
     * @principle Enforces ownership; only admins can manage their own devices.
     */
    match /devices/{deviceId} {
        allow get: if false;
        allow list: if false;
        allow create: if isSignedIn() && request.resource.data.adminId == request.auth.uid;
        allow update: if isExistingOwner(resource.data.adminId) && request.resource.data.adminId == resource.data.adminId;
        allow delete: if isExistingOwner(resource.data.adminId);
    }

    /**
     * @description
     *  Rules for the alerts collection. Alerts can be created and managed only by admins.
     *  Admins can only manage alerts associated with their adminId.
     * @path /alerts/{alertId}
     * @allow (create) An admin can create an alert with their adminId.
     * @allow (list) An admin can list alerts associated with their adminId.
     * @allow (update) An admin can update an alert with their adminId if the alert exists.
     * @allow (delete) An admin can delete an alert with their adminId if the alert exists.
     * @deny (create) A user cannot create an alert with an incorrect adminId.
     * @principle Enforces ownership; only admins can manage their own alerts.
     */
    match /alerts/{alertId} {
      allow get: if false;
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.adminId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.adminId) && request.resource.data.adminId == resource.data.adminId;
      allow delete: if isExistingOwner(resource.data.adminId);
    }
  }
}