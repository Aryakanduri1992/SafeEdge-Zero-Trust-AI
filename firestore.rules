/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a role-based access control model with a super admin.
 *
 * Data Structure:
 * - /roles_super_admin/{superAdminId}: Documents identifying super admins.
 * - /organizations/{organizationId}: Organization profile information.
 * - /departments/{departmentId}: Department information for organizations.
 * - /devices/{deviceId}: Device information.
 *
 * Key Security Decisions:
 * - Super admins are identified by the presence of a document in `/roles_super_admin/{superAdminId}`.
 * - Organizations can only be created by super admins.
 * - Departments can only be created by super admins.
 * - Devices can only be created by super admins.
 * - No public listing of any collections is allowed.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the current user is signed in.
     * @return {boolean} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the current user is a super admin.
     * @return {boolean} True if the user is a super admin, false otherwise.
     */
    function isSuperAdmin() {
      return exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
    }

    /**
     * @description Checks if the provided userId matches the request's authentication UID.
     * @param {string} userId - The user ID to compare against the request's auth UID.
     * @return {boolean} True if the user ID matches the request's auth UID, false otherwise.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the user is the owner of the existing document.
     * @param {string} userId - The user ID to compare against the resource's data.
     * @return {boolean} True if the user is the owner and the resource exists, false otherwise.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Security rules for super admin roles.
     * @path /roles_super_admin/{superAdminId}
     * @allow (create) - A user can create their own super admin document if their UID matches the superAdminId.
     * @allow (get) - Any authenticated user can get a super admin document.
     * @allow (list) - Any authenticated user can list super admin documents.
     * @allow (update) - Only the super admin can update their own document.
     * @allow (delete) - Only the super admin can delete their own document.
     * @deny (create) - A user cannot create a super admin document for another user.
     * @deny (update) - A user cannot update another user's super admin document.
     * @deny (delete) - A user cannot delete another user's super admin document.
     * @principle Enforces document ownership for super admin roles.
     */
    match /roles_super_admin/{superAdminId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isOwner(superAdminId);
      allow update: if isExistingOwner(superAdminId);
      allow delete: if isExistingOwner(superAdminId);
    }

    /**
     * @description Security rules for organizations.
     * @path /organizations/{organizationId}
     * @allow (create) - Only a super admin can create an organization.
     * @allow (get) - Any authenticated user can get an organization document.
     * @allow (list) - Any authenticated user can list organization documents.
     * @allow (update) - Only a super admin can update an organization.
     * @allow (delete) - Only a super admin can delete an organization.
     * @deny (create) - A non-super admin cannot create an organization.
     * @deny (update) - A non-super admin cannot update an organization.
     * @deny (delete) - A non-super admin cannot delete an organization.
     * @principle Enforces super admin control over organizations.
     */
    match /organizations/{organizationId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    /**
     * @description Security rules for departments.
     * @path /departments/{departmentId}
     * @allow (create) - Only a super admin can create a department.
     * @allow (get) - Any authenticated user can get a department document.
     * @allow (list) - Any authenticated user can list department documents.
     * @allow (update) - Only a super admin can update a department.
     * @allow (delete) - Only a super admin can delete a department.
     * @deny (create) - A non-super admin cannot create a department.
     * @deny (update) - A non-super admin cannot update a department.
     * @deny (delete) - A non-super admin cannot delete a department.
     * @principle Enforces super admin control over departments.
     */
    match /departments/{departmentId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    /**
     * @description Security rules for devices.
     * @path /devices/{deviceId}
     * @allow (create) - Only a super admin can create a device.
     * @allow (get) - Any authenticated user can get a device document.
     * @allow (list) - Any authenticated user can list device documents.
     * @allow (update) - Only a super admin can update a device.
     * @allow (delete) - Only a super admin can delete a device.
     * @deny (create) - A non-super admin cannot create a device.
     * @deny (update) - A non-super admin cannot update a device.
     * @deny (delete) - A non-super admin cannot delete a device.
     * @principle Enforces super admin control over devices.
     */
    match /devices/{deviceId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }
  }
}