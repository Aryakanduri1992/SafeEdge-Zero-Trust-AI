/**
 * @fileoverview Firestore Security Rules for AuthStation Application
 *
 * Core Philosophy:
 * This ruleset enforces a role-based access control (RBAC) system where Super Admins have privileged access.
 * It also implements owner-based access control for user-specific data.
 *
 * Data Structure:
 * - /roles_super_admin/{superAdminId}:  Documents indicating super admin status, ID is the Firebase Auth UID.
 * - /organizations/{organizationId}: Organization profiles.
 * - /departments/{departmentId}: Departments within organizations.
 * - /devices/{deviceId}: IoT devices registered to departments.
 * - /alerts/{alertId}: Alerts generated by devices.
 *
 * Key Security Decisions:
 * - Super Admins can read/write all Organizations, Departments and Devices.
 * - Only authenticated users can create/modify data. Anonymous access is not granted for write operations.
 * - Data validation during write operations is minimized for prototyping, focusing on ownership and relational integrity.
 *
 * Denormalization for Authorization:
 * - The `superAdminId` field is present in the Organization and Department entities to simplify access control based on the creator.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants Super Admins read access to their profile.
     * @path /roles_super_admin/{superAdminId}
     * @allow (get, list) User with UID 'ggrqPS1rQ8Uo6Ies71W3QlBCXxo2' can get their own super admin role document.
     * @deny (get, list) User with UID 'someOtherUid' cannot get the super admin role document for 'ggrqPS1rQ8Uo6Ies71W3QlBCXxo2'.
     * @principle Enforces user-ownership for read access to super admin role documents.
     */
    match /roles_super_admin/{superAdminId} {
      allow get: if isSignedIn() && isOwner(superAdminId);
      allow list: if false; // Prevent listing of all super admin roles

      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Grants Super Admins create, read, update and delete access to organizations.
     * @path /organizations/{organizationId}
     * @allow (create) Super Admin 'superAdminUid' can create a new organization.
     * @allow (get) Super Admin 'superAdminUid' can read an organization.
     * @allow (update) Super Admin 'superAdminUid' can update an organization.
     * @allow (delete) Super Admin 'superAdminUid' can delete an organization.
     * @deny (create) Non-Super Admin cannot create an organization.
     * @deny (get) Non-Super Admin cannot read an organization.
     * @deny (update) Non-Super Admin cannot update an organization.
     * @deny (delete) Non-Super Admin cannot delete an organization.
     * @principle Enforces super admin role for CRUD operations on organizations.
     */
    match /organizations/{organizationId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.superAdminId == request.auth.uid;
      allow update: if isSignedIn() && isExistingOwner(resource.data.superAdminId);
      allow delete: if isSignedIn() && isExistingOwner(resource.data.superAdminId);
    }

    /**
     * @description Grants Super Admins create, read, update and delete access to departments.
     * @path /departments/{departmentId}
     * @allow (create) Super Admin 'superAdminUid' can create a new department.
     * @allow (get) Super Admin 'superAdminUid' can read a department.
     * @allow (update) Super Admin 'superAdminUid' can update a department.
     * @allow (delete) Super Admin 'superAdminUid' can delete a department.
     * @deny (create) Non-Super Admin cannot create a department.
     * @deny (get) Non-Super Admin cannot read a department.
     * @deny (update) Non-Super Admin cannot update a department.
     * @deny (delete) Non-Super Admin cannot delete a department.
     * @principle Enforces super admin role for CRUD operations on departments.
     */
    match /departments/{departmentId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.superAdminId == request.auth.uid;
      allow update: if isSignedIn() && isExistingOwner(resource.data.superAdminId);
      allow delete: if isSignedIn() && isExistingOwner(resource.data.superAdminId);
    }

    /**
     * @description Grants authenticated users create, read, update and delete access to devices.
     * @path /devices/{deviceId}
     * @allow (create) User 'userUid' can create a new device if it's under their department.
     * @allow (get) User 'userUid' can read a device.
     * @allow (update) User 'userUid' can update a device if they own the parent department.
     * @allow (delete) User 'userUid' can delete a device if they own the parent department.
     * @deny (create) User 'otherUserUid' cannot create a device under 'userUid's department.
     * @deny (get) Anonymous user cannot read devices.
     * @principle Enforces super admin role or ownership through the department for CRUD operations on devices.
     */
    match /devices/{deviceId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Grants authenticated users create, read, update and delete access to alerts.
     * @path /alerts/{alertId}
     * @allow (create) User 'userUid' can create a new alert if it's for their device.
     * @allow (get) User 'userUid' can read an alert.
     * @allow (update) User 'userUid' can update an alert if it's for their device.
     * @allow (delete) User 'userUid' can delete an alert if it's for their device.
     * @deny (create) User 'otherUserUid' cannot create an alert for 'userUid's device.
     * @deny (get) Anonymous user cannot read alerts.
     * @principle Enforces user role or ownership through the device for CRUD operations on alerts.
     */
    match /alerts/{alertId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }
  }

  // Helper functions
  function isSignedIn() {
    return request.auth != null;
  }

  function isOwner(userId) {
    return request.auth.uid == userId;
  }

  function isExistingOwner(userId) {
    return isSignedIn() && isOwner(userId) && resource != null;
  }
}