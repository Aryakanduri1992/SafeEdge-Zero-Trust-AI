/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a role-based access control model with super-admin capabilities.
 *
 * Data Structure:
 * - /roles_super_admin/{superAdminId}: Documents identifying super admins, accessible only to themselves.
 * - /organizations/{organizationId}: Organization profiles, readable by anyone but writable only by super admins.
 * - /departments/{departmentId}: Department data, accessible only to super admins.
 * - /devices/{deviceId}: Device information, accessible only to super admins.
 *
 * Key Security Decisions:
 * - Super Admin role is determined by presence in the `roles_super_admin` collection.
 * - Listing of users is disallowed.
 * - Unauthenticated access is forbidden.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user's ID matches the provided userId.
     * @param {string} userId - The user ID to compare against.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the user is signed in and the document exists.
     * @param {string} userId - The user ID to compare against.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Checks if the user is a super admin by verifying their existence in the roles_super_admin collection.
     */
    function isSuperAdmin() {
        return exists(/databases/(default)/documents/roles_super_admin/$(request.auth.uid));
    }

    /**
     * @description Rule for documents that identify Super Admins.
     * @path /roles_super_admin/{superAdminId}
     * @allow (get, create, update, delete) User with matching superAdminId.
     * @deny (get, create, update, delete) User with non-matching superAdminId.
     * @principle Enforces document ownership for writes and reads, only super admins can read their own profile.
     */
    match /roles_super_admin/{superAdminId} {
      allow get: if isOwner(superAdminId);
      allow list: if false;
      allow create: if isOwner(superAdminId);
      allow update: if isExistingOwner(superAdminId);
      allow delete: if isExistingOwner(superAdminId);
    }

    /**
     * @description Rules for organization profiles.
     * @path /organizations/{organizationId}
     * @allow (get, list) Public read access for all organizations.
     * @allow (create, update, delete) Only Super Admins can manage organization profiles.
     * @deny (create, update, delete) Non-Super Admins.
     * @principle Public read access with super admin-only writes.
     */
    match /organizations/{organizationId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin() && resource != null;
      allow delete: if isSuperAdmin() && resource != null;
    }

    /**
     * @description Rules for department data within organizations.
     * @path /departments/{departmentId}
     * @allow (get, list) Only Super Admins can read department data.
     * @allow (create, update, delete) Only Super Admins can manage department data.
     * @deny (get, create, update, delete) Non-Super Admins.
     * @principle Super Admin-only access for department data.
     */
    match /departments/{departmentId} {
      allow get: if isSuperAdmin();
      allow list: if isSuperAdmin();
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin() && resource != null;
      allow delete: if isSuperAdmin() && resource != null;
    }

    /**
     * @description Rules for individual devices.
     * @path /devices/{deviceId}
     * @allow (get, list) Only Super Admins can read device data.
     * @allow (create, update, delete) Only Super Admins can manage device data.
     * @deny (get, create, update, delete) Non-Super Admins.
     * @principle Super Admin-only access for device data.
     */
    match /devices/{deviceId} {
      allow get: if isSuperAdmin();
      allow list: if isSuperAdmin();
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin() && resource != null;
      allow delete: if isSuperAdmin() && resource != null;
    }
  }
}