/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a role-based access control model with super-admin capabilities.
 *
 * Data Structure:
 * - /roles_super_admin/{superAdminId}: Documents identifying super admins.
 * - /organizations/{organizationId}: Organization profiles.
 * - /devices/{deviceId}: IoT device data.
 * - /alerts/{alertId}: System alerts.
 *
 * Key Security Decisions:
 * - Super admins have full read and write access to all organizations.
 * - Only super admins can create organizations.
 * - Devices and alerts are publicly accessible.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     * @return {bool} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user is a super admin.
     * @return {bool} True if the user is a super admin, false otherwise.
     */
    function isSuperAdmin() {
      return exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
    }

    /**
     * @description Checks if the user is the owner of the document.
     * @param {string} userId - The user ID to check against.
     * @return {bool} True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the user is the owner of the existing document.
     * @param {string} userId - The user ID to check against.
     * @param {string} superAdminId - The ID of the super admin.
     * @return {bool} True if the user is the owner and the document exists, false otherwise.
     */
    function isExistingOwner(superAdminId) {
      return request.auth.uid == resource.data.userId && resource != null;
    }

    /**
     * @description Rules for super admin roles.
     * @path /roles_super_admin/{superAdminId}
     */
    match /roles_super_admin/{superAdminId} {
      allow get: if isSignedIn() && request.auth.uid == superAdminId;
      allow list: if false; // Do not allow listing of super admins

      allow create: if isSignedIn() && request.auth.uid == superAdminId;
      allow update: if isSignedIn() && request.auth.uid == superAdminId;
      allow delete: if isSignedIn() && request.auth.uid == superAdminId;
    }

    /**
     * @description Rules for organizations.
     * @path /organizations/{organizationId}
     */
    match /organizations/{organizationId} {
      allow get: if isSuperAdmin();
      allow list: if isSuperAdmin();

      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    /**
     * @description Rules for devices.
     * @path /devices/{deviceId}
     */
    match /devices/{deviceId} {
      allow get: if true;
      allow list: if true;

      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Rules for alerts.
     * @path /alerts/{alertId}
     */
    match /alerts/{alertId} {
      allow get: if true;
      allow list: if true;

      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }
  }
}