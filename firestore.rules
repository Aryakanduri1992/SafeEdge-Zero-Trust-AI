/**
 * @file Firestore Security Rules for AuthStation
 *
 * Core Philosophy:
 * This ruleset enforces a role-based access control model with a separation of concerns.
 * Super Admins and Admins have distinct privileges, and data is isolated between different admin accounts.
 *
 * Data Structure:
 * - /roles_super_admin/{superAdminId}:  Presence of a document indicates Super Admin role.
 * - /admins/{adminId}: Stores Admin profiles, linked to a Super Admin.
 * - /devices/{deviceId}: Stores IoT device data, linked to an Admin.
 * - /alerts/{alertId}: Stores system alerts, linked to an Admin.
 *
 * Key Security Decisions:
 * - Authorization Independence: Rules avoid `get()` calls by relying on document existence for role verification and denormalizing the `adminId` onto devices and alerts.
 * - List Operations: List operations are secured by enforcing that admins can only list data associated with their `adminId`.
 * - Immutability: SuperAdmin-to-Admin relationships should be immutable.
 *
 * Denormalization for Authorization:
 * - Alerts have an `adminId` field, allowing rules to easily restrict access based on the authenticated user's admin ID.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the requesting user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the requesting user is the owner of the document, based on the document ID.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the requesting user is the owner of an existing document.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Checks if the requesting user is a Super Admin.
     */
    function isSuperAdmin() {
      return exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
    }

    /**
     * @description Rules for the /roles_super_admin collection.
     * @path /roles_super_admin/{superAdminId}
     * @allow (create) If the user's UID matches the document ID, they can create it, indicating they are claiming Super Admin role.
     * @allow (get) If the user is a SuperAdmin.
     * @allow (list) If the user is a SuperAdmin.
     * @deny (update) Always deny updates. Super Admin role should be managed through document creation/deletion.
     * @deny (delete) Always deny deletes. Super Admin role should be managed through document creation/deletion.
     * @principle Enforces role-based access control. Only the user themselves can claim the Super Admin role, and only Super Admins can read or list these roles.
     */
    match /roles_super_admin/{superAdminId} {
      allow get: if isSuperAdmin();
      allow list: if isSuperAdmin();
      allow create: if isSignedIn() && isOwner(superAdminId);
      allow update, delete: if false;
    }

    /**
     * @description Rules for the /admins collection.
     * @path /admins/{adminId}
     * @allow (create) If the user is a Super Admin.
     * @allow (get) If the user is a Super Admin or the Admin themselves.
     * @allow (list) If the user is a Super Admin.
     * @deny (update) Only Super Admins should be able to update admin profiles.
     * @deny (delete) Only Super Admins should be able to delete admin profiles.
     * @principle Restricts Admin creation, modification, and deletion to Super Admins, or the Admin themselves.
     */
    match /admins/{adminId} {
      allow get: if isSuperAdmin() || isOwner(adminId);
      allow list: if isSuperAdmin();
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin() && isExistingOwner(adminId);
      allow delete: if isSuperAdmin() && isExistingOwner(adminId);
    }

    /**
     * @description Rules for the /devices collection.
     * @path /devices/{deviceId}
     * @allow (create) If the user is an Admin creating a new device and the adminId matches their own ID.
     * @allow (get) If the user is an Admin and the device's adminId matches their own ID.
     * @allow (list) If the user is an Admin and the device's adminId matches their own ID.
     * @deny (update) If the user is not the Admin associated with the device.
     * @deny (delete) If the user is not the Admin associated with the device.
     * @principle Enforces that only the Admin who created a device can manage it.
     */
    match /devices/{deviceId} {
      allow get: if isSignedIn() && resource.data.adminId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.adminId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.adminId == request.auth.uid;
      allow update: if isSignedIn() && resource != null && resource.data.adminId == request.auth.uid;
      allow delete: if isSignedIn() && resource != null && resource.data.adminId == request.auth.uid;
    }

    /**
     * @description Rules for the /alerts collection.
     * @path /alerts/{alertId}
     * @allow (create) If the user is an Admin, the alert's adminId matches their ID.
     * @allow (get) If the user is an Admin, the alert's adminId matches their ID.
     * @allow (list) If the user is an Admin, the alert's adminId matches their ID.
     * @deny (update) If the user is not the Admin associated with the alert.
     * @deny (delete) If the user is not the Admin associated with the alert.
     * @principle Enforces that only the Admin associated with an alert can manage it.
     */
    match /alerts/{alertId} {
      allow get: if isSignedIn() && resource.data.adminId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.adminId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.adminId == request.auth.uid;
      allow update: if isSignedIn() && resource != null && resource.data.adminId == request.auth.uid;
      allow delete: if isSignedIn() && resource != null && resource.data.adminId == request.auth.uid;
    }
  }
}