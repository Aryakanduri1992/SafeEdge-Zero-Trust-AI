/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a role-based access control system for the AuthStation application.
 *
 * Data Structure:
 * - /roles_super_admin/{superAdminId}: Super admin user profiles.
 * - /organizations/{organizationId}: Organization profiles, using the Firebase Auth UID as the document ID.
 * - /departments/{departmentId}: Department profiles, linked to an organization via 'organizationId'.
 * - /devices/{deviceId}: IoT device data, linked to a department.
 * - /alerts/{alertId}: System alerts generated by devices, linked to a department.
 *
 * Key Security Decisions:
 * - Super Admins are managed via a dedicated `/roles_super_admin` collection, where each document ID corresponds to a super admin's UID.
 * - Organizations are self-created using their Firebase Auth UID as the document ID.
 * - Departments and Devices are linked to Organizations using the 'organizationId' field for authorization.
 * - Public listing of any collection is disallowed for security and privacy reasons.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Manages super admin user profiles. Only super admins can create, update, or delete their own profiles.
     * @path /roles_super_admin/{superAdminId}
     * @allow (create) User with matching UID can create their own profile.
     * @deny (create) User with a different UID attempts to create a profile.
     * @allow (get) Any authenticated user can get a SuperAdmin profile.
     * @deny (get) Unauthenticated user attempts to get a SuperAdmin profile.
     * @allow (update) User with matching UID can update their own profile.
     * @deny (update) User with a different UID attempts to update a profile.
     * @allow (delete) User with matching UID can delete their own profile.
     * @deny (delete) User with a different UID attempts to delete a profile.
     * @principle Enforces document ownership for writes.
     */
    match /roles_super_admin/{superAdminId} {
      function isOwner(superAdminId) {
        return request.auth.uid == superAdminId;
      }
      function isExistingOwner(superAdminId) {
        return isOwner(superAdminId) && resource != null;
      }

      allow get: if isSignedIn();
      allow list: if false;

      allow create: if isOwner(superAdminId) && request.resource.data.id == request.auth.uid;
      allow update: if isExistingOwner(superAdminId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(superAdminId);
    }

    /**
     * @description Manages organization profiles, using the Firebase Auth UID as the document ID.
     * @path /organizations/{organizationId}
     * @allow (create) User with matching UID can create their own organization profile.
     * @deny (create) User with a different UID attempts to create an organization profile.
     * @allow (get) Any authenticated user can get a Organization profile.
     * @deny (get) Unauthenticated user attempts to get a Organization profile.
     * @allow (update) User with matching UID can update their own organization profile.
     * @deny (update) User with a different UID attempts to update a profile.
     * @allow (delete) User with matching UID can delete their own profile.
     * @deny (delete) User with a different UID attempts to delete a profile.
     * @principle Enforces document ownership for writes.
     */
    match /organizations/{organizationId} {
      function isOwner(organizationId) {
        return request.auth.uid == organizationId;
      }
        function isExistingOwner(organizationId) {
        return isOwner(organizationId) && resource != null;
      }

      allow get: if isSignedIn();
      allow list: if false;

      allow create: if isOwner(organizationId) && request.resource.data.id == request.auth.uid;
      allow update: if isExistingOwner(organizationId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(organizationId);
    }

    /**
     * @description Manages department profiles, linked to an organization.
     * @path /departments/{departmentId}
     * @allow (create) Only the superAdmin can create a department profile within their organization.
     * @deny (create) Unauthorized user attempts to create a department profile.
     * @allow (get) Any authenticated user can get a Department profile.
     * @deny (get) Unauthenticated user attempts to get a Department profile.
     * @allow (update) Only the superAdmin can update a department profile within their organization.
     * @deny (update) Unauthorized user attempts to update a department profile.
     * @allow (delete) Only the superAdmin can delete a department profile within their organization.
     * @deny (delete) Unauthorized user attempts to delete a department profile.
     * @principle Enforces role-based access control for department management.
     */
    match /departments/{departmentId} {
        function isSuperAdminForOrg(organizationId) {
            return exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid))
            && get(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid)).data.departmentName == request.resource.data.departmentName
            && request.resource.data.organizationId == organizationId;
        }

        function isExistingSuperAdminForOrg(organizationId) {
            return exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid))
            && get(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid)).data.departmentName == resource.data.departmentName
            && resource.data.organizationId == organizationId && resource != null;
        }

        allow get: if isSignedIn();
        allow list: if false;

        allow create: if isSuperAdminForOrg(request.resource.data.organizationId);
        allow update: if isExistingSuperAdminForOrg(resource.data.organizationId);
        allow delete: if isExistingSuperAdminForOrg(resource.data.organizationId);
    }

    /**
     * @description Manages IoT device data, linked to a department.
     * @path /devices/{deviceId}
     * @allow (create) SuperAdmin can create a device within a department.
     * @deny (create) Unauthorized user attempts to create a device.
     * @allow (get) Any authenticated user can get a Device profile.
     * @deny (get) Unauthenticated user attempts to get a Device profile.
     * @allow (update) SuperAdmin can update a device within a department.
     * @deny (update) Unauthorized user attempts to update a device.
     * @allow (delete) SuperAdmin can delete a device within a department.
     * @deny (delete) Unauthorized user attempts to delete a device.
     * @principle Enforces role-based access control for device management.
     */
    match /devices/{deviceId} {
      function isSuperAdminForDepartment(departmentId) {
          return exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid))
          && get(/databases/$(database)/documents/departments/$(request.resource.data.departmentId)).data.departmentName == get(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid)).data.departmentName
          && request.resource.data.departmentId == departmentId;
      }

      function isExistingSuperAdminForDepartment(departmentId) {
          return exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid))
          && get(/databases/$(database)/documents/departments/$(resource.data.departmentId)).data.departmentName == get(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid)).data.departmentName
          && resource.data.departmentId == departmentId && resource != null;
      }

      allow get: if isSignedIn();
      allow list: if false;

      allow create: if isSuperAdminForDepartment(request.resource.data.departmentId);
      allow update: if isExistingSuperAdminForDepartment(resource.data.departmentId);
      allow delete: if isExistingSuperAdminForDepartment(resource.data.departmentId);
    }

    /**
     * @description Manages system alerts generated from devices, linked to a department.
     * @path /alerts/{alertId}
     * @allow (create) SuperAdmin can create a device within a department.
     * @deny (create) Unauthorized user attempts to create a device.
     * @allow (get) Any authenticated user can get a Device profile.
     * @deny (get) Unauthenticated user attempts to get a Device profile.
     * @allow (update) SuperAdmin can update a device within a department.
     * @deny (update) Unauthorized user attempts to update a device.
     * @allow (delete) SuperAdmin can delete a device within a department.
     * @deny (delete) Unauthorized user attempts to delete a device.
     * @principle Enforces role-based access control for device management.
     */
        match /alerts/{alertId} {
            function isSuperAdminForDepartment(departmentId) {
                return exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid))
                && get(/databases/$(database)/documents/departments/$(request.resource.data.departmentId)).data.departmentName == get(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid)).data.departmentName
                && request.resource.data.departmentId == departmentId;
            }

            function isExistingSuperAdminForDepartment(departmentId) {
                return exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid))
                && get(/databases/$(database)/documents/departments/$(resource.data.departmentId)).data.departmentName == get(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid)).data.departmentName
                && resource.data.departmentId == departmentId && resource != null;
            }

            allow get: if isSignedIn();
            allow list: if false;

            allow create: if isSuperAdminForDepartment(request.resource.data.departmentId);
            allow update: if isExistingSuperAdminForDepartment(resource.data.departmentId);
            allow delete: if isExistingSuperAdminForDepartment(resource.data.departmentId);
        }


    function isSignedIn() {
      return request.auth != null;
    }
  }
}