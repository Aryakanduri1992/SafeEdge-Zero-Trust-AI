/**
 * @fileoverview Firestore Security Rules for AuthStation application.
 *
 * Core Philosophy:
 * This ruleset enforces a role-based access control model, primarily driven by the existence of documents
 * in specific role collections (e.g., `/roles_super_admin/{superAdminId}`). It emphasizes Authorization
 * Independence and avoids complex `get()` calls in favor of simpler, existence-based checks. Data is secured
 * at the collection level, with owner-only access for write operations in most cases.
 *
 * Data Structure:
 * - `/roles_super_admin/{superAdminId}`: Indicates a Super Admin. The document content is not relevant; existence is sufficient.
 * - `/admins/{adminId}`: Stores Admin profiles, linked to a Super Admin via the `superAdminId` field.
 * - `/devices/{deviceId}`: Stores IoT device data, linked to an Admin via the `adminId` field.
 * - `/alerts/{alertId}`: Stores system alerts, linked to an Admin via the `adminId` field.
 *
 * Key Security Decisions:
 * - Super Admin role is verified by the existence of a document in `/roles_super_admin/{superAdminId}`.
 * - Listing of Super Admins is explicitly denied.
 * - Admin access to Devices and Alerts is restricted to those associated with their `adminId`.
 * - All write operations require a valid, authenticated user (`request.auth != null`).
 *
 * Denormalization for Authorization:
 * - The `admins/{adminId}` documents store the `superAdminId` to enable simple relationship checks
 *   without needing to read the Super Admin document.
 * - The `devices/{deviceId}` and `alerts/{alertId}` documents store the `adminId`, allowing
 *   for efficient filtering and authorization based on the owning Admin.
 *
 * Structural Segregation:
 * - Separate collections are used for Super Admins and Admins, allowing for distinct access controls
 *   and preventing accidental exposure of sensitive data.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
    }

    function isAdmin(adminId) {
        return isSignedIn() && get(/databases/$(database)/documents/admins/$(adminId)).data.id == request.auth.uid;
    }

    function isExistingOwner(resourceOwnerId) {
        return resource != null && resource.data.id == resourceOwnerId;
    }

    /**
     * @description Rule for Super Admin role documents.
     * @path /roles_super_admin/{superAdminId}
     * @allow (create) If the user's UID matches the document ID.
     * @deny (create) If the user's UID does not match the document ID.
     * @principle Allows creation of Super Admin role documents only by the user themselves.
     */
    match /roles_super_admin/{superAdminId} {
        allow get: if false;
        allow list: if false;
        allow create: if isSignedIn() && request.auth.uid == superAdminId;
        allow update: if false;
        allow delete: if false;
    }

    /**
     * @description Rules for Admin profiles.
     * @path /admins/{adminId}
     * @allow (create) If the request is made by a Super Admin.
     * @allow (get) If the request is made by a Super Admin.
     * @allow (update, delete) If the request is made by a Super Admin.
     * @deny (create) If the request is not made by a Super Admin.
     * @deny (get) If the request is not made by a Super Admin.
     * @deny (update, delete) If the request is not made by a Super Admin.
     * @principle Super Admins can create, read, update, and delete admin profiles.
     */
    match /admins/{adminId} {
      allow get: if isSuperAdmin();
      allow list: if false;
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    /**
     * @description Rules for Device documents.
     * @path /devices/{deviceId}
     * @allow (create) If the user is an Admin and the adminId matches the user's UID.
     * @allow (get, list) If the user is an Admin and the device's adminId matches the user's UID.
     * @allow (update, delete) If the user is an Admin, the device exists, and the device's adminId matches the user's UID.
     * @deny (create) If the user is not an Admin.
     * @deny (create) If the adminId does not match the user's UID.
     * @deny (get, list) If the user is not an Admin.
     * @deny (get, list) If the device's adminId does not match the user's UID.
     * @deny (update, delete) If the user is not an Admin.
     * @deny (update, delete) If the device's adminId does not match the user's UID.
     * @deny (update, delete) If the device does not exist.
     * @principle Admins can only manage devices associated with their own accounts.
     */
    match /devices/{deviceId} {
        allow get: if isSignedIn() && resource.data.adminId == request.auth.uid;
        allow list: if false; // Listing all devices is generally not a good idea for security/privacy
        allow create: if isSignedIn() && request.resource.data.adminId == request.auth.uid;
        allow update: if isSignedIn() && request.resource.data.adminId == request.auth.uid;
        allow delete: if isSignedIn() && resource.data.adminId == request.auth.uid;
    }

     /**
      * @description Rules for Alert documents.
      * @path /alerts/{alertId}
      * @allow (create) If the user is an Admin and the alert's adminId matches the user's UID.
      * @allow (get, list) If the user is an Admin and the alert's adminId matches the user's UID.
      * @allow (update, delete) If the user is an Admin, the alert exists, and the alert's adminId matches the user's UID.
      * @deny (create) If the user is not an Admin.
      * @deny (create) If the alert's adminId does not match the user's UID.
      * @deny (get, list) If the user is not an Admin.
      * @deny (get, list) If the alert's adminId does not match the user's UID.
      * @deny (update, delete) If the user is not an Admin.
      * @deny (update, delete) If the alert's adminId does not match the user's UID.
      * @deny (update, delete) If the alert does not exist.
      * @principle Admins can only manage alerts associated with their own accounts.
      */
    match /alerts/{alertId} {
        allow get: if isSignedIn() && resource.data.adminId == request.auth.uid;
        allow list: if false; // Listing all alerts is generally not a good idea for security/privacy
        allow create: if isSignedIn() && request.resource.data.adminId == request.auth.uid;
        allow update: if isSignedIn() && request.resource.data.adminId == request.auth.uid;
        allow delete: if isSignedIn() && resource.data.adminId == request.auth.uid;
    }
  }
}