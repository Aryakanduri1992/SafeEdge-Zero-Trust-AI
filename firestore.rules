/**
 * @fileOverview Firestore Security Rules for AuthStation application.
 *
 * Core Philosophy:
 * This ruleset enforces a role-based access control model, with Super Admins having the highest privileges, followed by Admins.
 * Ownership is enforced on Admin, Device, and Alert resources via `adminId` or `superAdminId` fields.
 *
 * Data Structure:
 * - /roles_super_admin/{superAdminId}: Indicates a Super Admin role. Existence of a document grants super-admin privileges.
 * - /admins/{adminId}: Stores Admin profiles, linked to a Super Admin via `superAdminId`.
 * - /devices/{deviceId}: Stores IoT device data, linked to an Admin via `adminId`.
 * - /alerts/{alertId}: Stores system alerts, linked to an Admin via `adminId`.
 *
 * Key Security Decisions:
 * - Super Admin status is determined by the existence of a document in `/roles_super_admin/{superAdminId}`.
 * - Admins can only manage devices and alerts associated with their `adminId`.
 * - Data validation is relaxed to allow rapid prototyping but includes validation to ensure path consistency.
 * - Listing of alerts is restricted to admins to prevent information leakage.
 *
 * Denormalization for Authorization:
 * - The existence of a document in `/roles_super_admin/{superAdminId}` serves as the authorization for super-admin-only actions.
 * - Each Admin, Device, and Alert document includes an `adminId` or `superAdminId` to simplify ownership checks.
 *
 * Structural Segregation:
 * - Super Admin roles are managed in a separate collection (`/roles_super_admin`) to provide a clear separation of concerns.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     * @param {string} userId - The user's ID.
     * @returns {boolean} - True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user is the owner of the resource.
     * @param {string} userId - The user's ID.
     * @returns {boolean} - True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the user is the existing owner of the resource.
     * @param {string} userId - The user's ID.
     * @returns {boolean} - True if the user is the existing owner, false otherwise.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Checks if the user is a super admin.
     * @returns {boolean} - True if the user is a super admin, false otherwise.
     */
    function isSuperAdmin() {
      return exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
    }

    /*************************** SuperAdmin Role Collection ***************************/

    /**
     * @description Rules for the /roles_super_admin collection. Only Super Admins (identified via auth) can create their role document.
     * @path /roles_super_admin/{superAdminId}
     * @allow (create) User p4a8KfA23kRCuabLpvw10cVKfXo2 with matching auth and document ID can create their SuperAdmin role.
     * @deny (create) User p4a8KfA23kRCuabLpvw10cVKfXo2 cannot create SuperAdmin role for user another_user_id.
     * @allow (get, list) Any signed-in user can check Super Admin roles.
     * @deny (update, delete) Only the Super Admin can modify their own role.
     * @principle Super Admin role creation is self-administered based on user ID; enforces role-based access control.
     */
    match /roles_super_admin/{superAdminId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isOwner(superAdminId);
      allow update, delete: if false;
    }

    /*************************** Admins Collection ***************************/

    /**
     * @description Rules for the /admins collection. Super Admins can create Admin profiles.
     * @path /admins/{adminId}
     * @allow (create) Super Admin can create new admin profile
     * @deny (create) Regular user cannot create an admin profile.
     * @allow (get, list) Any signed-in user can get/list admin profiles.
     * @deny (update, delete) Only Super Admin can update or delete Admin profiles.
     * @principle Enforces role-based access control; restricts Admin profile creation to Super Admins.
     */
    match /admins/{adminId} {
      allow get, list: if isSignedIn();
      allow create: if isSuperAdmin();
      allow update, delete: if false;
    }

    /*************************** Devices Collection ***************************/

    /**
     * @description Rules for the /devices collection. Admins can create and manage devices.
     * @path /devices/{deviceId}
     * @allow (create) Admin can create a device with their adminId.
     * @deny (create) Admin cannot create a device with another adminId.
     * @allow (get, list) Admins can get/list devices associated with their adminId.
     * @deny (update, delete) Only the owning Admin can update or delete their devices.
     * @principle Enforces ownership; restricts device management to the associated Admin.
     */
    match /devices/{deviceId} {
      allow get: if isSignedIn() && resource.data.adminId == request.auth.uid;
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.adminId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.adminId);
      allow delete: if isExistingOwner(resource.data.adminId);
    }

     /*************************** Alerts Collection ***************************/

    /**
     * @description Rules for the /alerts collection. Admins can create and manage alerts.
     * @path /alerts/{alertId}
     * @allow (create) Admin can create an alert associated with their adminId.
     * @deny (create) Admin cannot create an alert with another adminId.
     * @allow (get) Admins can read alerts associated with their adminId.
     * @deny (list) Listing of alerts is prohibited due to security concerns and potential data leakage.
     * @deny (update, delete) Only the owning Admin can update or delete their alerts.
     * @principle Enforces ownership; restricts alert management to the associated Admin.
     */
    match /alerts/{alertId} {
      allow get: if isSignedIn() && resource.data.adminId == request.auth.uid;
      allow list: if false;
      allow create: if isSignedIn() && request.resource.data.adminId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.adminId);
      allow delete: if isExistingOwner(resource.data.adminId);
    }
  }
}