/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a role-based access control system with super-admin and organization-level permissions.
 *
 * Data Structure:
 * - /roles_super_admin/{superAdminId}: Stores SuperAdmin profile information, accessible only to the super admin user and other super admins.
 * - /organizations/{organizationId}: Stores Organization profile information, accessible only to the creating super admin.
 * - /departments/{departmentId}: Stores Department information for all organizations, accessible only to the organization users.
 *
 * Key Security Decisions:
 * - Super admins are identified by their UID in the /roles_super_admin collection.
 * - Organizations can only be created by super admins.
 * - Departments can only be created by organization users.
 *
 * Denormalization for Authorization:
 * - Organization documents store the superAdminId to quickly verify the creator.
 * - Department documents store both organizationId and superAdminId for authorization checks.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows super admins to manage their own profile information.
     * @path /roles_super_admin/{superAdminId}
     * @allow (get) User is the super admin.
     * @allow (list) User is the super admin.
     * @allow (create) User is the super admin.
     * @allow (update) User is the super admin.
     * @allow (delete) User is the super admin.
     * @deny (get) User is not the super admin.
     * @deny (list) User is not the super admin.
     * @deny (create) User is not the super admin.
     * @deny (update) User is not the super admin.
     * @deny (delete) User is not the super admin.
     * @principle Enforces document ownership for super admin profiles.
     */
    match /roles_super_admin/{superAdminId} {
      allow get: if isSignedIn() && isOwner(superAdminId);
      allow list: if isSignedIn() && isOwner(superAdminId);
      allow create: if isSignedIn() && isOwner(superAdminId);
      allow update: if isSignedIn() && isOwner(superAdminId);
      allow delete: if isSignedIn() && isOwner(superAdminId);
    }

    /**
     * @description Allows super admins to create organizations, and restricts modification/deletion.
     * @path /organizations/{organizationId}
     * @allow (get) Anyone can read organization data.
     * @allow (list) Anyone can list organization data.
     * @allow (create) A super admin can create an organization if the superAdminId matches their own.
     * @deny (update) Only the creating super admin can update.
     * @deny (delete) Only the creating super admin can delete.
     * @principle Enforces super admin-only creation and owner-only modification/deletion of organizations.
     */
    match /organizations/{organizationId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.superAdminId == request.auth.uid;
      allow update: if isSignedIn() && isExistingOwner(resource.data.superAdminId);
      allow delete: if isSignedIn() && isExistingOwner(resource.data.superAdminId);
    }

    /**
     * @description Allows organization users to manage their departments.
     * @path /departments/{departmentId}
     * @allow (get) Anyone can read the department data.
     * @allow (list) Anyone can list department data.
     * @allow (create) User within the organization can create if the organizationId matches.
     * @deny (update) Only a user within the organization can update.
     * @deny (delete) Only a user within the organization can delete.
     * @principle Enforces organization-level ownership for departments.
     */
    match /departments/{departmentId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.organizationId != null;
      allow update: if isSignedIn() && isExistingOwner(resource.data.organizationId);
      allow delete: if isSignedIn() && isExistingOwner(resource.data.organizationId);
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return isSignedIn() && isOwner(userId) && resource != null;
    }
  }
}