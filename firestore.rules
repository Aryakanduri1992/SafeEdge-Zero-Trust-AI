/**
 * @file Firebase Security Rules for AuthStation application.
 *
 * @core_philosophy This ruleset enforces role-based access control, with a super admin role
 *   having elevated privileges. Organizations and departments are secured based on
 *   their relationship to the super admin. Data validation is relaxed in prototyping
 *   mode to allow for rapid schema iteration, focusing instead on authorization.
 *
 * @data_structure The data is structured with a top-level collection for super admins
 *   (`/roles_super_admin/{superAdminId}`), organizations (`/organizations/{organizationId}`),
 *   and departments (`/departments/{departmentId}`).
 *
 * @key_security_decisions
 *   - Only super admins can create organizations.
 *   - Organizations can only be created by super admins.
 *   - Departments can be created by super admins who own the parent organization.
 *   - User listing is disabled to protect user privacy.
 *
 * @denormalization Organizations include a `superAdminId` field to link back to the
 *   creating super admin. Departments include both `organizationId` and `superAdminId` for
 *   efficient rule evaluation without needing additional reads.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     * @path N/A (Helper function)
     * @allow N/A (Helper function)
     * @deny N/A (Helper function)
     * @principle Requires authentication for certain operations.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user is a Super Admin.
     * @path N/A (Helper function)
     * @allow N/A (Helper function)
     * @deny N/A (Helper function)
     * @principle Enforces role-based access control.
     */
    function isSuperAdmin() {
      return exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
    }

    /**
     * @description Checks if the authenticated user is the owner (super admin) of the resource.
     * @path N/A (Helper function)
     * @allow N/A (Helper function)
     * @deny N/A (Helper function)
     * @principle Enforces ownership for data access.
     */
    function isOwner(superAdminId) {
      return request.auth.uid == superAdminId;
    }

    /**
     * @description Checks if the authenticated user is the owner of the resource and the resource exists.
     * @path N/A (Helper function)
     * @allow N/A (Helper function)
     * @deny N/A (Helper function)
     * @principle Ensures resource exists before allowing destructive operations.
     */
    function isExistingOwner(superAdminId) {
      return isOwner(superAdminId) && resource != null;
    }

    /**
     * @description Rules for the super_admin role.
     * @path /roles_super_admin/{superAdminId}
     * @allow (create) User with matching UID can create their own super admin document.
     * @deny (create) User attempts to create a super admin document with a mismatched UID.
     * @principle Enforces document ownership and self-creation.
     */
    match /roles_super_admin/{superAdminId} {
      allow get: if false;
      allow list: if false;

      allow create: if isSignedIn() && request.auth.uid == superAdminId;
      allow update: if isSignedIn() && request.auth.uid == superAdminId;
      allow delete: if isSignedIn() && request.auth.uid == superAdminId;
    }

    /**
     * @description Rules for the organizations collection.
     * @path /organizations/{organizationId}
     * @allow (create) Super Admin can create an organization.
     * @deny (create) Non-Super Admin attempts to create an organization.
     * @principle Restricts organization creation to super admins.
     */
    match /organizations/{organizationId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();

      allow create: if isSignedIn() && isSuperAdmin();
      allow update: if isSignedIn() && isSuperAdmin();
      allow delete: if isSignedIn() && isSuperAdmin();
    }

    /**
     * @description Rules for the departments collection.
     * @path /departments/{departmentId}
     * @allow (create) Super Admin can create a department.
     * @deny (create) Non-Super Admin attempts to create a department.
     * @principle Restricts department creation to super admins.
     */
    match /departments/{departmentId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();

      allow create: if isSignedIn() && isSuperAdmin();
      allow update: if isSignedIn() && isSuperAdmin();
      allow delete: if isSignedIn() && isSuperAdmin();
    }
  }
}