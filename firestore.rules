rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     * @path N/A (Helper Function)
     * @allow N/A (Helper Function)
     * @deny N/A (Helper Function)
     * @principle Authentication: Ensures that only authenticated users can access certain resources.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user's UID matches the provided userId.
     * @path N/A (Helper Function)
     * @allow N/A (Helper Function)
     * @deny N/A (Helper Function)
     * @principle Ownership: Verifies that the user is the owner of the resource.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user's UID matches the provided userId and the document exists.
     * @path N/A (Helper Function)
     * @allow N/A (Helper Function)
     * @deny N/A (Helper Function)
     * @principle Ownership and Existence: Ensures that the user is the owner of an existing resource.
     */
    function isExistingOwner(userId) {
        return isOwner(userId) && exists(/databases/$(database)/documents/roles_super_admin/$(userId));
    }

    /**
     * @description Checks if the requesting user has Super Admin role.
     * @path N/A (Helper Function)
     * @allow N/A (Helper Function)
     * @deny N/A (Helper Function)
     * @principle Role-Based Access Control: Only Super Admins can perform certain actions.
     */
    function isSuperAdmin() {
      return exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
    }


    /**
     * @description Manages Super Admin role assignments.
     * @path /roles_super_admin/{superAdminId}
     * @allow (create) If the authenticated user's UID matches the superAdminId.
     * @deny (create) If the authenticated user's UID does not match the superAdminId.
     * @principle Role Assignment: Only a user can create their own role assignment.
     */
    match /roles_super_admin/{superAdminId} {
      allow get: if false;
      allow list: if false;

      allow create: if isSignedIn() && isOwner(superAdminId);
      allow update: if isSignedIn() && isOwner(superAdminId) && isSuperAdmin();
      allow delete: if isSignedIn() && isOwner(superAdminId) && isSuperAdmin();
    }

    /**
     * @description Manages Admin profiles.
     * @path /admins/{adminId}
     * @allow (create) A Super Admin can create new admin profiles. The 'superAdminId' field in the new document must match the Super Admin's UID.
     * @allow (update, delete) A Super Admin can update or delete existing admin profiles.
     * @deny (create, update, delete) Non-Super Admins cannot create, update, or delete admin profiles.
     * @principle Admin Management: Super Admins control Admin profiles.
     */
    match /admins/{adminId} {
      allow get: if false;
      allow list: if false;

      allow create: if isSignedIn() && isSuperAdmin() && request.resource.data.superAdminId == request.auth.uid;
      allow update: if isSignedIn() && isSuperAdmin();
      allow delete: if isSignedIn() && isSuperAdmin();
    }

    /**
     * @description Manages IoT device data.
     * @path /devices/{deviceId}
     * @allow (create) An authenticated user can create a device, provided the 'adminId' field matches their UID.
     * @allow (update, delete) An authenticated user can update or delete a device, provided the 'adminId' field matches their UID. Document must exist for update/delete.
     * @allow (get, list) An authenticated user can get/list their own devices (where 'adminId' matches their UID).
     * @deny (create, update, delete) If the 'adminId' field does not match the authenticated user's UID.
     * @principle Device Ownership: Admins control their own devices.
     */
    match /devices/{deviceId} {
      allow get: if isSignedIn() && resource.data.adminId == request.auth.uid;
      allow list: if isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));

      allow create: if isSignedIn() && request.resource.data.adminId == request.auth.uid;
      allow update: if isSignedIn() && request.resource.data.adminId == resource.data.adminId;
      allow delete: if isSignedIn() && resource.data.adminId == request.auth.uid;
    }

    /**
     * @description Manages system alerts.
     * @path /alerts/{alertId}
     * @allow (create) An authenticated user can create an alert, provided the 'adminId' field matches their UID.
     * @allow (update, delete) An authenticated user can update or delete an alert, provided the 'adminId' field matches their UID. Document must exist for update/delete.
     * @allow (get, list) An authenticated user can get/list their own alerts (where 'adminId' matches their UID).
     * @deny (create, update, delete) If the 'adminId' field does not match the authenticated user's UID.
     * @principle Alert Ownership: Admins control their own alerts.
     */
    match /alerts/{alertId} {
      allow get: if isSignedIn() && resource.data.adminId == request.auth.uid;
      allow list: if isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));

      allow create: if isSignedIn() && request.resource.data.adminId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.adminId == resource.data.adminId;
      allow delete: if isSignedIn() && resource.data.adminId == request.auth.uid;
    }
  }
}