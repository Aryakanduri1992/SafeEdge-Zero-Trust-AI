/**
 * @file Firebase Security Rules for AuthStation.
 *
 * @description This ruleset enforces a strict user-ownership model for organizations,
 * departments, and devices. Super admins are granted broad read access.
 *
 * @data_structure
 * - /roles_super_admin/{superAdminId}: Documents identifying super admins.
 * - /organizations/{organizationId}: Organization profiles, owned by the creating user (superAdminId).
 * - /departments/{departmentId}: Department data, linked to an organization.
 * - /devices/{deviceId}: Device information, linked to a department and organization.
 *
 * @key_security_decisions
 * - Super admins can read all data.
 * - Organizations can only be created by an authenticated user, who becomes the owner.
 * - Only the organization owner (superAdminId) can modify organization data.
 * - Departments and Devices inherit the organization's ownership.
 * - User listing is disallowed for security.
 * - Denormalization: Organization, Department, and Device documents include `superAdminId` to simplify ownership checks and prevent extra reads.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is authenticated.
     * @returns {boolean} True if the request is authenticated, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user is the owner (superAdmin) of the resource.
     * @param {string} userId - The user ID to compare against the request's auth UID.
     * @returns {boolean} True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user is the existing owner of the resource.
     * @param {string} userId - The user ID to compare against the resource's owner ID.
     * @returns {boolean} True if the user is the owner and the resource exists, false otherwise.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }
    
    /**
     * @description Checks if the requesting user is a super admin by verifying the existence of a document in the roles_super_admin collection.
     * @returns {boolean} True if the user is a super admin, false otherwise.
     */
    function isSuperAdmin() {
        return exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
    }

    /**
     * @description Rules for documents that identify Super Admins.
     * @path /roles_super_admin/{superAdminId}
     * @allow (create) User with matching UID can create their own super admin role document.
     * @deny (create) User attempts to create a super admin document for another user.
     * @allow (get) Any super admin can read any super admin document.
     * @deny (get) Non-super admin attempts to read a super admin document.
     * @principle Enforces super admin role assignment.
     */
    match /roles_super_admin/{superAdminId} {
      allow get: if isSuperAdmin();
      allow list: if false;
      allow create: if isOwner(superAdminId);
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Rules for organization profile information.
     * @path /organizations/{organizationId}
     * @allow (create) Authenticated user can create a new organization, becoming its owner (superAdminId).
     * @deny (create) Unauthenticated user attempts to create an organization.
     * @allow (get) Super admins and the organization owner can read organization data.
     * @deny (get) Non-owner attempts to read organization data.
     * @allow (update) Only the organization owner can update organization data.
     * @deny (update) Non-owner attempts to update organization data.
     * @allow (delete) Only the organization owner can delete the organization.
     * @deny (delete) Non-owner attempts to delete the organization.
     * @principle Enforces organization ownership for writes, allows super admins to read.
     */
    match /organizations/{organizationId} {
      allow get: if isSuperAdmin() || isOwner(resource.data.superAdminId);
      allow list: if false;
      allow create: if isSignedIn() && request.resource.data.superAdminId == request.auth.uid;
      allow update: if isSuperAdmin() || (isSignedIn() && resource.data.superAdminId == request.auth.uid);
      allow delete: if isSuperAdmin() || (isSignedIn() && resource.data.superAdminId == request.auth.uid);
    }

    /**
     * @description Rules for department information for all organizations.
     * @path /departments/{departmentId}
     * @allow (create) Authenticated user (organization owner) can create a department.
     * @deny (create) Non-owner attempts to create a department.
     * @allow (get) Super admins and the organization owner can read department data.
     * @deny (get) Non-owner attempts to read department data.
     * @allow (update) Only the organization owner can update department data.
     * @deny (update) Non-owner attempts to update department data.
     * @allow (delete) Only the organization owner can delete the department.
     * @deny (delete) Non-owner attempts to delete the department.
     * @principle Enforces organization ownership for writes, allows super admins to read.
     */
    match /departments/{departmentId} {
      allow get: if isSuperAdmin() || isOwner(resource.data.superAdminId);
      allow list: if false;
      allow create: if isSignedIn() && get(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)).data.superAdminId == request.auth.uid;
      allow update: if isSuperAdmin() || (isSignedIn() && resource.data.superAdminId == request.auth.uid);
      allow delete: if isSuperAdmin() || (isSignedIn() && resource.data.superAdminId == request.auth.uid);
    }

    /**
     * @description Rules for information about individual devices.
     * @path /devices/{deviceId}
     * @allow (create) Authenticated user (organization owner) can create a device.
     * @deny (create) Non-owner attempts to create a device.
     * @allow (get) Super admins and the organization owner can read device data.
     * @deny (get) Non-owner attempts to read device data.
     * @allow (update) Only the organization owner can update device data.
     * @deny (update) Non-owner attempts to update device data.
     * @allow (delete) Only the organization owner can delete the device.
     * @deny (delete) Non-owner attempts to delete the device.
     * @principle Enforces organization ownership for writes, allows super admins to read.
     */
    match /devices/{deviceId} {
      allow get: if isSuperAdmin() || isOwner(resource.data.superAdminId);
      allow list: if false;
      allow create: if isSignedIn() && get(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)).data.superAdminId == request.auth.uid;
      allow update: if isSuperAdmin() || (isSignedIn() && resource.data.superAdminId == request.auth.uid);
      allow delete: if isSuperAdmin() || (isSignedIn() && resource.data.superAdminId == request.auth.uid);
    }
  }
}