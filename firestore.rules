/**
 * @description This ruleset enforces a strict organization-based access control model for the AuthStation application.
 * All data is organized under top-level collections for organizations, departments, and devices. Super Admin
 * roles are stored in a separate collection.
 * @data_structure
 * - /roles_super_admin/{superAdminId}: Stores Super Admin role documents, accessible only to authenticated super admins.
 * - /organizations/{organizationId}: Stores organization profile information, accessible only to authenticated super admins.
 * - /departments/{departmentId}: Stores department information, accessible only to authenticated super admins.
 * - /devices/{deviceId}: Stores device information, accessible only to authenticated super admins and members of the organization.
 * @key_security_decisions
 * - Listing of all users is disallowed.
 * - The rules assume that an `organizationId` field exists on the `/devices/{deviceId}` documents.
 * - Default security posture: Deny all access unless explicitly allowed.
 * @denormalization_for_authorization
 * The `organizationId` is denormalized (copied) onto the `Device` document to allow efficient security rules
 * without requiring additional reads.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the current user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the current user's UID matches the provided userId.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the current user is the owner of an existing document.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Allows super admins to manage their profiles.
     * @path /roles_super_admin/{superAdminId}
     * @allow (create) User with matching UID can create their own super admin profile.
     * @deny (create) User attempts to create a super admin profile with a mismatched UID.
     * @principle Enforces document ownership for writes.
     */
    match /roles_super_admin/{superAdminId} {
      allow get: if isOwner(superAdminId);
      allow list: if false;
      allow create: if isOwner(superAdminId);
      allow update: if isExistingOwner(superAdminId);
      allow delete: if isExistingOwner(superAdminId);
    }

    /**
     * @description Manages organizations.
     * @path /organizations/{organizationId}
     * @allow (create) Super Admins can create organizations.
     * @deny (delete) Non-Super Admins cannot delete organizations.
     * @principle Restricts organization management to Super Admins.
     */
    match /organizations/{organizationId} {
      allow get: if isSignedIn(); // TODO: Tighten this rule to allow only org members or super admins
      allow list: if false;
      allow create: if isSignedIn(); // TODO: Tighten this rule to allow only super admins
      allow update: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
      allow delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Manages departments within organizations.
     * @path /departments/{departmentId}
     * @allow (create) Super Admins can create departments.
     * @deny (delete) Non-Super Admins cannot delete departments.
     * @principle Restricts department management to Super Admins.
     */
    match /departments/{departmentId} {
      allow get: if isSignedIn(); // TODO: Tighten this rule to allow only members of the organization
      allow list: if false;
      allow create: if isSignedIn(); // TODO: Tighten this rule to allow only super admins
      allow update: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
      allow delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Manages devices.  Allows listing devices only for users belonging to the specified organization.
     * @path /devices/{deviceId}
     * @allow (list) User belonging to the organization can list devices.
     * @allow (create) Super Admins can create new devices.
     * @deny (update) Non-Super Admins cannot update devices.
     * @principle Enforces organization-based access control for devices.
     */
    match /devices/{deviceId} {
        allow get: if true; // TODO: Tighten this rule to allow only members of the organization
        allow list: if request.query.organizationId == request.auth.uid;
        allow create: if isSignedIn(); // TODO: Tighten this rule to allow only super admins
        allow update: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
        allow delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }
  }
}