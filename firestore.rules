/**
 * @file Firebase Security Rules
 * @description This ruleset enforces a multi-tenant security model where organizations and their members have isolated data access.
 *
 * Data Structure:
 * - /roles_super_admin/{superAdminId}: Super admin role assignments, keyed by UID.
 * - /organizations/{organizationId}: Organization profiles.
 * - /departments/{departmentId}: Department information, scoped to organizations.
 * - /devices/{deviceId}: Device information, scoped to departments and organizations.
 * - /sensorReadings/{readingId}: Sensor data, scoped to devices and organizations.
 *
 * Key Security Decisions:
 * - Super admins can manage their own organizations, departments, and devices.
 * - Standard users (non super admins) are not supported.
 * - Public listing is disabled for all collections containing private data.
 *
 * Denormalization for Authorization:
 * - The `organizationId` field is present on `departments`, `devices`, and `sensorReadings` to enable efficient filtering and authorization.
 *
 * Structural Segregation:
 * - There is no private/public data segregation.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secure super admin role assignments. Only allows read access for authenticated users. Write access is denied.
     * @path /roles_super_admin/{superAdminId}
     * @allow (get, list) if isSignedIn()
     * @deny (create, update, delete)
     * @principle Restricts write access to super admin roles.
     */
    match /roles_super_admin/{superAdminId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Secure organization profiles. Allows read access for authenticated users. Allows create, update, delete only for super admins.
     * @path /organizations/{organizationId}
     * @allow (get, list) if isSignedIn()
     * @allow (create) if request.auth.uid == request.resource.data.superAdminId
     * @allow (update, delete) if isExistingOwner(resource.data.superAdminId)
     * @deny (create) if request.auth.uid != request.resource.data.superAdminId
     * @deny (update, delete) if !isExistingOwner(resource.data.superAdminId)
     * @principle Enforces document ownership for organization management.
     */
    match /organizations/{organizationId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if request.auth.uid == request.resource.data.superAdminId;
      allow update: if isExistingOwner(resource.data.superAdminId);
      allow delete: if isExistingOwner(resource.data.superAdminId);
    }

    /**
     * @description Secure department information, scoped to organizations.
     * @path /departments/{departmentId}
     * @allow (get) if isSignedIn() && resource.data.organizationId == request.auth.uid
     * @allow (list) if isSignedIn() && listVisibleByOrg(request.auth.uid)
     * @allow (create) if request.auth.uid == request.resource.data.superAdminId
     * @allow (update, delete) if isExistingOwner(resource.data.superAdminId) && resource.data.organizationId == request.auth.uid
     * @deny (create) if request.auth.uid != request.resource.data.superAdminId
     * @deny (update, delete) if !isExistingOwner(resource.data.superAdminId) || resource.data.organizationId != request.auth.uid
     * @principle Enforces organizational scoping for department access and modification.
     */
    match /departments/{departmentId} {
      allow get: if isSignedIn() && resource.data.organizationId == request.auth.uid;
      allow list: if isSignedIn() && listVisibleByOrg(request.auth.uid);
      allow create: if request.auth.uid == request.resource.data.superAdminId;
      allow update: if isExistingOwner(resource.data.superAdminId) && resource.data.organizationId == request.auth.uid;
      allow delete: if isExistingOwner(resource.data.superAdminId) && resource.data.organizationId == request.auth.uid;
    }

    /**
     * @description Secure device information, scoped to departments and organizations.
     * @path /devices/{deviceId}
     * @allow (get) if isSignedIn() && resource.data.organizationId == request.auth.uid
     * @allow (list) if isSignedIn() && listVisibleByOrg(request.auth.uid)
     * @allow (create) if request.auth.uid == request.resource.data.organizationId
     * @allow (update, delete) if isExistingOwner(resource.data.organizationId)
     * @deny (create) if request.auth.uid != request.resource.data.organizationId
     * @deny (update, delete) if !isExistingOwner(resource.data.organizationId)
     * @principle Enforces organizational scoping for device access and modification.
     */
    match /devices/{deviceId} {
      allow get: if isSignedIn() && resource.data.organizationId == request.auth.uid;
      allow list: if isSignedIn() && listVisibleByOrg(request.auth.uid);
      allow create: if request.auth.uid == request.resource.data.organizationId;
      allow update: if isExistingOwner(resource.data.organizationId);
      allow delete: if isExistingOwner(resource.data.organizationId);
    }

    /**
     * @description Secure sensor readings, scoped to devices and organizations.
     * @path /sensorReadings/{readingId}
     * @allow (get) if isSignedIn() && resource.data.organizationId == request.auth.uid
     * @allow (list) if isSignedIn() && listVisibleByOrg(request.auth.uid)
     * @allow (create) if request.auth.uid == request.resource.data.organizationId
     * @allow (update, delete) if false;
     * @deny (create) if request.auth.uid != request.resource.data.organizationId
     * @principle Enforces organizational scoping for sensor data access. Prevents modification of sensor data.
     */
    match /sensorReadings/{readingId} {
      allow get: if isSignedIn() && resource.data.organizationId == request.auth.uid;
      allow list: if isSignedIn() && listVisibleByOrg(request.auth.uid);
      allow create: if request.auth.uid == request.resource.data.organizationId;
      allow update: if false;
      allow delete: if false;
    }

  }

  // Helper functions
  function isSignedIn() {
    return request.auth != null;
  }

  function isOwner(userId) {
    return request.auth.uid == userId;
  }

  function isExistingOwner(userId) {
    return isSignedIn() && isOwner(userId) && resource != null;
  }
    // Helper function to determine if the list operation is visible by the org.
    function listVisibleByOrg(orgId) {
      return isSignedIn() && request.auth.uid == orgId;
    }
}