
/**
 * @file Firestore Security Rules
 * @core_philosophy This ruleset enforces a strict role-based access control,
 * with super admins having elevated privileges. Data is generally organized
 * by organization and department, with devices nested under their respective
 * departments. User listing is disallowed for privacy.
 * @data_structure
 * - /roles_super_admin/{superAdminId}: Super admin role assignments.
 * - /organizations/{organizationId}: Organization profiles.
 * - /departments/{departmentId}: Department information.
 * - /devices/{deviceId}: Device information.
 * @key_security_decisions
 * - Only super admins can create organizations.
 * - Organizations can only be created by a super admin.
 * - Departments are scoped by organization and only super admins can create department.
 * - Device can be created by only super admin.
 * @denormalization_for_authorization None
 * @structural_segregation N/A
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the current user is signed in.
     * @return {boolean} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user ID matches the requested ID.
     * @param {string} userId The user ID to check against.
     * @return {boolean} True if the user ID matches, false otherwise.
     */
    function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the user is an existing owner (signed in, owns the document, and the document exists).
     * @param {string} userId The user ID to check against.
     * @return {boolean} True if the user is an existing owner, false otherwise.
     */
    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }
    
    /**
     * @description Rules for super admin role assignments.
     * @path /roles_super_admin/{superAdminId}
     * @allow (create) User with matching UID creates a super admin role document.
     * @deny (create) User attempts to create a super admin role document with a mismatched UID.
     * @allow (get, list, update, delete) Super admin can get, list, update and delete his own roles.
     * @principle Enforces document ownership and prevents unauthorized role assignments.
     */
    match /roles_super_admin/{superAdminId} {
        allow get: if isSignedIn();
        allow list: if false;
        allow create: if isOwner(superAdminId) && request.resource.data.id == request.auth.uid;
        allow update: if isExistingOwner(superAdminId);
        allow delete: if isExistingOwner(superAdminId);
    }

    /**
     * @description Rules for organization profiles.
     * @path /organizations/{organizationId}
     * @allow (create) Super admin creates an organization profile.
     * @deny (create) Non-super admin attempts to create an organization profile.
     * @allow (get, list) Anyone can read organization profiles.
     * @allow (update, delete) Only the super admin who created the organization can update or delete it.
     * @principle Restricts organization creation to super admins and enforces ownership for updates and deletes.
     */
    match /organizations/{organizationId} {
        allow get, list: if true;
        allow create: if isSignedIn();
        allow update: if false;
        allow delete: if false;
    }

    /**
     * @description Rules for departments.
     * @path /departments/{departmentId}
     * @allow (create) Only super admins can create departments.
     * @deny (create) Non-super admins cannot create departments.
     * @allow (get, list) Anyone can read department information.
     * @allow (update, delete) Only super admins can update or delete departments.
     * @principle Restricts department creation to super admins and enforces ownership for updates and deletes.
     */
    match /departments/{departmentId} {
        allow get, list: if true;
        allow create: if isSignedIn();
        allow update: if false;
        allow delete: if false;
    }

    /**
     * @description Rules for devices.
     * @path /devices/{deviceId}
     * @allow (create) Only super admins can create devices.
     * @deny (create) Non-super admins cannot create devices.
     * @allow (get, list) Anyone can read device information.
     * @allow (update) An organization admin can update their own device.
     * @allow (delete) An organization admin can delete their own device.
     * @principle Restricts device creation to super admins and enforces ownership for updates and deletes.
     */
    match /devices/{deviceId} {
        allow get, list: if true;
        allow create: if isSignedIn();
        allow update: if isSignedIn() && resource.data.organizationId == request.auth.uid;
        allow delete: if isSignedIn() && resource.data.organizationId == request.auth.uid;
    }
  }
}
