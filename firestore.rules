rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Manages Super Admin role assignments.
     * @path /roles_super_admin/{superAdminId}
     * @allow (create) - A user with matching auth UID can create their Super Admin role document.
     * @allow (get, list) - Any authenticated user can check for the existence of a Super Admin role document.
     * @allow (update, delete) - No one can update or delete the super admin role once created.
     * @deny (create) - A user cannot create a Super Admin document with an ID that doesn't match their auth UID.
     * @deny (update, delete) - No one should be able to update or delete this document once created.
     * @principle DBAC (Database Auth Based Control): Super Admin status is determined by the existence of a document.
     */
    match /roles_super_admin/{superAdminId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == superAdminId;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Manages Admin profiles, only Super Admins can manage them.
     * @path /admins/{adminId}
     * @allow (create) - A Super Admin can create a new Admin profile.
     * @allow (get) - Any authenticated user can retrieve an Admin profile.
     * @allow (list) - Only Super Admins can list Admin profiles.
     * @allow (update, delete) - Only Super Admins can update or delete Admin profiles.
     * @deny (create) - A non-Super Admin cannot create an Admin profile.
     * @deny (update, delete) - A non-Super Admin cannot update or delete an Admin profile.
     * @principle Enforces role-based access control; only Super Admins can manage Admin profiles.
     */
    match /admins/{adminId} {
      allow get: if isSignedIn();
      allow list: if isSuperAdmin();
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }
  }

  // Helper functions
  function isSignedIn() {
    return request.auth != null;
  }

  function isSuperAdmin() {
    return exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
  }
}