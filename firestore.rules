/**
 * @fileOverview Firestore Security Rules for the AuthStation application.
 *
 * Core Philosophy:
 * This ruleset enforces a role-based access control model with authorization independence. Super Admins are managed via a dedicated `roles_super_admin` collection. Admins and Devices are linked by IDs, enabling fine-grained access control. Alerts are associated with admin accounts, isolating alert data.
 *
 * Data Structure:
 * - `/roles_super_admin/{superAdminId}`: Documents indicating Super Admin status. Existence of a document grants Super Admin privileges.
 * - `/admins/{adminId}`: Admin user profiles, linked to a Super Admin via `superAdminId`.
 * - `/devices/{deviceId}`: IoT device data, linked to an Admin via `adminId`.
 * - `/alerts/{alertId}`: System alerts, linked to an Admin via `adminId`.
 *
 * Key Security Decisions:
 * - Role-Based Access: Super Admin status is determined by the existence of a document in `/roles_super_admin/{superAdminId}`.
 * - Authorization Independence: Admin access is NOT dependent on reading the Super Admin's document.
 * - Data Isolation: Admins can only access Devices and Alerts associated with their `adminId`.
 * - Super Admins cannot list all Admins.
 *
 * Denormalization for Authorization:
 * - The `adminId` field is denormalized into the `Device` and `Alert` documents. This allows us to write rules that check `request.auth.uid == resource.data.adminId` without needing to perform additional `get()` operations.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     * @path N/A (Helper function)
     * @allow N/A (Helper function)
     * @deny N/A (Helper function)
     * @principle N/A (Helper function)
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user's UID matches the provided userId.
     * @path N/A (Helper function)
     * @allow N/A (Helper function)
     * @deny N/A (Helper function)
     * @principle Ensures only the owner can access their data.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user's UID matches the provided userId and the resource exists.
     * @path N/A (Helper function)
     * @allow N/A (Helper function)
     * @deny N/A (Helper function)
     * @principle Ensures only the existing owner can modify their data.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Determines if the user is a Super Admin based on document existence.
     * @path N/A (Helper function)
     * @allow N/A (Helper function)
     * @deny N/A (Helper function)
     * @principle Checks for Super Admin role based on document existence.
     */
    function isSuperAdmin() {
      return exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
    }

    /**
     * @description Rules for Super Admin role management.
     * @path /roles_super_admin/{superAdminId}
     * @allow (create) User with matching UID creates their Super Admin role: `auth.uid == superAdminId`.
     * @deny (create) User attempts to create a Super Admin role for another user: `auth.uid != superAdminId`.
     * @principle Restricts Super Admin role creation to the authenticated user.
     */
    match /roles_super_admin/{superAdminId} {
      // Access Control Pattern: Ownership
      allow get: if false; // No one is allowed to read a super admin role directly via get
      allow list: if false; // No one is allowed to list super admins

      allow create: if isSignedIn() && isOwner(superAdminId);
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Rules for Admin profile management.
     * @path /admins/{adminId}
     * @allow (create) Super Admin creates a new Admin profile.
     * @deny (create) Non-Super Admin attempts to create an Admin profile.
     * @principle Super Admins manage Admin profiles.
     */
    match /admins/{adminId} {
      // Access Control Pattern: Roles (SuperAdmin)
      allow get: if isSignedIn() && isOwner(adminId);
      allow list: if false; // Super Admins are not allowed to list all admins.

      allow create: if isSignedIn() && isSuperAdmin() && request.resource.data.superAdminId == request.auth.uid && request.resource.data.id == adminId;
      allow update: if isSignedIn() && isSuperAdmin() && resource.data.superAdminId == request.auth.uid && resource.data.id == adminId;
      allow delete: if isSignedIn() && isSuperAdmin() && resource.data.superAdminId == request.auth.uid && resource.data.id == adminId;
    }

    /**
     * @description Rules for Device data management.
     * @path /devices/{deviceId}
     * @allow (create) Admin creates a new device profile with matching `adminId`.
     * @deny (update) Non-Admin attempts to modify a device profile.
     * @principle Admins manage their own devices.
     */
    match /devices/{deviceId} {
      // Access Control Pattern: Ownership (via adminId)
      allow get: if isSignedIn() && resource.data.adminId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.adminId == request.auth.uid;

      allow create: if isSignedIn() && request.resource.data.adminId == request.auth.uid && request.resource.data.id == deviceId;
      allow update: if isSignedIn() && isExistingOwner(resource.data.adminId) && resource.data.id == deviceId;
      allow delete: if isSignedIn() && isExistingOwner(resource.data.adminId) && resource.data.id == deviceId;
    }

    /**
     * @description Rules for Alert data management.
     * @path /alerts/{alertId}
     * @allow (create) System creates a new alert with matching `adminId`.
     * @deny (update) Non-Admin attempts to modify an alert.
     * @principle Admins manage alerts associated with their account.
     */
    match /alerts/{alertId} {
      // Access Control Pattern: Ownership (via adminId)
      allow get: if isSignedIn() && resource.data.adminId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.adminId == request.auth.uid;

      allow create: if isSignedIn() && request.resource.data.adminId == request.auth.uid;
      allow update: if isSignedIn() && isExistingOwner(resource.data.adminId);
      allow delete: if isSignedIn() && isExistingOwner(resource.data.adminId);
    }
  }
}