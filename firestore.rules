/**
 * @fileoverview Firestore Security Rules for AuthStation.
 *
 * Core Philosophy:
 * This ruleset enforces a role-based access control model. Super Admins are granted elevated privileges via document existence in the `/roles_super_admin/{superAdminId}` collection. Admins and devices are associated via the `adminId` field and alerts are linked via `deviceId` and `adminId`.
 *
 * Data Structure:
 * - /roles_super_admin/{superAdminId}: Super Admin role documents. Existence confers super admin status.
 * - /admins/{adminId}: Admin profile documents, linked to a Super Admin via `superAdminId`.
 * - /devices/{deviceId}: IoT device data, linked to an Admin via `adminId`.
 * - /alerts/{alertId}: System alerts, linked to a device via `deviceId` and an Admin via `adminId`.
 *
 * Key Security Decisions:
 * - Super Admin role is determined by document existence in `/roles_super_admin/{superAdminId}`.
 * - Admins can only manage their own devices and alerts (enforced via `adminId`).
 * - Listing devices and alerts is restricted to admins based on `adminId`.
 * - Authorization Independence is maintained by avoiding `get()` calls in security rules.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user's UID matches the provided user ID.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user's UID matches the document's owner ID and the document exists.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Determines if the requesting user is a Super Admin based on document existence.
     */
    function isSuperAdmin() {
      return exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
    }


    /**
     * @description Security rules for Super Admin role documents.
     * @path /roles_super_admin/{superAdminId}
     * @allow (get) User "p4a8KfA23kRCuabLpvw10cVKfXo2" can read their own SuperAdmin role if they are authenticated.
     * @allow (create) User "p4a8KfA23kRCuabLpvw10cVKfXo2" can create their own SuperAdmin role if they are authenticated and the document ID matches their UID.
     * @deny (get) User "randomId" cannot read another user's SuperAdmin role.
     * @deny (create) User "randomId" cannot create a SuperAdmin role with a different document ID.
     * @principle Enforces owner-only access for Super Admin role documents.
     */
    match /roles_super_admin/{superAdminId} {
      allow get: if isOwner(superAdminId);
      allow list: if false;
      allow create: if isOwner(superAdminId);
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Security rules for Admin profile documents.
     * @path /admins/{adminId}
     * @allow (get) User "adminId" can read their own Admin profile if they are authenticated and the document ID matches their UID.
     * @allow (create) User "adminId" can create their own Admin profile if they are a super admin.
     * @allow (update) User "adminId" can update their own Admin profile if they are the owner (adminId)
     * @deny (get) User "randomId" cannot read another user's Admin profile.
     * @deny (create) User "randomId" cannot create an Admin profile with a different document ID.
     * @principle Enforces owner-only access for Admin profile documents, but allows super admins to create them.
     */
    match /admins/{adminId} {
      allow get: if isOwner(adminId);
      allow list: if false;
      allow create: if isSuperAdmin();
      allow update: if isExistingOwner(adminId);
      allow delete: if false;
    }

    /**
     * @description Security rules for IoT device documents.
     * @path /devices/{deviceId}
     * @allow (get) Admins can read device data.
     * @allow (create) Admins can create device data, enforcing that the `adminId` field matches their own UID.
     * @allow (update) Admins can update their own device data, but the `adminId` field cannot be changed.
     * @deny (get) Non-admins cannot read device data.
     * @deny (create) Admins cannot create device data with a mismatched `adminId`.
     * @principle Enforces admin-ownership and data isolation for devices.
     */
    match /devices/{deviceId} {
      allow get: if isSignedIn() && resource.data.adminId == request.auth.uid;
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.adminId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.adminId) && resource.data.adminId == request.resource.data.adminId;
      allow delete: if false;
    }

    /**
     * @description Security rules for system alert documents.
     * @path /alerts/{alertId}
     * @allow (get) Admins can read alert data associated with their admin ID.
     * @allow (create) Admins can create alert data, provided the `adminId` matches their own UID.
     * @allow (update) Admins can update alerts if they are an existing owner.
     * @deny (get) Non-admins cannot read alert data.
     * @deny (create) Admins cannot create alert data with a mismatched `adminId`.
     * @principle Enforces admin-ownership for alerts.
     */
    match /alerts/{alertId} {
      allow get: if isSignedIn() && resource.data.adminId == request.auth.uid;
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.adminId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.adminId);
      allow delete: if false;
    }
  }
}