/**
 * @file Firestore Security Rules for AuthStation.
 *
 * @core_philosophy This ruleset enforces a strict role-based access control model,
 *  where Super Admins and Admins have distinct privileges.  Authorization is
 *  primarily determined by the existence of documents in specific role collections
 *  (e.g., `/roles_super_admin/{superAdminId}`).
 *
 * @data_structure The database consists of two main collections:
 *  - `/roles_super_admin/{superAdminId}`:  Indicates a Firebase Auth user is a Super Admin. The document's content is not used; existence is sufficient.
 *  - `/admins/{adminId}`: Stores Admin profiles, linked to a Super Admin via the `superAdminId` field.
 *
 * @key_security_decisions
 *  - Super Admin privileges are granted solely based on the existence of a document in `/roles_super_admin/{superAdminId}`.
 *  - Admin creation is restricted to Super Admins.
 *  - Listing of admins is only allowed for super admins.
 *  - The rules prioritize Authorization Independence; access control checks do not depend on reading properties of other documents.
 *
 * @denormalization The existence of a document in `/roles_super_admin/{superAdminId}`
 *  acts as a denormalized role assignment, enabling efficient security rules without
 *  requiring extra `get()` calls.
 *
 * @structural_segregation The use of separate collections for super admin roles and admin profiles
 *  allows for clear separation of concerns and simplifies access control logic.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants Super Admin privileges based on the existence of a document in this collection.
     * @path /roles_super_admin/{superAdminId}
     * @allow (create) - Authenticated user with UID matching {superAdminId} can create the role document. This allows self-assignment of the role.
     * @allow (get) - Any authenticated user can check if a superAdmin role exists for the requested superAdminId.
     * @allow (list) - Any authenticated user can list super admin documents.
     * @allow (update) - No updates are permitted. Super Admin role is granted on document creation only.
     * @allow (delete) - Authenticated user with UID matching {superAdminId} can delete the role document. This revokes the role.
     * @deny (create) - Non-authenticated users cannot create Super Admin roles.
     * @deny (update) - No one can update the role document.
     * @deny (delete) - Non-authenticated users cannot delete Super Admin roles.
     * @principle Implements role-based access control (RBAC) using document existence.
     */
    match /roles_super_admin/{superAdminId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isOwner(superAdminId);
      allow update: if false;
      allow delete: if isSignedIn() && isOwner(superAdminId);
    }

    /**
     * @description Stores Admin profiles.  Super Admins can create, read, update, and delete Admin profiles.
     * @path /admins/{adminId}
     * @allow (create) - Super Admins can create new Admin profiles. The 'superAdminId' field in the new document must match the Super Admin's UID.
     * @allow (get) - Super Admins can read Admin profiles.
     * @allow (list) - Super Admins can list Admin profiles.
     * @allow (update) - Super Admins can update existing Admin profiles. The 'superAdminId' field cannot be changed.
     * @allow (delete) - Super Admins can delete Admin profiles.
     * @deny (create) - Non-Super Admins cannot create Admin profiles.
     * @deny (update) - Non-Super Admins cannot update Admin profiles.
     * @deny (delete) - Non-Super Admins cannot delete Admin profiles.
     * @principle Enforces role-based access control (RBAC) and protects the integrity of the SuperAdmin-to-Admin relationship.
     */
    match /admins/{adminId} {
      allow get, list: if isSuperAdmin();
      allow create: if isSuperAdmin() && request.resource.data.superAdminId == request.auth.uid;
      allow update: if isSuperAdmin() && isExistingAdmin() && resource.data.superAdminId == request.resource.data.superAdminId;
      allow delete: if isSuperAdmin() && isExistingAdmin();
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isSuperAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
    }

    function isExistingAdmin() {
        return resource != null;
    }
  }
}