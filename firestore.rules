rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Super Admins can read/write anything
    match /{document=**} {
      allow read, write: if get(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid)).data.email == request.auth.email;
    }

    match /organizations/{orgId} {
      allow read, update: if request.auth.uid == orgId;
    }

    match /departments/{deptId} {
      allow read: if request.auth.uid == get(/databases/$(database)/documents/departments/$(deptId)).data.organizationId;
    }

    match /devices/{deviceId} {
      // Admins can create devices for their own organization
      allow create: if request.auth.uid == request.resource.data.organizationId;

      // Admins can get, update, and delete devices in their own organization
      allow get, update, delete: if request.auth.uid == get(/databases/$(database)/documents/devices/$(deviceId)).data.organizationId;
      
      // Admins can list devices for their own organization
      allow list: if request.auth.uid == request.query.filters[0].value;
    }
  }
}
