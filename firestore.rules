/**
 * @fileOverview Firestore Security Rules for AuthStation application.
 *
 * Core Philosophy:
 * This ruleset enforces a role-based access control model, primarily focused on securing access for Super Admins and Admins. It utilizes Authorization Independence and Database Auth Based Control (DBAC) principles.
 *
 * Data Structure:
 * - /roles_super_admin/{superAdminId}: Documents indicating Super Admin status, where the document ID is the Firebase Auth UID.
 * - /admins/{adminId}: Documents containing Admin profiles, linked to a Super Admin via the superAdminId field.
 * - /devices/{deviceId}: Documents containing IoT device data, linked to an admin account
 * - /alerts/{alertId}: Documents containing system alerts generated from devices, linked to an admin account
 *
 * Key Security Decisions:
 * - Super Admin privileges are determined by the existence of a document in the `/roles_super_admin/{superAdminId}` collection.
 * - Authorization Independence: Admin access is governed by their own document and the `adminId` within device documents, not by data within the Super Admin's profile.
 * - Data Isolation: Admins can only access devices and alerts associated with their `adminId`.
 * - No user listing is allowed for the `/roles_super_admin` collection.
 *
 * Denormalization for Authorization:
 * - The `superAdminId` field is denormalized into the Admin document to establish the relationship between Admins and Super Admins.
 * - The `adminId` field is denormalized into the Device and Alert documents to establish the relationship between Devices/Alerts and Admins.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secure Super Admin role assignment. Only an authenticated user can create their own role document.
     * @path /roles_super_admin/{superAdminId}
     * @allow (create) User with UID 'user_abc' can create /roles_super_admin/user_abc if authenticated.
     * @deny (create) User with UID 'user_abc' cannot create /roles_super_admin/user_xyz.
     * @deny (update) No one can update a role document.
     * @deny (delete) No one can delete a role document.
     * @principle Enforces self-creation of role and prevents modification or deletion.
     */
    match /roles_super_admin/{superAdminId} {
      allow get: if false;
      allow list: if false;

      allow create: if isSignedIn() && isOwner(superAdminId);
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Manages Admin profiles. Super Admins can create admins. Admins can read their own profile.
     * @path /admins/{adminId}
     * @allow (create) SuperAdmin with UID 'super_admin_abc' can create an admin profile under /admins/{adminId}.
     * @allow (get) Admin with UID 'admin_abc' can get their own profile at /admins/admin_abc.
     * @deny (create) Unauthorized user cannot create admin profiles.
     * @deny (update) Regular users cannot modify admin profiles.
     * @deny (delete) Regular users cannot delete admin profiles.
     * @principle Enforces Super Admin control over Admin creation.
     */
    match /admins/{adminId} {
      allow get: if isSignedIn() && isOwner(adminId);
      allow list: if false;

      allow create: if isSignedIn() && isAdminCreationRequestValid(adminId);
      allow update: if isSignedIn() && isAdminUpdateRequestValid(adminId);
      allow delete: if false;
    }

      /**
       * @description Manages IoT device data. Admins can create, read, update, and delete devices associated with their account.
       * @path /devices/{deviceId}
       * @allow (create) Admin with UID 'admin_abc' can create a device under /devices/{deviceId} if device.adminId == 'admin_abc'.
       * @allow (get) Admin with UID 'admin_abc' can get a device at /devices/{deviceId} if device.adminId == 'admin_abc'.
       * @allow (update) Admin with UID 'admin_abc' can update a device at /devices/{deviceId} if device.adminId == 'admin_abc'.
       * @allow (delete) Admin with UID 'admin_abc' can delete a device at /devices/{deviceId} if device.adminId == 'admin_abc'.
       * @deny (create) Unauthorized user cannot create devices.
       * @deny (update) Regular users cannot modify devices they don't own.
       * @principle Enforces Admin ownership of devices.
       */
    match /devices/{deviceId} {
        allow get: if isSignedIn() && isDeviceOwnedByAdmin(deviceId);
        allow list: if isSignedIn() && isListingAllowedForAdmin();

        allow create: if isSignedIn() && isDeviceCreationRequestValid(deviceId);
        allow update: if isSignedIn() && isDeviceOwnedByAdmin(deviceId) && resource != null;
        allow delete: if isSignedIn() && isDeviceOwnedByAdmin(deviceId) && resource != null;
    }

    /**
     * @description Manages system alerts. Admins can create, read, update, and delete alerts associated with their account.
     * @path /alerts/{alertId}
     * @allow (create) Admin with UID 'admin_abc' can create an alert under /alerts/{alertId} if alert.adminId == 'admin_abc'.
     * @allow (get) Admin with UID 'admin_abc' can get an alert at /alerts/{alertId} if alert.adminId == 'admin_abc'.
     * @allow (update) Admin with UID 'admin_abc' can update an alert at /alerts/{alertId} if alert.adminId == 'admin_abc'.
     * @allow (delete) Admin with UID 'admin_abc' can delete an alert at /alerts/{alertId} if alert.adminId == 'admin_abc'.
     * @deny (create) Unauthorized user cannot create alerts.
     * @deny (update) Regular users cannot modify alerts they don't own.
     * @principle Enforces Admin ownership of alerts.
     */
    match /alerts/{alertId} {
        allow get: if isSignedIn() && isAlertOwnedByAdmin(alertId);
        allow list: if isSignedIn() && isListingAllowedForAdmin();

        allow create: if isSignedIn() && isAlertCreationRequestValid(alertId);
        allow update: if isSignedIn() && isAlertOwnedByAdmin(alertId) && resource != null;
        allow delete: if isSignedIn() && isAlertOwnedByAdmin(alertId) && resource != null;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdminCreationRequestValid(adminId) {
      return request.resource.data.id == adminId && isValidSuperAdminId(request.resource.data.superAdminId);
    }

    function isAdminUpdateRequestValid(adminId) {
        return request.resource.data.id == adminId;
    }

      function isDeviceCreationRequestValid(deviceId) {
          return request.resource.data.id == deviceId && request.resource.data.adminId == request.auth.uid;
      }

    function isValidSuperAdminId(superAdminId) {
      return get(/databases/$(database)/documents/roles_super_admin/$(superAdminId)).data != null;
    }

      function isDeviceOwnedByAdmin(deviceId) {
          return get(/databases/$(database)/documents/devices/$(deviceId)).data.adminId == request.auth.uid;
      }

      function isAlertCreationRequestValid(alertId) {
        return request.resource.data.id == alertId && request.resource.data.adminId == request.auth.uid;
      }

      function isAlertOwnedByAdmin(alertId) {
          return get(/databases/$(database)/documents/alerts/$(alertId)).data.adminId == request.auth.uid;
      }

      function isListingAllowedForAdmin() {
        return true;
      }
  }
}