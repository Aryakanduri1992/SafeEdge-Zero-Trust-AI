/**
 * @fileoverview Firestore Security Rules for AuthStation.
 *
 * Core Philosophy:
 * This ruleset enforces a role-based access control model with super-admin privileges and organization-based ownership.
 * Super admins have full access to their organizations and departments, while regular users might have more restricted access (currently not implemented).
 *
 * Data Structure:
 * - /roles_super_admin/{superAdminId}: Documents to identify Super Admins (created on user signup).
 * - /organizations/{organizationId}: Stores organization profiles.
 * - /departments/{departmentId}: Stores department data, linked to organizations.
 * - /devices/{deviceId}: Stores device information, linked to organizations and departments.
 *
 * Key Security Decisions:
 * - Only super admins can create, update or delete organizations
 * - Devices cannot be listed publicly.
 *
 * Denormalization for Authorization:
 * The `superAdminId` field is denormalized onto Organizations, Departments to facilitate authorization checks.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows super admins to manage their roles.
     * @path /roles_super_admin/{superAdminId}
     * @allow (create) - A user with a matching UID can create their own super admin role.
     * @allow (get) - Any authenticated user can check if a super admin role exists.
     * @allow (list) - Only an authenticated user can list.
     * @allow (update) - Only an authenticated user can update if owner.
     * @allow (delete) - Only an authenticated user can delete if owner.
     * @deny (create) - A user cannot create a super admin role for another user.
     * @deny (update) - A user cannot modify another user's super admin role.
     * @deny (delete) - A user cannot delete another user's super admin role.
     * @principle Enforces self-creation and ownership for super admin roles.
     */
    match /roles_super_admin/{superAdminId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner() {
        return request.auth.uid == superAdminId;
      }

      function isExistingOwner() {
        return request.auth.uid == resource.id;
      }
        allow get: if isSignedIn();
        allow list: if false;
        allow create: if isSignedIn() && request.auth.uid == superAdminId;
        allow update: if isSignedIn() && isExistingOwner();
        allow delete: if isSignedIn() && isExistingOwner();
    }

    /**
     * @description Allows super admins to manage their organizations.
     * @path /organizations/{organizationId}
     * @allow (create) - Only a super admin can create an organization. Must match auth uid.
     * @allow (get) - Anyone can read organization data.
     * @allow (list) - Anyone can list organizations.
     * @allow (update) - Only the super admin who owns the organization can update it.
     * @allow (delete) - Only the super admin who owns the organization can delete it.
     * @deny (create) - Regular users cannot create organizations.
     * @deny (update) - Users cannot modify organizations they don't own.
     * @deny (delete) - Users cannot delete organizations they don't own.
     * @principle Enforces owner-only writes with public reads for organizations.
     */
    match /organizations/{organizationId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner() {
        return request.auth.uid == resource.data.superAdminId;
      }

       function isCreatingOwner() {
        return request.auth.uid == request.resource.data.superAdminId;
      }

      allow get, list: if true;
      allow create: if isSignedIn() && isCreatingOwner();
      allow update: if isSignedIn() && isOwner();
      allow delete: if isSignedIn() && isOwner();
    }

    /**
     * @description Allows super admins to manage departments within their organizations.
     * @path /departments/{departmentId}
     * @allow (create) - Only a super admin can create a department, and superAdminId must match auth uid.
     * @allow (get) - Any authenticated user can read department data.
     * @allow (list) - Any authenticated user can list departments.
     * @allow (update) - Only the super admin who owns the organization that the department belongs to can update it.
     * @allow (delete) - Only the super admin who owns the organization that the department belongs to can delete it.
     * @deny (create) - Regular users cannot create departments.
     * @deny (update) - Users cannot modify departments in organizations they don't own.
     * @deny (delete) - Users cannot delete departments in organizations they don't own.
     * @principle Enforces organization-based ownership for department management.
     */
    match /departments/{departmentId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner() {
        return request.auth.uid == resource.data.superAdminId;
      }

       function isCreatingOwner() {
        return request.auth.uid == request.resource.data.superAdminId;
      }

      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isCreatingOwner();
      allow update: if isSignedIn() && isOwner();
      allow delete: if isSignedIn() && isOwner();
    }

    /**
     * @description Manages access to device information.
     * @path /devices/{deviceId}
     * @allow (create) - Only a super admin can create a device, and superAdminId must match auth uid.
     * @allow (get) - Only a super admin can get a device.
     * @deny (list) - No listing allowed
     * @allow (update) - Only the super admin who owns the organization that the device belongs to can update it.
     * @allow (delete) - Only the super admin who owns the organization that the device belongs to can delete it.
     * @principle Enforces organization-based ownership for device management.
     */
    match /devices/{deviceId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function getDepartment(departmentId) {
          return get(/databases/$(database)/documents/departments/$(departmentId)).data.superAdminId;
      }

      function isCreatingOwner() {
        return request.resource.data.containsKey('departmentId') && request.auth.uid == getDepartment(request.resource.data.departmentId);
      }

      function isOwner() {
        return resource.data.containsKey('departmentId') && request.auth.uid == getDepartment(resource.data.departmentId);
      }


      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn() && isCreatingOwner();
      allow update: if isSignedIn() && isOwner();
      allow delete: if isSignedIn() && isOwner();
    }
  }
}