/**
 * @fileoverview Firestore Security Rules for AuthStation.
 *
 * Core Philosophy:
 * This ruleset enforces a role-based access control model with Super Admins and Organizations.
 * Super Admins have elevated privileges. Organizations manage their own departments (Admins) and devices.
 *
 * Data Structure:
 * - /roles_super_admin/{superAdminId}: Documents indicating super admin status, where superAdminId matches the Firebase Auth UID.
 * - /organizations/{organizationId}: Documents representing organizations, where organizationId matches the Firebase Auth UID.
 * - /admins/{adminId}: Documents representing departments within organizations. Contains an `organizationId` field linking it to the parent organization.
 * - /devices/{deviceId}: Documents representing IoT devices, linked to a department (Admin document) via the `adminId` field.
 * - /alerts/{alertId}: Documents representing alerts generated by devices, linked to a department (Admin document) via the `adminId` field.
 *
 * Key Security Decisions:
 * - Super Admins are granted read and write access to all organizations and departments.
 * - Organizations can manage their own departments and devices.
 * - Devices and alerts are associated with departments, and access is controlled through the department's organization.
 * - Listing all devices is denied for regular authenticated users.
 *
 * Denormalization for Authorization:
 * - The `admins` and `devices` collections have `organizationId` and `adminId` respectively to avoid queries and enforce ownership.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user's UID matches the given userId.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the user's UID matches the resource's superAdminId.
     */
    function isSuperAdminOwner(superAdminId) {
        return request.auth.uid == superAdminId;
    }

    /**
     * @description Checks if the user's UID matches the resource's organizationId.
     */
    function isOrganizationOwner(organizationId) {
        return request.auth.uid == organizationId;
    }

     /**
     * @description Checks if the user's UID matches the resource's adminId.
     */
    function isAdminOwner(adminId) {
        return request.auth.uid == adminId;
    }

     /**
     * @description Checks if the organization exists and the request is coming from the owner
     */
    function isExistingOrganizationOwner(organizationId) {
      return (isOrganizationOwner(organizationId) && getSelf().data != null);
    }
    
    /**
     * @description Checks if the super admin exists and the request is coming from the owner
     */
    function isExistingSuperAdminOwner(superAdminId) {
      return (isSuperAdminOwner(superAdminId) && getSelf().data != null);
    }
    
    /**
     * @description Checks if the organization ID exists on the document and if the organization owner is making the request.
     */
    function organizationIdMatchesResource(organizationId) {
        return request.resource.data.organizationId == organizationId;
    }
    
    /**
     * @description Checks if the super admin ID exists on the document and if the super admin is making the request.
     */
    function superAdminIdMatchesResource(superAdminId) {
        return request.resource.data.superAdminId == superAdminId;
    }

    function getSelf() {
        return get(/databases/$(database)/documents/$(request.path));
    }

    /**
     * @description Rules for the /roles_super_admin/{superAdminId} collection.
     * @path /roles_super_admin/{superAdminId}
     * @allow (get) User with matching UID can read their own super admin role.
     * @allow (create) User with matching UID can create their own super admin role.
     * @deny (get) User tries to read a different super admin role.
     * @deny (create) User tries to create a super admin role for someone else.
     * @principle Enforces document ownership for reads and writes.
     */
    match /roles_super_admin/{superAdminId} {
      allow get: if isSignedIn() && isOwner(superAdminId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(superAdminId);
      allow update: if isSignedIn() && isOwner(superAdminId);
      allow delete: if isSignedIn() && isOwner(superAdminId);
    }

    /**
     * @description Rules for the /organizations/{organizationId} collection.
     * @path /organizations/{organizationId}
     * @allow (get) Organization with matching UID can read its own organization profile.
     * @allow (create) Organization with matching UID can create its own organization profile.
     * @deny (get) User tries to read a different organization's profile.
     * @deny (create) User tries to create an organization profile for someone else.
     * @principle Enforces document ownership for reads and writes.
     */
    match /organizations/{organizationId} {
      allow get: if isSignedIn() && isOwner(organizationId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(organizationId);
      allow update: if isSignedIn() && isOwner(organizationId);
      allow delete: if isSignedIn() && isOwner(organizationId);
    }

    /**
     * @description Rules for the /admins/{adminId} collection.
     * @path /admins/{adminId}
     * @allow (get) Organization with matching organizationId can read admin profiles.
     * @allow (create) Organization with matching organizationId can create admin profiles with a matching organizationId on the document.
     * @deny (update) Regular user tries to update an admin profile.
     * @deny (delete) Regular user tries to delete an admin profile.
     * @principle Enforces that only the parent organization can create and manage departments.
     */
    match /admins/{adminId} {
      allow get: if isSignedIn() && get(/databases/$(database)/documents/organizations/$(resource.data.organizationId)).data != null;
      allow list: if false;
      allow create: if isSignedIn() && request.resource.data.organizationId == request.auth.uid && get(/databases/$(database)/documents/organizations/$(request.auth.uid)).data != null;
      allow update: if isSignedIn() && get(/databases/$(database)/documents/organizations/$(resource.data.organizationId)).data != null;
      allow delete: if isSignedIn() && get(/databases/$(database)/documents/organizations/$(resource.data.organizationId)).data != null;
    }

    /**
     * @description Rules for the /devices/{deviceId} collection.
     * @path /devices/{deviceId}
     * @allow (get) Organization with matching organizationId can read device data.
     * @deny (create) Regular user tries to create device data.
     * @deny (update) Regular user tries to update device data.
     * @deny (delete) Regular user tries to delete device data.
     */
    match /devices/{deviceId} {
        allow get: if isSignedIn() && get(/databases/$(database)/documents/admins/$(resource.data.adminId)).data.organizationId == request.auth.uid;
        allow list: if false;
        allow create: if isSignedIn() && get(/databases/$(database)/documents/admins/$(request.resource.data.adminId)).data.organizationId == request.auth.uid;
        allow update: if isSignedIn() && get(/databases/$(database)/documents/admins/$(resource.data.adminId)).data.organizationId == request.auth.uid;
        allow delete: if isSignedIn() && get(/databases/$(database)/documents/admins/$(resource.data.adminId)).data.organizationId == request.auth.uid;
    }

    /**
     * @description Rules for the /alerts/{alertId} collection.
     * @path /alerts/{alertId}
     * @allow (get) Organization with matching organizationId can read alert data.
     * @deny (create) Regular user tries to create alert data.
     * @deny (update) Regular user tries to update alert data.
     * @deny (delete) Regular user tries to delete alert data.
     */
    match /alerts/{alertId} {
        allow get: if isSignedIn() && get(/databases/$(database)/documents/admins/$(resource.data.adminId)).data.organizationId == request.auth.uid;
        allow list: if false;
        allow create: if isSignedIn() && get(/databases/$(database)/documents/admins/$(request.resource.data.adminId)).data.organizationId == request.auth.uid;
        allow update: if isSignedIn() && get(/databases/$(database)/documents/admins/$(resource.data.adminId)).data.organizationId == request.auth.uid;
        allow delete: if isSignedIn() && get(/databases/$(database)/documents/admins/$(resource.data.adminId)).data.organizationId == request.auth.uid;
    }
  }
}