/**
 * @fileoverview Firestore Security Rules for AuthStation application.
 *
 * Core Philosophy:
 * This ruleset enforces a hierarchical security model based on Super Admins, Organizations, and Admins (Departments).
 * Organizations have a single login, and Departments are linked to their parent Organization via the `organizationId` field.
 * Super Admins have elevated privileges, but these are not currently implemented.
 *
 * Data Structure:
 * - /roles_super_admin/{superAdminId}: Indicates a Super Admin user.
 * - /organizations/{organizationId}: Stores Organization profiles, linked to a Firebase Auth UID.
 * - /admins/{adminId}: Stores Department (Admin) profiles, linked to an Organization via 'organizationId'.
 * - /devices/{deviceId}: Stores IoT device data, linked to a Department (Admin document).
 * - /alerts/{alertId}: Stores system alerts generated from devices, linked to a Department (Admin document).
 *
 * Key Security Decisions:
 * - User listing is generally disallowed.
 * - `get` operations do not verify document existence.
 * - Write operations are strictly controlled via ownership and relational integrity checks.
 * - Super Admin privileges are not yet implemented, but the `roles_super_admin` collection is in place.
 *
 * Denormalization for Authorization:
 * - Admins (Departments) denormalize `organizationId` to link back to the parent Organization.
 * - Devices denormalize `adminId` to link back to the parent Admin (Department).
 * - Alerts denormalize `adminId` to link back to the parent Admin (Department).
 *
 * Structural Segregation:
 * - No structural segregation is used currently. All data is stored in top-level collections with ownership/relationship links.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     * @path N/A (Helper Function)
     * @allow N/A (Helper Function)
     * @deny N/A (Helper Function)
     * @principle Requires a verified user identity for secure data access.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the request is made by the owner of the resource (based on the document ID).
     * @path N/A (Helper Function)
     * @allow N/A (Helper Function)
     * @deny N/A (Helper Function)
     * @principle Enforces ownership for data access.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the request is made by the owner of the resource (based on the document ID) and the document exists.
     * @path N/A (Helper Function)
     * @allow N/A (Helper Function)
     * @deny N/A (Helper Function)
     * @principle Enforces ownership and verifies document existence for destructive operations.
     */
    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }

    /**
     * @description Defines access rules for the super admin roles collection.
     * @path /roles_super_admin/{superAdminId}
     * @allow (get, list) Signed-in super admin can read their own role.
     * @allow (create) Signed-in user can create their own super admin role (if they are granted the role).
     * @allow (update, delete) Signed-in super admin can update/delete their own role.
     * @deny (get, list) Non-super admin trying to access super admin roles.
     * @deny (create, update, delete) Non-super admin trying to create/update/delete super admin roles.
     * @principle Enforces owner-only access for managing super admin roles.
     */
    match /roles_super_admin/{superAdminId} {
      allow get: if isSignedIn() && isOwner(superAdminId);
      allow list: if isSignedIn() && isOwner(superAdminId);
      allow create: if isSignedIn() && isOwner(superAdminId);
      allow update: if isSignedIn() && isExistingOwner(superAdminId);
      allow delete: if isExistingOwner(superAdminId);
    }

    /**
     * @description Defines access rules for the organizations collection.
     * @path /organizations/{organizationId}
     * @allow (get, list) Any user can read organizations.
     * @allow (create) Signed-in user can create an organization with their UID as the organizationId.
     * @allow (update, delete) Only the organization itself can update or delete its profile.
     * @deny (create) User attempts to create an organization with an ID different from their own UID.
     * @principle Enforces organization ownership and read access for any user.
     */
    match /organizations/{organizationId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && isOwner(organizationId) && request.resource.data.id == organizationId;
      allow update: if isExistingOwner(organizationId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(organizationId);
    }

    /**
     * @description Defines access rules for the admins (departments) collection.
     * @path /admins/{adminId}
     * @allow (get, list) Any user can read department information.
     * @allow (create) Signed-in user can create a department, enforcing that the organizationId matches an existing organization.
     * @allow (update, delete) Only the parent organization can update or delete a department.
     * @deny (create) User attempts to create a department with a mismatched or non-existent organizationId.
     * @principle Enforces organization-level control over department management.
     */
    match /admins/{adminId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.organizationId != null;
      allow update: if isSignedIn() && resource.data.organizationId == request.resource.data.organizationId;
      allow delete: if isSignedIn() && resource.data.organizationId == request.resource.data.organizationId;
    }

    /**
     * @description Defines access rules for the devices collection.
     * @path /devices/{deviceId}
     * @allow (get, list) Any user can read device information.
     * @allow (create) Signed-in user can create a device, enforcing that the adminId matches an existing department.
     * @allow (update, delete) Only the parent organization (via admin) can update or delete a device.
     * @deny (create) User attempts to create a device with a mismatched or non-existent adminId.
     * @principle Enforces department-level control over device management, with organization oversight.
     */
    match /devices/{deviceId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.adminId != null;
      allow update: if isSignedIn() && request.resource.data.adminId != null;
      allow delete: if isSignedIn() && request.resource.data.adminId != null;
    }

    /**
     * @description Defines access rules for the alerts collection.
     * @path /alerts/{alertId}
     * @allow (get, list) Any user can read alert information.
     * @allow (create) Signed-in user can create an alert, enforcing that the adminId matches an existing department.
     * @allow (update, delete) Only the parent organization (via admin) can update or delete an alert.
     * @deny (create) User attempts to create an alert with a mismatched or non-existent adminId.
     * @principle Enforces department-level control over alert management, with organization oversight.
     */
    match /alerts/{alertId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.adminId != null;
      allow update: if isSignedIn() && request.resource.data.adminId != null;
      allow delete: if isSignedIn() && request.resource.data.adminId != null;
    }
  }
}