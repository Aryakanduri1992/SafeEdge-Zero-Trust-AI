/**
 * @fileoverview Firestore Security Rules for AuthStation application.
 *
 * Core Philosophy:
 * This ruleset implements a role-based access control system with SuperAdmin privileges and organization-based data segregation.
 * It enforces strict ownership and authorization checks for data access and modification.
 *
 * Data Structure:
 * - /roles_super_admin/{superAdminId}: Documents identify Super Admins by their UID.
 * - /organizations/{organizationId}: Stores organization profile data.
 * - /departments/{departmentId}: Stores department information, linked to organizations.
 * - /devices/{deviceId}: Stores device information, linked to departments and organizations.
 *
 * Key Security Decisions:
 * - SuperAdmin role is determined by presence in the `roles_super_admin` collection.
 * - Organizations can only be created by a SuperAdmin, with the SuperAdmin ID stored within the Organization document.
 * - Departments are scoped to organizations, with strict validation of `organizationId`.
 * - Devices are scoped to departments and organizations, with `departmentId` and `organizationId` validation.
 * - Listing of SuperAdmins is disallowed for security reasons.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the requesting user is signed in.
     * @path N/A (Helper Function)
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the requesting user is a SuperAdmin.
     * @path N/A (Helper Function)
     */
    function isSuperAdmin() {
      return exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
    }

    /**
     * @description Checks if the requesting user is the owner (identified by userId).
     * @path N/A (Helper Function)
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the requesting user is the existing owner (identified by userId) and the document exists.
     * @path N/A (Helper Function)
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }


    /**
     * @description Rules for the roles_super_admin collection. Only SuperAdmins can create new SuperAdmin records. SuperAdmins can read their own record. Listing all super admins is not allowed.
     * @path /roles_super_admin/{superAdminId}
     */
    match /roles_super_admin/{superAdminId} {
      allow get: if isOwner(superAdminId);
      allow list: if false;
      allow create: if isSuperAdmin() && isOwner(superAdminId);
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Rules for the organizations collection. Only SuperAdmins can create organizations.
     * @path /organizations/{organizationId}
     */
    match /organizations/{organizationId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSuperAdmin() && request.resource.data.superAdminId == request.auth.uid;
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    /**
     * @description Rules for the departments collection.
     * @path /departments/{departmentId}
     */
    match /departments/{departmentId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSuperAdmin() && 'organizationId' in request.resource.data;
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

     /**
      * @description Rules for the devices collection.
      * @path /devices/{deviceId}
      */
    match /devices/{deviceId} {
        allow get: if true;
        allow list: if true;
        allow create: if isSuperAdmin() && 'departmentId' in request.resource.data && 'organizationId' in request.resource.data;
        allow update: if isSuperAdmin();
        allow delete: if isSuperAdmin();
    }
  }
}