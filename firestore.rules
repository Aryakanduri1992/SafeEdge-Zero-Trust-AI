/**
 * @description This ruleset enforces a role-based access control model for the AuthStation application.
 * Super Admins and Admins have specific permissions to manage users, devices and alerts.
 * @dataStructure
 * - `/roles_super_admin/{superAdminId}`: Documents indicating Super Admin status.
 * - `/admins/{adminId}`: Admin user profiles, linked to a Super Admin.
 * - `/devices/{deviceId}`: IoT device data, linked to an admin account.
 * - `/alerts/{alertId}`: System alerts generated by devices, linked to an admin account.
 * @keySecurityDecisions
 * - Super Admin status is determined by the existence of a document in `/roles_super_admin/{superAdminId}`.
 * - Authorization Independence is achieved by denormalizing authorization context (e.g., adminId) directly into documents, avoiding `get()` calls in rules.
 * - `list` operations are secured by segregating data based on access requirements and user's `adminId`.
 * @denormalizationForAuthorization
 *   - The `Admin` document contains a `superAdminId` field, but rules do NOT depend on reading the SuperAdmin document.
 *   - `Alert` and `Device` documents contain `adminId` to isolate data access.
 * @structuralSegregation N/A
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user's UID matches the provided userId.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user's UID matches the provided userId and the document exists.
     */
    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }

    /**
     * @description Allows read and write access to super admin roles only to super admins themselves.
     * @path /roles_super_admin/{superAdminId}
     * @allow (create) User with UID 'user1' creates a super admin role document with ID 'user1'.
     * @deny (create) User with UID 'user1' creates a super admin role document with ID 'user2'.
     * @principle Enforces ownership for super admin role documents.
     */
    match /roles_super_admin/{superAdminId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isOwner(superAdminId);
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows read and write access to admin profiles only to super admins.
     * @path /admins/{adminId}
     * @allow (create) A super admin creates a new admin profile.
     * @deny (create) A regular user tries to create an admin profile.
     * @principle Enforces super admin role for admin profile creation.
     */
    match /admins/{adminId} {
      allow get: if true; // Public read
      allow list: if false;
      allow create: if request.auth.uid == request.resource.data.superAdminId;
      allow update: if isExistingOwner(request.resource.data.superAdminId) && request.resource.data.superAdminId == resource.data.superAdminId;
      allow delete: if isExistingOwner(request.resource.data.superAdminId);
    }

    /**
     * @description Allows read and write access to devices only to admins.
     * @path /devices/{deviceId}
     * @allow (create) An admin creates a new device.
     * @deny (create) A regular user tries to create a device.
     * @principle Enforces admin role for device creation.
     */
    match /devices/{deviceId} {
      allow get: if true; //Public read
      allow list: if true;
      allow create: if request.auth.uid == request.resource.data.adminId;
      allow update: if isExistingOwner(request.resource.data.adminId) && request.resource.data.adminId == resource.data.adminId;
      allow delete: if isExistingOwner(request.resource.data.adminId);
    }

    /**
     * @description Allows read and write access to alerts only to admins.
     * @path /alerts/{alertId}
     * @allow (create) An admin creates a new alert.
     * @deny (create) A regular user tries to create an alert.
     * @principle Enforces admin role for alert creation.
     */
    match /alerts/{alertId} {
      allow get: if true; //Public read
      allow list: if true;
      allow create: if request.auth.uid == request.resource.data.adminId;
      allow update: if isExistingOwner(request.resource.data.adminId) && request.resource.data.adminId == resource.data.adminId;
      allow delete: if isExistingOwner(request.resource.data.adminId);
    }
  }
}