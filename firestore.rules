/**
 * @file Firestore Security Rules for AuthStation
 * @version Prototyping
 *
 * @description This ruleset enforces a hierarchical access control model for the AuthStation application.
 *  It focuses on securing data related to Super Admins, Organizations, Admins (departments), Devices, and Alerts.
 *
 * Data Structure:
 * - /roles_super_admin/{superAdminId}: Stores Super Admin profiles, with document ID matching the Firebase Auth UID.
 * - /organizations/{organizationId}: Stores Organization profiles, with document ID matching the Firebase Auth UID.
 * - /admins/{adminId}: Stores Admin (department) profiles, linked to an organization via the 'organizationId' field.
 * - /devices/{deviceId}: Stores Device data, linked to a department (Admin) via the 'adminId' field.
 * - /alerts/{alertId}: Stores Alert data, linked to a department (Admin) via the 'adminId' field.
 *
 * Key Security Decisions:
 * - Super Admin Role: Super admins are granted elevated privileges based on their presence in the /roles_super_admin collection.
 * - Organization Ownership: Each organization's data is secured using its Firebase Auth UID as the document ID.
 * - Departmental Access: Admins (departments) are linked to organizations via the 'organizationId' field, enabling secure access to devices and alerts within their department.
 * - Denormalization: The `adminId` field is denormalized onto Device and Alert documents to simplify authorization checks.
 * - List Operations: Listing of Super Admins is disallowed. Listing of other collections is allowed for authorized users.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants Super Admins full access to their profile.
     * @path /roles_super_admin/{superAdminId}
     * @allow (get, list) if isSignedIn()
     * @allow (create) if isSuperAdmin(superAdminId)
     * @allow (update, delete) if isExistingSuperAdmin(superAdminId)
     * @deny (create) if !isSuperAdmin(superAdminId)
     * @deny (update, delete) if !isExistingSuperAdmin(superAdminId)
     * @principle Enforces Super Admin ownership for writes.
     */
    match /roles_super_admin/{superAdminId} {
      allow get: if isSignedIn();
      allow list: if false; // Super Admins should not be listable.
      allow create: if isSignedIn() && request.auth.uid == superAdminId;
      allow update: if isSignedIn() && isSuperAdmin(superAdminId) && request.auth.uid == superAdminId;
      allow delete: if isSignedIn() && isSuperAdmin(superAdminId) && request.auth.uid == superAdminId;
    }

    /**
     * @description Grants Organizations full access to their profile.
     * @path /organizations/{organizationId}
     * @allow (get, list) if isSignedIn()
     * @allow (create) if isSignedIn() && request.auth.uid == organizationId
     * @allow (update, delete) if isExistingOwner(organizationId)
     * @deny (create) if !isSignedIn() || request.auth.uid != organizationId
     * @deny (update, delete) if !isExistingOwner(organizationId)
     * @principle Enforces Organization ownership for writes.
     */
    match /organizations/{organizationId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == organizationId;
      allow update: if isSignedIn() && isOwner(organizationId) && request.auth.uid == organizationId;
      allow delete: if isSignedIn() && isOwner(organizationId) && request.auth.uid == organizationId;
    }

    /**
     * @description Grants Organizations full access to their Admin (department) profiles.
     * @path /admins/{adminId}
     * @allow (get, list) if isSignedIn()
     * @allow (create) if isOrganizationAdmin(request.resource.data.organizationId)
     * @allow (update, delete) if isExistingOrganizationAdmin(resource.data.organizationId)
     * @deny (create) if !isOrganizationAdmin(request.resource.data.organizationId)
     * @deny (update, delete) if !isExistingOrganizationAdmin(resource.data.organizationId)
     * @principle Enforces Organization ownership for Admin writes.
     */
    match /admins/{adminId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.organizationId != null && isOrganizationAdmin(request.resource.data.organizationId);
      allow update: if isSignedIn() && get(/databases/$(database)/documents/admins/$(adminId)).data.organizationId != null && isOrganizationAdmin(get(/databases/$(database)/documents/admins/$(adminId)).data.organizationId) && get(/databases/$(database)/documents/admins/$(adminId)).data.organizationId == request.resource.data.organizationId; //Enforce Organization ownership and organizationId immutability on update
      allow delete: if isSignedIn() && get(/databases/$(database)/documents/admins/$(adminId)).data.organizationId != null && isOrganizationAdmin(get(/databases/$(database)/documents/admins/$(adminId)).data.organizationId);
    }

     /**
      * @description Grants access to devices based on department (Admin) ownership.
      * @path /devices/{deviceId}
      * @allow (get, list) if isSignedIn()
      * @allow (create) if isAdminOfDevice(request.resource.data.adminId)
      * @allow (update, delete) if isExistingAdminOfDevice(resource.data.adminId)
      * @deny (create) if !isAdminOfDevice(request.resource.data.adminId)
      * @deny (update, delete) if !isExistingAdminOfDevice(resource.data.adminId)
      * @principle Enforces Admin ownership for Device writes.
      */
    match /devices/{deviceId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.adminId != null && isAdminOfDevice(request.resource.data.adminId);
      allow update: if isSignedIn() && get(/databases/$(database)/documents/devices/$(deviceId)).data.adminId != null && isAdminOfDevice(get(/databases/$(database)/documents/devices/$(deviceId)).data.adminId) && get(/databases/$(database)/documents/devices/$(deviceId)).data.adminId == request.resource.data.adminId;
      allow delete: if isSignedIn() && get(/databases/$(database)/documents/devices/$(deviceId)).data.adminId != null && isAdminOfDevice(get(/databases/$(database)/documents/devices/$(deviceId)).data.adminId);
    }

    /**
     * @description Grants access to alerts based on department (Admin) ownership.
     * @path /alerts/{alertId}
     * @allow (get, list) if isSignedIn()
     * @allow (create) if isAdminOfAlert(request.resource.data.adminId)
     * @allow (update, delete) if isExistingAdminOfAlert(resource.data.adminId)
     * @deny (create) if !isAdminOfAlert(request.resource.data.adminId)
     * @deny (update, delete) if !isExistingAdminOfAlert(resource.data.adminId)
     * @principle Enforces Admin ownership for Alert writes.
     */
    match /alerts/{alertId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.adminId != null && isAdminOfAlert(request.resource.data.adminId);
      allow update: if isSignedIn() && get(/databases/$(database)/documents/alerts/$(alertId)).data.adminId != null && isAdminOfAlert(get(/databases/$(database)/documents/alerts/$(alertId)).data.adminId) && get(/databases/$(database)/documents/alerts/$(alertId)).data.adminId == request.resource.data.adminId;
      allow delete: if isSignedIn() && get(/databases/$(database)/documents/alerts/$(alertId)).data.adminId != null && isAdminOfAlert(get(/databases/$(database)/documents/alerts/$(alertId)).data.adminId);
    }

    // Helper functions

    // Check if user is signed in
    function isSignedIn() {
      return request.auth != null;
    }

    // Check if the user is a super admin.
    function isSuperAdmin(superAdminId) {
        return exists(/databases/$(database)/documents/roles_super_admin/$(superAdminId));
    }

    // Check if a super admin exists.
    function isExistingSuperAdmin(superAdminId) {
      return isSuperAdmin(superAdminId) && get(/databases/$(database)/documents/roles_super_admin/$(superAdminId)).data != null;
    }

    // Check if the user is the owner of the document (Organization).
    function isOwner(organizationId) {
      return isSignedIn() && request.auth.uid == organizationId;
    }

     // Check if the user is the existing owner of the document (Organization).
    function isExistingOwner(organizationId) {
      return isOwner(organizationId) && exists(/databases/$(database)/documents/organizations/$(organizationId));
    }

    // Check if the organization ID matches the user's auth UID.
    function isOrganizationAdmin(organizationId) {
      return isSignedIn() && request.auth.uid == organizationId;
    }

     // Check if the organization ID matches the user's auth UID.
    function isExistingOrganizationAdmin(organizationId) {
      return isOrganizationAdmin(organizationId) && exists(/databases/$(database)/documents/organizations/$(organizationId));
    }

    // Check if the admin ID matches the device's adminId.
    function isAdminOfDevice(adminId) {
      return exists(/databases/$(database)/documents/admins/$(adminId));
    }

    // Check if the admin ID matches the device's adminId and the device exists.
     function isExistingAdminOfDevice(adminId) {
      return isAdminOfDevice(adminId);
    }

    // Check if the admin ID matches the alert's adminId.
    function isAdminOfAlert(adminId) {
      return exists(/databases/$(database)/documents/admins/$(adminId));
    }

    // Check if the admin ID matches the alert's adminId and the alert exists.
    function isExistingAdminOfAlert(adminId) {
      return isAdminOfAlert(adminId);
    }
  }
}