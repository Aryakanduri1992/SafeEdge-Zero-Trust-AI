/**
 * @fileoverview Firestore Security Rules for AuthStation application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict role-based access control (RBAC) model, with Super Admins at the top.
 * Organizations and Departments are associated with a Super Admin. Devices are associated with Organizations and Departments.
 *
 * Data Structure:
 * - /roles_super_admin/{superAdminId}: Super Admin role assignments.
 * - /organizations/{organizationId}: Organization profiles, linked to a Super Admin via `superAdminId`.
 * - /departments/{departmentId}: Department data, linked to an Organization via `organizationId` and a Super Admin via `superAdminId`.
 * - /devices/{deviceId}: Device data, linked to an Organization via `organizationId` and Department via `departmentId`.
 *
 * Key Security Decisions:
 * - Only authenticated users can access the database.
 * - Super Admins have full access to organizations, departments, and devices associated with them.
 * - Normal users (non-Super Admins) are denied all access.
 * - Data validation is relaxed in this prototyping phase.
 *
 * Denormalization for Authorization:
 * - The `superAdminId` is denormalized into the `organizations`, `departments`, and `devices` documents. This avoids costly `get()` calls in security rules.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the current user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the current user is the owner (Super Admin).
     */
    function isOwner(superAdminId) {
      return isSignedIn() && request.auth.uid == superAdminId;
    }

    /**
     * @description Checks if the current user is an existing owner (Super Admin) and if the document exists.
     */
    function isExistingOwner(superAdminId) {
      return isOwner(superAdminId) && resource != null;
    }

    /**
     * @description Rules for Super Admin role assignments.
     * @path /roles_super_admin/{superAdminId}
     * @allow (create) User with matching UID creates their SuperAdmin document.
     * @allow (get) Any signed-in user can check if a SuperAdmin role exists.
     * @deny (update) No one can update a SuperAdmin document after creation.
     * @deny (delete) No one can delete a SuperAdmin document.
     * @deny (create) User attempts to create a SuperAdmin document for another user.
     * @principle Enforces self-creation and prevents modification of SuperAdmin roles.
     */
    match /roles_super_admin/{superAdminId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isOwner(superAdminId) && request.resource.data.id == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

     /**
      * @description Rules for Organizations.
      * @path /organizations/{organizationId}
      * @allow (create) Super Admin creates an organization with their ID in the `superAdminId` field.
      * @allow (get) Any signed-in user can read organization data.
      * @allow (update) Only the Super Admin who owns the organization can update it.
      * @allow (delete) Only the Super Admin who owns the organization can delete it.
      * @deny (create) User attempts to create an organization for another Super Admin.
      * @deny (update) User attempts to update an organization they don't own.
      * @principle Enforces ownership for organization management by Super Admins.
      */
    match /organizations/{organizationId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.superAdminId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.superAdminId) && resource.data.superAdminId == request.resource.data.superAdminId;
      allow delete: if isExistingOwner(resource.data.superAdminId);
    }

    /**
     * @description Rules for Departments.
     * @path /departments/{departmentId}
     * @allow (create) Super Admin creates a department with their ID in the `superAdminId` field.
     * @allow (get) Any signed-in user can read department data.
     * @allow (update) Only the Super Admin who owns the department (via `superAdminId`) can update it.
     * @allow (delete) Only the Super Admin who owns the department can delete it.
     * @deny (create) User attempts to create a department for another Super Admin or Organization.
     * @deny (update) User attempts to update a department they don't own.
     * @principle Enforces ownership for department management by Super Admins.
     */
    match /departments/{departmentId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.superAdminId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.superAdminId) && resource.data.superAdminId == request.resource.data.superAdminId;
      allow delete: if isExistingOwner(resource.data.superAdminId);
    }

    /**
     * @description Rules for Devices.
     * @path /devices/{deviceId}
     * @allow (create) Super Admin creates a device with their ID in the `superAdminId` field of the related organization.
     * @allow (get) Any signed-in user can read device data.
     * @allow (update) Only the Super Admin who owns the device (via the related organization's `superAdminId`) can update it.
     * @allow (delete) Only the Super Admin who owns the device can delete it.
     * @deny (create) User attempts to create a device for another Super Admin or Organization.
     * @deny (update) User attempts to update a device they don't own.
     * @principle Enforces ownership for device management by Super Admins.
     */
    match /devices/{deviceId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && get(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)).data.superAdminId == request.auth.uid;
      allow update: if isSignedIn() && get(/databases/$(database)/documents/organizations/$(resource.data.organizationId)).data.superAdminId == request.auth.uid && resource != null;
      allow delete: if isSignedIn() && get(/databases/$(database)/documents/organizations/$(resource.data.organizationId)).data.superAdminId == request.auth.uid && resource != null;
    }
  }
}