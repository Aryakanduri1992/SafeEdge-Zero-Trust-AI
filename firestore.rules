
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the user is a Super Admin
    function isSuperAdmin() {
      return exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
    }

    // Helper function to check if the user is the owner of the organization
    function isOwner(orgId) {
      return request.auth.uid == orgId;
    }

    // Super Admins can read/write any data for administrative purposes
    match /{path=**}/documents/{docId} {
        allow read, write: if isSuperAdmin();
    }

    // Rules for the organizations collection
    match /organizations/{orgId} {
      // Allow create by Super Admins
      allow create: if isSuperAdmin() && request.resource.data.superAdminId == request.auth.uid;
      
      // Allow organization admin to read their own data
      allow read: if isOwner(orgId);
    }

    // Rules for the departments collection
    match /departments/{deptId} {
       // Organization admin can manage their own departments
       allow read, create, update: if request.auth.uid == request.resource.data.organizationId;
    }

    // Rules for the devices collection
    match /devices/{deviceId} {
      // Allow read for the organization owner of the department the device belongs to
      allow read: if exists(/databases/$(database)/documents/departments/$(request.resource.data.departmentId)) &&
                   get(/databases/$(database)/documents/departments/$(request.resource.data.departmentId)).data.organizationId == request.auth.uid;
      
      // Allow device management for the organization owner
      allow create, update, delete: if exists(/databases/$(database)/documents/departments/$(request.resource.data.departmentId)) &&
                                    get(/databases/$(database)/documents/departments/$(request.resource.data.departmentId)).data.organizationId == request.auth.uid;
    }
    
    // Rules for the roles_super_admin collection
    match /roles_super_admin/{uid} {
        // Only other super admins can read this collection
        allow read: if isSuperAdmin();
        // Disallow client-side writes for security
        allow write: if false;
    }
  }
}
