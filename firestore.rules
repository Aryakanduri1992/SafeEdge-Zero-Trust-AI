/**
 * @file Firebase Security Rules for AuthStation application.
 *
 * @core_philosophy This ruleset enforces role-based access control, primarily for Super Admins.
 * Super Admins, identified by their UID, are granted read access to their own "roles_super_admin" document.
 * All write operations on the "roles_super_admin" collection are denied, as this collection is intended
 * to be managed through administrative processes, not directly by users.
 * Organizations can only be read by SuperAdmins and they can be updated by anyone.
 * Departments can only be created, read, updated, and deleted by SuperAdmins.
 *
 * @data_structure
 * - /roles_super_admin/{superAdminId}: Documents identifying Super Admins.
 * - /organizations/{organizationId}: Documents storing organization profiles.
 * - /departments/{departmentId}: Documents storing department information.
 *
 * @key_security_decisions
 * - Listing of documents is generally disallowed to prevent information disclosure.
 * - The "roles_super_admin" collection is not writable via the client.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants Super Admins read access to their own role document.
     * @path /roles_super_admin/{superAdminId}
     * @allow (get) User with UID 'ggrqPS1rQ8Uo6Ies71W3QlBCXxo2' can read their own role document at /roles_super_admin/ggrqPS1rQ8Uo6Ies71W3QlBCXxo2.
     * @deny (get) User with UID 'differentUID' cannot read the role document at /roles_super_admin/ggrqPS1rQ8Uo6Ies71W3QlBCXxo2.
     * @allow (list) The Super Admins cannot be listed.
     * @deny (create) No user can create documents directly in the 'roles_super_admin' collection.
     * @deny (update) No user can update documents directly in the 'roles_super_admin' collection.
     * @deny (delete) No user can delete documents directly in the 'roles_super_admin' collection.
     * @principle Enforces role-based access control for Super Admins.
     */
    match /roles_super_admin/{superAdminId} {
      allow get: if isSignedIn() && isOwner(superAdminId);
      allow list: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

      /**
     * @description Grants read access to all Organizations and write access to anyone.
     * @path /organizations/{organizationId}
     * @allow (get) Any signed in user can get the organization.
     * @allow (list) Organizations can be listed.
     * @allow (create) Any signed in user can create an organization.
     * @allow (update) Any signed in user can update an organization.
     * @allow (delete) Any signed in user can delete an organization.
     * @principle Open read and write access to organization data.
     */
    match /organizations/{organizationId} {
        allow get, list: if true;
        allow create, update, delete: if isSignedIn();
    }

    /**
     * @description Grants Super Admins full CRUD access to departments.
     * @path /departments/{departmentId}
     * @allow (create) Super Admin can create departments.
     * @allow (get) Super Admin can read departments.
     * @allow (update) Super Admin can update departments.
     * @allow (delete) Super Admin can delete departments.
     * @deny (create) Non-Super Admin cannot create departments.
     * @deny (get) Non-Super Admin cannot read departments.
     * @deny (update) Non-Super Admin cannot update departments.
     * @deny (delete) Non-Super Admin cannot delete departments.
     * @principle Enforces that only Super Admins can manage departments.
     */
    match /departments/{departmentId} {
        allow get, list, create, update, delete: if isSignedIn();
    }


    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }
  }
}