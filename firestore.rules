/**
 * @description This ruleset enforces a role-based access control model for the AuthStation application.
 * Super Admins have elevated privileges, while Admins manage devices within their organization.
 *
 * @dataStructure
 * - /roles_super_admin/{superAdminId}: Documents indicating Super Admin status. Existence of a document grants super-admin privileges.
 * - /admins/{adminId}: Admin profiles, containing details like email, organization, and the ID of the Super Admin who created them.
 * - /devices/{deviceId}: IoT device data, linked to an admin account.
 *
 * @keySecurityDecisions
 * - Super Admin status is determined by the existence of a document in `/roles_super_admin/{superAdminId}`.
 * - Admin creation is restricted to Super Admins.
 * - Listing of Admins is restricted to Super Admins.
 * - Devices are accessible to any authenticated user.
 *
 * @denormalizationForAuthorization
 * - Super Admin status is determined by the existence of a document in /roles_super_admin/{superAdminId}, enabling simple existence checks for authorization.
 * - The admin document has a superAdminId to avoid needing to read the superAdmin's information.
 *
 * @structuralSegregation
 * - Role-based segregation is achieved by using a dedicated roles_super_admin collection.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the current user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user's UID matches the provided userId.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user is a Super Admin by verifying the existence of a document in the roles_super_admin collection.
     */
    function isSuperAdmin() {
      return exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
    }

    /**
     * @description Checks if the user is signed in and owns an existing document.
     */
    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }

    /**
     * @description Defines rules for the /roles_super_admin/{superAdminId} collection.
     * @path /roles_super_admin/{superAdminId}
     * @allow (create) User with UID 'user123' can create a document at /roles_super_admin/user123 if they are authenticated and the UID matches.
     * @deny (create) User with UID 'user456' cannot create a document at /roles_super_admin/user123 because the UIDs do not match.
     * @principle Enforces ownership: only the authenticated user can create their own Super Admin role document.
     */
    match /roles_super_admin/{superAdminId} {
      allow get: if isSignedIn();
      allow list: if false; // Super admins should not be listable.
      allow create: if isSignedIn() && isOwner(superAdminId);
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Defines rules for the /admins/{adminId} collection.
     * @path /admins/{adminId}
     * @allow (create) A Super Admin can create an Admin profile.
     * @deny (create) A regular user cannot create an Admin profile.
     * @principle Restricts Admin creation to Super Admins.
     */
    match /admins/{adminId} {
      allow get: if isSignedIn();
      allow list: if isSuperAdmin();
      allow create: if isSuperAdmin();
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Defines rules for the /devices/{deviceId} collection.
     * @path /devices/{deviceId}
     * @allow (get, list) Any authenticated user can read device data.
     * @allow (create, update, delete) Only the owner (adminId) can create, update or delete a device.
     * @deny (create, update, delete) A non-owner cannot create, update or delete a device.
     * @principle Allows public read access to device data, but restricts write access to the owner.
     */
    match /devices/{deviceId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }
  }
}