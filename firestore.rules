
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
  
    function isSuperAdmin() {
      return request.auth.token.superadmin == true;
    }
    
    function isOrgAdmin(orgId) {
      return request.auth.uid == orgId;
    }
  
    match /roles_super_admin/{superAdminId} {
      allow read: if isSuperAdmin() && request.auth.uid == superAdminId;
      allow write: if isSuperAdmin() && request.auth.uid == superAdminId;
    }
    
    match /organizations/{organizationId} {
      allow read: if isOrgAdmin(organizationId) || isSuperAdmin();
      allow write: if isSuperAdmin();
      allow create: if isSuperAdmin();
    }
    
    match /departments/{departmentId} {
      allow read: if isOrgAdmin(resource.data.organizationId) || isSuperAdmin();
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }
    
    match /devices/{deviceId} {
      allow read, write: if isOrgAdmin(request.auth.uid) || isSuperAdmin();
    }
  }
}
