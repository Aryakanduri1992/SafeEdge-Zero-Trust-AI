/**
 * @fileoverview Firestore Security Rules for AuthStation.
 *
 * Core Philosophy:
 * This ruleset enforces a multi-tenant security model where organizations and their super admins
 * have strict ownership over their data. Users can only access data belonging to their
 * organization. Super admins have elevated privileges within their own organization.
 *
 * Data Structure:
 * - /roles_super_admin/{superAdminId}: Stores documents identifying super admins by their UID.
 * - /organizations/{organizationId}: Stores organization profile information.
 * - /departments/{departmentId}: Stores department information for all organizations.
 * - /devices/{deviceId}: Stores information about individual devices.
 *
 * Key Security Decisions:
 * - Listing of organizations or super admins is not permitted.
 * - Super admins are granted full CRUD access to organizations.
 * - All data is organization-scoped, and access is validated against the organizationId.
 *
 * Denormalization for Authorization:
 * - Documents in /departments and /devices collections have an organizationId field that is checked against the user's organization.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user's UID matches the provided userId.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the user is a super admin by verifying their UID against the roles_super_admin collection.
     */
    function isSuperAdmin() {
      return exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
    }

    /**
     * @description Checks if the user is a super admin of the specified organization, which is derived from department or device data.
     * @param organizationId The ID of the organization to check against.
     */
    function isSuperAdminOfOrganization(organizationId) {
        return isSuperAdmin() && get(/databases/$(database)/documents/organizations/$(organizationId)).data.superAdminId == request.auth.uid;
    }

    /**
     * @description Check if document exists and the user is the owner.
     */
    function isExistingOwner(userId) {
        return (isOwner(userId) && resource != null);
    }

    /**
     * @description Roles Super Admin collection access rules.
     * @path /roles_super_admin/{superAdminId}
     * @allow (create) - A user can create their own super admin record if their UID matches the superAdminId.
     * @allow (get) - A super admin can get their own record.
     * @deny (list) - No one can list the super admins.
     * @deny (create) - A user cannot create a super admin record for another user.
     * @deny (update) - A user cannot update another super admin's record.
     * @deny (delete) - A user cannot delete another super admin's record.
     * @principle Enforces super admin ownership.
     */
    match /roles_super_admin/{superAdminId} {
      allow get: if isOwner(superAdminId);
      allow list: if false;
      allow create: if isOwner(superAdminId);
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Organization collection access rules.
     * @path /organizations/{organizationId}
     * @allow (create) - A super admin can create an organization. The superAdminId field in the document must match their UID.
     * @allow (get) - Any authenticated user can get an organization's data.
     * @deny (list) - No one can list organizations.
     * @allow (update) - A super admin of the organization can update the organization's data.
     * @allow (delete) - A super admin of the organization can delete the organization.
     * @deny (create) - Non super admins cannot create organizations.
     * @principle Enforces super admin ownership of organizations.
     */
    match /organizations/{organizationId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn() && request.resource.data.superAdminId == request.auth.uid;
      allow update: if isSignedIn() && isSuperAdminOfOrganization(organizationId);
      allow delete: if isSignedIn() && isSuperAdminOfOrganization(organizationId);
    }

    /**
     * @description Department collection access rules.
     * @path /departments/{departmentId}
     * @allow (create) - Super admins can create departments within their organization.
     * @allow (get) - Any authenticated user can get department data.
     * @allow (list) - Super admins can list departments within their organization.
     * @allow (update) - Super admins of an organization can update departments within their organization.
     * @allow (delete) - Super admins of an organization can delete departments within their organization.
     * @deny (create) - Non-super admins cannot create departments.
     * @principle Enforces super admin ownership of departments.
     */
    match /departments/{departmentId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && isSuperAdmin();
      allow create: if isSignedIn() && isSuperAdminOfOrganization(request.resource.data.organizationId) && request.resource.data.organizationId != null;
      allow update: if isSignedIn() && isSuperAdminOfOrganization(resource.data.organizationId);
      allow delete: if isSignedIn() && isSuperAdminOfOrganization(resource.data.organizationId);
    }

    /**
     * @description Device collection access rules.
     * @path /devices/{deviceId}
     * @allow (create) - Super admins can create devices within their organization.
     * @allow (get) - Any authenticated user can get device data.
     * @allow (list) - Super admins can list devices within their organization.
     * @allow (update) - Super admins of an organization can update devices within their organization.
     * @allow (delete) - Super admins of an organization can delete devices within their organization.
     * @deny (create) - Non-super admins cannot create devices.
     * @principle Enforces super admin ownership of devices.
     */
    match /devices/{deviceId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && isSuperAdmin();
      allow create: if isSignedIn() && isSuperAdminOfOrganization(request.resource.data.organizationId) && request.resource.data.organizationId != null;
      allow update: if isSignedIn() && isSuperAdminOfOrganization(resource.data.organizationId);
      allow delete: if isSignedIn() && isSuperAdminOfOrganization(resource.data.organizationId);
    }
  }
}