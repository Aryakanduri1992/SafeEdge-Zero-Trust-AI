/**
 * @file Firestore Security Rules
 * @core_philosophy This ruleset enforces a role-based access control model. Super Admins, identified by documents in the `/roles_super_admin/{superAdminId}` collection, have elevated privileges.
 * @data_structure
 * - `/roles_super_admin/{superAdminId}`: Stores Super Admin role assignments.
 * - `/organizations/{organizationId}`: Stores organization data.
 * - `/departments/{departmentId}`: Stores department data.
 * - `/devices/{deviceId}`: Stores device data.
 * @key_security_decisions
 * - Super Admins can read any document.
 * - Organizations are secured such that the `superAdminId` field must match the authenticated user's ID for write operations.
 * - Departments inherit the organization-level ownership model via the `organizationId` field, restricting create/update/delete to the Super Admin of the related Organization.
 * - Devices also inherit the organization-level ownership model via the `organizationId` field.
 * - Read operations are generally open to Super Admins.
 * @denormalization_for_authorization The `organizationId` field is used in both the `/departments` and `/devices` collections to link them to an organization and enable authorization checks. This avoids the need for complex queries or `get()` calls in the security rules.
 * @structural_segregation N/A. This data model does not segregate data into public and private collections.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user is a Super Admin.
     */
    function isSuperAdmin() {
        return exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
    }

    /**
     * @description Checks if the authenticated user is the owner (superAdmin) of the organization.
     */
    function isOrganizationOwner(superAdminId) {
        return isSignedIn() && request.auth.uid == superAdminId;
    }

    /**
     * @description Checks if the authenticated user is the existing owner of the organization.
     * Also verifies resource exists before allowing update or delete.
     */
    function isExistingOrganizationOwner(superAdminId) {
      return isOrganizationOwner(superAdminId) && resource != null;
    }


    /**
     * @description Rules for the Super Admin role assignments.
     * @path /roles_super_admin/{superAdminId}
     * @allow (create) If the user's ID matches the document ID (self-creation).
     * @deny (create) If the user's ID does not match the document ID.
     * @allow (get, list) If the user is a Super Admin.
     * @deny (get, list) If the user is not a Super Admin.
     * @principle Enforces document ownership for creation and role-based access for reads.
     */
    match /roles_super_admin/{superAdminId} {
      allow create: if isSignedIn() && request.auth.uid == superAdminId;
      allow get: if isSuperAdmin();
      allow list: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Rules for the organizations collection.
     * @path /organizations/{organizationId}
     * @allow (create) If the authenticated user's ID matches the `superAdminId` in the request data.
     * @deny (create) If the `superAdminId` does not match the authenticated user's ID.
     * @allow (get, list) If isSuperAdmin()
     * @deny (get, list) if not isSuperAdmin()
     * @allow (update, delete) If the authenticated user is the owner of the organization.
     * @deny (update, delete) If the authenticated user is not the owner of the organization.
     * @principle Enforces document ownership for writes and role-based access for reads.
     */
    match /organizations/{organizationId} {
      allow create: if isSignedIn() && request.resource.data.superAdminId == request.auth.uid;
      allow get: if isSuperAdmin();
      allow list: if isSuperAdmin();
      allow update: if isExistingOrganizationOwner(resource.data.superAdminId);
      allow delete: if isExistingOrganizationOwner(resource.data.superAdminId);
    }

    /**
     * @description Rules for the departments collection.
     * @path /departments/{departmentId}
     * @allow (create) If the authenticated user is a Super Admin for the organization the department belongs to.
     * @deny (create) If the authenticated user is not a Super Admin for the organization the department belongs to.
     * @allow (get, list) If the user is a Super Admin.
     * @deny (get, list) If the user is not a Super Admin.
     * @allow (update, delete) If the authenticated user is a Super Admin for the organization the department belongs to.
     * @deny (update, delete) If the authenticated user is not a Super Admin for the organization the department belongs to.
     * @principle Enforces role-based access control, linking department access to organization ownership.
     */
    match /departments/{departmentId} {
      allow create: if isSignedIn() && isSuperAdmin();
      allow get: if isSuperAdmin();
      allow list: if isSuperAdmin();
      allow update: if isSignedIn() && isSuperAdmin();
      allow delete: if isSignedIn() && isSuperAdmin();
    }

    /**
     * @description Rules for the devices collection.
     * @path /devices/{deviceId}
     * @allow (create) If the authenticated user is a Super Admin.
     * @deny (create) If the authenticated user is not a Super Admin.
     * @allow (get, list) If the user is a Super Admin.
     * @deny (get, list) If the user is not a Super Admin.
     * @allow (update, delete) If the authenticated user is a Super Admin.
     * @deny (update, delete) If the authenticated user is not a Super Admin.
     * @principle Enforces role-based access control, granting device management to Super Admins.
     */
    match /devices/{deviceId} {
      allow create: if isSignedIn() && isSuperAdmin();
      allow get: if isSuperAdmin();
      allow list: if isSuperAdmin();
      allow update: if isSignedIn() && isSuperAdmin();
      allow delete: if isSignedIn() && isSuperAdmin();
    }
  }
}