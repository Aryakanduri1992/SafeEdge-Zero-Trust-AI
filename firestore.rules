rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Manages SuperAdmin roles.
     * @path /roles_super_admin/{superAdminId}
     * @allow (create) User with matching UID can create their SuperAdmin profile.
     * @deny (create) User tries to create a SuperAdmin profile with a different UID.
     * @allow (get) Any signed-in user can retrieve SuperAdmin profile data.
     * @deny (update) No updates allowed through security rules.
     * @principle Enforces user-ownership for SuperAdmin profiles.
     */
    match /roles_super_admin/{superAdminId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSelf(superAdminId);
      allow update, delete: if false;
    }

    /**
     * @description Manages Organization profiles.
     * @path /organizations/{organizationId}
     * @allow (create) SuperAdmin can create an organization, and the organizationId must match the auth UID.
     * @deny (create) Non-SuperAdmin attempts to create an organization.
     * @allow (get) Any signed-in user can retrieve Organization data.
     * @deny (update) No updates allowed through security rules.
     * @principle Restricts Organization creation to SuperAdmins and enforces ownership.
     */
    match /organizations/{organizationId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSuperAdmin() && request.auth.uid == organizationId;
      allow update, delete: if false;
    }

    /**
     * @description Manages Admin (department) profiles within an organization.
     * @path /admins/{adminId}
     * @allow (create) SuperAdmin can create an Admin profile, and the organizationId must match the parent Organization.
     * @deny (create) Non-SuperAdmin attempts to create an Admin profile.
     * @allow (get) Any signed-in user can retrieve Admin data.
     * @deny (update) No updates allowed through security rules.
     * @principle Restricts Admin creation to SuperAdmins and enforces organization membership.
     */
    match /admins/{adminId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSuperAdmin();
      allow update, delete: if false;
    }

    /**
     * @description Manages IoT Device data, linked to a department (Admin document).
     * @path /devices/{deviceId}
     * @allow (get) Any signed-in user can retrieve Device data.
     * @allow (list) Any signed-in user can list Device data.
     * @deny (create) Creation must be done by a SuperAdmin or the organization through a trusted execution environment.
     * @deny (update) No updates allowed through security rules.
     * @principle Restricts Device creation to SuperAdmins/Organizations and enforces department membership.
     */
    match /devices/{deviceId} {
      allow get, list: if isSignedIn();
      allow create: if isSuperAdmin();
      allow update, delete: if false;
    }

      /**
       * @description Manages system alerts generated from devices, linked to a department (Admin document).
       * @path /alerts/{alertId}
       * @allow (get) Any signed-in user can retrieve Alert data.
       * @allow (list) Any signed-in user can list Alert data.
       * @deny (create) Creation must be done by a SuperAdmin or the organization through a trusted execution environment.
       * @deny (update) No updates allowed through security rules.
       * @principle Restricts Alert creation to SuperAdmins/Organizations and enforces department membership.
       */
    match /alerts/{alertId} {
      allow get, list: if isSignedIn();
      allow create: if isSuperAdmin();
      allow update, delete: if false;
    }

    // --- Helper Functions ---

    /**
     * @description Checks if the user is signed in.
     * @return {bool} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user is the owner of the resource.
     * @param {string} userId - The user ID to check against.
     * @return {bool} True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the user is creating their own profile.
     * @param {string} resourceId - The resource ID to check against.
     * @return {bool} True if the user is creating their own profile, false otherwise.
     */
    function isSelf(resourceId) {
        return request.auth.uid == resourceId;
    }

    /**
     * @description Checks if the user has the SuperAdmin role.
     * @return {bool} True if the user has the SuperAdmin role, false otherwise.
     */
    function isSuperAdmin() {
        return exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
    }
  }
}