/**
 * @fileOverview Firestore Security Rules for AuthStation application.
 *
 * Core Philosophy:
 * This ruleset enforces a role-based access control model, with Super Admins having privileged access and Admins having access to data within their organization.  It prioritizes Authorization Independence and DBAC (Database Auth Based Control) to prevent unauthorized access.
 *
 * Data Structure:
 * - /roles_super_admin/{superAdminId}: Documents indicate Super Admin status. Existence is sufficient for role verification.
 * - /admins/{adminId}: Stores Admin profiles, linked to a Super Admin via 'superAdminId'.
 * - /devices/{deviceId}: Stores IoT device data, linked to an Admin via 'adminId'.
 * - /alerts/{alertId}: Stores system alerts generated from devices, linked to an Admin via 'adminId'.
 *
 * Key Security Decisions:
 * - Super Admin status is determined by the existence of a document in the /roles_super_admin collection.
 * - Admins can only access devices and alerts associated with their 'adminId'.
 * - Authorization Independence: Security rules avoid `get()` calls by relying on the existence of role documents or denormalized data within documents (e.g., 'adminId' in devices and alerts).
 * - Writes to the /admins collection are restricted to Super Admins.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     * @returns {boolean} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user's UID matches the provided userId.
     * @param {string} userId - The user ID to compare against the authenticated user's UID.
     * @returns {boolean} True if the user is signed in and the UID matches, false otherwise.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user is an existing owner of the document.
     * @param {string} userId - The user ID to compare against the authenticated user's UID.
     * @returns {boolean} True if the user is signed in, the UID matches, and the resource exists, false otherwise.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Checks if the user is a Super Admin.
     * @returns {boolean} True if the user has a document in the /roles_super_admin collection, false otherwise.
     */
    function isSuperAdmin() {
      return exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
    }

    /**
     * @description Rules for the /roles_super_admin collection.
     * @path /roles_super_admin/{superAdminId}
     * @allow (create) - A user can create their own super admin role if their UID matches the document ID.
     * @allow (get, list) - Anyone can read if they are a super admin
     * @deny (update, delete) - No one can update or delete an existing super admin role via direct write, use backend functions.
     * @principle Enforces role-based access control for Super Admins.
     */
    match /roles_super_admin/{superAdminId} {
      allow get, list: if isSuperAdmin();
      allow create: if isOwner(superAdminId);
      allow update, delete: if false;
    }

    /**
     * @description Rules for the /admins collection.
     * @path /admins/{adminId}
     * @allow (create) - A Super Admin can create a new admin profile. The 'superAdminId' field in the created document must match the Super Admin's UID.
     * @allow (get, list) - Anyone can read admin details if they are a super admin.
     * @allow (update, delete) - Only Super Admins can modify admin profiles.
     * @deny (create) - Non-Super Admins cannot create admin profiles.
     * @deny (update, delete) - Non-Super Admins cannot modify admin profiles.
     * @principle Enforces role-based access control and ownership for admin profiles.
     */
    match /admins/{adminId} {
      allow get, list: if isSuperAdmin();
      allow create: if isSuperAdmin();
      allow update, delete: if isSuperAdmin();
    }

    /**
     * @description Rules for the /devices collection.
     * @path /devices/{deviceId}
     * @allow (get, list) - Anyone can list devices
     * @allow (create) - Any Admin can create devices
     * @allow (update, delete) - Only the admin who created the device can modify it.
     * @principle Enforces ownership for device data.
     */
    match /devices/{deviceId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update, delete: if resource.data.adminId == request.resource.data.adminId && isSignedIn();
    }

    /**
     * @description Rules for the /alerts collection.
     * @path /alerts/{alertId}
     * @allow (get, list) - Anybody can list alerts
     * @allow (create) - Any Admin can create alerts (probably from a device).
     * @allow (update, delete) - Only the admin who the alert belongs to can modify it.
     */
    match /alerts/{alertId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update, delete: if resource.data.adminId == request.resource.data.adminId && isSignedIn();
    }
  }
}