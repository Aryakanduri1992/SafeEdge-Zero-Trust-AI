/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a role-based access control model with super-admin capabilities.
 *
 * Data Structure:
 * - /roles_super_admin/{superAdminId}: Documents identifying super administrators.
 * - /organizations/{organizationId}: Documents containing organization profiles.
 * - /departments/{departmentId}: Documents storing department information.
 * - /devices/{deviceId}: Documents holding device information.
 *
 * Key Security Decisions:
 * - Super-admin role is determined by presence of a document in the `roles_super_admin` collection.
 * - Organizations can only be created by super-admins.
 * - Departments and Devices can only be created by super-admins or organization admins.
 * - Listing of any collection is generally disallowed except for super-admins, for security reasons.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the current user is signed in.
     * @return {boolean} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the current user's UID matches the provided userId.
     * @param {string} userId - The user ID to compare against the authenticated user's UID.
     * @return {boolean} True if the user is signed in and their UID matches, false otherwise.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the user has super admin role.
     * @return {boolean} True if the user has super admin role, false otherwise.
     */
    function isSuperAdmin() {
        return exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
    }

    /**
     * @description Checks if the organization ID matches the super admin's organization ID.
     * @param {string} superAdminId - The super admin ID to compare against the authenticated user's super admin ID.
     * @return {boolean} True if the organization ID matches the super admin's organization ID.
     */
    function isOrganizationIdMatchesSuperAdminOrgId(superAdminId) {
      return get(/databases/$(database)/documents/roles_super_admin/$(superAdminId)).data.organizationId == request.auth.uid;
    }

    /**
     * @description Documents identifying super administrators.
     * @path /roles_super_admin/{superAdminId}
     * @allow (create) User abc creates a document with id 'abc' to become a super admin.
     * @deny (create) User def tries to create a super admin document with id 'abc'.
     * @principle Enforces that only a user can create their own super admin profile.
     */
    match /roles_super_admin/{superAdminId} {
      allow get: if isSuperAdmin() || isOwner(superAdminId);
      allow list: if false;
      allow create: if isOwner(superAdminId);
      allow update: if isSuperAdmin() || isOwner(superAdminId);
      allow delete: if isSuperAdmin() || isOwner(superAdminId);
    }

    /**
     * @description Documents containing organization profiles.
     * @path /organizations/{organizationId}
     * @allow (create) SuperAdmin abc creates an organization with ID xyz.
     * @deny (update) User abc tries to update organization xyz (only super admins can).
     * @principle Only super admins can create or modify organizations.
     */
    match /organizations/{organizationId} {
      allow get: if isSuperAdmin();
      allow list: if false;
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    /**
     * @description Documents storing department information.
     * @path /departments/{departmentId}
     * @allow (create) SuperAdmin abc creates department xyz.
     * @deny (update) User abc tries to update department xyz (only super admins can).
     * @principle Only super admins can create or modify departments.
     */
    match /departments/{departmentId} {
      allow get: if isSuperAdmin();
      allow list: if false;
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    /**
     * @description Documents holding device information.
     * @path /devices/{deviceId}
     * @allow (create) SuperAdmin abc creates device xyz.
     * @deny (update) User abc tries to update device xyz (only super admins can).
     * @principle Only super admins can create or modify devices.
     */
    match /devices/{deviceId} {
      allow get: if isSuperAdmin();
      allow list: if false;
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }
  }
}