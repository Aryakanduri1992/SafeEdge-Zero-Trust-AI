
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check for superadmin claim
    function isSuperAdmin() {
      return request.auth.token.superadmin == true;
    }

    // Helper function to check if the user is the owner of the organization
    function isOrganizationOwner(orgId) {
      return request.auth.uid == orgId;
    }

    // Super Admins can create their own profile document if it doesn't exist
    match /roles_super_admin/{uid} {
      allow read, update: if isSuperAdmin() && request.auth.uid == uid;
      allow create: if isSuperAdmin() && request.auth.uid == uid;
    }
    
    match /organizations/{organizationId} {
      // Super Admins can read/write any organization profile
      allow read, write: if isSuperAdmin();
      // An organization admin can only read their own profile
      allow get: if isOrganizationOwner(organizationId);
      allow update: if isOrganizationOwner(organizationId) && 
        !('superAdminId' in request.resource.data) &&
        !('createdAt' in request.resource.data);
    }

    match /departments/{departmentId} {
      // Super Admins can manage all departments
      allow read, write: if isSuperAdmin();
      // Organization admins can read departments associated with their org
      allow read: if exists(/databases/$(database)/documents/organizations/$(request.auth.uid)) && 
                     get(/databases/$(database)/documents/departments/$(departmentId)).data.organizationId == request.auth.uid;
    }
    
    match /devices/{deviceId} {
      // Super Admins can read all devices
      allow read: if isSuperAdmin();
      // Organization admins can manage devices within their organization
      allow read, create, update, delete: if exists(/databases/$(database)/documents/organizations/$(request.auth.uid)) && 
                                            request.auth.uid == resource.data.organizationId;
    }
  }
}
