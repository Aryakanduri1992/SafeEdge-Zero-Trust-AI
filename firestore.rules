/**
 * @fileoverview Firestore Security Rules for AuthStation application.
 *
 * Core Philosophy:
 * This ruleset employs a role-based access control model with a SuperAdmin role.
 * Organizations and departments are accessible based on user roles and organization membership.
 * All write operations are restricted to authorized users, with strong validation of
 * ownership and relational integrity. Data shapes are not strictly enforced.
 *
 * Data Structure:
 * - /roles_super_admin/{superAdminId}: SuperAdmin role assignments, keyed by user UID.
 * - /organizations/{organizationId}: Organization profiles.
 * - /departments/{departmentId}: Department profiles.
 * - /devices/{deviceId}: Device information.
 * - /sensorReadings/{readingId}: Sensor reading data.
 *
 * Key Security Decisions:
 * - SuperAdmin Role: Access to organizations and departments is granted to super admins via roles.
 * - No User Listing: Listing of users is not permitted.
 * - Default Security Posture: Strict authorization is enforced for all write operations.
 *
 * Denormalization for Authorization:
 * - The `superAdminId` field is used on `/organizations/{organizationId}` and `/departments/{departmentId}`
 * to quickly authorize write operations by the SuperAdmin.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secure the SuperAdmin role assignments.
     * @path /roles_super_admin/{superAdminId}
     * @allow (create) - A user can create their own SuperAdmin role if their UID matches the document ID.
     * @deny (create) - A user cannot create a SuperAdmin role for another user.
     * @allow (get) - Any authenticated user can get a SuperAdmin role.
     * @allow (list) - Any authenticated user can list SuperAdmin roles.
     * @deny (update) - No one can update a SuperAdmin role after creation.
     * @deny (delete) - No one can delete a SuperAdmin role.
     * @principle Enforces document ownership and prevents unauthorized role modifications.
     */
    match /roles_super_admin/{superAdminId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isOwner(superAdminId);
      allow update, delete: if false;
    }

    /**
     * @description Secure organization profiles.
     * @path /organizations/{organizationId}
     * @allow (create) - Any signed-in user can create an organization. The `superAdminId` must match the user's UID.
     * @deny (create) - A user cannot create an organization with a `superAdminId` that doesn't match their UID.
     * @allow (get) - Any user can read any organization profile.
     * @allow (list) - Any user can list organization profiles.
     * @allow (update) - Only the SuperAdmin can update the organization.
     * @allow (delete) - Only the SuperAdmin can delete the organization.
     * @principle Enforces ownership for organization management and allows public reads.
     */
    match /organizations/{organizationId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.superAdminId == request.auth.uid;
      allow update: if isSignedIn() && isSuperAdmin() && resource.data.superAdminId == get(/databases/$(database)/documents/organizations/$(organizationId)).data.superAdminId;
      allow delete: if isSignedIn() && isSuperAdmin() && resource.data.superAdminId == get(/databases/$(database)/documents/organizations/$(organizationId)).data.superAdminId;
    }

    /**
     * @description Secure department profiles.
     * @path /departments/{departmentId}
     * @allow (create) - Only a SuperAdmin can create a department. The `superAdminId` must match the user's UID.
     * @deny (create) - A non SuperAdmin user cannot create department
     * @allow (get) - Any user can read any department profile.
     * @allow (list) - Any user can list department profiles.
     * @allow (update) - Only the SuperAdmin can update the department.
     * @allow (delete) - Only the SuperAdmin can delete the department.
     * @principle Enforces ownership for department management and allows public reads.
     */
    match /departments/{departmentId} {
      allow get, list: if true;
      allow create: if isSignedIn() && isSuperAdmin() && request.resource.data.superAdminId == request.auth.uid;
      allow update: if isSignedIn() && isSuperAdmin() && resource.data.superAdminId == get(/databases/$(database)/documents/departments/$(departmentId)).data.superAdminId;
      allow delete: if isSignedIn() && isSuperAdmin() && resource.data.superAdminId == get(/databases/$(database)/documents/departments/$(departmentId)).data.superAdminId;
    }

    /**
     * @description Secure device information.
     * @path /devices/{deviceId}
     * @allow (create) - Only a SuperAdmin can create a device. The `organizationId` and `departmentId` must be valid.
     * @deny (create) - A user cannot create a device if not a SuperAdmin.
     * @allow (get) - Any user can read any device information.
     * @allow (list) - Any user can list device information.
     * @allow (update) - Only the SuperAdmin can update the device information.
     * @allow (delete) - Only the SuperAdmin can delete the device information.
     * @principle Enforces ownership for device management and allows public reads.
     */
    match /devices/{deviceId} {
      allow get, list: if true;
      allow create: if isSignedIn() && isSuperAdmin();
      allow update: if isSignedIn() && isSuperAdmin();
      allow delete: if isSignedIn() && isSuperAdmin();
    }

    /**
     * @description Secure sensor reading data.
     * @path /sensorReadings/{readingId}
     * @allow (create) - Any authenticated user can create a sensor reading. The `organizationId` and `deviceId` must be valid.
     * @deny (create) - A user cannot create a sensor reading if not authenticated.
     * @allow (get) - Any user can read any sensor reading.
     * @allow (list) - Any user can list sensor readings.
     * @allow (update) - No one can update a sensor reading.
     * @allow (delete) - No one can delete a sensor reading.
     * @principle Enforces data integrity and allows public reads.
     */
    match /sensorReadings/{readingId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update, delete: if false;
    }
  }

  // Helper functions
  function isSignedIn() {
    return request.auth != null;
  }

  function isOwner(userId) {
    return request.auth.uid == userId;
  }

  function isSuperAdmin() {
      return exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
  }
}