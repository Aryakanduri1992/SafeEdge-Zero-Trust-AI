/**
 * @fileoverview Firestore Security Rules for AuthStation application.
 *
 * Core Philosophy:
 * This ruleset enforces a role-based access control model with a SuperAdmin role.
 * SuperAdmins can create Organizations and Departments. Departments own Devices and Alerts.
 *
 * Data Structure:
 * - /roles_super_admin/{superAdminId}: Documents indicating SuperAdmin status.
 * - /organizations/{organizationId}: Organization profiles, created by SuperAdmins.
 * - /departments/{departmentId}: Department data, owned by an organization.
 * - /devices/{deviceId}: Device data, owned by a department.
 * - /alerts/{alertId}: Alert data, owned by a department.
 *
 * Key Security Decisions:
 * - SuperAdmin Role: SuperAdmins are identified via documents in the /roles_super_admin collection.
 * - Ownership: SuperAdmins create Organizations, which in turn "own" Departments. Departments "own" Devices and Alerts.
 * - Flexible Data Shapes:  Data validation is relaxed to facilitate rapid prototyping. Only authorization-critical fields are validated.
 * - No User Listing: Listing users is generally disallowed for privacy and security reasons.
 *
 * Denormalization for Authorization:
 * - Organizations store the superAdminId of the user who created them.
 * - Departments store the organizationId of their parent and the superAdminId of the creating super admin.
 * - Alerts and Devices store the departmentId.
 *
 * Structural Segregation:
 * - No explicit segregation is used in this configuration.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user's UID matches the provided userId.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the user is an existing owner of the document.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Checks if the requesting user is a super admin
     */
    function isSuperAdmin() {
      return exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
    }

    /**
     * @description Security rules for the /roles_super_admin/{superAdminId} collection.
     * @path /roles_super_admin/{superAdminId}
     * @allow (create) User with matching UID can create their super admin profile.
     * @allow (get) Super Admin can get their own profile.
     * @deny (create) User cannot create a super admin profile for another user.
     * @principle Enforces user ownership for SuperAdmin profiles and prevents unauthorized profile creation.
     */
    match /roles_super_admin/{superAdminId} {
      allow get: if isOwner(superAdminId);
      allow list: if false;
      allow create: if isOwner(superAdminId);
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Security rules for the /organizations/{organizationId} collection.
     * SuperAdmins can create organizations.
     * @path /organizations/{organizationId}
     * @allow (create) SuperAdmin can create an organization. The organization must have the correct superAdminId.
     * @allow (get) Any signed-in user can read an organization.
     * @deny (update) Only the SuperAdmin who created the organization can update it.
     * @principle Enforces SuperAdmin ownership for organization creation and restricts updates.
     */
    match /organizations/{organizationId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.superAdminId == request.auth.uid && isSuperAdmin();
      allow update: if isSuperAdmin() && get(/databases/$(database)/documents/organizations/$(organizationId)).data.superAdminId == request.auth.uid;
      allow delete: if false;
    }

    /**
     * @description Security rules for the /departments/{departmentId} collection.
     * SuperAdmins can create departments. The department must be linked to an existing organization.
     * @path /departments/{departmentId}
     * @allow (create) SuperAdmin can create a department.  The department must have the correct superAdminId and organizationId.
     * @allow (get) Any signed-in user can read a department.
     * @deny (update) Only the SuperAdmin can update a department they created.
     * @principle Enforces SuperAdmin ownership for department creation.
     */
    match /departments/{departmentId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.superAdminId == request.auth.uid && exists(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)) && isSuperAdmin();
      allow update: if isSuperAdmin() && get(/databases/$(database)/documents/departments/$(departmentId)).data.superAdminId == request.auth.uid;
      allow delete: if false;
    }

    /**
     * @description Security rules for the /devices/{deviceId} collection.
     * Devices are associated with departments. Only SuperAdmins can create, update, or delete devices.
     * @path /devices/{deviceId}
     * @allow (create) SuperAdmin can create a device. The device must have the correct departmentId.
     * @allow (get) Any signed-in user can read a device.
     * @deny (update) Only the SuperAdmin can update a device.
     * @principle Enforces department ownership for device management.
     */
    match /devices/{deviceId} {
      allow get, list: if true;
      allow create: if isSignedIn() && exists(/databases/$(database)/documents/departments/$(request.resource.data.departmentId)) && isSuperAdmin();
      allow update: if isSuperAdmin();
      allow delete: if false;
    }

    /**
     * @description Security rules for the /alerts/{alertId} collection.
     * Alerts are associated with devices and departments.
     * @path /alerts/{alertId}
     * @allow (create) SuperAdmin can create an alert. The alert must have the correct deviceId and departmentId.
     * @allow (get) Any signed-in user can read an alert.
     * @deny (update) Only the SuperAdmin can update an alert.
     * @principle Enforces device/department association for alert management.
     */
    match /alerts/{alertId} {
      allow get, list: if true;
      allow create: if isSignedIn() && exists(/databases/$(database)/documents/devices/$(request.resource.data.deviceId)) && exists(/databases/$(database)/documents/departments/$(request.resource.data.departmentId)) && isSuperAdmin();
      allow update: if isSuperAdmin();
      allow delete: if false;
    }
  }
}