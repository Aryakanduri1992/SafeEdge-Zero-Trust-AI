/**
 * @file Firestore Security Rules for AuthStation
 * @core_philosophy This ruleset enforces a role-based access control (RBAC) model with super-admin and admin roles.
 * Data is segregated by adminId to ensure data isolation.
 * @data_structure
 * - /roles_super_admin/{superAdminId}: Documents indicating super-admin status. Existence is sufficient for role verification.
 * - /admins/{adminId}: Admin profiles, linked to a super-admin via superAdminId.
 * - /devices/{deviceId}: IoT device data, linked to an admin via adminId.
 * - /alerts/{alertId}: System alerts generated from devices, linked to an admin via adminId.
 * @key_security_decisions
 * - Super-admin status is determined solely by the existence of a document in /roles_super_admin/{superAdminId}.
 * - Authorization Independence: Admin access does NOT depend on reading the superAdmin document.
 * - Data Isolation: Admins can only access devices and alerts associated with their adminId.
 * - Listing Super Admins is not allowed.
 * @denormalization Super-admin status is denormalized into the /roles_super_admin collection.
 * AdminId is denormalized into the Device and Alert documents.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants super-admin access based on the existence of a document.
     * @path /roles_super_admin/{superAdminId}
     * @allow (create) User with UID 'superAdminId' can create their super-admin document.
     * @deny (create) User with UID 'otherUserId' cannot create a super-admin document with ID 'superAdminId'.
     * @principle Existence check for role verification.
     */
    match /roles_super_admin/{superAdminId} {
      function isSuperAdmin(superAdminId) {
        return request.auth != null && request.auth.uid == superAdminId;
      }
      allow get: if false;
      allow list: if false;
      allow create: if isSuperAdmin(superAdminId);
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Manages admin profiles. Super admins can create admins. Admins can manage their own profiles.
     * @path /admins/{adminId}
     * @allow (create) SuperAdmin 'superAdminId' can create an admin profile with ID 'adminId'
     * @deny (create) Non-SuperAdmin cannot create an admin profile.
     * @principle Enforces super-admin role for admin creation.
     */
    match /admins/{adminId} {
      function isSuperAdmin() {
        return exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
      }
      function isAdmin(adminId) {
          return request.auth != null && request.auth.uid == adminId;
      }
      allow get: if isAdmin(adminId) || isSuperAdmin();
      allow list: if false;
      allow create: if isSuperAdmin();
      allow update: if isAdmin(adminId) || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    /**
     * @description Manages IoT device data. Admins can create, read, update, and delete devices associated with their adminId.
     * @path /devices/{deviceId}
     * @allow (create) Admin 'adminId' can create a device.
     * @deny (create) Non-Admin cannot create a device.
     * @principle Enforces admin ownership for device data.
     */
    match /devices/{deviceId} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth.uid == request.resource.data.adminId;
      allow update: if request.auth.uid == resource.data.adminId;
      allow delete: if request.auth.uid == resource.data.adminId;
    }

    /**
     * @description Manages system alerts. Admins can read alerts associated with their adminId.
     * @path /alerts/{alertId}
     * @allow (get) Admin 'adminId' can read an alert associated with their adminId.
     * @deny (get) Admin 'otherAdminId' cannot read an alert associated with 'adminId'.
     * @principle Enforces admin-level data isolation for alerts.
     */
    match /alerts/{alertId} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth.uid == request.resource.data.adminId;
      allow update: if request.auth.uid == resource.data.adminId;
      allow delete: if request.auth.uid == resource.data.adminId;
    }
  }
}