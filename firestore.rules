/**
 * @file Firestore Security Rules for AuthStation
 *
 * Core Philosophy: This ruleset enforces a role-based access control model, primarily focused on
 * securing SuperAdmin and Admin roles. Authorization is based on the existence of documents
 * in specific role collections.
 *
 * Data Structure:
 * - /roles_super_admin/{superAdminId}: Presence of a document indicates a SuperAdmin role.
 * - /admins/{adminId}: Stores Admin profiles, linked to a SuperAdmin via 'superAdminId'.
 *
 * Key Security Decisions:
 * - SuperAdmin role is determined by document existence in /roles_super_admin/{superAdminId}.
 * - Authorization Independence: Admin access does NOT depend on the content of the SuperAdmin document,
 *   only on the SuperAdmin's role. This avoids costly `get()` calls and ensures that admin
 *   permissions remain valid even if the SuperAdmin's profile changes.
 * - Listing admins is restricted to Super Admins.
 * - Only a SuperAdmin can create an admin. The `superAdminId` field in the `Admin` document
 *   is immutable after creation, maintaining the integrity of the relationship.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to SuperAdmin role documents.
     * @path /roles_super_admin/{superAdminId}
     * @allow (create) - A user can create their own SuperAdmin role document if their auth UID matches the document ID.
     * @allow (get, list) - Any authenticated user can check for the existence of a SuperAdmin role.
     * @allow (update, delete) - No one can update/delete an existing SuperAdmin role document.
     * @deny (create) - A user cannot create a SuperAdmin role document for another user.
     * @deny (update, delete) - A non super admin user cannot modify this data.
     * @principle Role-based access control; ensures only authenticated users can be SuperAdmins.
     */
    match /roles_super_admin/{superAdminId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isOwner(superAdminId);
      allow update, delete: if false;
    }

    /**
     * @description Controls access to Admin profile documents.
     * @path /admins/{adminId}
     * @allow (create) - Only a SuperAdmin can create an Admin. The 'superAdminId' field must match the SuperAdmin's UID.
     * @allow (get) - Any authenticated user can read an Admin profile.
     * @allow (list) - Only a SuperAdmin can list Admin profiles.
     * @allow (update, delete) - Only the SuperAdmin who created the Admin can update or delete the profile.
     * @deny (create) - A non-SuperAdmin cannot create an Admin profile.
     * @deny (update, delete) - An unauthorized user cannot modify or delete an Admin profile.
     * @principle Enforces role-based access and maintains the SuperAdmin-to-Admin relationship.
     */
    match /admins/{adminId} {
      allow get: if isSignedIn();
      allow list: if isSuperAdmin();
      allow create: if isSuperAdmin() && request.resource.data.superAdminId == request.auth.uid && request.resource.data.id == adminId;
      allow update: if isExistingOwner(request.resource.data.superAdminId) && resource.data.superAdminId == request.resource.data.superAdminId;
      allow delete: if isExistingOwner(resource.data.superAdminId);
    }

    // ---- Helper functions ----

    // Checks if the user is signed in.
    function isSignedIn() {
      return request.auth != null;
    }

    // Checks if the user's auth UID matches the provided userId.
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Checks if the user's auth UID exists as a document in /roles_super_admin/{uid}.
    function isSuperAdmin() {
      return exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
    }

    //Checks if the user's auth UID matches the provided userId and the document exists
    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }
  }
}