/**
 * @fileOverview Firestore Security Rules for AuthStation application.
 *
 * Core Philosophy:
 * This ruleset enforces a role-based access control model, with strict separation of privileges
 * between Super Admins, Organizations, and regular users. Ownership and association
 * are validated on write operations to maintain data integrity.
 *
 * Data Structure:
 * - /roles_super_admin/{superAdminId}: Stores Super Admin profiles.
 * - /organizations/{organizationId}: Stores Organization profiles.
 * - /admins/{adminId}: Stores department profiles, linked to an organization via 'organizationId'.
 * - /devices/{deviceId}: Stores device data, linked to a department via 'adminId'.
 * - /alerts/{alertId}: Stores alert data, linked to a department via 'adminId'.
 *
 * Key Security Decisions:
 * - Super Admins have read access to all devices.
 * - Organizations can manage their own departments (admins).
 * - Only organizations can create devices which is added to the admins.
 * - Data validation focuses on authorization-critical fields (owner IDs, relationships).
 *
 * Denormalization for Authorization:
 * - The 'adminId' field in the 'devices' and 'alerts' collections is used to quickly authorize access based on the parent department.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Manages Super Admin role assignments.
     * @path /roles_super_admin/{superAdminId}
     * @allow (get, list) if isSignedIn()
     * @allow (create, update, delete) if false
     * @deny (create) if true
     * @principle Restricts Super Admin role creation.  Super admin is assigned on backend not in client side.
     */
    match /roles_super_admin/{superAdminId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Manages Organization profiles.
     * @path /organizations/{organizationId}
     * @allow (get, list) if isSignedIn()
     * @allow (create) if isSelfCreation(organizationId)
     * @allow (update, delete) if isOwner(organizationId)
     * @deny (create) if !isSelfCreation(organizationId)
     * @deny (update, delete) if !isOwner(organizationId)
     * @principle Enforces organization ownership for profile management.
     */
    match /organizations/{organizationId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSelfCreation(organizationId);
      allow update: if isExistingOwner(organizationId);
      allow delete: if isExistingOwner(organizationId);
    }

    /**
     * @description Manages Department (Admin) profiles within an organization.
     * @path /admins/{adminId}
     * @allow (get, list) if isSignedIn()
     * @allow (create) if request.auth.uid == request.resource.data.organizationId
     * @allow (update, delete) if resource.data.organizationId == request.auth.uid && resource != null;
     * @deny (create) if request.auth.uid != request.resource.data.organizationId
     * @deny (update, delete) if resource.data.organizationId != request.auth.uid
     * @principle Enforces organizational control over department creation and modification.
     */
    match /admins/{adminId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if request.auth.uid == request.resource.data.organizationId;
      allow update: if resource.data.organizationId == request.auth.uid && resource != null;
      allow delete: if resource.data.organizationId == request.auth.uid && resource != null;
    }

    /**
     * @description Manages IoT Devices, restricting creation to organizations.
     * @path /devices/{deviceId}
     * @allow (get) if isSignedIn()
     * @allow (list) if isSignedIn()
     * @allow (create) if request.auth.uid == get(/databases/$(database)/documents/admins/$(request.resource.data.adminId)).data.organizationId
     * @allow (update, delete) if get(/databases/$(database)/documents/admins/$(resource.data.adminId)).data.organizationId == request.auth.uid && resource != null;
     * @deny (create) if request.auth.uid != get(/databases/$(database)/documents/admins/$(request.resource.data.adminId)).data.organizationId
     * @deny (update, delete) if get(/databases/$(database)/documents/admins/$(resource.data.adminId)).data.organizationId != request.auth.uid
     * @principle Restricts device creation to organizations and enforces organizational ownership for modifications.
     */
    match /devices/{deviceId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if request.auth.uid == get(/databases/$(database)/documents/admins/$(request.resource.data.adminId)).data.organizationId;
      allow update: if get(/databases/$(database)/documents/admins/$(resource.data.adminId)).data.organizationId == request.auth.uid && resource != null;
      allow delete: if get(/databases/$(database)/documents/admins/$(resource.data.adminId)).data.organizationId == request.auth.uid && resource != null;
    }

    /**
     * @description Manages system alerts generated by devices.
     * @path /alerts/{alertId}
     * @allow (get, list) if isSignedIn()
     * @allow create: if get(/databases/$(database)/documents/admins/$(request.resource.data.adminId)).data.organizationId == request.auth.uid;
     * @allow update: if get(/databases/$(database)/documents/admins/$(resource.data.adminId)).data.organizationId == request.auth.uid && resource != null;
     * @allow delete: if get(/databases/$(database)/documents/admins/$(resource.data.adminId)).data.organizationId == request.auth.uid && resource != null;
     * @principle Enforces organizational control over alert management.
     */
    match /alerts/{alertId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if get(/databases/$(database)/documents/admins/$(request.resource.data.adminId)).data.organizationId == request.auth.uid;
      allow update: if get(/databases/$(database)/documents/admins/$(resource.data.adminId)).data.organizationId == request.auth.uid && resource != null;
      allow delete: if get(/databases/$(database)/documents/admins/$(resource.data.adminId)).data.organizationId == request.auth.uid && resource != null;
    }

    //---------------------------------- Helper functions ----------------------------------//
    /**
     * @description Checks if the user is signed in.
     * @return {boolean} True if the user is authenticated, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user is the owner of the resource.
     * @param {string} userId - The user ID to compare against the authenticated user's ID.
     * @return {boolean} True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user is the owner of the resource, and that the resource exists.
     * @param {string} userId - The user ID to compare against the authenticated user's ID.
     * @return {boolean} True if the user is the owner and resource exists, false otherwise.
     */
    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }

    /**
     * @description Checks if the authenticated user is attempting to create their own user document.
     * @param {string} documentId - The document ID to compare against the authenticated user's ID.
     * @return {boolean} True if the user is creating their own document, false otherwise.
     */
    function isSelfCreation(documentId) {
      return request.auth.uid == documentId;
    }
  }
}