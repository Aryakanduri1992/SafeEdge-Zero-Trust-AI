/**
 * @file Firestore Security Rules
 * @core-philosophy This ruleset enforces a role-based access control model, with a special 'SuperAdmin' role. It secures access to organization and department data based on the super admin's identity and role.
 * @data-structure
 *   - /roles_super_admin/{superAdminId}: Stores super admin profile information, indexed by UID.
 *   - /organizations/{organizationId}: Stores organization profile information.
 *   - /departments/{departmentId}: Stores department information.
 * @key-security-decisions
 *   - Only super admins can create, update, or delete organizations.
 *   - Departments can be listed by anyone.
 * @denormalization-for-authorization
 *   - SuperAdmin ID is stored on both Organization and Department documents to enable direct authorization checks.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user's UID matches the provided userId.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user is an existing owner (signed in, UID matches, and resource exists).
     */
    function isExistingOwner(userId) {
      return isSignedIn() && isOwner(userId) && resource != null;
    }
    
    /**
     * @description Allows only authenticated super admins to manage their profiles.
     * @path /roles_super_admin/{superAdminId}
     * @allow (get, create, update, delete) - User with UID 'user123' can read/write their own super admin profile.
     * @deny (get, create, update, delete) - User with UID 'user456' cannot read/write the profile of 'user123'.
     * @principle Enforces document ownership for writes and restricts access to a user's own data tree.
     */
    match /roles_super_admin/{superAdminId} {
      allow get: if isOwner(superAdminId);
      allow list: if false; // Listing super admins is not allowed.
      allow create: if isOwner(superAdminId);
      allow update: if isExistingOwner(superAdminId);
      allow delete: if isExistingOwner(superAdminId);
    }

    /**
     * @description Allows only super admins to manage organizations.
     * @path /organizations/{organizationId}
     * @allow (create) - A super admin can create an organization.
     * @allow (update, delete) - A super admin can update/delete their organization.
     * @deny (create, update, delete) - A regular user cannot create/update/delete organizations.
     * @principle Enforces role-based access control for organization management.
     */
    match /organizations/{organizationId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.superAdminId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.superAdminId);
      allow delete: if isExistingOwner(resource.data.superAdminId);
    }

    /**
     * @description Allows anyone to read departments, but only super admins can manage them.
     * @path /departments/{departmentId}
     * @allow (get, list) - Anyone can retrieve department information.
     * @allow (create, update, delete) - Only a super admin can create, update, or delete departments.
     * @deny (create, update, delete) - Regular users cannot create, update, or delete departments.
     * @principle Allows public read access with owner-only writes.
     */
    match /departments/{departmentId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.superAdminId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.superAdminId);
      allow delete: if isExistingOwner(resource.data.superAdminId);
    }
  }
}