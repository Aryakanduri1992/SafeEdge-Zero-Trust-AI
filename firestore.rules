/**
 * @fileoverview Firestore Security Rules for AuthStation.
 *
 * Core Philosophy:
 * This ruleset enforces a role-based access control model for super admins and an ownership model for other resources.
 *
 * Data Structure:
 * - /roles_super_admin/{superAdminId}:  Super admin role assignments, with documents named by the user's UID.
 * - /organizations/{organizationId}: Organization profiles, with documents named by the organization's ID.
 * - /departments/{departmentId}: Departments within organizations, with documents named by the department's ID.
 * - /devices/{deviceId}: Devices managed within departments, with documents named by the device's ID.
 *
 * Key Security Decisions:
 * - Only super admins can create/update/delete organizations and departments.
 * - Anyone can read organization and department information.
 * - Only authenticated users can update device statuses.
 *
 * Denormalization for Authorization:
 * - The 'superAdminId' field is present in the 'organizations' and 'departments' collections to facilitate authorization checks.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the current user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the current user is the owner (UID matches).
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the document exists and the current user is the owner.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Checks if the user is a super admin by verifying the existence of a document in /roles_super_admin/{userId}.
     */
    function isSuperAdmin() {
      return exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
    }

    /**
     * @description Rules for the /roles_super_admin/{superAdminId} collection.
     * @path /roles_super_admin/{superAdminId}
     * @allow (get) Authenticated user can get its own role
     * @deny (get) Authenticated user cannot get another user's role
     * @allow (create) Only the user themselves (verified by UID) can create their role entry.
     * @deny (create) A different user cannot create a role entry for another user.
     * @principle Enforces self-creation and owner-only access to role documents.
     */
    match /roles_super_admin/{superAdminId} {
      allow get: if isSignedIn() && isOwner(superAdminId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(superAdminId);
      allow update: if isSignedIn() && isOwner(superAdminId);
      allow delete: if isSignedIn() && isOwner(superAdminId);
    }

     /**
      * @description Rules for the /organizations/{organizationId} collection.
      * @path /organizations/{organizationId}
      * @allow (get) Anyone can read organization profile information.
      * @deny (create) Only super admins can create organizations.
      * @allow (update) Only super admins can update organization information.
      * @principle Enforces role-based access control for organization management.
      */
    match /organizations/{organizationId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    /**
     * @description Rules for the /departments/{departmentId} collection.
     * @path /departments/{departmentId}
     * @allow (get) Anyone can read department information.
     * @deny (create) Only super admins can create new departments.
     * @allow (update) Only super admins can update department information.
     * @principle Enforces role-based access control for department management.
     */
    match /departments/{departmentId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    /**
     * @description Rules for the /devices/{deviceId} collection.
     * @path /devices/{deviceId}
     * @allow (get) Anyone can read device information.
     * @allow (list) Anyone can list devices.
     * @deny (create) Only super admins can create new devices.
     * @allow (update) Only authenticated user can update device statuses.
     */
    match /devices/{deviceId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSuperAdmin();
      allow update: if isSignedIn();
      allow delete: if isSuperAdmin();
    }
  }
}