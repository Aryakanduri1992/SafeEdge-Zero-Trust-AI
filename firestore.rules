/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a role-based access control system with strict ownership for user-related data.
 *
 * Data Structure:
 * - /roles_super_admin/{superAdminId}: Super admin profiles, accessible only to themselves.
 * - /organizations/{organizationId}: Organization profiles, writable only by super admins.
 * - /departments/{departmentId}: Departments, writable only by super admins or organization admins.
 * - /devices/{deviceId}: Devices, writable only by super admins or organization admins.
 * - /sensorReadings/{readingId}: Sensor readings, writable only by devices (authenticated or trusted).
 *
 * Key Security Decisions:
 * - Super admins are identified by their UID matching a document ID in `/roles_super_admin`.
 * - Organizations can only be created by a super admin.
 * - Listing of any collection is generally disallowed unless explicitly public.
 *
 * Denormalization for Authorization:
 * - The `superAdminId` field is used in the `organizations` and `departments` collections to simplify ownership checks.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     * @path N/A
     * @allow N/A
     * @deny N/A
     * @principle Verifies user authentication.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user is the owner of the document (UID matches document ID).
     * @path N/A
     * @allow N/A
     * @deny N/A
     * @principle Enforces document ownership based on UID.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the user is an existing owner of the document.
     * @path N/A
     * @allow N/A
     * @deny N/A
     * @principle Enforces document ownership and existence for updates/deletes.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }


    /**
     * @description Super admin profiles. Only the super admin can read or write their own profile.
     * @path /roles_super_admin/{superAdminId}
     * @allow (get, create, update, delete) - A super admin can access their own profile.
     * @deny (get, create, update, delete) - Any other user attempts to access a super admin profile.
     * @principle Enforces strict ownership for super admin profiles.
     */
    match /roles_super_admin/{superAdminId} {
      allow get: if isOwner(superAdminId);
      allow list: if false;
      allow create: if isOwner(superAdminId);
      allow update: if isExistingOwner(superAdminId);
      allow delete: if isExistingOwner(superAdminId);
    }

    /**
     * @description Organization profiles. Super admins can create organizations.
     * @path /organizations/{organizationId}
     * @allow (create) - A super admin can create a new organization.
     * @allow (get) - Any authenticated user can read organization profiles.
     * @deny (create) - A non-super admin attempts to create an organization.
     * @deny (update, delete) - Any user attempts to update or delete an organization.
     * @principle Restricts organization creation to super admins.
     */
    match /organizations/{organizationId} {
      allow get: if true;
      allow list: if false;
      allow create: if isSignedIn() && get(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid)).data.id == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Department information. Super Admins can create department profiles.
     * @path /departments/{departmentId}
     * @allow (create) - A super admin can create a department.
     * @allow (get) - Any authenticated user can read department information.
     * @deny (create) - A non-super admin attempts to create a department.
     * @deny (update, delete) - Any user attempts to update or delete a department.
     * @principle Restricts department creation to super admins.
     */
    match /departments/{departmentId} {
        allow get: if true;
        allow list: if false;
        allow create: if isSignedIn() && get(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid)).data.id == request.auth.uid;
        allow update: if false;
        allow delete: if false;
    }

    /**
     * @description Device information. Super Admins can create device profiles.
     * @path /devices/{deviceId}
     * @allow (create) - A super admin can create a device.
     * @allow (get) - Any authenticated user can read device information.
     * @deny (create) - A non-super admin attempts to create a device.
     * @deny (update, delete) - Any user attempts to update or delete a device.
     * @principle Restricts device creation to super admins.
     */
    match /devices/{deviceId} {
        allow get: if true;
        allow list: if false;
        allow create: if isSignedIn() && get(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid)).data.id == request.auth.uid;
        allow update: if false;
        allow delete: if false;
    }

    /**
     * @description Sensor readings data. Allow anyone to read sensor readings but only allow the devices to create it.
     * @path /sensorReadings/{readingId}
     * @allow (get) - Any authenticated user can read sensor readings.
     * @allow (create) - Any authenticated user can create a sensor reading.
     * @deny (update, delete) - No one can update or delete a sensor reading.
     */
    match /sensorReadings/{readingId} {
        allow get: if true;
        allow list: if false;
        allow create: if isSignedIn();
        allow update: if false;
        allow delete: if false;
    }
  }
}