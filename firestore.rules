/**
 * @description This ruleset enforces a strict role-based access control model for the AuthStation application.
 * Super Admins are managed via the `/roles_super_admin/{superAdminId}` collection, and regular Admins are stored in the `/admins/{adminId}` collection.
 * Devices and Alerts are linked to Admin accounts via the `adminId` field and access is controlled based on this relationship.
 *
 * @dataStructure
 * - /roles_super_admin/{superAdminId}: Indicates Super Admin status.
 * - /admins/{adminId}: Stores Admin profiles, linked to a Super Admin via `superAdminId`.
 * - /devices/{deviceId}: Stores device information, linked to an Admin via `adminId`.
 * - /alerts/{alertId}: Stores alert data, linked to an Admin via `adminId`.
 *
 * @keySecurityDecisions
 * - Super Admin status is determined by the existence of a document in `/roles_super_admin/{superAdminId}`.
 * - Admins can only manage devices and alerts associated with their `adminId`.
 * - Authorization Independence is maintained: admin access does NOT depend on the superAdmin document content.
 *
 * @denormalizationForAuthorization
 * - The `adminId` field is denormalized into both the `/devices/{deviceId}` and `/alerts/{alertId}` documents. This allows security rules to efficiently filter and secure data based on admin ownership without requiring additional `get()` calls.
 *
 * @structuralSegregation
 * - Super Admin roles are managed in a separate collection (`/roles_super_admin/{superAdminId}`) to ensure clear separation of concerns and efficient role verification.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user's UID matches the provided userId.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user's UID matches the provided userId and the resource exists.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Checks if the user is a Super Admin by verifying the existence of their UID in the /roles_super_admin/{superAdminId} collection.
     */
    function isSuperAdmin() {
        return exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
    }

    match /roles_super_admin/{superAdminId} {
      /**
       * @description Manages Super Admin role assignments.
       * @path /roles_super_admin/{superAdminId}
       * @allow (create) User with matching UID can create their SuperAdmin role.
       * @deny (create) User tries to create a SuperAdmin role with a different UID.
       * @allow (get, list) Any signed-in user can read the Super Admin role assignments.
       * @deny (update, delete) No one can update or delete Super Admin role assignments directly through the rules.
       * @principle Enforces secure Super Admin role management by controlling who can create Super Admin roles.
       */
      allow get, list: if isSignedIn();
      allow create: if isOwner(superAdminId);
      allow update, delete: if false;
    }

    match /admins/{adminId} {
      /**
       * @description Manages Admin profiles.
       * @path /admins/{adminId}
       * @allow (create) A Super Admin can create an Admin profile.
       * @deny (create) A regular user cannot create an Admin profile.
       * @allow (get, list) Any signed-in user can read Admin profiles.
       * @allow (update, delete) Only Super Admins can update or delete Admin profiles.
       * @principle Enforces role-based access control for Admin profile management.
       */
      allow get, list: if isSignedIn();
      allow create: if isSuperAdmin();
      allow update, delete: if isSuperAdmin() && isExistingOwner(adminId);
    }

    match /devices/{deviceId} {
      /**
       * @description Manages IoT device data.
       * @path /devices/{deviceId}
       * @allow (create) An Admin can create a device associated with their adminId.
       * @deny (create) A user cannot create a device not associated with their adminId.
       * @allow (get, list) Any signed-in user can read list device data.
       * @allow (update, delete) Only the Admin associated with the device can update or delete it.
       * @principle Enforces ownership-based access control for device management.
       */
      allow get, list: if isSignedIn();
      allow create: if request.resource.data.adminId == request.auth.uid;
      allow update, delete: if isExistingOwner(resource.data.adminId);
    }

    match /alerts/{alertId} {
      /**
       * @description Manages system alerts.
       * @path /alerts/{alertId}
       * @allow (create) An Admin can create an alert associated with their adminId.
       * @deny (create) A user cannot create an alert not associated with their adminId.
       * @allow (get, list) Any signed-in user can read alert data.
       * @allow (update, delete) Only the Admin associated with the alert can update or delete it.
       * @principle Enforces ownership-based access control for alert management.
       */
      allow get, list: if isSignedIn();
      allow create: if request.resource.data.adminId == request.auth.uid;
      allow update, delete: if isExistingOwner(resource.data.adminId);
    }
  }
}