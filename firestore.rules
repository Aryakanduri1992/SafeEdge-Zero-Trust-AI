/**
 * @file Overview
 * This ruleset enforces a role-based access control model with super-admin privileges.
 *
 * Data Structure:
 * - /roles_super_admin/{superAdminId}: Stores documents that identify a user as a Super Admin by their UID.
 * - /organizations/{organizationId}: Stores organization profile information.
 * - /departments/{departmentId}: Stores department information for all organizations.
 * - /devices/{deviceId}: Stores information about individual devices.
 * - /sensorReadings/{readingId}: Stores time-series data from sensor devices.
 *
 * Key Security Decisions:
 * - Super admins have full access to organizations, departments, and devices.
 * - Regular users (non-super admins) are not explicitly granted any access in this initial prototyping phase, effectively restricting them.  Their access would need to be defined in a later iteration based on a defined user role or ownership model.
 * - List operations are generally disallowed except where explicitly granted to super admins.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to super admin role assignments.
     * @path /roles_super_admin/{superAdminId}
     * @allow (create) - A user with a matching UID can create their own super admin role if they don't already have one.
     * @deny (create) - A user attempts to create a super admin role for a different UID.
     * @allow (get) - Any authenticated user can check if a super admin role exists for a given UID.
     * @deny (list) - Listing all super admin roles is prohibited.
     * @principle Enforces self-assignment of the super admin role using UID matching.
     */
    match /roles_super_admin/{superAdminId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(superAdminId) {
        return request.auth.uid == superAdminId;
      }
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isOwner(superAdminId);
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Controls access to organization profiles.
     * @path /organizations/{organizationId}
     * @allow (create) - A super admin can create a new organization.
     * @deny (create) - A non-super admin attempts to create an organization.
     * @allow (get) - Any authenticated user can retrieve an organization profile.
     * @deny (list) - Listing all organizations is prohibited.
     * @principle Restricts organization creation to super admins.
     */
    match /organizations/{organizationId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isSuperAdmin() {
        return exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
      }
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    /**
     * @description Controls access to department information.
     * @path /departments/{departmentId}
     * @allow (create) - A super admin can create a new department.
     * @deny (create) - A non-super admin attempts to create a department.
     * @allow (get) - Any authenticated user can retrieve department information.
     * @deny (list) - Listing all departments is prohibited.
     * @principle Restricts department creation to super admins.
     */
    match /departments/{departmentId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isSuperAdmin() {
        return exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
      }
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    /**
     * @description Controls access to device information.
     * @path /devices/{deviceId}
     * @allow (create) - A super admin can create a new device.
     * @deny (create) - A non-super admin attempts to create a device.
     * @allow (get) - Any authenticated user can retrieve device information.
     * @deny (list) - Listing all devices is prohibited.
     * @principle Restricts device creation to super admins.
     */
    match /devices/{deviceId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isSuperAdmin() {
        return exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
      }
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    /**
     * @description Controls access to sensor readings.
     * @path /sensorReadings/{readingId}
     * @allow (create) - A super admin can create a new sensor reading.
     * @deny (create) - A non-super admin attempts to create a sensor reading.
     * @allow (get) - Any authenticated user can retrieve a sensor reading.
     * @deny (list) - Listing all sensor readings is prohibited.
     * @principle Restricts sensor reading creation to super admins.
     */
    match /sensorReadings/{readingId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isSuperAdmin() {
        return exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
      }
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }
  }
}