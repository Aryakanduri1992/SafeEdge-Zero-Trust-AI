
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check for superadmin claim
    function isSuperAdmin() {
      return request.auth.token.superadmin == true;
    }

    // Super Admins can read and write anything
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }
    
    // Organization admins can read their own organization document
    match /organizations/{orgId} {
      allow get: if request.auth.uid == orgId;
      allow update: if request.auth.uid == orgId;
    }
    
    // Organization admins can read departments and devices belonging to their organization
    match /departments/{deptId} {
      allow read: if get(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)).data.superAdminId == request.auth.uid || request.resource.data.organizationId == request.auth.uid;
    }
    
    match /devices/{deviceId} {
       allow read, write: if request.resource.data.organizationId == request.auth.uid;
    }
    
    // Allow SuperAdmins to read their own role document
     match /roles_super_admin/{superAdminId} {
      allow get: if request.auth.uid == superAdminId;
    }
  }
}
