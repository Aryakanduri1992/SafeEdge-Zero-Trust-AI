/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a role-based access control model with super-admin capabilities and organization-specific data isolation.
 *
 * Data Structure:
 * - /roles_super_admin/{superAdminId}: Stores super admin role assignments, keyed by user UID.
 * - /organizations/{organizationId}: Stores organization data.
 * - /departments/{departmentId}: Stores department data, linked to an organization.
 * - /devices/{deviceId}: Stores device data, linked to a department and organization.
 *
 * Key Security Decisions:
 * - Super admins can manage (create, update, delete) organizations, departments, and devices.
 * - Organizations and their associated data (departments, devices) are isolated from each other.  Non-super admins cannot access any data.
 *
 * Denormalization for Authorization:
 * - Each document contains `organizationId` to simplify organization-level authorization checks.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     * @path N/A
     * @allow N/A
     * @deny N/A
     * @principle Verifies user authentication.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user is a Super Admin.
     * @path N/A
     * @allow N/A
     * @deny N/A
     * @principle Checks for super admin role based on UID.
     */
    function isSuperAdmin() {
        return exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
    }

    /**
     * @description Checks if the provided user ID matches the authenticated user's ID.
     * @path N/A
     * @allow N/A
     * @deny N/A
     * @principle Enforces user ownership based on UID comparison.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the user is the owner of the existing resource based on an internal ownership field.
     */
    function isExistingOwner(ownerId) {
        return (isOwner(ownerId) && resource != null);
    }


    /**
     * @description Rules for the roles_super_admin collection. Grants super admin access based on UID.
     * @path /roles_super_admin/{superAdminId}
     * @allow (get) User 'superAdmin123' can retrieve their own role if authenticated.
     * @allow (create) User 'superAdmin123' can create their own role if authenticated.
     * @deny (create) User 'user123' cannot create a super admin role for 'superAdmin123'.
     * @deny (get) User 'user123' cannot retrieve the role of 'superAdmin123'.
     * @principle Enforces super admin role management based on user ID.
     */
    match /roles_super_admin/{superAdminId} {
        allow get: if isSignedIn() && isOwner(superAdminId);
        allow list: if false;
        allow create: if isSignedIn() && isOwner(superAdminId);
        allow update: if isSignedIn() && isOwner(superAdminId);
        allow delete: if isSignedIn() && isOwner(superAdminId);
    }

    /**
     * @description Rules for the organizations collection. Allows super admins to manage organizations.
     * @path /organizations/{organizationId}
     * @allow (create) A super admin can create a new organization.
     * @allow (get) Anyone can retrieve organization data.
     * @deny (create) A non-super admin cannot create an organization.
     * @deny (update) A non-super admin cannot update an organization.
     * @principle Restricts organization management to super admins.
     */
    match /organizations/{organizationId} {
      allow get, list: if true;
      allow create: if isSignedIn() && isSuperAdmin();
      allow update: if isSignedIn() && isSuperAdmin();
      allow delete: if isSignedIn() && isSuperAdmin();
    }

    /**
     * @description Rules for the departments collection. Allows super admins to manage departments.
     * @path /departments/{departmentId}
     * @allow (create) A super admin can create a new department.
     * @allow (get) Anyone can retrieve department data.
     * @deny (create) A non-super admin cannot create a department.
     * @deny (update) A non-super admin cannot update a department.
     * @principle Restricts department management to super admins.
     */
    match /departments/{departmentId} {
        allow get, list: if true;
        allow create: if isSignedIn() && isSuperAdmin();
        allow update: if isSignedIn() && isSuperAdmin();
        allow delete: if isSignedIn() && isSuperAdmin();
    }

    /**
     * @description Rules for the devices collection. Allows super admins to manage devices.
     * @path /devices/{deviceId}
     * @allow (create) A super admin can create a new device.
     * @allow (get) Anyone can retrieve device data.
     * @deny (create) A non-super admin cannot create a device.
     * @deny (update) A non-super admin cannot update a device.
     * @principle Restricts device management to super admins.
     */
    match /devices/{deviceId} {
        allow get, list: if true;
        allow create: if isSignedIn() && isSuperAdmin();
        allow update: if isSignedIn() && isSuperAdmin();
        allow delete: if isSignedIn() && isSuperAdmin();
    }
  }
}