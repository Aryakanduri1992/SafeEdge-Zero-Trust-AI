/**
 * @fileOverview Firestore Security Rules for AuthStation application.
 *
 * Core Philosophy:
 * This ruleset enforces a role-based access control model, primarily centered around the concept of ownership and administrative privileges.
 * Super Admins have elevated access to manage organizations and departments. Organizations can manage their own departments and devices.
 *
 * Data Structure:
 * - /roles_super_admin/{superAdminId}: Stores SuperAdmin profiles, with the document ID matching the Firebase Auth UID.
 * - /organizations/{organizationId}: Stores Organization profiles, with the document ID matching the Firebase Auth UID.
 * - /departments/{departmentId}: Stores Department profiles, linked to an organization via the 'organizationId' field.
 * - /devices/{deviceId}: Stores IoT device data, linked to a department via the 'departmentId' field.
 * - /alerts/{alertId}: Stores system alerts generated by devices, linked to a department via the 'departmentId' field.
 *
 * Key Security Decisions:
 * - Super Admins are granted create, read, update and delete access to organizations.
 * - Organizations can manage their own departments and devices.
 * - Departments do not have separate login credentials; their access is managed through the parent organization.
 * - Listing of Super Admins and Organizations is denied to prevent unauthorized enumeration.
 *
 * Denormalization for Authorization:
 *  - The `departments` and `devices` collections rely on the `organizationId` field on documents in `departments` to determine the parent organization. Similarly, the `devices` and `alerts` collections rely on the `departmentId` field to determine the parent department.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Rule for SuperAdmin profiles.
     * @path /roles_super_admin/{superAdminId}
     * @allow (create) - If the user's UID matches the document ID and the email is verified
     * @allow (get, update, delete) - If the user's UID matches the document ID.
     * @deny (list) - Listing SuperAdmins is not permitted.
     * @deny (create) - If the user's UID does not match the document ID.
     * @deny (update, delete) - If the user's UID does not match the document ID.
     * @principle Enforces document ownership for writes and prevents unauthorized listing.
     */
    match /roles_super_admin/{superAdminId} {
      allow get: if isSignedIn() && isOwner(superAdminId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(superAdminId);
      allow update: if isSignedIn() && isExistingOwner(superAdminId);
      allow delete: if isSignedIn() && isExistingOwner(superAdminId);
    }

    /**
     * @description Rule for Organization profiles.
     * @path /organizations/{organizationId}
     * @allow (create) - Only super admins can create new organizations.
     * @allow (get, update, delete) - If the user's UID matches the document ID.
     * @deny (list) - Listing Organizations is not permitted.
     * @deny (create) - If the user is not a super admin.
     * @deny (update, delete) - If the user's UID does not match the document ID.
     * @principle Enforces ownership and restricts organization creation to super admins.
     */
    match /organizations/{organizationId} {
      allow get: if isSignedIn() && isOwner(organizationId);
      allow list: if false;
      allow create: if isSignedIn() && isSuperAdmin();
      allow update: if isSignedIn() && isExistingOwner(organizationId);
      allow delete: if isSignedIn() && isExistingOwner(organizationId);
    }

    /**
     * @description Rule for Department profiles.
     * @path /departments/{departmentId}
     * @allow (create) - If the organizationId matches the organizationId in the document.
     * @allow (get, list, update, delete) - If the user is the owner of the organization to which the department belongs.
     * @deny (create) - If the organizationId does not match the organizationId in the document or if the user is not the owner of the organization.
     * @deny (update, delete) - If the user is not the owner of the organization to which the department belongs or if the document does not exist.
     * @principle Organizations can manage their own departments.
     */
    match /departments/{departmentId} {
      allow get: if isSignedIn() && isOrganizationOwner(resource.data.organizationId);
      allow list: if isSignedIn() && isOrganizationOwner(get(/databases/$(database)/documents/departments/$(departmentId)).data.organizationId);
      allow create: if isSignedIn() && request.resource.data.organizationId == request.auth.uid;
      allow update: if isSignedIn() && isExistingOrganizationOwner(resource.data.organizationId);
      allow delete: if isSignedIn() && isExistingOrganizationOwner(resource.data.organizationId);
    }

     /**
     * @description Rule for Device profiles.
     * @path /devices/{deviceId}
     * @allow (create) - If the departmentId matches the departmentId in the document.
     * @allow (get, list, update, delete) - If the user is the owner of the organization to which the device belongs.
     * @deny (create) - If the departmentId does not match the departmentId in the document or if the user is not the owner of the organization.
     * @deny (update, delete) - If the user is not the owner of the organization to which the device belongs or if the document does not exist.
     * @principle Organizations can manage their own devices.
     */
    match /devices/{deviceId} {
        allow get: if isSignedIn() && isOrganizationOwner(get(/databases/$(database)/documents/departments/$(resource.data.departmentId)).data.organizationId);
        allow list: if isSignedIn() && isOrganizationOwner(get(/databases/$(database)/documents/departments/$(resource.data.departmentId)).data.organizationId);
        allow create: if isSignedIn() && isOrganizationOwner(get(/databases/$(database)/documents/departments/$(request.resource.data.departmentId)).data.organizationId);
        allow update: if isSignedIn() && isExistingDeviceOrganizationOwner(resource.data.departmentId);
        allow delete: if isSignedIn() && isExistingDeviceOrganizationOwner(resource.data.departmentId);
    }

    /**
     * @description Rule for Alert profiles.
     * @path /alerts/{alertId}
     * @allow (create) - If the departmentId matches the departmentId in the document.
     * @allow (get, list, update, delete) - If the user is the owner of the organization to which the alert belongs.
     * @deny (create) - If the departmentId does not match the departmentId in the document or if the user is not the owner of the organization.
     * @deny (update, delete) - If the user is not the owner of the organization to which the alert belongs or if the document does not exist.
     * @principle Organizations can manage their own alerts.
     */
    match /alerts/{alertId} {
        allow get: if isSignedIn() && isOrganizationOwner(get(/databases/$(database)/documents/departments/$(resource.data.departmentId)).data.organizationId);
        allow list: if isSignedIn() && isOrganizationOwner(get(/databases/$(database)/documents/departments/$(resource.data.departmentId)).data.organizationId);
        allow create: if isSignedIn() && isOrganizationOwner(get(/databases/$(database)/documents/departments/$(request.resource.data.departmentId)).data.organizationId);
        allow update: if isSignedIn() && isExistingAlertOrganizationOwner(resource.data.departmentId);
        allow delete: if isSignedIn() && isExistingAlertOrganizationOwner(resource.data.departmentId);
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }

    function isOrganizationOwner(organizationId) {
      return request.auth.uid == organizationId;
    }

    function isExistingOrganizationOwner(organizationId) {
        return isOrganizationOwner(organizationId) && resource != null;
    }

    function isDeviceOrganizationOwner(departmentId) {
        return isOrganizationOwner(get(/databases/$(database)/documents/departments/$(departmentId)).data.organizationId);
    }

    function isExistingDeviceOrganizationOwner(departmentId) {
        return isDeviceOrganizationOwner(departmentId) && resource != null;
    }

    function isAlertOrganizationOwner(departmentId) {
        return isOrganizationOwner(get(/databases/$(database)/documents/departments/$(departmentId)).data.organizationId);
    }

    function isExistingAlertOrganizationOwner(departmentId) {
        return isAlertOrganizationOwner(departmentId) && resource != null;
    }

    function isSuperAdmin() {
      return exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
    }
  }
}