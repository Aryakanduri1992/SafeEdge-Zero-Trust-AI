/**
 * @fileOverview Firestore Security Rules for AuthStation.
 *
 * Core Philosophy: This ruleset enforces a role-based access control system with a focus on authorization independence.
 *  Super Admins are authorized by the existence of a document under `/roles_super_admin/{superAdminId}`. Admins have individual profiles under `/admins/{adminId}`.
 *  Access to devices and alerts is controlled via an `adminId` field within each document, ensuring data isolation between different admins.
 *
 * Data Structure:
 * - /roles_super_admin/{superAdminId}: Documents indicating Super Admin status.
 * - /admins/{adminId}: Admin user profiles. Contains a `superAdminId` field.
 * - /devices/{deviceId}: IoT device data, linked to an admin account via `adminId`.
 * - /alerts/{alertId}: System alerts, also linked to an admin account via `adminId`.
 *
 * Key Security Decisions:
 * - Super Admin status is determined solely by the existence of a document in the `/roles_super_admin/{superAdminId}` collection.
 * - `list` operations are generally allowed for owners of subcollections.
 *
 * Denormalization for Authorization:
 * - The `adminId` field in both `devices` and `alerts` is used to quickly authorize access without needing additional `get()` calls.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants Super Admin role to a user. Existence of a document here is sufficient for role verification.
     * @path /roles_super_admin/{superAdminId}
     * @allow (get, create) if request.auth.uid == superAdminId
     * @deny (get, create) if request.auth.uid != superAdminId
     * @allow (list) if false
     * @deny (update, delete) if true
     * @principle Enforces role-based access control using document existence.
     */
    match /roles_super_admin/{superAdminId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }
      
      allow get: if isOwner(superAdminId);
      allow list: if false;
      allow create: if isOwner(superAdminId);
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Stores Admin profiles. Access is NOT dependent on the superAdmin document's content, ensuring Authorization Independence.
     * @path /admins/{adminId}
     * @allow (create) if request.auth.uid == request.resource.data.id
     * @deny (create) if request.auth.uid != request.resource.data.id
     * @allow (get, list) if true
     * @deny (update, delete) if true
     * @principle Restricts admin profile creation to the authenticated user and prevents unauthorized modifications.
     */
    match /admins/{adminId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }

      allow get, list: if true;
      allow create: if isOwner(adminId) && request.resource.data.id == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Stores IoT device data, linked to an admin account.
     * @path /devices/{deviceId}
     * @allow (create) if request.auth.uid == request.resource.data.adminId
     * @deny (create) if request.auth.uid != request.resource.data.adminId
     * @allow (get, list) if true
     * @deny (update, delete) if true
     * @principle Enforces that devices are created and managed only by authorized admins.
     */
    match /devices/{deviceId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isAdmin(adminId) {
        return isSignedIn() && request.auth.uid == adminId;
      }

      allow get, list: if true;
      allow create: if isAdmin(request.resource.data.adminId);
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Stores system alerts generated from devices, linked to an admin account.
     * @path /alerts/{alertId}
     * @allow (create) if request.auth.uid == request.resource.data.adminId
     * @deny (create) if request.auth.uid != request.resource.data.adminId
     * @allow (get, list) if true
     * @deny (update, delete) if true
     * @principle Restricts alert creation and management to the appropriate admin account.
     */
    match /alerts/{alertId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isAdmin(adminId) {
        return isSignedIn() && request.auth.uid == adminId;
      }

      allow get, list: if true;
      allow create: if isAdmin(request.resource.data.adminId);
      allow update: if false;
      allow delete: if false;
    }
  }
}