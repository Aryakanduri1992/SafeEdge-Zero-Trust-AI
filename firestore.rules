rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Enforces Super Admin role via document existence in /roles_super_admin/{superAdminId}.
     * @path /roles_super_admin/{superAdminId}
     */
    match /roles_super_admin/{superAdminId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == superAdminId;
      allow update, delete: if false;
    }

    /**
     * @description Manages Admin profiles, linking them to a Super Admin.
     * @path /admins/{adminId}
     */
    match /admins/{adminId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && isSuperAdmin();
      allow create: if isSignedIn() && isSuperAdmin() && request.resource.data.superAdminId == request.auth.uid;
      allow update: if isSignedIn() && isSuperAdmin() && get(/databases/$(database)/documents/admins/$(adminId)).data.superAdminId == request.auth.uid;
      allow delete: if isSignedIn() && isSuperAdmin() && get(/databases/$(database)/documents/admins/$(adminId)).data.superAdminId == request.auth.uid;
    }

    /**
     * @description Manages IoT device data, ensuring data isolation between admins.
     * @path /devices/{deviceId}
     */
    match /devices/{deviceId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && get(/databases/$(database)/documents/devices/$(deviceId)).data.adminId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.adminId == request.auth.uid;
      allow update: if isSignedIn() && get(/databases/$(database)/documents/devices/$(deviceId)).data.adminId == request.auth.uid;
      allow delete: if isSignedIn() && get(/databases/$(database)/documents/devices/$(deviceId)).data.adminId == request.auth.uid;
    }

    /**
     * @description Manages system alerts, ensuring data isolation between admins.
     * @path /alerts/{alertId}
     */
    match /alerts/{alertId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && get(/databases/$(database)/documents/alerts/$(alertId)).data.adminId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.adminId == request.auth.uid;
      allow update: if isSignedIn() && get(/databases/$(database)/documents/alerts/$(alertId)).data.adminId == request.auth.uid;
      allow delete: if isSignedIn() && get(/databases/$(database)/documents/alerts/$(alertId)).data.adminId == request.auth.uid;
    }

    /**
     * @description Manages organizations profiles, linking them to a Super Admin.
     * @path /organizations/{organizationId}
     */
    match /organizations/{organizationId} {
        allow get: if isSignedIn();
        allow list: if isSignedIn() && isSuperAdmin();
        allow create: if isSignedIn() && isSuperAdmin();
        allow update: if isSignedIn() && isSuperAdmin();
        allow delete: if isSignedIn() && isSuperAdmin();
    }
  }

  // Helper functions
  function isSignedIn() {
    return request.auth != null;
  }

  function isOwner(userId) {
    return request.auth.uid == userId;
  }

  function isSuperAdmin() {
    return exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
  }
}