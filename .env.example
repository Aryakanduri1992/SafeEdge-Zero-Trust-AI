# Firebase Configuration (Current - Local Development)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your_project.firebaseio.com

# Cloud Provider Selection
NEXT_PUBLIC_CLOUD_PROVIDER=firebase

# ==================== DATABASE CONFIGURATION ====================
# Set USE_AZURE_SQL=true to use Azure SQL instead of SQLite
USE_AZURE_SQL=false

# Azure SQL Database Configuration
# Server: lume-sql-server.database.windows.net
# Database: LUME
AZURE_SQL_SERVER=lume-sql-server.database.windows.net
AZURE_SQL_DATABASE=LUME
AZURE_SQL_USER=your_sql_username
AZURE_SQL_PASSWORD=your_sql_password

# AI Services (Free Tier - Local Development)
GROQ_API_KEY=your_groq_api_key
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# Azure Configuration (Future - Post-Competition)
NEXT_PUBLIC_AZURE_TENANT_ID=your_azure_tenant_id
NEXT_PUBLIC_AZURE_CLIENT_ID=your_azure_client_id
NEXT_PUBLIC_AZURE_STORAGE_ACCOUNT=your_storage_account
AZURE_IOT_HUB_CONNECTION_STRING=your_iot_hub_connection
AZURE_OPENAI_ENDPOINT=your_openai_endpoint
AZURE_SPEECH_SERVICE_KEY=your_speech_key

# Security Response Pipeline Configuration
ENABLE_VOICE_ALERTS=true
ENABLE_PHONE_ALERTS=true
MAX_PROCESSING_TIME=30000
